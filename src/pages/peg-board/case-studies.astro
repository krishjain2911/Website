---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Case studies | RHSP PEG Board';
const description = 'Our case studies are coming soon.';
---

<BaseLayout title={title} description={description}>
  <Nav />

  <main id="main-content" class="case-studies-main">
    <div class="container case-studies-container">
      <!-- Back Link -->
      <a href="/peg-board" class="back-link">
        <Icon name="arrow-left" size={14} />
        <span>Back to the board</span>
      </a>

      <!-- Header -->
      <div class="case-studies-hero" style="view-transition-name: tile-case-studies;">
        <span class="eyebrow">CASE STUDIES</span>
        <h1 class="page-heading">Case studies are on their way.</h1>
        <p class="lead-p">
          We are writing up our projects with the teams behind them. They will hang here as soon as they are ready.
        </p>
      </div>

      <!-- Illustrated Empty Hooks -->
      <div class="empty-hooks-display" aria-hidden="true">
        <div class="empty-hook hook-1">
          <div class="drilled-hole"></div>
          <div class="empty-square-peg peg-orange"></div>
        </div>
        <div class="empty-hook hook-2">
          <div class="drilled-hole"></div>
          <div class="empty-square-peg peg-red"></div>
        </div>
        <div class="empty-hook hook-3">
          <div class="drilled-hole"></div>
          <div class="empty-square-peg peg-blue"></div>
        </div>
      </div>

      <!-- Actions -->
      <div class="case-studies-actions">
        <a href="/peg-board" class="btn btn-secondary">
          <span>Browse the guides</span>
        </a>
        <a href="/#contact" class="btn btn-primary">
          <span>Talk to us about your project</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @view-transition {
    navigation: auto;
  }

  .case-studies-main {
    min-height: calc(100vh - 120px);
    padding-top: calc(72px + 3rem);
    padding-bottom: 5rem;
    background-color: var(--color-bg);
  }

  .case-studies-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .case-studies-hero {
    margin-bottom: 3rem;
  }

  .page-heading {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
    color: var(--color-text-primary);
  }

  .lead-p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 0;
  }

  /* Empty hooks illustration */
  .empty-hooks-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    padding: 3.5rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    margin-bottom: 3rem;
  }

  .empty-hook {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  @media (prefers-reduced-motion: no-preference) {
    .empty-hook {
      animation: gentleSway 3s ease-in-out infinite alternate;
    }
    .hook-2 { animation-delay: 0.5s; }
    .hook-3 { animation-delay: 1s; }
  }

  @keyframes gentleSway {
    0% { transform: rotate(-3deg); }
    100% { transform: rotate(3deg); }
  }

  .drilled-hole {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.15) 60%, transparent 75%);
    margin-bottom: -7px;
  }

  .empty-square-peg {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .peg-orange { background-color: #F7941D; }
  .peg-red { background-color: #EE4B2B; }
  .peg-blue { background-color: #1E4B8F; }

  .case-studies-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
</style>
