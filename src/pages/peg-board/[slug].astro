---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import PegPicker from '../../components/pegboard/PegPicker.astro';
import { guides, type ResourceGuide } from '../../data/pegBoard';
import '../../styles/pegboard-tokens.css';

export function getStaticPaths() {
  return Object.values(guides).map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

interface Props {
  guide: ResourceGuide;
}

const { guide } = Astro.props;
const title = `${guide.h1} | RHSP PEG Board`;
const description = guide.seoDescription;

// Article JSON-LD Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': guide.h1,
  'description': guide.summary,
  'author': {
    '@type': 'Organization',
    'name': 'Round Hole Square Peg'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Round Hole Square Peg'
  }
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <Nav />

  <main id="main-content" class="pegboard-page guide-page-main">
    <div class="container guide-page-container">
      <!-- Back Link -->
      <a href="/peg-board" class="back-link">
        <Icon name="arrow-left" size={14} />
        <span>Back to the board</span>
      </a>

      <!-- Header with View Transition Matching Tile -->
      <header class="guide-header" style={`view-transition-name: tile-${guide.slug};`}>
        <span class="eyebrow">GUIDE</span>
        <h1 class="guide-h1">{guide.h1}</h1>
        <p class="guide-summary">{guide.summary}</p>
      </header>

      <!-- Intro Paragraph -->
      <div class="guide-intro-block">
        <p class="intro-p">{guide.intro}</p>
      </div>

      <!-- Comparison Table Container (Horizontal Scroll on Mobile) -->
      <section class="guide-table-section" aria-labelledby="comparison-table-heading">
        <h2 id="comparison-table-heading" class="sr-only">Detailed stack comparison table</h2>
        <div class="table-scroll-wrapper">
          <table class="guide-comparison-table">
            <caption class="sr-only">{guide.h1} comparison table</caption>
            <thead>
              <tr>
                {guide.tableHeaders.map((header) => (
                  <th scope="col">{header}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {guide.tableRows.map((row) => (
                <tr>
                  <th scope="row" class="topic-header-cell">{row.topic}</th>
                  {row.columns.map((col, i) => (
                    <td data-label={guide.tableHeaders[i + 1]}>{col}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {guide.tableNote && (
          <p class="guide-table-note">{guide.tableNote}</p>
        )}
      </section>

      <!-- Choose When Lists Side-by-Side (Stacked on Mobile) -->
      <section class="choose-when-section">
        <div class="choose-when-grid">
          {guide.chooseWhen.map((col) => (
            <div class="choose-when-card card-mastercard">
              <h3 class="choose-col-title">{col.title}</h3>
              <ul class="choose-points-list">
                {col.points.map((pt) => (
                  <li class="choose-point-item">
                    <span class="point-bullet" aria-hidden="true">✓</span>
                    <span class="point-text">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Dynamic Priority Picker Component -->
      {guide.picker && (
        <PegPicker guideSlug={guide.slug} picker={guide.picker} />
      )}

      <!-- How We Decide Section -->
      <section class="how-we-decide-section card-mastercard">
        <h2 class="decide-heading">How we decide</h2>
        <p class="decide-p">{guide.howWeDecide}</p>
      </section>

      <!-- Bottom Sticky / Clear CTA Block -->
      <section class="guide-cta-footer card-mastercard">
        <div class="cta-content-col">
          <h3 class="cta-heading">Ready to talk through your architecture?</h3>
          <p class="cta-sub">
            Let's discuss how this applies to your team, timeline, and existing systems.
          </p>
        </div>

        <div class="cta-actions-col">
          <a href="/#contact" class="btn btn-primary cta-talk-btn">
            <span>Talk to us</span>
            <Icon name="arrow-right" size={14} />
          </a>

          <button
            type="button"
            class="btn btn-secondary cta-pin-btn"
            id="footer-pin-guide-btn"
            data-guide-slug={guide.slug}
          >
            <Icon name="bookmark" size={14} />
            <span id="footer-pin-btn-text">Pin this guide</span>
          </button>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { togglePin, isPinned } from '../../scripts/pegBoardState';

  function initGuideFooterPin() {
    const btn = document.getElementById('footer-pin-guide-btn');
    const btnText = document.getElementById('footer-pin-btn-text');
    if (!btn || !btnText) return;

    const slug = btn.getAttribute('data-guide-slug') || '';

    function sync() {
      const p = isPinned(slug);
      if (btn) btn.classList.toggle('is-pinned', p);
      if (btnText) btnText.textContent = p ? 'Pinned to my board' : 'Pin this guide';
    }

    btn.addEventListener('click', () => {
      togglePin(slug);
      sync();
    });

    window.addEventListener('rhsp:pegboard:pins-changed', sync);
    sync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGuideFooterPin);
  } else {
    initGuideFooterPin();
  }
</script>

<style>
  @view-transition {
    navigation: auto;
  }

  .guide-page-main {
    min-height: calc(100vh - 120px);
    padding-top: calc(72px + 2.5rem);
    padding-bottom: 5rem;
    background-color: var(--pb-page, #FFFFFF);
    transition: background-color 0.25s ease;
  }

  .guide-page-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--pb-text-2, var(--color-text-secondary));
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--pb-accent, #F7941D);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .guide-header {
    margin-bottom: 2rem;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--pb-accent, #F7941D);
    text-transform: uppercase;
  }

  .guide-h1 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.85rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .guide-summary {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  .guide-intro-block {
    margin-bottom: 3rem;
  }

  .intro-p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--pb-text, var(--color-text-primary));
    margin: 0;
  }

  /* Comparison Table */
  .guide-table-section {
    margin-bottom: 3.5rem;
  }

  .table-scroll-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--pb-line, var(--color-border));
    border-radius: 16px;
    background-color: var(--pb-tile, var(--color-surface));
  }

  .guide-comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9375rem;
    min-width: 600px;
  }

  .guide-comparison-table th,
  .guide-comparison-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--pb-line, var(--color-border));
    vertical-align: top;
    line-height: 1.55;
  }

  .guide-comparison-table thead th {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--pb-accent, #F7941D);
    background-color: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
    border-bottom: 2px solid var(--pb-line);
  }

  .topic-header-cell {
    font-weight: 600;
    color: var(--pb-text, var(--color-text-primary));
    width: 22%;
  }

  .guide-comparison-table td {
    color: var(--pb-text-2, var(--color-text-secondary));
  }

  .guide-comparison-table tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.025);
  }

  .guide-comparison-table tbody tr:last-child th,
  .guide-comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .guide-table-note {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--pb-text-3, var(--color-text-muted));
    margin: 0.85rem 0 0;
    padding: 0 0.25rem;
  }

  /* Choose When Grid */
  .choose-when-section {
    margin-bottom: 3.5rem;
  }

  .choose-when-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .choose-when-card {
    padding: 1.75rem;
    border-radius: 18px;
    background-color: var(--pb-tile, var(--color-surface));
    border: 1px solid var(--pb-line, var(--color-border));
  }

  .choose-col-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .choose-points-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .choose-point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--pb-text-2, var(--color-text-secondary));
  }

  .point-bullet {
    color: var(--pb-accent, #F7941D);
    font-weight: 700;
    font-size: 0.875rem;
    margin-top: 0.1rem;
  }

  /* How We Decide */
  .how-we-decide-section {
    padding: 2rem 2.25rem;
    border-radius: 20px;
    background-color: var(--pb-tile, var(--color-surface));
    border: 1px solid var(--pb-line, var(--color-border));
    margin-bottom: 3.5rem;
  }

  .decide-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .decide-p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  /* Footer CTA */
  .guide-cta-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2.25rem;
    border-radius: 22px;
    background-color: var(--pb-tile, var(--color-surface));
    border: 1px solid var(--pb-line, var(--color-border));
  }

  .cta-content-col {
    max-width: 480px;
  }

  .cta-heading {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .cta-sub {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  .cta-actions-col {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .cta-talk-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.75rem 1.4rem;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 999px;
    background-color: var(--pb-accent, #F7941D);
    color: var(--pb-on-accent, #14110F);
    border: 1px solid var(--pb-accent-lo, #B86200);
    text-decoration: none;
    box-shadow: 0 4px 14px var(--pb-glow);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .cta-talk-btn:hover {
    background-color: var(--pb-accent-hi, #FFAE4A);
    transform: translateY(-1px);
  }

  .cta-talk-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .cta-pin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 999px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line);
    color: var(--pb-text);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .cta-pin-btn:hover {
    border-color: var(--pb-accent);
    color: var(--pb-accent);
  }

  .cta-pin-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .cta-pin-btn.is-pinned {
    background-color: var(--pb-accent-wash);
    border-color: var(--pb-accent);
    color: var(--pb-accent);
  }

  /* Phones: each table row becomes a stacked card with labelled values,
     so there is no sideways scrolling and nothing is cut off. */
  @media (max-width: 639px) {
    .table-scroll-wrapper {
      overflow: visible;
      border: none;
      background: transparent;
      border-radius: 0;
    }

    .guide-comparison-table {
      min-width: 0;
      display: block;
    }

    .guide-comparison-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .guide-comparison-table tbody,
    .guide-comparison-table tr,
    .guide-comparison-table th,
    .guide-comparison-table td {
      display: block;
      width: 100%;
      box-sizing: border-box;
    }

    .guide-comparison-table tbody tr {
      margin-bottom: 1rem;
      border: 1px solid var(--pb-line, var(--color-border));
      border-radius: 14px;
      background-color: var(--pb-tile, var(--color-surface));
      overflow: hidden;
    }

    .guide-comparison-table tbody tr:nth-child(even) {
      background-color: var(--pb-tile, var(--color-surface));
    }

    .guide-comparison-table th.topic-header-cell {
      width: 100%;
      padding: 0.85rem 1rem;
      background-color: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
      border-bottom: 1px solid var(--pb-line, var(--color-border));
    }

    .guide-comparison-table td {
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--pb-line, var(--color-border));
    }

    .guide-comparison-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.2rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--pb-accent, #F7941D);
    }

    .guide-comparison-table tbody tr:last-child th,
    .guide-comparison-table tbody tr:last-child td {
      border-bottom: 1px solid var(--pb-line, var(--color-border));
    }

    .guide-comparison-table tbody tr td:last-child {
      border-bottom: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>