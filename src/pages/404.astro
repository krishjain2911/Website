---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LogoMark from '../components/brand/LogoMark.astro';
---

<BaseLayout
  title="404 – Page Not Found | RHSP"
  description="Every challenge requires the right adapter. This URL does not lead to an active path."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <section class="not-found-section" aria-labelledby="not-found-heading">
      <div class="container not-found-container">
        <!-- 404 Geometric Visual -->
        <div class="not-found-visual-card card-mastercard reveal-on-scroll">
          <div class="not-found-logo-row">
            <LogoMark size="lg" showText={true} />
          </div>

          <div class="not-found-content">
            <span class="eyebrow">ERROR 404</span>
            <h1 id="not-found-heading" class="not-found-title">
              Page not found.
            </h1>
            <p class="not-found-subline">
              Every challenge requires the right adapter. This URL does not lead to an active path.
            </p>

            <div class="not-found-cta-group">
              <a href="/" class="btn btn-primary">
                <Icon name="arrow-left" size={16} />
                <span>Return to Homepage</span>
              </a>
              <a href="/#solutions" class="btn btn-secondary">
                <span>Explore Solutions</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Footer />
</BaseLayout>

<style>
  .not-found-section {
    padding: calc(72px + 4rem) 0 5rem;
    min-height: calc(100dvh - 350px);
    display: flex;
    align-items: center;
  }

  .not-found-container {
    max-width: 800px;
  }

  .not-found-visual-card {
    padding: clamp(2rem, 5vw, 4rem);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  .not-found-art-wrap {
    width: 240px;
    height: 160px;
  }

  .not-found-svg {
    width: 100%;
    height: 100%;
  }

  .not-found-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 520px;
  }

  .not-found-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .not-found-subline {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .not-found-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 1rem;
  }
</style>
