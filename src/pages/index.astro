---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ApproachJourney from '../components/ApproachJourney.astro';
import PegSolutions from '../components/PegSolutions.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="RHSP | OutSystems, MERN & Enterprise AI Partner in Mumbai"
  description="RHSP is a technology partner for enterprises in Mumbai: consulting, OutSystems low-code, custom MERN development, accelerators, and sovereign AI platforms."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. Hero: Pinned 3D Logo Cube & Scroll Pass-Through -->
    <Hero />

    <!-- 2. Our Approach: Six Stages Journey -->
    <ApproachJourney />

    <!-- 3. The PEG Solutions: How We Think + Capabilities & Solutions -->
    <PegSolutions />

    <!-- 4. Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
