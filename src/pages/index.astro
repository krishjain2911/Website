---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ApproachJourney from '../components/ApproachJourney.astro';
import PegCube from '../components/PegCube.astro';
import SolutionsGrid from '../components/SolutionsGrid.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="RHSP - Tech that adapts to business."
  description="RHSP is a technology partner for enterprises: consulting, implementation services and digital transformation, accelerators, and custom development."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. Hero: Pinned 3D Logo Cube & Scroll Pass-Through + Quick Links -->
    <Hero />

    <!-- 2. Our Approach: Six Stages Journey -->
    <ApproachJourney />

    <!-- 3. The PEG Cube: How We Think -->
    <PegCube />

    <!-- 4. Solutions: Capabilities & Solutions -->
    <SolutionsGrid />

    <!-- 5. Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
