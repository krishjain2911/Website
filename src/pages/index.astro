---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import SolutionsGrid from '../components/SolutionsGrid.astro';
import PegCube from '../components/PegCube.astro';
import AgileApproachFlow from '../components/AgileApproachFlow.astro';
import BuildYourWay from '../components/BuildYourWay.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import LeadershipTeaser from '../components/LeadershipTeaser.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="RHSP - Engineering the bridge from challenge to solution"
  description="Enterprise software built around how your business runs. Low-code speed on OutSystems, high-code depth in MERN, and sovereign enterprise AI."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. Hero: Pinned 3D Logo Cube & Scroll Pass-Through + Quick Links -->
    <Hero />

    <!-- 2. Who We Are: Mission · Purpose · Vision -->
    <WhoWeAre />

    <!-- 3. Solutions: Capabilities & Proof -->
    <SolutionsGrid />

    <!-- 4. The PEG Cube: How We Think -->
    <PegCube />

    <!-- 5. Agile Approach: How We Deliver -->
    <AgileApproachFlow />

    <!-- 6. Build Your Way: OutSystems | MERN Toggle -->
    <BuildYourWay />

    <!-- 7. Featured Ideas & Insights Carousel -->
    <FeaturedCarousel />

    <!-- 8. Leadership Teaser -->
    <LeadershipTeaser />

    <!-- 9. Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
