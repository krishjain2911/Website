        <!-- TAB 2: HOW TO PUBLISH -->
        <section id="tab-publish" class="tab-pane" style="display: none;">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">How to Publish Changes</h2>
              <p style="margin: 4px 0 0; color: var(--color-text-secondary); font-size: 0.9375rem;">
                RHSP runs 100% statically without a server database. Follow these 4 steps to deploy:
              </p>
            </div>
