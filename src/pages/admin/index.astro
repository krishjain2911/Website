---
import initialJobs from '../../data/jobs.json';
import { ADMIN_EMAIL, ADMIN_PASSWORD_HASH } from '../../lib/admin/credentials';
import { ANALYTICS_URL } from '../../lib/admin/config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>RHSP Console &bull; Static Management</title>
    <link rel="stylesheet" href="/fonts/raleway.css" />
    <style>
      :root {
        --color-bg: #FFFFFF;
        --color-bg-alt: #F6F6F4;
        --color-surface: #FFFFFF;
        --color-surface-hover: #F0F0EE;
        --color-border: #E6E6E3;
        --color-border-subtle: #ECECE9;
        --color-text-primary: #141413;
        --color-text-secondary: #575757;
        --color-text-muted: #8A8A92;
        --rhsp-navy: #1E4B8F;
        --rhsp-peg-start: #F7941D;
        --rhsp-peg-end: #EE4B2B;
        --rhsp-peg-gradient: linear-gradient(135deg, #F7941D 0%, #EE4B2B 100%);
        --radius-card: 16px;
      }

      [data-theme="dark"] {
        --color-bg: #0F1012;
        --color-bg-alt: #16171B;
        --color-surface: #1A1B20;
        --color-surface-hover: #22232A;
        --color-border: #2A2B32;
        --color-border-subtle: #23242A;
        --color-text-primary: #ECECEE;
        --color-text-secondary: #9A9AA2;
        --color-text-muted: #6C6D75;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --color-bg: #0F1012;
          --color-bg-alt: #16171B;
          --color-surface: #1A1B20;
          --color-surface-hover: #22232A;
          --color-border: #2A2B32;
          --color-border-subtle: #23242A;
          --color-text-primary: #ECECEE;
          --color-text-secondary: #9A9AA2;
          --color-text-muted: #6C6D75;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'Raleway', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-primary);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* LOGIN GATE OVERLAY */
      .gate-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 24px;
        background: radial-gradient(circle at 10% 20%, rgba(30, 75, 143, 0.08) 0%, transparent 60%),
                    radial-gradient(circle at 90% 80%, rgba(247, 148, 29, 0.08) 0%, transparent 60%),
                    var(--color-bg);
      }

      .gate-card {
        width: 100%;
        max-width: 440px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        padding: 44px 36px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
      }

      .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8125rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rhsp-peg-end);
        margin-bottom: 16px;
      }

      .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--rhsp-peg-gradient);
      }

      .gate-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0 0 8px;
      }

      .gate-subline {
        font-size: 0.9375rem;
        color: var(--color-text-secondary);
        margin: 0 0 28px;
        line-height: 1.5;
      }

      .alert-error {
        background: rgba(238, 75, 43, 0.08);
        border: 1px solid rgba(238, 75, 43, 0.25);
        color: var(--rhsp-peg-end);
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.875rem;
        margin-bottom: 20px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
      }

      label {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
      }

      .input-text,
      .input-select,
      .input-textarea {
        min-height: 46px;
        padding: 10px 16px;
        font-family: inherit;
        font-size: 0.9375rem;
        color: var(--color-text-primary);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .input-text:focus-visible,
      .input-select:focus-visible,
      .input-textarea:focus-visible {
        outline: none;
        border-color: var(--rhsp-peg-start);
        box-shadow: 0 0 0 3px rgba(247, 148, 29, 0.2);
      }

      .btn-primary {
        width: 100%;
        min-height: 48px;
        padding: 12px 24px;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        color: #ffffff;
        background: var(--color-text-primary);
        border: none;
        border-radius: 999px;
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      [data-theme="dark"] .btn-primary {
        background: #ffffff;
        color: #0F1012;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
      }

      /* ADMIN CONSOLE LAYOUT */
      .app-layout {
        display: none;
        min-height: 100vh;
      }

      .app-layout.active {
        display: flex;
      }

      /* Sidebar */
      .sidebar {
        width: 280px;
        background: var(--color-surface);
        border-right: 1px solid var(--color-border);
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--color-border-subtle);
        margin-bottom: 24px;
      }

      .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 8px;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .nav-item-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        font-family: inherit;
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--color-text-secondary);
        background: none;
        border: 1px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        text-align: left;
        width: 100%;
        transition: all 0.2s ease;
      }

      .nav-item-btn:hover {
        background: var(--color-bg-alt);
        color: var(--color-text-primary);
      }

      .nav-item-btn.active {
        background: rgba(247, 148, 29, 0.1);
        border-color: rgba(238, 75, 43, 0.25);
        color: var(--rhsp-peg-end);
      }

      .sidebar-footer {
        padding-top: 20px;
        border-top: 1px solid var(--color-border-subtle);
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .theme-toggle-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        font-family: inherit;
        font-size: 0.8125rem;
        font-weight: 600;
        background: var(--color-bg-alt);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        color: var(--color-text-secondary);
        cursor: pointer;
      }

      .btn-logout {
        padding: 10px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--rhsp-peg-end);
        background: rgba(238, 75, 43, 0.08);
        border: 1px solid rgba(238, 75, 43, 0.2);
        border-radius: 10px;
        cursor: pointer;
      }

      /* Main Content Area */
      .main-panel {
        flex: 1;
        padding: 36px 40px 80px;
        overflow-y: auto;
        background: var(--color-bg);
      }

      .panel-header {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
      }

      .panel-title {
        font-size: 1.85rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
      }

      .panel-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .action-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 700;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text-primary);
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .action-pill:hover {
        border-color: var(--rhsp-peg-start);
        transform: translateY(-1px);
      }

      .action-pill-accent {
        background: var(--rhsp-peg-gradient);
        color: #ffffff;
        border: none;
      }

      /* Toolbar */
      .filter-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
      }

      .search-box {
        position: relative;
        flex: 1;
        max-width: 360px;
        min-width: 240px;
      }

      .search-input {
        width: 100%;
        min-height: 42px;
        padding: 8px 14px 8px 36px;
        font-family: inherit;
        font-size: 0.9375rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        color: var(--color-text-primary);
      }

      .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-text-muted);
        pointer-events: none;
      }

      .status-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .status-pill-btn {
        padding: 6px 14px;
        font-family: inherit;
        font-size: 0.8125rem;
        font-weight: 700;
        background: var(--color-bg-alt);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-secondary);
        cursor: pointer;
      }

      .status-pill-btn.active {
        background: var(--color-text-primary);
        color: #ffffff;
        border-color: var(--color-text-primary);
      }

      [data-theme="dark"] .status-pill-btn.active {
        background: #ffffff;
        color: #0F1012;
      }

      /* Jobs List Cards */
      .jobs-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .job-item-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 24px 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: center;
        justify-content: space-between;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .job-item-card:hover {
        border-color: var(--rhsp-peg-start);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      }

      .job-info-col {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
        min-width: 280px;
      }

      .job-title-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .job-item-title {
        font-size: 1.15rem;
        font-weight: 800;
        margin: 0;
      }

      .job-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
      }

      .badge-chip {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
      }

      .status-published {
        background: rgba(30, 143, 60, 0.12);
        color: #1E8F3C;
        border: 1px solid rgba(30, 143, 60, 0.25);
      }

      .status-draft {
        background: rgba(247, 148, 29, 0.12);
        color: #B35B00;
        border: 1px solid rgba(247, 148, 29, 0.25);
      }

      .status-closed {
        background: var(--color-bg-alt);
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
      }

      .card-actions-col {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .btn-sm-action {
        padding: 8px 14px;
        font-family: inherit;
        font-size: 0.8125rem;
        font-weight: 700;
        background: var(--color-bg-alt);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text-primary);
        cursor: pointer;
      }

      .btn-sm-action:hover {
        background: var(--color-surface-hover);
        border-color: var(--rhsp-peg-start);
      }

      .btn-sm-danger:hover {
        background: rgba(238, 75, 43, 0.1);
        border-color: var(--rhsp-peg-end);
        color: var(--rhsp-peg-end);
      }

      /* Modal */
      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 100;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .modal-backdrop.open {
        display: flex;
      }

      .modal-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        max-width: 860px;
        width: 100%;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .modal-header {
        padding: 20px 28px;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .modal-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0;
      }

      .modal-close-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--color-text-secondary);
        cursor: pointer;
      }

      .modal-body {
        padding: 28px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .modal-footer {
        padding: 16px 28px;
        border-top: 1px solid var(--color-border);
        background: var(--color-bg-alt);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
      }

      /* Editor Live Preview */
      .editor-tabs-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }

      .editor-tab-btn {
        padding: 6px 14px;
        font-family: inherit;
        font-size: 0.8125rem;
        font-weight: 700;
        background: none;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        color: var(--color-text-secondary);
      }

      .editor-tab-btn.active {
        background: var(--color-bg-alt);
        border-color: var(--color-border);
        color: var(--color-text-primary);
      }

      .preview-box {
        min-height: 160px;
        padding: 14px 18px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow-y: auto;
        display: none;
      }

      .preview-box.active {
        display: block;
      }

      /* Guide / Instructions Panel */
      .instruction-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 32px;
        margin-bottom: 24px;
      }

      .instruction-step {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
      }

      .step-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--rhsp-peg-gradient);
        color: #ffffff;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .step-content h4 {
        margin: 0 0 6px;
        font-size: 1.0625rem;
      }

      .step-content p {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
      }

      .code-snippet {
        background: var(--color-bg-alt);
        border: 1px solid var(--color-border);
        padding: 8px 12px;
        border-radius: 8px;
        font-family: monospace;
        font-size: 0.875rem;
        display: block;
        margin-top: 8px;
      }

      @media (max-width: 840px) {
        .app-layout {
          flex-direction: column;
        }

        .sidebar {
          width: 100%;
          height: auto;
          position: static;
        }

        .main-panel {
          padding: 24px 16px;
        }

        .grid-2, .grid-3 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <!-- 1. SOFT LOGIN GATE -->
    <div id="login-gate" class="gate-container">
      <div class="gate-card">
        <div class="brand-badge">
          <span class="badge-dot"></span>
          <span>RHSP Administrator</span>
        </div>
        <h1 class="gate-title">Console Access</h1>
        <p class="gate-subline">Authenticate client-side to manage static role configurations.</p>

        <div id="login-error" class="alert-error" style="display: none;" role="alert"></div>

        <form id="gate-form">
          <div class="form-group">
            <label for="gate-email">Email Address</label>
            <input type="email" id="gate-email" required class="input-text" placeholder="admin@rhsp.solutions" />
          </div>

          <div class="form-group">
            <label for="gate-password">Security Credential</label>
            <input type="password" id="gate-password" required class="input-text" />
          </div>

          <button type="submit" class="btn-primary">Authenticate Console</button>
        </form>
      </div>
    </div>

    <!-- 2. MAIN ADMIN CONSOLE APP -->
    <div id="app-container" class="app-layout">
      <!-- Sidebar Navigation -->
      <aside class="sidebar">
        <div>
          <div class="sidebar-brand">
            <div class="badge-dot"></div>
            <span style="font-weight: 800; font-size: 1.05rem;">RHSP Console</span>
          </div>

          <ul class="nav-menu" role="tablist">
            <li>
              <button type="button" class="nav-item-btn active" data-tab="tab-positions">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <span>Positions &bull; Roles</span>
              </button>
            </li>
            <li>
              <button type="button" class="nav-item-btn" data-tab="tab-publish">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>How to Publish</span>
              </button>
            </li>
            <li>
              <button type="button" class="nav-item-btn" data-tab="tab-analytics">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"></path>
                  <path d="m19 9-5 5-4-4-3 3"></path>
                </svg>
                <span>Plausible Analytics</span>
              </button>
            </li>
          </ul>
        </div>

        <div class="sidebar-footer">
          <a href="/careers" target="_blank" rel="noopener noreferrer" style="font-size: 0.8125rem; color: var(--rhsp-navy); text-decoration: none; font-weight: 700;">
            View Careers Site &nearr;
          </a>
          <button type="button" id="theme-toggle" class="theme-toggle-btn">
            <span>Theme Mode</span>
            <span id="theme-label">Light / Dark</span>
          </button>
          <button type="button" id="btn-logout" class="btn-logout">Logout Console</button>
        </div>
      </aside>

      <!-- Main Work Panel -->
      <main class="main-panel">
        <!-- TAB 1: POSITIONS -->
        <section id="tab-positions" class="tab-pane">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Role Orientations</h2>
              <p style="margin: 4px 0 0; color: var(--color-text-secondary); font-size: 0.9375rem;">
                Manage static openings. Drafts autosave in your browser. Export to publish.
              </p>
            </div>

            <div class="panel-actions">
              <button type="button" id="btn-new-job" class="action-pill action-pill-accent">
                + New Orientation
              </button>
              <button type="button" id="btn-copy-json" class="action-pill">
                Copy JSON
              </button>
              <button type="button" id="btn-export-json" class="action-pill">
                Export jobs.json
              </button>
              <label class="action-pill" style="cursor: pointer;">
                Import File
                <input type="file" id="file-import-json" accept=".json" style="display: none;" />
              </label>
            </div>
          </div>

          <div class="filter-toolbar">
            <div class="search-box">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="search" id="job-search" class="search-input" placeholder="Search by title, department, or slug..." />
            </div>

            <div class="status-pills">
              <button type="button" class="status-pill-btn active" data-filter="all">All (<span id="count-all">0</span>)</button>
              <button type="button" class="status-pill-btn" data-filter="published">Published (<span id="count-published">0</span>)</button>
