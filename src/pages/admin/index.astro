    <!-- CLIENT INTERACTIVITY SCRIPT -->
    <script>
      function initAdmin() {
        // Search & Status filter
        const searchInput = document.getElementById('job-search') as HTMLInputElement | null;
        const statusButtons = Array.from(document.querySelectorAll('.status-pill-btn')) as HTMLButtonElement[];
        const rows = Array.from(document.querySelectorAll('.job-row')) as HTMLTableRowElement[];

        let activeStatus = 'all';

        function filterRows() {
          const query = (searchInput?.value || '').toLowerCase().trim();
          rows.forEach((row) => {
            const matchesSearch = !query || (row.dataset.search || '').includes(query);
            const matchesStatus = activeStatus === 'all' || row.dataset.status === activeStatus;
            row.style.display = matchesSearch && matchesStatus ? '' : 'none';
          });
        }

        searchInput?.addEventListener('input', filterRows);

        statusButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            statusButtons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            activeStatus = btn.dataset.filter || 'all';
            filterRows();
          });
        });

        // Modal elements
        const modalBackdrop = document.getElementById('job-modal-backdrop') as HTMLElement | null;
        const btnOpenCreate = document.getElementById('btn-open-create-modal');
        const btnCloseModal = document.getElementById('btn-close-modal');
        const btnCancelModal = document.getElementById('btn-cancel-modal');
        const jobForm = document.getElementById('job-form') as HTMLFormElement | null;
        const modalHeading = document.getElementById('modal-heading');
        const modalAlert = document.getElementById('modal-error-alert');

        const inputId = document.getElementById('form-job-id') as HTMLInputElement | null;
        const inputTitle = document.getElementById('form-title') as HTMLInputElement | null;
        const inputSlug = document.getElementById('form-slug') as HTMLInputElement | null;
        const inputDept = document.getElementById('form-dept') as HTMLInputElement | null;
        const inputLocation = document.getElementById('form-location') as HTMLInputElement | null;
        const inputWorkmode = document.getElementById('form-workmode') as HTMLSelectElement | null;
        const inputType = document.getElementById('form-type') as HTMLSelectElement | null;
        const inputStatus = document.getElementById('form-status') as HTMLSelectElement | null;
        const inputExp = document.getElementById('form-exp') as HTMLInputElement | null;
        const inputSummary = document.getElementById('form-summary') as HTMLTextAreaElement | null;
        const summaryCounter = document.getElementById('summary-counter');
        const inputDescription = document.getElementById('form-description') as HTMLTextAreaElement | null;
        const inputResp = document.getElementById('form-resp') as HTMLTextAreaElement | null;
        const inputReq = document.getElementById('form-req') as HTMLTextAreaElement | null;
        const inputSalary = document.getElementById('form-salary') as HTMLInputElement | null;
        const inputEmail = document.getElementById('form-email') as HTMLInputElement | null;
        const inputClosing = document.getElementById('form-closing') as HTMLInputElement | null;

        // Auto-slug generation from title
        inputTitle?.addEventListener('input', () => {
          if (!inputId?.value) {
            const slug = (inputTitle.value || '')
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/(^-|-$)/g, '');
            if (inputSlug) inputSlug.value = slug;
          }
        });

        // Summary char counter
        inputSummary?.addEventListener('input', () => {
          if (summaryCounter && inputSummary) {
            summaryCounter.textContent = `${inputSummary.value.length} / 160`;
          }
        });

        function openModal(isEdit = false, jobData?: any) {
          if (modalAlert) {
            modalAlert.style.display = 'none';
            modalAlert.textContent = '';
          }

          if (isEdit && jobData) {
            if (modalHeading) modalHeading.textContent = 'Revise Orientation';
            if (inputId) inputId.value = String(jobData.id);
            if (inputTitle) inputTitle.value = jobData.title || '';
            if (inputSlug) inputSlug.value = jobData.slug || '';
            if (inputDept) inputDept.value = jobData.department || '';
            if (inputLocation) inputLocation.value = jobData.location || 'Mumbai';
            if (inputWorkmode) inputWorkmode.value = jobData.work_mode || 'Hybrid';
            if (inputType) inputType.value = jobData.type || 'Full-time';
            if (inputStatus) inputStatus.value = jobData.status || 'Draft';
            if (inputExp) inputExp.value = jobData.experience || '';
            if (inputSummary) {
              inputSummary.value = jobData.summary || '';
              if (summaryCounter) summaryCounter.textContent = `${inputSummary.value.length} / 160`;
            }
            if (inputDescription) inputDescription.value = jobData.description_md || '';
            if (inputResp) inputResp.value = jobData.responsibilities || '';
            if (inputReq) inputReq.value = jobData.requirements || '';
            if (inputSalary) inputSalary.value = jobData.salary || '';
            if (inputEmail) inputEmail.value = jobData.apply_email || '';
            if (inputClosing) inputClosing.value = jobData.closing_date || '';
          } else {
            if (modalHeading) modalHeading.textContent = 'New Role Opening';
            jobForm?.reset();
            if (inputId) inputId.value = '';
            if (inputLocation) inputLocation.value = 'Mumbai';
            if (inputWorkmode) inputWorkmode.value = 'Hybrid';
            if (inputType) inputType.value = 'Full-time';
            if (inputStatus) inputStatus.value = 'Draft';
            if (summaryCounter) summaryCounter.textContent = '0 / 160';
          }

          modalBackdrop?.classList.add('open');
        }

        function closeModal() {
          modalBackdrop?.classList.remove('open');
        }

        btnOpenCreate?.addEventListener('click', () => openModal(false));
        btnCloseModal?.addEventListener('click', closeModal);
        btnCancelModal?.addEventListener('click', closeModal);

        modalBackdrop?.addEventListener('click', (e) => {
          if (e.target === modalBackdrop) closeModal();
        });

        // Edit button click
        document.querySelectorAll('.btn-edit-job').forEach((btn) => {
          btn.addEventListener('click', () => {
            const dataStr = (btn as HTMLElement).dataset.job;
            if (dataStr) {
              try {
                const data = JSON.parse(dataStr);
                openModal(true, data);
              } catch (err) {
                console.error('Failed to parse job data:', err);
              }
            }
          });
        });

        // Duplicate button click
        document.querySelectorAll('.btn-duplicate-job').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.id;
            if (!id) return;
            try {
              const res = await fetch('/api/admin/duplicate-job', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: parseInt(id, 10) }),
              });
              if (res.ok) {
                window.location.reload();
              } else {
                const err = await res.json();
                alert(err.error || 'Duplication failed');
              }
            } catch (err) {
              alert('Network error during duplication');
            }
          });
        });

        // Delete button click
        document.querySelectorAll('.btn-delete-job').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.id;
            const title = (btn as HTMLElement).dataset.title;
            if (!id) return;

            if (confirm(`Are you sure you want to delete "${title}"? This action cannot be reversed.`)) {
              try {
                const res = await fetch(`/api/admin/jobs?id=${id}`, {
                  method: 'DELETE',
                });
                if (res.ok) {
                  window.location.reload();
                } else {
                  const err = await res.json();
                  alert(err.error || 'Deletion failed');
                }
              } catch (err) {
                alert('Network error during deletion');
              }
            }
          });
        });

        // Form Submit (Create or Update)
        jobForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const isEdit = Boolean(inputId?.value);
          const payload = {
            id: isEdit ? parseInt(inputId!.value, 10) : undefined,
            title: inputTitle?.value.trim(),
            slug: inputSlug?.value.trim(),
            department: inputDept?.value.trim(),
            location: inputLocation?.value.trim(),
            work_mode: inputWorkmode?.value,
            type: inputType?.value,
            status: inputStatus?.value,
            experience: inputExp?.value.trim() || null,
            summary: inputSummary?.value.trim() || null,
            description_md: inputDescription?.value.trim(),
            responsibilities: inputResp?.value.trim() || '',
            requirements: inputReq?.value.trim() || '',
            salary: inputSalary?.value.trim() || null,
            apply_email: inputEmail?.value.trim() || null,
            closing_date: inputClosing?.value || null,
          };

          try {
            const res = await fetch('/api/admin/jobs', {
              method: isEdit ? 'PUT' : 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              closeModal();
              window.location.reload();
            } else {
              const err = await res.json();
              if (modalAlert) {
                modalAlert.textContent = err.errors ? err.errors.join(' &bull; ') : (err.error || 'Failed to save job');
                modalAlert.style.display = 'block';
              }
            }
          } catch (err) {
            if (modalAlert) {
              modalAlert.textContent = 'Network communication failure.';
              modalAlert.style.display = 'block';
            }
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAdmin);
      } else {
        initAdmin();
      }
    </script>
  </body>
</html>
