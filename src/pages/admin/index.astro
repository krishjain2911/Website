                <span style="font-size: 0.8125rem; color: var(--color-text-secondary);">Interactive games, finder questions, and board actions.</span>
              </div>
              <div style="background: var(--color-bg-alt); padding: 16px; border-radius: 12px; border: 1px solid var(--color-border);">
                <strong style="display: block; font-size: 0.9375rem;">peg_outbound</strong>
                <span style="font-size: 0.8125rem; color: var(--color-text-secondary);">Outbound links to solution guides or contact appointments.</span>
              </div>
              <div style="background: var(--color-bg-alt); padding: 16px; border-radius: 12px; border: 1px solid var(--color-border);">
                <strong style="display: block; font-size: 0.9375rem;">careers_apply_click</strong>
                <span style="font-size: 0.8125rem; color: var(--color-text-secondary);">Candidate application button clicks on role pages.</span>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- 3. JOB CREATE / EDIT MODAL -->
    <div id="job-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-card">
        <header class="modal-header">
          <h3 id="modal-title" class="modal-title">Configure Role Orientation</h3>
          <button type="button" id="modal-close" class="modal-close-btn" aria-label="Close dialog">&times;</button>
        </header>

        <form id="job-form">
          <input type="hidden" id="job-orig-slug" value="" />

          <div class="modal-body">
            <div id="form-error" class="alert-error" style="display: none;"></div>

            <div class="grid-2">
              <div class="form-group">
                <label for="form-title">Role Title *</label>
                <input type="text" id="form-title" required class="input-text" placeholder="e.g. Lead Systems Architect" />
              </div>
              <div class="form-group">
                <label for="form-slug">Slug Identifier (URL) *</label>
                <input type="text" id="form-slug" required class="input-text" placeholder="lead-systems-architect" />
              </div>
            </div>

            <div class="grid-3">
              <div class="form-group">
                <label for="form-dept">Practice / Department *</label>
                <input type="text" id="form-dept" required class="input-text" placeholder="Architecture & Systems" />
              </div>
              <div class="form-group">
                <label for="form-location">Location *</label>
                <input type="text" id="form-location" required class="input-text" value="Mumbai" />
              </div>
              <div class="form-group">
                <label for="form-mode">Work Mode *</label>
                <select id="form-mode" class="input-select">
                  <option value="Hybrid">Hybrid</option>
                  <option value="On-site">On-site</option>
                  <option value="Remote">Remote</option>
                </select>
              </div>
            </div>

            <div class="grid-3">
              <div class="form-group">
                <label for="form-type">Engagement Type *</label>
                <select id="form-type" class="input-select">
                  <option value="Full-time">Full-time</option>
                  <option value="Part-time">Part-time</option>
                  <option value="Internship">Internship</option>
                  <option value="Contract">Contract</option>
                </select>
              </div>
              <div class="form-group">
                <label for="form-status">Status *</label>
                <select id="form-status" class="input-select">
                  <option value="draft">Draft</option>
                  <option value="published">Published</option>
                  <option value="closed">Closed</option>
                </select>
              </div>
              <div class="form-group">
                <label for="form-exp">Experience</label>
                <input type="text" id="form-exp" class="input-text" placeholder="e.g. 5+ years" />
              </div>
            </div>

            <div class="form-group">
              <div style="display: flex; justify-content: space-between;">
                <label for="form-summary">Executive Summary (Max 160 chars)</label>
                <span id="char-count" style="font-size: 0.75rem; color: var(--color-text-muted);">0 / 160</span>
              </div>
              <input type="text" id="form-summary" maxlength="160" class="input-text" placeholder="Succinct preview description..." />
            </div>

            <div class="form-group">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <label for="form-desc">Role Description (Markdown) *</label>
                <div class="editor-tabs-bar">
                  <button type="button" class="editor-tab-btn active" data-tab-editor="edit">Edit</button>
                  <button type="button" class="editor-tab-btn" data-tab-editor="preview">Preview</button>
                </div>
              </div>
              <textarea id="form-desc" rows="6" class="input-textarea" placeholder="Detail the technical context, goals, and team orientation..."></textarea>
              <div id="desc-preview" class="preview-box"></div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label for="form-resp">Responsibilities (One item per line)</label>
                <textarea id="form-resp" rows="4" class="input-textarea" placeholder="Architect modular enterprise adapters&#10;Lead engineering reviews"></textarea>
              </div>
              <div class="form-group">
                <label for="form-req">Qualifications (One item per line)</label>
                <textarea id="form-req" rows="4" class="input-textarea" placeholder="Demonstrated distributed systems rigor&#10;TypeScript and queue systems mastery"></textarea>
              </div>
            </div>

            <div class="grid-3">
              <div class="form-group">
                <label for="form-salary">Compensation Note (Optional)</label>
                <input type="text" id="form-salary" class="input-text" placeholder="Competitive &bull; Tier 1" />
              </div>
              <div class="form-group">
                <label for="form-email">Apply Email Override (Optional)</label>
                <input type="email" id="form-email" class="input-text" placeholder="Default: letstalk@rhsp.solutions" />
              </div>
              <div class="form-group">
                <label for="form-closing">Closing Date (Optional)</label>
                <input type="date" id="form-closing" class="input-text" />
              </div>
            </div>
          </div>

          <footer class="modal-footer">
            <button type="button" id="modal-cancel" class="action-pill">Cancel</button>
            <button type="submit" class="action-pill action-pill-accent">Save Role</button>
          </footer>
        </form>
      </div>
    </div>

    <!-- CLIENT SCRIPT -->
    <script define:vars={{ initialJobs, ADMIN_EMAIL, ADMIN_PASSWORD_HASH }}>
      (function () {
        'use strict';

        // 1. Check Authenticated Session
        const loginGate = document.getElementById('login-gate');
        const appContainer = document.getElementById('app-container');
        const gateForm = document.getElementById('gate-form');
        const gateEmail = document.getElementById('gate-email');
        const gatePassword = document.getElementById('gate-password');
        const loginError = document.getElementById('login-error');
        const btnLogout = document.getElementById('btn-logout');

        async function sha256(text) {
          const enc = new TextEncoder().encode(text);
          const buf = await crypto.subtle.digest('SHA-256', enc);
          const arr = Array.from(new Uint8Array(buf));
          return arr.map((b) => b.toString(16).padStart(2, '0')).join('');
        }

        function checkAuth() {
          const isAuthed = sessionStorage.getItem('rhsp_admin_authenticated') === 'true';
          if (isAuthed) {
            loginGate.style.display = 'none';
            appContainer.classList.add('active');
          } else {
            loginGate.style.display = 'flex';
            appContainer.classList.remove('active');
          }
        }

        gateForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = (gateEmail.value || '').trim().toLowerCase();
          const pwd = (gatePassword.value || '').trim();

          const pwdHash = await sha256(pwd);

          if (email === ADMIN_EMAIL.toLowerCase() && pwdHash === ADMIN_PASSWORD_HASH) {
            sessionStorage.setItem('rhsp_admin_authenticated', 'true');
            if (loginError) loginError.style.display = 'none';
            checkAuth();
          } else {
            if (loginError) {
              loginError.textContent = 'Invalid administrator credentials.';
              loginError.style.display = 'block';
            }
          }
        });

        btnLogout?.addEventListener('click', () => {
          sessionStorage.removeItem('rhsp_admin_authenticated');
          checkAuth();
        });

        checkAuth();

        // 2. Navigation Tabs
        const tabButtons = document.querySelectorAll('.nav-item-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');

        tabButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-tab');
            tabButtons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');

            tabPanes.forEach((pane) => {
              pane.style.display = pane.id === targetId ? 'block' : 'none';
            });
          });
        });

        // 3. Theme Toggle
        const themeBtn = document.getElementById('theme-toggle');
        themeBtn?.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });

        // 4. Jobs Store (Local storage with fallback to initialJobs)
        const STORAGE_KEY = 'rhsp_admin_jobs_cache';
        function getStoredJobs() {
          try {
            const cached = localStorage.getItem(STORAGE_KEY);
            if (cached) return JSON.parse(cached);
          } catch (e) {}
          return initialJobs || [];
        }

        function saveJobs(jobs) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(jobs));
          renderJobsList();
        }

        // Render List
        const jobsContainer = document.getElementById('jobs-container');
        const emptyView = document.getElementById('empty-jobs-view');
        const searchInput = document.getElementById('job-search');
        let currentFilter = 'all';

        function renderJobsList() {
          const jobs = getStoredJobs();
          const query = (searchInput?.value || '').toLowerCase().trim();

          // Update counts
          document.getElementById('count-all').textContent = String(jobs.length);
          document.getElementById('count-published').textContent = String(jobs.filter((j) => j.status === 'published').length);
          document.getElementById('count-draft').textContent = String(jobs.filter((j) => j.status === 'draft').length);
          document.getElementById('count-closed').textContent = String(jobs.filter((j) => j.status === 'closed').length);

          const filtered = jobs.filter((j) => {
            const matchStatus = currentFilter === 'all' || j.status === currentFilter;
            const searchHaystack = `${j.title} ${j.department} ${j.slug}`.toLowerCase();
            const matchQuery = !query || searchHaystack.includes(query);
            return matchStatus && matchQuery;
          });

          if (!jobsContainer) return;
          jobsContainer.innerHTML = '';

          if (filtered.length === 0) {
            if (emptyView) emptyView.style.display = 'block';
            return;
          }
          if (emptyView) emptyView.style.display = 'none';

          filtered.forEach((job) => {
            const card = document.createElement('div');
            card.className = 'job-item-card';

            const statusClass = `status-${job.status}`;
            card.innerHTML = `
              <div class="job-info-col">
                <div class="job-title-row">
                  <h3 class="job-item-title">${job.title}</h3>
                  <span class="badge-chip ${statusClass}">${job.status}</span>
                </div>
                <div class="job-item-meta">
                  <span><b>Practice:</b> ${job.department}</span>
                  <span><b>Location:</b> ${job.location} (${job.mode || job.work_mode})</span>
                  <span><b>Slug:</b> /careers/${job.slug}</span>
                </div>
              </div>
              <div class="card-actions-col">
                <button type="button" class="btn-sm-action btn-edit" data-slug="${job.slug}">Edit</button>
                <button type="button" class="btn-sm-action btn-dup" data-slug="${job.slug}">Duplicate</button>
                <button type="button" class="btn-sm-action btn-sm-danger btn-del" data-slug="${job.slug}">Delete</button>
              </div>
            `;
            jobsContainer.appendChild(card);
          });

          // Attach card buttons
          jobsContainer.querySelectorAll('.btn-edit').forEach((b) => {
            b.addEventListener('click', () => openModal(b.getAttribute('data-slug')));
          });
          jobsContainer.querySelectorAll('.btn-dup').forEach((b) => {
            b.addEventListener('click', () => duplicateJob(b.getAttribute('data-slug')));
          });
          jobsContainer.querySelectorAll('.btn-del').forEach((b) => {
            b.addEventListener('click', () => deleteJob(b.getAttribute('data-slug')));
          });
        }

        // Filter Pills
        document.querySelectorAll('.status-pill-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.status-pill-btn').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.getAttribute('data-filter') || 'all';
            renderJobsList();
          });
        });

        searchInput?.addEventListener('input', renderJobsList);

        // 5. Modal & Form Handling
        const modal = document.getElementById('job-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalClose = document.getElementById('modal-close');
        const modalCancel = document.getElementById('modal-cancel');
        const jobForm = document.getElementById('job-form');
        const formError = document.getElementById('form-error');

        const inputOrigSlug = document.getElementById('job-orig-slug');
        const inputTitle = document.getElementById('form-title');
        const inputSlug = document.getElementById('form-slug');
        const inputDept = document.getElementById('form-dept');
        const inputLocation = document.getElementById('form-location');
        const inputMode = document.getElementById('form-mode');
        const inputType = document.getElementById('form-type');
        const inputStatus = document.getElementById('form-status');
        const inputExp = document.getElementById('form-exp');
        const inputSummary = document.getElementById('form-summary');
        const charCount = document.getElementById('char-count');
        const inputDesc = document.getElementById('form-desc');
        const descPreview = document.getElementById('desc-preview');
        const inputResp = document.getElementById('form-resp');
        const inputReq = document.getElementById('form-req');
        const inputSalary = document.getElementById('form-salary');
        const inputEmail = document.getElementById('form-email');
        const inputClosing = document.getElementById('form-closing');

        // Auto-slug
        inputTitle?.addEventListener('input', () => {
          if (!inputOrigSlug.value) {
            inputSlug.value = (inputTitle.value || '')
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/(^-|-$)/g, '');
          }
        });

        // Summary char count
        inputSummary?.addEventListener('input', () => {
          if (charCount) charCount.textContent = `${inputSummary.value.length} / 160`;
        });

        // Markdown preview tab
        document.querySelectorAll('.editor-tab-btn').forEach((tab) => {
          tab.addEventListener('click', () => {
            document.querySelectorAll('.editor-tab-btn').forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            const mode = tab.getAttribute('data-tab-editor');
            if (mode === 'preview') {
              inputDesc.style.display = 'none';
              descPreview.style.display = 'block';
              descPreview.innerHTML = inputDesc.value.replace(/\n/g, '<br/>');
            } else {
              inputDesc.style.display = 'block';
              descPreview.style.display = 'none';
            }
          });
        });

        function openModal(editSlug) {
          if (formError) formError.style.display = 'none';
          const jobs = getStoredJobs();

          if (editSlug) {
            const job = jobs.find((j) => j.slug === editSlug);
            if (!job) return;
            modalTitle.textContent = 'Revise Orientation';
            inputOrigSlug.value = job.slug;
            inputTitle.value = job.title;
            inputSlug.value = job.slug;
            inputDept.value = job.department;
            inputLocation.value = job.location || 'Mumbai';
            inputMode.value = job.mode || job.work_mode || 'Hybrid';
            inputType.value = job.type || 'Full-time';
            inputStatus.value = job.status || 'draft';
            inputExp.value = job.experience || '';
            inputSummary.value = job.summary || '';
            if (charCount) charCount.textContent = `${inputSummary.value.length} / 160`;
            inputDesc.value = job.description || '';
            inputResp.value = Array.isArray(job.responsibilities) ? job.responsibilities.join('\n') : (job.responsibilities || '');
            inputReq.value = Array.isArray(job.requirements) ? job.requirements.join('\n') : (job.requirements || '');
            inputSalary.value = job.salary || '';
            inputEmail.value = job.applyEmail || job.apply_email || '';
            inputClosing.value = job.closesAt || job.closing_date ? String(job.closesAt || job.closing_date).slice(0, 10) : '';
          } else {
            modalTitle.textContent = 'New Role Orientation';
            jobForm.reset();
            inputOrigSlug.value = '';
            inputLocation.value = 'Mumbai';
            inputMode.value = 'Hybrid';
            inputType.value = 'Full-time';
            inputStatus.value = 'draft';
            if (charCount) charCount.textContent = '0 / 160';
          }

          modal.classList.add('open');
        }

        function closeModal() {
          modal.classList.remove('open');
        }

        modalClose?.addEventListener('click', closeModal);
        modalCancel?.addEventListener('click', closeModal);

        document.getElementById('btn-new-job')?.addEventListener('click', () => openModal());

        // Save Form
        jobForm?.addEventListener('submit', (e) => {
          e.preventDefault();
          const origSlug = inputOrigSlug.value;
          const newSlug = inputSlug.value.trim().toLowerCase();
          const jobs = getStoredJobs();

          // Check unique slug
          const conflict = jobs.find((j) => j.slug === newSlug && j.slug !== origSlug);
          if (conflict) {
            if (formError) {
              formError.textContent = 'Slug identifier already exists. Please choose a unique URL slug.';
              formError.style.display = 'block';
            }
            return;
          }

          const updatedJob = {
            slug: newSlug,
            title: inputTitle.value.trim(),
            department: inputDept.value.trim(),
            location: inputLocation.value.trim() || 'Mumbai',
            type: inputType.value,
            mode: inputMode.value,
            experience: inputExp.value.trim(),
            summary: inputSummary.value.trim(),
            description: inputDesc.value.trim(),
            responsibilities: inputResp.value.split('\n').map((s) => s.trim()).filter(Boolean),
            requirements: inputReq.value.split('\n').map((s) => s.trim()).filter(Boolean),
            salary: inputSalary.value.trim() || undefined,
            applyEmail: inputEmail.value.trim() || undefined,
            postedAt: new Date().toISOString(),
            closesAt: inputClosing.value ? `${inputClosing.value}T23:59:59Z` : undefined,
            status: inputStatus.value,
          };

          let newJobs;
          if (origSlug) {
            newJobs = jobs.map((j) => (j.slug === origSlug ? updatedJob : j));
          } else {
            newJobs = [updatedJob, ...jobs];
          }

          saveJobs(newJobs);
          closeModal();
        });

        function duplicateJob(slug) {
          const jobs = getStoredJobs();
          const source = jobs.find((j) => j.slug === slug);
          if (!source) return;

          const dup = {
            ...source,
            slug: `${source.slug}-copy`,
            title: `${source.title} (Copy)`,
            status: 'draft',
            postedAt: new Date().toISOString(),
          };
          saveJobs([dup, ...jobs]);
        }

        function deleteJob(slug) {
          if (!confirm(`Are you sure you want to delete role /careers/${slug}?`)) return;
          const jobs = getStoredJobs();
          saveJobs(jobs.filter((j) => j.slug !== slug));
        }

        // 6. Export / Import / Copy JSON
        document.getElementById('btn-copy-json')?.addEventListener('click', () => {
          const jsonStr = JSON.stringify(getStoredJobs(), null, 2);
          navigator.clipboard.writeText(jsonStr).then(() => {
            alert('jobs.json contents copied to clipboard!');
          });
        });

        document.getElementById('btn-export-json')?.addEventListener('click', () => {
          const jsonStr = JSON.stringify(getStoredJobs(), null, 2);
          const blob = new Blob([jsonStr], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'jobs.json';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });

        const fileImport = document.getElementById('file-import-json');
        fileImport?.addEventListener('change', (e) => {
          const file = e.target.files?.[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (event) => {
            try {
              const parsed = JSON.parse(event.target.result);
              if (Array.isArray(parsed)) {
                saveJobs(parsed);
                alert(`Successfully imported ${parsed.length} role(s).`);
              } else {
                alert('Invalid file format: Expected a JSON array of roles.');
              }
            } catch (err) {
              alert('Error parsing JSON file.');
            }
          };
          reader.readAsText(file);
        });

        renderJobsList();
      })();
    </script>
  </body>
</html>
