---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import ProjectHero from '../../components/project/ProjectHero.astro';
import JourneyProgressPill from '../../components/JourneyProgressPill.astro';
import PhaseProblem from '../../components/project/PhaseProblem.astro';
import PhaseValue from '../../components/project/PhaseValue.astro';
import PhaseArchitecture from '../../components/project/PhaseArchitecture.astro';
import PhasePilot from '../../components/project/PhasePilot.astro';
import PhaseRollout from '../../components/project/PhaseRollout.astro';
import PhaseImpact from '../../components/project/PhaseImpact.astro';
import ProjectLightbox from '../../components/project/ProjectLightbox.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, allProducts: products }
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
  allProducts: CollectionEntry<'products'>[];
}

const { product, allProducts } = Astro.props;
const p = product.data;

// Chronological / ordered navigation according to Solutions dropdown order
const sortedProducts = [...allProducts].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const currentIndex = sortedProducts.findIndex((item) => item.slug === product.slug);
const prevProduct = currentIndex > 0 ? sortedProducts[currentIndex - 1] : sortedProducts[sortedProducts.length - 1];
const nextProduct = currentIndex < sortedProducts.length - 1 ? sortedProducts[currentIndex + 1] : sortedProducts[0];

// 6-stage approach phases
const phases = p.phases;

// Check before/after interactive asset if applicable
let beforeAfterId: 'clm' | 'dms' | 'whatsapp' | undefined;
if (product.slug === 'dms') beforeAfterId = 'dms';
else if (product.slug === 'whatsapp-journeys') beforeAfterId = 'whatsapp';

const pageTitle: string = (p.seoTitle as string | undefined) || `${p.title} | RHSP`;
const pageDescription: string = (p.seoDescription as string | undefined) || p.oneLiner;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Solutions', item: '/#solutions' },
    { name: p.pillar, item: '/#solutions' },
    { name: p.shortTitle || p.title, item: `/solutions/${product.slug}` }
  ]}
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- Top Adjacent Solutions Navigation directly under header, spanning container -->
    <div class="solution-nav-wrapper">
      <nav class="solution-top-nav container" aria-label="Adjacent solutions">
        <a href={`/solutions/${prevProduct.slug}`} class="solution-nav-btn prev-btn">
          <Icon name="arrow-left" size={16} class="nav-arrow" />
          <div class="nav-text-col">
            <span class="nav-label">Previous solution</span>
            <span class="nav-sub">{prevProduct.data.shortTitle || prevProduct.data.title}</span>
          </div>
        </a>

        <a href={`/solutions/${nextProduct.slug}`} class="solution-nav-btn next-btn">
          <div class="nav-text-col align-right">
            <span class="nav-label">Next solution</span>
            <span class="nav-sub">{nextProduct.data.shortTitle || nextProduct.data.title}</span>
          </div>
          <Icon name="arrow-right" size={16} class="nav-arrow" />
        </a>
      </nav>
    </div>

    <!-- 1. Hero Section with Media Frame, Hero Facts, and Flow Strip -->
    <ProjectHero product={product} />

    <!-- 2. Reusable Floating Progress Pill (Tracks #stage-01 to #stage-06) -->
    <JourneyProgressPill targetPrefix="stage-0" />

    <!-- 3. Standardized 6-Phase Approach Journey (Full container width) -->
    <div class="project-journey-container container">
      <div class="project-journey-track">
        <PhaseProblem
          slug={product.slug}
          stage1={p.stage1}
          problemData={phases?.problem}
          beforeAfterId={beforeAfterId}
        />
        <PhaseValue
          slug={product.slug}
          stage2={p.stage2}
          valueData={phases?.value}
        />
        <PhaseArchitecture
          slug={product.slug}
          stage3={p.stage3}
          architectureData={phases?.architecture}
        />
        <PhasePilot
          slug={product.slug}
          stage4={p.stage4}
          pageName={p.shortTitle || p.title}
          pilotData={phases?.pilot}
        />
        <PhaseRollout
          slug={product.slug}
          stage5={p.stage5}
          rolloutData={phases?.rollout}
        />
        <PhaseImpact
          slug={product.slug}
          stage6={p.stage6}
          impactData={phases?.impact}
        />
      </div>
    </div>

    <!-- 4. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />

  <!-- Global Fullscreen Media Viewer / Lightbox -->
  <ProjectLightbox />
</BaseLayout>

<style>
  /* Solution Top Navigation */
  .solution-nav-wrapper {
    width: 100%;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  :global(.dark) .solution-nav-wrapper {
    background-color: var(--color-surface);
  }

  .solution-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  .solution-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    max-width: 48%;
    min-width: 0;
    box-sizing: border-box;
  }

  .solution-nav-btn:hover {
    background-color: rgba(30, 75, 143, 0.08);
    border-color: rgba(30, 75, 143, 0.35);
    color: #1E4B8F;
    transform: translateY(-1px);
  }

  :global(.dark) .solution-nav-btn {
    background: var(--color-surface-raised);
  }

  :global(.dark) .solution-nav-btn:hover {
    background-color: rgba(91, 143, 224, 0.14);
    border-color: rgba(91, 143, 224, 0.45);
    color: #5B8FE0;
  }

  .solution-nav-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #F7941D;
  }

  .nav-arrow {
    flex-shrink: 0;
    color: currentColor;
  }

  .nav-text-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  .nav-text-col.align-right {
    align-items: flex-end;
    text-align: right;
  }

  .nav-label {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .nav-sub {
    font-size: 11.5px;
    color: var(--color-text-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  @media (max-width: 600px) {
    .solution-top-nav {
      gap: 0.5rem;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    .solution-nav-btn {
      padding: 8px 12px;
      gap: 0.4rem;
    }
    .nav-label {
      font-size: 10px;
    }
    .nav-sub {
      font-size: 10px;
      max-width: 110px;
    }
  }

  /* 6-Stage Journey Layout: Full container width, 24px gap */
  .project-journey-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
    position: relative;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
    box-sizing: border-box;
  }

  .project-journey-track {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>
