<script>
  function setupInterfaceShowcase() {
    const showcase = document.getElementById('interface-showcase');
    if (!showcase) return;

    const tabs = showcase.querySelectorAll<HTMLButtonElement>('.interactive-step-card');
    const slides = showcase.querySelectorAll<HTMLElement>('.tablet-screen-slide');
    const pills = showcase.querySelectorAll<HTMLButtonElement>('.quick-switch-btn');
    const captionEl = document.getElementById('tablet-caption-text');

    if (!tabs.length || !slides.length) return;

    let currentIndex = 0;
    let autoInterval: any = null;

    function activateSlide(index: number) {
      currentIndex = index;

      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });

      pills.forEach((pill, i) => {
        pill.classList.toggle('is-active', i === index);
      });

      const activeTab = tabs[index];
      if (captionEl && activeTab) {
        const text = activeTab.getAttribute('data-status-text') || activeTab.querySelector('.step-card-copy')?.textContent || '';
        if (text) captionEl.textContent = text;
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.getAttribute('data-screen-idx') || '0', 10);
        activateSlide(idx);
        stopAutoplay();
      });
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const idx = parseInt(pill.getAttribute('data-target-idx') || '0', 10);
        activateSlide(idx);
        stopAutoplay();
      });
    });

    function startAutoplay() {
      if (autoInterval) clearInterval(autoInterval);
      autoInterval = setInterval(() => {
        const next = (currentIndex + 1) % slides.length;
        activateSlide(next);
      }, 5500);
    }

    function stopAutoplay() {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
    }

    showcase.addEventListener('mouseenter', stopAutoplay);
    showcase.addEventListener('mouseleave', startAutoplay);
    showcase.addEventListener('touchstart', stopAutoplay, { passive: true });

    startAutoplay();
  }

  setupInterfaceShowcase();
  document.addEventListener('astro:after-swap', setupInterfaceShowcase);
</script>
