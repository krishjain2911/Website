---
import '../../styles/solution-dark.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import ProjectHero from '../../components/project/ProjectHero.astro';
import JourneyProgressPill from '../../components/JourneyProgressPill.astro';
import PhaseProblem from '../../components/project/PhaseProblem.astro';
import PhaseValue from '../../components/project/PhaseValue.astro';
import PhaseArchitecture from '../../components/project/PhaseArchitecture.astro';
import PhasePilot from '../../components/project/PhasePilot.astro';
import PhaseRollout from '../../components/project/PhaseRollout.astro';
import PhaseImpact from '../../components/project/PhaseImpact.astro';
import ProjectLightbox from '../../components/project/ProjectLightbox.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, allProducts: products }
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
  allProducts: CollectionEntry<'products'>[];
}

const { product, allProducts } = Astro.props;
const p = product.data;

// Chronological / ordered navigation according to Solutions dropdown order
const sortedProducts = [...allProducts].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const currentIndex = sortedProducts.findIndex((item) => item.slug === product.slug);
const prevProduct = currentIndex > 0 ? sortedProducts[currentIndex - 1] : sortedProducts[sortedProducts.length - 1];
const nextProduct = currentIndex < sortedProducts.length - 1 ? sortedProducts[currentIndex + 1] : sortedProducts[0];

// 6-stage approach phases
const phases = p.phases;

// Check before/after interactive asset if applicable
let beforeAfterId: 'clm' | 'dms' | 'whatsapp' | undefined;

const pageTitle: string = (p.seoTitle as string | undefined) || `${p.title} | RHSP`;
const pageDescription: string = (p.seoDescription as string | undefined) || p.oneLiner;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Solutions', item: '/#solutions' },
    { name: p.pillar, item: '/#solutions' },
    { name: p.shortTitle || p.title, item: `/solutions/${product.slug}` }
  ]}
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- Adjacent Solutions Floating Sticky Navigation (Sticky throughout entire scroll, docked near page ends) -->
    <aside class="solution-nav-wrapper" aria-label="Adjacent solutions navigation">
      <nav class="solution-adjacent-nav" aria-label="Adjacent solutions">
        <a
          href={`/solutions/${prevProduct.slug}`}
          class="solution-nav-btn prev-btn"
          title={`Previous solution: ${prevProduct.data.shortTitle || prevProduct.data.title}`}
          aria-label={`Previous solution: ${prevProduct.data.shortTitle || prevProduct.data.title}`}
        >
          <span class="nav-arrow-wrap" aria-hidden="true">
            <Icon name="arrow-left" size={13} class="nav-arrow" />
          </span>
          <span class="nav-prefix">Prev</span>
          <span class="nav-sep" aria-hidden="true">/</span>
          <span class="nav-title">{prevProduct.data.shortTitle || prevProduct.data.title}</span>
        </a>

        <a
          href={`/solutions/${nextProduct.slug}`}
          class="solution-nav-btn next-btn"
          title={`Next solution: ${nextProduct.data.shortTitle || nextProduct.data.title}`}
          aria-label={`Next solution: ${nextProduct.data.shortTitle || nextProduct.data.title}`}
        >
          <span class="nav-title">{nextProduct.data.shortTitle || nextProduct.data.title}</span>
          <span class="nav-sep" aria-hidden="true">/</span>
          <span class="nav-prefix">Next</span>
          <span class="nav-arrow-wrap" aria-hidden="true">
            <Icon name="arrow-right" size={13} class="nav-arrow" />
          </span>
        </a>
      </nav>
    </aside>

    <!-- 1. Hero Section with Media Frame, Hero Facts, and Flow Strip -->
    <ProjectHero product={product} />

    <!-- 2. Reusable Floating Progress Pill (Tracks #stage-01 to #stage-06) -->
    <JourneyProgressPill targetPrefix="stage-0" />

    <!-- 3. Standardized 6-Phase Approach Journey (Full container width) -->
    <div class="project-journey-container container">
      <div class="project-journey-track">
        <PhaseProblem
          slug={product.slug}
          stage1={p.stage1}
          problemData={phases?.problem}
          beforeAfterId={beforeAfterId}
        />
        <PhaseValue
          slug={product.slug}
          stage2={p.stage2}
          valueData={phases?.value}
        />
        <PhaseArchitecture
          slug={product.slug}
          stage3={p.stage3}
          architectureData={phases?.architecture}
        />
        <PhasePilot
          slug={product.slug}
          stage4={p.stage4}
          pageName={p.shortTitle || p.title}
          pilotData={phases?.pilot}
        />
        <PhaseRollout
          slug={product.slug}
          stage5={p.stage5}
          rolloutData={phases?.rollout}
        />
        <PhaseImpact
          slug={product.slug}
          stage6={p.stage6}
          impactData={phases?.impact}
        />
      </div>
    </div>

    <!-- 4. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />

  <!-- Global Fullscreen Media Viewer / Lightbox -->
  <ProjectLightbox />
</BaseLayout>

<style>
  /* Adjacent Solutions Floating Sticky Navigation (docked near bottom/ends of page) */
  .solution-nav-wrapper {
    position: fixed;
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    left: 0;
    right: 0;
    z-index: 85;
    pointer-events: none;
    display: flex;
    justify-content: center;
  }

  .solution-adjacent-nav {
    width: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    pointer-events: none;
  }

  .solution-nav-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: clamp(150px, 28vw, 240px);
    box-sizing: border-box;
  }

  .solution-nav-btn.prev-btn {
    padding-left: 10px;
  }

  .solution-nav-btn.next-btn {
    padding-right: 10px;
  }

  .solution-nav-btn:hover {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(247, 148, 29, 0.55);
    box-shadow: 0 6px 20px -4px rgba(247, 148, 29, 0.25), 0 2px 6px rgba(0, 0, 0, 0.06);
    color: #141413;
  }

  .solution-nav-btn.prev-btn:hover {
    transform: translateX(-3px);
  }

  .solution-nav-btn.next-btn:hover {
    transform: translateX(3px);
  }

  .solution-nav-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #F7941D, 0 4px 16px rgba(247, 148, 29, 0.3);
  }

  .nav-arrow-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgba(30, 75, 143, 0.08);
    color: #1E4B8F;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .solution-nav-btn:hover .nav-arrow-wrap {
    background-color: rgba(247, 148, 29, 0.15);
    color: #F7941D;
  }

  .nav-prefix {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1E4B8F;
    flex-shrink: 0;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .solution-nav-btn:hover .nav-prefix {
    color: #F7941D;
  }

  .nav-sep {
    font-size: 10px;
    color: var(--color-border-hover, #94a3b8);
    flex-shrink: 0;
    line-height: 1;
    opacity: 0.7;
  }

  .nav-title {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .solution-adjacent-nav {
      padding: 0 0.85rem;
    }
    .solution-nav-btn {
      height: 33px;
      padding: 0 10px;
      gap: 0.35rem;
      max-width: 145px;
    }
    .solution-nav-btn.prev-btn {
      padding-left: 8px;
    }
    .solution-nav-btn.next-btn {
      padding-right: 8px;
    }
    .nav-prefix, .nav-sep {
      display: none;
    }
    .nav-title {
      font-size: 11px;
    }
    .nav-arrow-wrap {
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-nav-btn {
      transition: none !important;
      transform: none !important;
    }
  }

  /* 6-Stage Journey Layout: Narrowed by 10% (1116px = 1240 x 0.9) */
  :global(.project-hero-container.container),
  .project-journey-container.container {
    --solution-max: 1116px; /* 1240 x 0.9 */
    max-width: var(--solution-max);
  }

  .project-journey-container {
    --solution-max: 1116px; /* 1240 x 0.9 */
    max-width: var(--solution-max);
    margin: 0 auto;
    position: relative;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
    box-sizing: border-box;
  }

  .project-journey-track {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>
