---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import MediaAsset from '../../components/MediaAsset.astro';
import LearnMore from '../../components/LearnMore.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, allProducts: products }
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
  allProducts: CollectionEntry<'products'>[];
}

const { product, allProducts } = Astro.props;
const p = product.data;


// Related products in the same pillar
const relatedProducts = allProducts
  .filter((item) => item.slug !== product.slug && (p.related.includes(item.slug) || item.data.pillar === p.pillar))
  .slice(0, 3);
---

<BaseLayout
  title={`${p.title} - RHSP Enterprise Solution`}
  description={p.seoDescription || p.oneLiner}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Solutions', item: '/solutions' },
    { name: p.title, item: `/solutions/${product.slug}` }
  ]}
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. Product Hero Section -->
    <section class="product-hero-section" aria-labelledby="product-title">
      <div class="container">
        <div class="product-hero-grid">
          <div class="product-hero-content reveal-on-scroll">
            <!-- Breadcrumbs with prominent Back to Solutions link -->
            <nav class="breadcrumb-row" aria-label="Breadcrumb">
              <a href="/solutions" class="breadcrumb-back-link">
                <Icon name="arrow-left" size={14} />
                <span>Back to solutions</span>
              </a>
              <span class="breadcrumb-divider" aria-hidden="true">•</span>
              <ol class="breadcrumb-list">
                <li class="breadcrumb-item"><a href="/" class="breadcrumb-link">Home</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li class="breadcrumb-item"><a href="/solutions" class="breadcrumb-link">Solutions</a></li>
                <li class="breadcrumb-sep" aria-hidden="true">/</li>
                <li class="breadcrumb-item" aria-current="page"><span class="breadcrumb-current">{p.pillar}</span></li>
              </ol>
            </nav>

            <div class="product-badge-row">
              {p.badges && p.badges.length > 0 ? (
                p.badges.map((b, idx) => (
                  <span class={idx === 0 ? "pillar-pill" : "stack-pill"}>{b}</span>
                ))
              ) : (
                <>
                  <span class="pillar-pill">{p.pillar}</span>
                  <span class="stack-pill">{p.badge}</span>
                </>
              )}
            </div>

            <h1 id="product-title" class="product-hero-title">
              {p.title}
            </h1>

            <p class="product-outcome-lead">
              {p.outcomeHeadline}
            </p>

            <p class="product-oneliner-desc">
              {p.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}
            </p>

            <div class="product-cta-row">
              <a
                href="#contact"
                class="btn btn-primary"
              >
                <span>{p.ctaText || "Let's talk"}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>

          <!-- Hero Media Asset Frame with Quarter-Circle Corner -->
          <div class="product-hero-media-wrapper card-mastercard reveal-on-scroll">
            <MediaAsset
              assetKey={`product-${product.slug}`}
              alt={`${p.title} architecture and user interface overview`}
              aspectRatio="16/10"
              crop="quarter"
              theme={p.pillar === 'Gen-AI' ? 'navy' : 'warm'}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Problem Section ("Without [product]...") -->
    <section class="product-problem-section" aria-labelledby="problem-heading">
      <div class="container">
        <div class="section-lead-block reveal-on-scroll">
          <span class="eyebrow">THE OPERATIONAL FRICTION</span>
          <h2 id="problem-heading" class="section-headline">
            Without {p.shortTitle}…
          </h2>
          <p class="section-lead-subline">{p.problem.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
        </div>

        <div class="pain-points-grid">
          {p.painPoints.map((pain, idx) => (
            <div class="pain-card card-mastercard reveal-on-scroll">
              <span class="pain-number">0{idx + 1}</span>
              <p class="pain-text">{pain.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 2.5 What We Built Section -->
    {p.whatWeBuilt && (
      <section class="what-we-built-section" aria-labelledby="what-we-built-heading">
        <div class="container">
          <div class="built-card card-mastercard reveal-on-scroll">
            <div class="built-card-header">
              <span class="eyebrow">WHAT WE BUILT</span>
              <h2 id="what-we-built-heading" class="built-card-title">
                Catalogue-grounded AI on the showroom floor.
              </h2>
            </div>
            <p class="built-card-desc">
              {p.whatWeBuilt}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- 4. How It Works (3-step flow with Optional Interactive Showroom Tablet) -->
    <section class="how-it-works-section" aria-labelledby="how-it-works-heading">
      <div class="container">
        <div class="section-lead-block reveal-on-scroll">
          <span class="eyebrow">INTEGRATION FLOW</span>
          <h2 id="how-it-works-heading" class="section-headline">How it works.</h2>
          <p class="section-lead-subline">{p.value.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
        </div>

        {p.interfaceScreens && p.interfaceScreens.length > 0 ? (
          <div class="interface-showcase-wrapper reveal-on-scroll" id="interface-showcase">
            <!-- 3 Step Cards Row (Clickable Interactive Tabs) -->
            <div class="interactive-steps-nav" role="tablist" aria-label="Showroom flow steps">
              {p.interfaceScreens.map((screen, idx) => (
                <button
                  type="button"
                  class={`interactive-step-card card-mastercard ${idx === 0 ? 'is-active' : ''}`}
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  aria-controls={`tablet-slide-${idx}`}
                  id={`step-tab-${idx}`}
                  data-screen-idx={idx}
                  data-status-text={screen.statusText || screen.description}
                >
                  <div class="step-card-top">
                    <div class="step-badge-pill">
                      <span class="step-dot" aria-hidden="true"></span>
                      <span class="step-pill-label">STEP {screen.step}</span>
                    </div>
                    {screen.badge && (
                      <span class="step-tag-pill">{screen.badge}</span>
                    )}
                  </div>
                  <h3 class="step-card-heading">{screen.title}</h3>
                  <p class="step-card-copy">{screen.description}</p>
                  <div class="step-progress-indicator" aria-hidden="true"></div>
                </button>
              ))}
            </div>

            <!-- Showroom Tablet Mockup Chassis -->
            <div class="showroom-tablet-chassis">
              <!-- Tablet Header Bar -->
              <div class="tablet-chassis-topbar">
                <div class="tablet-camera-notch" aria-hidden="true">
                  <span class="camera-lens"></span>
                  <span class="ambient-sensor"></span>
                </div>
                <div class="tablet-topbar-meta">
                  <span class="tablet-app-title">IN-STORE TABLET INTERFACE</span>
                  <span class="tablet-live-pill">
                    <span class="live-pulse-dot" aria-hidden="true"></span>
                    <span>Live Catalogue Active</span>
                  </span>
                </div>
              </div>

              <!-- Tablet Screen Viewport -->
              <div class="tablet-viewport" id="tablet-viewport">
                {p.interfaceScreens.map((screen, idx) => (
                  <div
                    class={`tablet-screen-slide ${idx === 0 ? 'is-active' : ''}`}
                    id={`tablet-slide-${idx}`}
                    role="tabpanel"
                    aria-labelledby={`step-tab-${idx}`}
                    data-slide-idx={idx}
                  >
                    <img
                      src={screen.image}
                      alt={screen.alt}
                      class="tablet-screenshot-img"
                      loading={idx === 0 ? "eager" : "lazy"}
                      draggable="false"
                    />
                  </div>
                ))}
              </div>

              <!-- Tablet Footer Status Bar -->
              <div class="tablet-chassis-bottombar">
                <div class="tablet-caption-box">
                  <Icon name="check" size={14} class="caption-icon" />
                  <span class="tablet-caption-text" id="tablet-caption-text">
                    {p.interfaceScreens[0].statusText || p.interfaceScreens[0].description}
                  </span>
                </div>

                <div class="tablet-quick-switch" role="tablist" aria-label="Screen Quick Switcher">
                  {p.interfaceScreens.map((screen, idx) => (
                    <button
                      type="button"
                      role="tab"
                      aria-selected={idx === 0 ? "true" : "false"}
                      class={`quick-switch-btn ${idx === 0 ? 'is-active' : ''}`}
                      data-target-idx={idx}
                      aria-label={`Jump to Step ${screen.step}: ${screen.title}`}
                    >
                      <span>Step {screen.step}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="flow-steps-grid">
            {p.howItWorks.map((st) => (
              <div class="flow-step-card card-mastercard reveal-on-scroll">
                <div class="step-card-top">
                  <div class="step-badge-pill">
                    <span class="step-dot" aria-hidden="true"></span>
                    <span class="step-pill-label">STEP {st.step}</span>
                  </div>
                </div>
                <h3 class="step-card-heading">{st.title}</h3>
                <p class="step-card-copy">{st.description.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- What We've Built (Deployed Proof) -->
    {p.builtExamples && p.builtExamples.length > 0 && (
      <section class="built-examples-section" aria-labelledby="built-examples-heading">
        <div class="container">
          <div class="section-lead-block reveal-on-scroll">
            <span class="eyebrow">PROOF OF CAPABILITY</span>
            <h2 id="built-examples-heading" class="section-headline">What we've built.</h2>
            <p class="section-lead-subline">Real systems deployed and operational in enterprise environments.</p>
          </div>

          <div class="built-examples-grid">
            {p.builtExamples.map((example) => (
              <article class="built-example-card card-mastercard reveal-on-scroll">
                <div class="built-example-header">
                  <div class="example-title-meta">
                    <h3 class="example-name">{example.name}</h3>
                    <span class="example-deployed-for">Deployed for {example.deployedFor}</span>
                  </div>
                  <div class="example-badges">
                    <span class="example-stack-badge">{example.stack}</span>
                    <span class="example-ready-badge">Ready to deploy &middot; customizable</span>
                  </div>
                </div>
                <p class="example-oneliner">{example.oneLiner}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 6. Key Features Grid -->
    {p.features && p.features.length > 0 && (
      <section class="features-section" aria-labelledby="features-heading">
        <div class="container">
          <div class="section-lead-block reveal-on-scroll">
            <span class="eyebrow">CAPABILITIES</span>
            <h2 id="features-heading" class="section-headline">Key features.</h2>
          </div>

          <div class="features-grid">
            {p.features.map((feat) => (
              <div class="feature-card card-mastercard reveal-on-scroll">
                <div class="feature-icon-circle" aria-hidden="true">
                  <Icon name="check" size={16} />
                </div>
                <h3 class="feature-title">{feat.title}</h3>
                <p class="feature-desc">{feat.description.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 6.5 Make It Yours Section -->
    {p.makeItYours && (
      <section class="make-it-yours-section" aria-labelledby="make-it-yours-heading">
        <div class="container">
          <div class="section-lead-block reveal-on-scroll">
            <span class="eyebrow">{p.makeItYours.subline || "MAKE IT YOURS"}</span>
            <h2 id="make-it-yours-heading" class="section-headline">{p.makeItYours.headline}</h2>
            {p.makeItYours.description && (
              <p class="make-it-yours-lead">{p.makeItYours.description}</p>
            )}
          </div>

          <div class="usecases-grid">
            {p.makeItYours.useCases.map((uc, idx) => (
              <div class="usecase-card card-mastercard reveal-on-scroll">
                <span class="usecase-number">0{idx + 1}</span>
                <h3 class="usecase-title">{uc.title}</h3>
                <p class="usecase-desc">{uc.description}</p>
              </div>
            ))}
          </div>

          {p.makeItYours.closing && (
            <div class="make-it-yours-callout card-mastercard reveal-on-scroll">
              <span class="callout-badge">PURPOSE-BUILT DEPLOYMENT</span>
              <p class="callout-text">{p.makeItYours.closing}</p>
            </div>
          )}
        </div>
      </section>
    )}


    <!-- 8. Accessible FAQ Accordion -->
    {p.faq && p.faq.length > 0 && (
      <section class="faq-section" aria-labelledby="faq-heading">
        <div class="container faq-container">
          <div class="section-lead-block reveal-on-scroll">
            <span class="eyebrow">ANSWERS</span>
            <h2 id="faq-heading" class="section-headline">Frequently asked questions.</h2>
          </div>

          <div class="faq-list">
            {p.faq.map((item) => (
              <details class="faq-accordion-item card-mastercard reveal-on-scroll">
                <summary class="faq-summary">
                  <span class="faq-question">{item.question.replace(/^\[PLACEHOLDER\]\s*/i, '')}</span>
                  <Icon name="chevron-down" size={18} class="faq-chevron" />
                </summary>
                <div class="faq-answer-body">
                  <p>{item.answer.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 9. Related Solutions -->
    {relatedProducts.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-lead-block reveal-on-scroll">
            <span class="eyebrow">RELATED SOLUTIONS</span>
            <h2 id="related-heading" class="section-headline">More in {p.pillar}.</h2>
          </div>

          <div class="related-grid">
            {relatedProducts.map((rel) => (
              <div class="related-card card-mastercard reveal-on-scroll">
                <div class="related-top-row">
                  <span class="pillar-pill">{rel.data.pillar}</span>
                </div>
                <h3 class="related-title">{rel.data.title}</h3>
                <p class="related-desc">{rel.data.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
                <div class="related-action">
                  <LearnMore href={`/solutions/${rel.slug}`} text={`Explore ${rel.data.title}`} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 10. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  .product-hero-section {
    padding: calc(72px + var(--section-spacing-desktop)) 0 var(--section-spacing-desktop);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .product-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .product-hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 5rem;
    }
  }

  .breadcrumb-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .breadcrumb-back-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover);
    border-color: var(--color-text-secondary);
  }

  .breadcrumb-divider {
    color: var(--color-text-muted);
    opacity: 0.4;
  }

  .breadcrumb-list {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-text-primary);
  }

  .breadcrumb-sep {
    color: var(--color-text-muted);
    user-select: none;
    opacity: 0.6;
  }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .product-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .pillar-pill {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
  }

  .stack-pill {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .product-hero-title {
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .product-outcome-lead {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin-bottom: 1rem;
    max-width: 44ch;
  }

  .product-oneliner-desc {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2.25rem;
    max-width: 48ch;
  }

  .product-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .product-demo-btn {
    min-height: 52px;
    padding: 0 2rem;
  }

  .product-hero-media-wrapper {
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-surface-alt);
    box-shadow: var(--shadow-card-hover);
  }

  /* Section Lead */
  .section-lead-block {
    max-width: 680px;
    margin-bottom: 3.5rem;
  }

  .section-headline {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-top: -0.25rem;
    margin-bottom: 0.75rem;
  }

  .section-lead-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* Problem Section */
  .product-problem-section {
    padding: var(--section-spacing-desktop) 0;
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .pain-points-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .pain-points-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pain-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--color-border-subtle);
  }

  .pain-number {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--rhsp-peg-start);
  }

  .pain-text {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* How It Works Grid Fallback */
  .flow-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .flow-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .flow-step-card {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--color-border-subtle);
  }

  .flow-step-marker {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .flow-step-title {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .flow-step-desc {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Interactive Showroom Tablet & Flow Showcase */
  .interface-showcase-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 1rem;
  }

  .interactive-steps-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 840px) {
    .interactive-steps-nav {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .interactive-step-card {
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-align: left;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-subtle);
    font-family: inherit;
  }

  .interactive-step-card:hover {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    transform: translateY(-2px);
  }

  .interactive-step-card.is-active {
