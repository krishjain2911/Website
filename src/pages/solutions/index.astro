---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import MediaAsset from '../../components/MediaAsset.astro';
import LearnMore from '../../components/LearnMore.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../config/site';
import { getCollection } from 'astro:content';

const rawProducts = await getCollection('products');
const products = rawProducts.sort((a, b) => a.data.order - b.data.order);

const engineerSlugs = ['clm', 'dms', 'whatsapp-journeys'];
const genAiSlugs = ['voice-agents', 'sovereign-ai', 'ask-me-anything'];

const isDefined = <T>(val: T | undefined): val is T => Boolean(val);
const engineerProducts = engineerSlugs.map(slug => products.find(p => p.slug === slug)).filter(isDefined);
const genAiProducts = genAiSlugs.map(slug => products.find(p => p.slug === slug)).filter(isDefined);

const planPillar = siteConfig.pegMethod.pillars.find(p => p.id === 'plan');
---

<BaseLayout
  title="Solutions Directory - RHSP"
  description="Explore RHSP's enterprise software solutions across Engineer and Gen-AI, plus our Plan advisory service. Low-code velocity on OutSystems, bespoke high-code in MERN, and sovereign AI."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Solutions', item: '/solutions' }
  ]}
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- Solutions Hero -->
    <section class="solutions-hero-section" aria-labelledby="solutions-index-title">
      <div class="container">
        <div class="solutions-hero-content reveal-on-scroll">
          <span class="eyebrow">SOLUTIONS DIRECTORY</span>
          <h1 id="solutions-index-title" class="solutions-index-headline">
            Built around how your business runs.
          </h1>
          <p class="solutions-index-subline">
            Enterprise platforms designed from your workflows up, not from a template.
          </p>

          <!-- Jump Bar -->
          <nav class="solutions-jump-bar" id="solutions-jump-bar" aria-label="Jump to capability sections">
            <a href="#plan" class="jump-pill" data-target="plan">
              <span class="jump-dot" style="background-color: #1E4B8F;"></span>
              <span class="pill-full">Plan — Technology Consulting</span>
              <span class="pill-short">Plan</span>
            </a>
            <a href="#engineer" class="jump-pill" data-target="engineer">
              <span class="jump-dot" style="background-color: #F7941D;"></span>
              <span class="pill-full">Engineer — Enterprise Applications</span>
              <span class="pill-short">Engineer</span>
            </a>
            <a href="#gen-ai" class="jump-pill" data-target="gen-ai">
              <span class="jump-dot" style="background-color: #EE4B2B;"></span>
              <span class="pill-full">Gen-AI — Enterprise Intelligence</span>
              <span class="pill-short">Gen-AI</span>
            </a>
          </nav>
        </div>
      </div>
    </section>

    <!-- 1. Plan Section (#plan) -->
    <section id="plan" class="capability-group-section" aria-labelledby="plan-heading">
      <div class="container">
        <div class="group-header reveal-on-scroll">
          <div class="group-title-row">
            <span class="pillar-letter-badge" style="background-color: #1E4B8F;">P</span>
            <div>
              <span class="eyebrow" style="color: #1E4B8F;">PLAN</span>
              <h2 id="plan-heading" class="group-headline">Technology consulting</h2>
            </div>
          </div>
          <p class="group-subline">
            Decide right, once. Zero-bias architecture assessment, platform selection, and roadmaps before code begins.
          </p>
        </div>

        <div class="advisory-card card-mastercard reveal-on-scroll">
          <div class="advisory-card-body">
            <span class="advisory-badge">Strategic Advisory &middot; Architecture Roadmaps</span>
            <h3 class="advisory-card-title">{planPillar?.tagline || 'The right decision before the first line of code.'}</h3>
            <p class="advisory-card-desc">{planPillar?.description}</p>
            
            <ul class="advisory-bullets">
              {planPillar?.bullets.map((bullet) => (
                <li>
                  <span class="bullet-dot" style="background-color: #1E4B8F;" aria-hidden="true"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <div class="advisory-action-row">
              <a href="/#contact" class="btn btn-primary">
                <span>Talk to an architect</span>
                <Icon name="arrow-right" size={16} />
              </a>
              <LearnMore href="/about#how" text="See our delivery methodology" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Engineer Section (#engineer) -->
    <section id="engineer" class="capability-group-section" aria-labelledby="engineer-heading">
      <div class="container">
        <div class="group-header reveal-on-scroll">
          <div class="group-title-row">
            <span class="pillar-letter-badge" style="background-color: #F7941D;">E</span>
            <div>
              <span class="eyebrow" style="color: #F7941D;">ENGINEER</span>
              <h2 id="engineer-heading" class="group-headline">Enterprise applications on OutSystems &amp; MERN</h2>
            </div>
          </div>
          <p class="group-subline">
            Low-code speed on OutSystems or bespoke freedom in MERN, chosen per budget and operational requirements.
          </p>
        </div>

        <div class="capability-cards-grid">
          {engineerProducts.map((item) => {
            const p = item.data;
            return (
              <article class="capability-card card-mastercard reveal-on-scroll">
                <div class="capability-media-wrapper">
                  <MediaAsset
                    assetKey={p.imageKey || `product-${item.slug}`}
                    alt={p.title}
                    aspectRatio="4/5"
                    crop="quarter"
                    focus={p.focus}
                    hoverVideoKey={`video-${item.slug}`}
                    theme="warm"
                  />
                  <div class="capability-pillar-badge" style="background-color: #F7941D;">
                    <span>Engineer</span>
                  </div>
                </div>

                <div class="capability-body">
                  <div class="capability-tags-row">
                    <span class="capability-stack-tag">{p.badge}</span>
                    {p.builtExamples && p.builtExamples.map((ex) => (
                      <span class="example-chip" title={`Deployed for ${ex.deployedFor}`}>
                        Built: {ex.name}
                      </span>
                    ))}
                  </div>

                  <h3 class="capability-title">
                    <a href={`/solutions/${item.slug}`}>{p.title}</a>
                  </h3>

                  <p class="capability-outcome">{p.outcomeHeadline}</p>
                  <p class="capability-desc">{p.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>

                  <div class="capability-action">
                    <LearnMore href={`/solutions/${item.slug}`} text={`Explore ${p.title}`} />
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 3. Gen-AI Section (#gen-ai) -->
    <section id="gen-ai" class="capability-group-section" aria-labelledby="gen-ai-heading">
      <div class="container">
        <div class="group-header reveal-on-scroll">
          <div class="group-title-row">
            <span class="pillar-letter-badge" style="background-color: #EE4B2B;">G</span>
            <div>
              <span class="eyebrow" style="color: #EE4B2B;">GEN-AI</span>
              <h2 id="gen-ai-heading" class="group-headline">Enterprise intelligence</h2>
            </div>
          </div>
          <p class="group-subline">
            Private, sovereign AI systems that operate on your data, inside your infrastructure.
          </p>
        </div>

        <div class="capability-cards-grid">
          {genAiProducts.map((item) => {
            const p = item.data;
            return (
              <article class="capability-card card-mastercard reveal-on-scroll">
                <div class="capability-media-wrapper">
                  <MediaAsset
                    assetKey={p.imageKey || `product-${item.slug}`}
                    alt={p.title}
                    aspectRatio="4/5"
                    crop="quarter"
                    focus={p.focus}
                    hoverVideoKey={`video-${item.slug}`}
                    theme="navy"
                  />
                  <div class="capability-pillar-badge" style="background-color: #EE4B2B;">
                    <span>Gen-AI</span>
                  </div>
                </div>

                <div class="capability-body">
                  <div class="capability-tags-row">
                    <span class="capability-stack-tag">{p.badge}</span>
                    {p.builtExamples && p.builtExamples.map((ex) => (
                      <span class="example-chip" title={`Deployed for ${ex.deployedFor}`}>
                        Built: {ex.name}
                      </span>
                    ))}
                  </div>

                  <h3 class="capability-title">
                    <a href={`/solutions/${item.slug}`}>{p.title}</a>
                  </h3>

                  <p class="capability-outcome">{p.outcomeHeadline}</p>
                  <p class="capability-desc">{p.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>

                  <div class="capability-action">
                    <LearnMore href={`/solutions/${item.slug}`} text={`Explore ${p.title}`} />
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  .solutions-hero-section {
    padding: calc(72px + 48px) 0 48px;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .solutions-hero-content {
    max-width: 840px;
  }

  .solutions-index-headline {
    font-size: var(--fs-h1);
    font-weight: 500;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .solutions-index-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  /* Jump Bar */
  .solutions-jump-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    max-width: 100%;
  }

  .jump-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: all 0.2s var(--ease-out-expo);
  }

  .jump-pill:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover);
  }

  .jump-pill.is-active {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border-color: var(--color-border);
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .jump-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .pill-short {
    display: none;
  }

  @media (max-width: 767px) {
    .solutions-jump-bar {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      display: flex;
      justify-content: space-between;
      padding: 4px;
    }

    .solutions-jump-bar::-webkit-scrollbar {
      display: none;
    }

    .pill-full {
      display: none;
    }

    .pill-short {
      display: inline;
    }

    .jump-pill {
      flex: 1;
      justify-content: center;
      padding: 0.45rem 0.65rem;
      font-size: 13px;
    }
  }

  /* Capability Group Sections */
  .capability-group-section {
    padding: var(--section-spacing-desktop) 0;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 88px;
  }

  .capability-group-section:nth-of-type(even) {
    background-color: var(--color-bg-alt);
  }

  .group-header {
    margin-bottom: 3rem;
    max-width: 760px;
  }

  .group-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .pillar-letter-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .group-headline {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin: 0;
  }

  .group-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Advisory Card */
  .advisory-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid #1E4B8F;
    box-shadow: var(--shadow-subtle);
  }

  .advisory-card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .advisory-badge {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1E4B8F;
  }

  .advisory-card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .advisory-card-desc {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 65ch;
  }

  .advisory-bullets {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .advisory-bullets li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }

  .bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .advisory-action-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  /* Capability Cards Grid (3 cards) */
  .capability-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .capability-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capability-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .capability-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-subtle);
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s var(--ease-out-expo);
  }

  .capability-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .capability-media-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .capability-pillar-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .capability-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .capability-tags-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .capability-stack-tag {
    font-size: 12px;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .example-chip {
    font-size: 12px;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background-color: rgba(30, 75, 143, 0.08);
    border: 1px solid rgba(30, 75, 143, 0.2);
    color: var(--color-brand-primary, #1E4B8F);
  }

  .capability-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .capability-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .capability-title a:hover {
    color: var(--color-brand-primary);
  }

  .capability-outcome {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .capability-desc {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .capability-action {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  function setupSolutionsJumpBar() {
    const jumpBar = document.getElementById('solutions-jump-bar');
    if (!jumpBar) return;

    const pills = Array.from(jumpBar.querySelectorAll<HTMLAnchorElement>('.jump-pill'));
    const sectionIds = pills.map(p => p.getAttribute('data-target')).filter(Boolean) as string[];
    const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    function setActiveJump(id: string) {
      pills.forEach(pill => {
        const isMatch = pill.getAttribute('data-target') === id;
        pill.classList.toggle('is-active', isMatch);
      });
    }

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const targetId = pill.getAttribute('data-target');
        if (targetId) setActiveJump(targetId);
      });
    });

    if ('IntersectionObserver' in window && sections.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            setActiveJump(entry.target.id);
          }
        });
      }, {
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0
      });

      sections.forEach(s => observer.observe(s));
    }
  }

  setupSolutionsJumpBar();
  document.addEventListener('astro:after-swap', setupSolutionsJumpBar);
</script>
