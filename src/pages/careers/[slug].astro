---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedJobBySlug } from '../../lib/careers/jobs';
import { CAREERS_EMAIL, COMPANY_NAME, DEFAULT_LOCATION } from '../../lib/careers/config';

const { slug } = Astro.params;
const job = slug ? getPublishedJobBySlug(slug) : undefined;

if (!job || job.status !== 'Published') {
  Astro.response.status = 404;
}

const applyEmail = job?.apply_email || CAREERS_EMAIL;
const applySubject = encodeURIComponent(`Application: ${job?.title || ''}`);
const applyMailto = `mailto:${applyEmail}?subject=${applySubject}`;

const respList = job?.responsibilities
  ? job.responsibilities.split('\n').map((s) => s.trim()).filter(Boolean)
  : [];

const reqList = job?.requirements
  ? job.requirements.split('\n').map((s) => s.trim()).filter(Boolean)
  : [];

const isRemote = job?.work_mode?.toLowerCase().includes('remote') || false;

// JobPosting JSON-LD schema
const jobPostingSchema = job && job.status === 'Published' ? {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: job.description_html || job.summary || job.title,
  datePosted: job.created_at,
  ...(job.closing_date ? { validThrough: job.closing_date } : {}),
  employmentType: job.type ? job.type.toUpperCase().replace('-', '_') : 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: COMPANY_NAME,
    sameAs: 'https://roundholesquarepeg.com',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: job.location || DEFAULT_LOCATION,
      addressCountry: 'IN',
    },
  },
  ...(isRemote ? { jobLocationType: 'TELECOMMUTE' } : {}),
} : null;

const pageTitle = job && job.status === 'Published'
  ? `${job.title} | Careers at RHSP`
  : 'Position Not Found | RHSP Careers';

const pageDesc = job && job.status === 'Published'
  ? (job.summary || `${job.title} opening at RHSP in ${job.department}, ${job.location}. Explore our engineering orientation.`)
  : 'The requested position is unavailable or has closed.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={job && job.status === 'Published' ? [
    { name: 'Careers', item: '/careers' },
    { name: job.title, item: `/careers/${job.slug}` },
  ] : undefined}
>
  <Nav />

  <main id="main-content" class="role-page">
    {job && job.status === 'Published' ? (
      <article class="role-article">
        {jobPostingSchema && (
          <script type="application/ld+json" set:html={JSON.stringify(jobPostingSchema)} />
        )}

        <!-- Top Navigation Bar -->
        <div class="role-top-nav">
          <div class="article-container">
            <a href="/careers" class="back-link" data-track="careers_back_click">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Back to all open orientations</span>
            </a>
          </div>
        </div>

        <!-- Role Header -->
        <header class="role-header">
          <div class="article-container">
            <div class="role-badge-row">
              <span class="badge dept-badge">{job.department}</span>
              <span class="badge type-badge">{job.type}</span>
              <span class="badge mode-badge">{job.work_mode}</span>
            </div>

            <h1 class="role-title">{job.title}</h1>

            <div class="role-meta-grid">
              <div class="meta-item">
                <span class="meta-label">Location</span>
                <span class="meta-val">{job.location}</span>
              </div>
              {job.experience && (
                <div class="meta-item">
                  <span class="meta-label">Experience</span>
                  <span class="meta-val">{job.experience}</span>
                </div>
              )}
              {job.salary && (
                <div class="meta-item">
                  <span class="meta-label">Compensation</span>
                  <span class="meta-val">{job.salary}</span>
                </div>
              )}
              {job.closing_date && (
                <div class="meta-item">
                  <span class="meta-label">Closing Date</span>
                  <span class="meta-val">{job.closing_date}</span>
                </div>
              )}
            </div>
          </div>
        </header>

        <!-- Role Body & Sticky Sidebar -->
        <div class="role-body-section">
          <div class="article-container body-grid">
            <div class="role-main-content">
              {job.summary && (
                <div class="role-lead-summary">
                  <p>{job.summary}</p>
                </div>
              )}

              {job.description_html && (
                <section class="content-block" aria-labelledby="heading-about-role">
                  <h2 id="heading-about-role" class="content-heading">Context &amp; Challenge</h2>
                  <div class="rendered-markdown" set:html={job.description_html} />
                </section>
              )}

              {respList.length > 0 && (
                <section class="content-block" aria-labelledby="heading-responsibilities">
                  <h2 id="heading-responsibilities" class="content-heading">Responsibilities</h2>
                  <ul class="role-list">
                    {respList.map((item) => (
                      <li>
                        <span class="list-bullet" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {reqList.length > 0 && (
                <section class="content-block" aria-labelledby="heading-requirements">
                  <h2 id="heading-requirements" class="content-heading">Qualifications &amp; Trajectory</h2>
                  <ul class="role-list">
                    {reqList.map((item) => (
                      <li>
                        <span class="list-bullet" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              <section class="apply-bottom-card" aria-label="Apply for this orientation">
                <div class="apply-card-inner">
                  <h3>Ready to calibrate your orientation with RHSP?</h3>
                  <p>Send your portfolio, repository links, or dossier directly to our engineering review panel.</p>
                  <a
                    href={applyMailto}
                    class="cta-apply-prominent"
                    data-track="careers_apply_click"
                    data-track-role={job.slug}
                  >
                    Apply for this Position
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </section>
            </div>

            <!-- Sticky Sidebar -->
            <aside class="role-sidebar" aria-label="Role Summary and Application">
              <div class="sticky-apply-box">
                <div class="box-header">
                  <span class="box-badge">Direct Application</span>
                  <div class="box-peg-notch" aria-hidden="true"></div>
                </div>

                <div class="box-role-info">
                  <h3 class="box-title">{job.title}</h3>
                  <p class="box-location">{job.location} &bull; {job.work_mode}</p>
                </div>

                <a
                  href={applyMailto}
                  class="cta-apply-sticky"
                  data-track="careers_apply_click"
                  data-track-role={job.slug}
                >
                  Apply Now
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>

                <div class="box-footer-note">
                  <p>Inquiries routed to <code>{applyEmail}</code></p>
                  <p class="anti-spam-note">Response guaranteed within 3 enterprise cycles.</p>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </article>
    ) : (
      <div class="not-found-container">
        <div class="not-found-card">
          <div class="not-found-aperture" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
              <circle cx="36" cy="36" r="32" stroke="var(--color-border)" stroke-width="2" stroke-dasharray="6 6"/>
              <line x1="26" y1="26" x2="46" y2="46" stroke="var(--rhsp-peg-end)" stroke-width="3" stroke-linecap="round"/>
              <line x1="46" y1="26" x2="26" y2="46" stroke="var(--rhsp-peg-end)" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <h1>Orientation Closed or Unavailable</h1>
          <p>
            The role you are looking for has either concluded its intake cycle or has moved to an alternate aperture.
          </p>
          <div class="not-found-actions">
            <a href="/careers" class="cta-primary">View Open Roles</a>
            <a href={`mailto:${CAREERS_EMAIL}?subject=Open%20application`} class="cta-secondary">Open Application</a>
          </div>
        </div>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .role-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding-top: 80px;
    background: var(--color-bg);
    color: var(--color-text-primary);
  }

  .article-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Top Nav */
  .role-top-nav {
    padding: 24px 0 12px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--rhsp-navy);
    text-decoration: none;
    min-height: 44px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  :global([data-theme="dark"]) .back-link {
    color: #6FA3F5;
  }

  .back-link:hover {
    color: var(--rhsp-peg-end);
    transform: translateX(-3px);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--rhsp-peg-start);
    outline-offset: 4px;
  }

  /* Header */
  .role-header {
    padding: 48px 0 40px;
    background: radial-gradient(circle at 90% 10%, rgba(247, 148, 29, 0.06) 0%, transparent 60%),
                var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .role-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    padding: 6px 14px;
    border-radius: 999px;
  }

  .dept-badge {
    background: var(--color-bg-alt);
    color: var(--rhsp-navy);
    border: 1px solid var(--color-border);
  }

  :global([data-theme="dark"]) .dept-badge {
    color: #6FA3F5;
  }

  .type-badge {
    background: rgba(247, 148, 29, 0.12);
    color: var(--rhsp-peg-end);
    border: 1px solid rgba(238, 75, 43, 0.2);
  }

  .mode-badge {
    background: var(--color-surface-hover);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-subtle);
  }

  .role-title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    color: var(--color-text-primary);
  }

  .role-meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    padding-top: 24px;
    border-top: 1px dashed var(--color-border);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .meta-val {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  /* Body & Layout */
  .role-body-section {
    padding: 64px 0 96px;
  }

  .body-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 56px;
    align-items: start;
  }

  .role-main-content {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .role-lead-summary {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    border-left: 3px solid var(--rhsp-peg-start);
    padding-left: 20px;
  }

  .content-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .content-heading {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--color-text-primary);
  }

  .rendered-markdown {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .rendered-markdown :global(p) {
    margin: 0 0 16px;
  }

  .rendered-markdown :global(p:last-child) {
    margin-bottom: 0;
  }

  .rendered-markdown :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 24px 0 12px;
    color: var(--color-text-primary);
  }

  .rendered-markdown :global(ul),
  .rendered-markdown :global(ol) {
    margin: 12px 0 20px 24px;
    padding: 0;
  }

  .rendered-markdown :global(li) {
    margin-bottom: 8px;
  }

  .role-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .role-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .list-bullet {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--rhsp-peg-start);
    margin-top: 9px;
    flex-shrink: 0;
  }

  /* Sticky Sidebar */
  .role-sidebar {
    position: sticky;
    top: 104px;
  }

  .sticky-apply-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 32px 24px;
    box-shadow: var(--shadow-dropdown);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .box-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rhsp-peg-end);
    background: rgba(238, 75, 43, 0.08);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .box-peg-notch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rhsp-peg-gradient);
  }

  .box-role-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .box-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .box-location {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .cta-apply-sticky {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 20px;
    background: var(--rhsp-peg-gradient);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(238, 75, 43, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-apply-sticky:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(238, 75, 43, 0.4);
  }

  .cta-apply-sticky:focus-visible {
    outline: 2px solid var(--rhsp-peg-start);
    outline-offset: 4px;
  }

  .box-footer-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    border-top: 1px dashed var(--color-border);
    padding-top: 16px;
  }

  .box-footer-note p {
    margin: 0 0 6px;
  }

  .box-footer-note code {
    background: var(--color-bg-alt);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--rhsp-navy);
  }

  :global([data-theme="dark"]) .box-footer-note code {
    color: #6FA3F5;
  }

  .anti-spam-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0 !important;
  }

  /* Bottom Card */
  .apply-bottom-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 36px 32px;
    margin-top: 24px;
  }

  .apply-card-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .apply-card-inner h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
  }

  .apply-card-inner p {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0 0 12px;
  }

  .cta-apply-prominent {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 28px;
    background: var(--color-text-primary);
    color: var(--color-surface);
    font-size: 1rem;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  :global([data-theme="dark"]) .cta-apply-prominent {
    background: #ffffff;
    color: #141413;
  }

  .cta-apply-prominent:hover {
    transform: translateY(-2px);
  }

  /* Not Found */
  .not-found-container {
    max-width: 640px;
    margin: 80px auto 120px;
    padding: 0 24px;
    text-align: center;
  }

  .not-found-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    padding: 56px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .not-found-card h1 {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0;
  }

  .not-found-card p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 16px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 28px;
    font-weight: 700;
    color: #ffffff;
    background: var(--color-text-primary);
    border-radius: 999px;
    text-decoration: none;
  }

  :global([data-theme="dark"]) .cta-primary {
    background: #ffffff;
    color: #141413;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    font-weight: 700;
    color: var(--color-text-primary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .body-grid {
      grid-template-columns: 1fr;
    }

    .role-sidebar {
      position: static;
      order: -1;
      margin-bottom: 32px;
    }
  }

  @media (max-width: 640px) {
    .role-header {
      padding: 32px 0 28px;
    }

    .role-meta-grid {
      gap: 16px;
    }

    .apply-bottom-card {
      padding: 24px 20px;
    }
  }
</style>
