---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Team from '../components/Team.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';

const { about } = siteConfig;

const theoryCards = [
  {
    id: 'hole',
    step: '01 / Round hole',
    title: 'The round hole: your challenge',
    text: 'Defined by your people, processes and data.',
    color: '#1E4B8F',
    beat: 1
  },
  {
    id: 'adapter',
    step: '02 / The adapter',
    title: 'The adapter: RHSP',
    text: 'The engineering that lets the two work together, with no compromise on either side.',
    color: '#F7941D',
    beat: 2
  },
  {
    id: 'peg',
    step: '03 / Square peg',
    title: 'The square peg: the solution',
    text: 'Powerful technology, built for the general case.',
    color: '#EE4B2B',
    beat: 3
  }
];

function formatMandateText(text: string) {
  return text
    .replace(/\badapts\b/g, '<strong>adapts</strong>')
    .replace(/\blatent revenue\b/g, '<strong>latent revenue</strong>')
    .replace(/\bintelligent automation\b/g, '<strong>intelligent automation</strong>')
    .replace(/\btrusted technology partner\b/g, '<strong>trusted technology partner</strong>');
}
---

<BaseLayout
  title="The RHSP theory - About RHSP"
  description="RHSP stands for Round Hole Square Peg. Every business challenge is a round hole. Every powerful technology is a square peg. We engineer the adapter between them."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'About', item: '/about' }
  ]}
>
  <Nav />

  <!-- Desktop Sticky Pill Sub-Nav (Hidden below 900px) -->
  <nav class="about-sticky-subnav" id="about-sticky-subnav" aria-label="About page sections">
    <div class="subnav-pill-container">
      <a href="#theory-hero" class="subnav-link is-active" data-section="theory-hero">Theory &amp; Origin</a>
      <span class="subnav-sep" aria-hidden="true">·</span>
      <a href="#mission" class="subnav-link" data-section="mission">Mission</a>
      <span class="subnav-sep" aria-hidden="true">·</span>
      <a href="#team" class="subnav-link" data-section="team">Leadership</a>
    </div>
  </nav>

  <main id="main-content" tabindex="-1">
    <!-- 1. MERGED SECTION: The RHSP Theory & Apollo 13 Story inside one large rounded container -->
    <section id="theory-hero" class="about-hero-section" aria-labelledby="hero-heading">
      <div class="container">
        <div class="unified-theory-container card-mastercard reveal-on-scroll">
          
          <!-- 1. HEADER ROW -->
          <div class="theory-header-row">
            <!-- Left: small label "The RHSP theory", large heading "The RHSP theory.", expandable chip -->
            <div class="theory-header-left">
              <span class="eyebrow">The RHSP theory</span>
              <h1 id="hero-heading" class="hero-heading">The RHSP theory.</h1>

              <!-- Expandable Definition Pill -->
              <div class="definition-chip-wrap">
                <button
                  type="button"
                  class="rhsp-expandable-pill"
                  id="rhsp-expandable-pill"
                  aria-expanded="false"
                  aria-label="RHSP stands for Round Hole Square Peg"
                >
                  <span class="sr-only">RHSP stands for Round Hole Square Peg.</span>
                  <span class="pill-track" aria-hidden="true">
                    <span class="pill-chunk" data-letter="R">
                      <span class="chunk-letter letter-r">R</span><span class="chunk-word">ound</span>
                    </span>
                    <span class="pill-dot">·</span>
                    <span class="pill-chunk" data-letter="H">
                      <span class="chunk-letter letter-h">H</span><span class="chunk-word">ole</span>
                    </span>
                    <span class="pill-dot">·</span>
                    <span class="pill-chunk" data-letter="S">
                      <span class="chunk-letter letter-s">S</span><span class="chunk-word">quare</span>
                    </span>
                    <span class="pill-dot">·</span>
                    <span class="pill-chunk" data-letter="P">
                      <span class="chunk-letter letter-p">P</span><span class="chunk-word">eg</span>
                    </span>
                  </span>
                  <span class="pill-hint" aria-hidden="true">
                    <Icon name="chevron-right" size={12} class="pill-hint-icon" />
                  </span>
                </button>
                <span class="definition-fallback-text sr-only">RHSP stands for Round Hole Square Peg.</span>
              </div>
            </div>

            <!-- Right: Three short paragraphs with bold lead-ins -->
            <div class="theory-header-right">
              <p class="theory-lead-p">
                <strong>The Problem:</strong> Standard tech solves for the 80%, leaving your unique business processes out in the cold.
              </p>
              <p class="theory-lead-p">
                <strong>The Status Quo:</strong> Too often, IT tells you to change how you operate just to fit the software.
              </p>
              <p class="theory-lead-p">
                <strong>Our Approach:</strong> We don't force square pegs into round holes. We build the exact custom bridge between your technology and your requirements, preserving your operational DNA without compromise.
              </p>
            </div>
          </div>

          <!-- 2. THREE CARDS IN A ROW (Stack on mobile) -->
          <div class="theory-cards-row">
            {theoryCards.map((card) => (
              <article
                class="theory-row-card card-mastercard"
                id={`theory-card-${card.id}`}
                data-card-id={card.id}
                data-beat={card.beat}
                tabindex="0"
                style={`border-top: 3px solid ${card.color};`}
              >
                <div class="theory-card-header">
                  <span class="theory-card-step" style={`color: ${card.color};`}>
                    {card.step}
                  </span>
                  <h2 class="theory-card-title">{card.title}</h2>
                </div>
                <p class="theory-card-copy">{card.text}</p>
                <button
                  type="button"
                  class="theory-card-link-btn"
                  data-beat-target={card.beat}
                  style={`color: ${card.color};`}
                >
                  <span>Highlight in architecture &rarr;</span>
                </button>
              </article>
            ))}
          </div>

          <!-- 3. APOLLO BLOCK (Same container) -->
          <div class="apollo-merged-block" id="apollo-block">
            <!-- Left Column: Apollo story & timeline -->
            <div class="apollo-left-col">
              <span class="eyebrow">Our Inspiration</span>
              <h2 class="apollo-heading">The Apollo 13 imperative.</h2>

              <ol class="apollo-timeline" aria-label="Apollo 13 timeline sequence">
                <li class="apollo-timeline-item" data-beat-target="1" role="button" tabindex="0">
                  <span class="apollo-step-num circle-blue" aria-hidden="true">01</span>
                  <p class="step-text">
                    In April 1970, Apollo 13 suffered an oxygen tank explosion 200,000 miles from Earth.
                  </p>
                </li>
                <li class="apollo-timeline-item" data-beat-target="2" role="button" tabindex="0">
                  <span class="apollo-step-num circle-orange" aria-hidden="true">02</span>
                  <p class="step-text">
                    NASA ground crew had to fit square lithium hydroxide canisters into round sockets using only materials on board.
                  </p>
                </li>
                <li class="apollo-timeline-item" data-beat-target="3" role="button" tabindex="0">
                  <span class="apollo-step-num circle-red" aria-hidden="true">03</span>
                  <p class="step-text">
                    They didn't force the socket. They engineered the adapter.
                  </p>
                </li>
              </ol>


              <!-- Quote with orange left rule -->
              <div class="apollo-quote-box">
                <p class="apollo-quote-text">
                  Round Hole Square Peg was founded on the exact same imperative: we don't force your enterprise to conform to rigid software - we engineer the adapter around your operational reality.
                </p>
              </div>
            </div>

            <!-- Right Column: Interactive Diagram with 3 Tabs & Replay -->
            <div class="apollo-right-col">
              <div class="diagram-surface card-mastercard" id="theory-diagram-wrapper" data-beat="1">
                <!-- Replay & Beat Indicator Header -->
                <div class="diagram-top-bar">
                  <div class="diagram-beat-pills" role="tablist" aria-label="Diagram beats">
                    <button type="button" class="beat-pill is-active" data-beat-target="1" role="tab" aria-selected="true">1. Challenge</button>
                    <button type="button" class="beat-pill" data-beat-target="2" role="tab" aria-selected="false">2. Adapter</button>
                    <button type="button" class="beat-pill" data-beat-target="3" role="tab" aria-selected="false">3. Solution</button>
                  </div>
                  <button type="button" class="diagram-replay-btn" id="diagram-replay-btn" aria-label="Replay animation">
                    <Icon name="rotate-ccw" size={13} />
                    <span>Replay</span>
                  </button>
                </div>

                <!-- Full-Panel Animated SVG Diagram -->
                <div class="svg-container">
                  <svg
                    viewBox="0 0 560 300"
                    fill="none"
                    class="theory-interactive-svg"
                    id="theory-interactive-svg"
                    xmlns="http://www.w3.org/2000/svg"
                    role="img"
                    aria-label="RHSP animation: a square peg and a round hole. Six lines run from the edges of the square and map onto the circle, then the peg settles into the hole."
                  >
                    <defs>
                      <radialGradient id="holeGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#1E4B8F" stop-opacity="0.22" />
                        <stop offset="100%" stop-color="#1E4B8F" stop-opacity="0" />
                      </radialGradient>
                      <linearGradient id="mapLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#EE4B2B" />
                        <stop offset="100%" stop-color="#F7941D" />
                      </linearGradient>
                    </defs>

                    <!-- ROUND HOLE -->
                    <g class="d-hole" id="d-hole" transform="translate(420, 140)">
                      <circle r="92" fill="url(#holeGlow)" class="d-hole-glow" />
                      <text y="-94" class="d-label d-label-hole" text-anchor="middle">ROUND HOLE</text>
                      <text y="92" class="d-sub" text-anchor="middle">Your business reality</text>
                      <circle r="62" class="d-hole-ring" />
                      <circle r="46" class="d-hole-inner" />
                      <!-- ghost of the peg: shows the corner clash in the first beat -->
                      <g class="d-ghost">
                        <rect x="-38" y="-38" width="76" height="76" rx="3" class="d-ghost-rect" />
                        <circle cx="-38" cy="-38" r="4" class="d-clash" />
                        <circle cx="38" cy="-38" r="4" class="d-clash" />
                        <circle cx="38" cy="38" r="4" class="d-clash" />
                        <circle cx="-38" cy="38" r="4" class="d-clash" />
                      </g>
                    </g>

                    <!-- SIX MAPPING LINES (square edges to circle), drawn by script -->
                    <g class="d-lines">
                      <path class="d-line" /><path class="d-line" /><path class="d-line" />
                      <path class="d-line" /><path class="d-line" /><path class="d-line" />
                    </g>
                    <g class="d-nodes">
                      <circle class="d-node" r="3.5" /><circle class="d-node" r="3.5" /><circle class="d-node" r="3.5" />
                      <circle class="d-node" r="3.5" /><circle class="d-node" r="3.5" /><circle class="d-node" r="3.5" />
                    </g>

                    <!-- SQUARE PEG -->
                    <g class="d-peg" id="d-peg" transform="translate(120, 140)">
                      <rect x="-38" y="-38" width="76" height="76" rx="3" class="d-peg-rect" />
                      <rect x="-14" y="-14" width="28" height="28" rx="2" class="d-peg-core" />
                    </g>

                    <!-- Labels -->
                    <text x="120" y="46" class="d-label d-label-peg" text-anchor="middle">SQUARE PEG</text>
                    <text x="120" y="232" class="d-sub d-sub-peg" text-anchor="middle">Your technology</text>
                    <text x="270" y="262" class="d-label d-label-adapter" text-anchor="middle">RHSP ADAPTER</text>
                    <text x="280" y="270" class="d-sub d-sub-fit" text-anchor="middle">Zero compromise on either side</text>
                  </svg>
                </div>

                <!-- Narrative Beat Caption Bar -->
                <div class="diagram-caption-footer">
                  <span class="caption-tag">Story</span>
                  <p class="caption-text" id="diagram-caption-text">
                    The square peg meets the round hole. Its corners clash with the socket.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MISSION & VISION -->
    <section id="mission" class="about-section mission-section" aria-labelledby="mission-heading">
      <div class="container">
        <div class="section-header reveal-on-scroll">
          <span class="eyebrow">{about.mandate.badge}</span>
          <h2 id="mission-heading" class="section-title">{about.mandate.headline}</h2>
          <p class="section-subline">{about.mandate.subline}</p>
        </div>

        <div class="three-col-cards-grid">
          {about.mandate.cards.map((card, index) => {
            const colors = ['#1E4B8F', '#F7941D', '#EE4B2B'];
            const color = colors[index % colors.length];
            return (
              <article
                class="mandate-card card-mastercard reveal-on-scroll"
                style={`transition-delay: ${index * 60}ms; border-top: 3px solid ${color};`}
              >
                <div class="mandate-card-header">
                  <span class="mandate-card-step" style={`color: ${color};`}>
                    0{index + 1} / {card.title.toUpperCase()}
                  </span>
                  <h3 class="mandate-card-title">{card.title}</h3>
                </div>
                <p class="mandate-card-copy" set:html={formatMandateText(card.text)} />
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 3. LEADERSHIP TEAM -->
    <Team />

    <!-- 4. UNIVERSAL CONTACT SECTION -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Sticky Sub-Nav (Desktop >= 900px) */
  .about-sticky-subnav {
    position: sticky;
    top: 72px;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0.75rem 1rem;
    pointer-events: none;
    margin-bottom: -48px;
  }

  .subnav-pill-container {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    pointer-events: auto;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  :global(.dark) .subnav-pill-container {
    background: rgba(22, 28, 40, 0.85);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .subnav-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 0.2rem 0.4rem;
  }

  .subnav-link:hover,
  .subnav-link.is-active {
    color: #F7941D;
  }

  .subnav-sep {
    color: var(--color-border-strong);
    font-size: 11px;
  }

  @media (max-width: 899px) {
    .about-sticky-subnav {
      display: none;
    }
  }

  /* Section Spacing */
  .about-hero-section {
    padding-top: calc(72px + 2.75rem);
    padding-bottom: 2.5rem;
    background-color: var(--color-bg);
  }

  @media (max-width: 767px) {
    .about-hero-section {
      padding-top: calc(64px + var(--section-spacing-mobile, 40px));
      padding-bottom: var(--section-spacing-mobile, 40px);
    }
  }

  /* UNIFIED MASTER CONTAINER */
  .unified-theory-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
  }

  :global(.dark) .unified-theory-container {
    background: var(--color-surface-raised);
    border-color: var(--color-border);
  }

  /* 1. Header row */
  .theory-header-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: clamp(1.1rem, 2vw, 1.6rem);
  }

  @media (min-width: 960px) {
    .theory-header-row {
      grid-template-columns: 1fr 1.25fr;
      gap: 3.5rem;
    }
  }

  .hero-heading {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 800;
    line-height: 1.12;
    margin: 0.25rem 0 0.85rem 0;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .theory-header-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .theory-lead-p {
    font-size: clamp(0.9rem, 1.2vw, 0.975rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .theory-lead-p strong {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  /* Expandable Definition Pill */
  .definition-chip-wrap {
    margin-bottom: 0.5rem;
  }

  .rhsp-expandable-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark) .rhsp-expandable-pill {
    background-color: var(--color-surface);
  }

  .rhsp-expandable-pill:hover,
  .rhsp-expandable-pill.is-expanded {
    border-color: var(--color-border-strong);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .pill-track {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pill-chunk {
    display: inline-flex;
    align-items: baseline;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .chunk-letter {
    font-weight: 800;
  }

  .letter-r { color: #1E4B8F; }
  .letter-h { color: #1E4B8F; }
  .letter-s { color: #F7941D; }
  .letter-p { color: #EE4B2B; }

  :global(.dark) .letter-r,
  :global(.dark) .letter-h {
    color: #5B8FE0;
  }

  .chunk-word {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-text-secondary);
    font-weight: 600;
    transition: max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .rhsp-expandable-pill:hover .chunk-word,
  .rhsp-expandable-pill.is-expanded .chunk-word {
    max-width: 60px;
    opacity: 1;
    margin-left: 1px;
  }

  .pill-dot {
    color: var(--color-border-strong);
    font-weight: 700;
  }

  .pill-hint {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .rhsp-expandable-pill:hover .pill-hint,
  .rhsp-expandable-pill.is-expanded .pill-hint {
    transform: rotate(90deg);
  }

  /* 2. Three cards in a row */
  .theory-cards-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  @media (min-width: 860px) {
    .theory-cards-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .theory-row-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  :global(.dark) .theory-row-card {
    background: var(--color-surface);
  }

  .theory-row-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .theory-card-header {
    margin-bottom: 0.65rem;
  }

  .theory-card-step {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    margin-bottom: 0.4rem;
  }

  .theory-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .theory-card-copy {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    flex: 1;
  }

  .theory-card-link-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .theory-card-link-btn:hover {
    text-decoration: underline;
  }

  /* 3. Apollo block (Same container) */
  .apollo-merged-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 960px) {
    .apollo-merged-block {
      grid-template-columns: 1fr 1.15fr;
      gap: 3.5rem;
      align-items: center;
    }
  }

  .apollo-heading {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0.35rem 0 1.5rem 0;
    color: var(--color-text-primary);
  }

  .apollo-timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .apollo-timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .apollo-timeline-item:hover,
  .apollo-timeline-item.is-selected {
    background: rgba(30, 75, 143, 0.05);
  }

  .apollo-step-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .circle-blue { background-color: #1E4B8F; }
  .circle-orange { background-color: #F7941D; }
  .circle-red { background-color: #EE4B2B; }

  .step-text {
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .apollo-chips-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
