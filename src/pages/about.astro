  .label-hole-title { fill: #1E4B8F; }
  :global(.dark) .label-hole-title { fill: #5B8FE0; }
  .label-adapter-title { fill: #F7941D; }
  .label-peg-title { fill: #EE4B2B; }

  .diagram-svg-sublabel {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    fill: var(--color-text-secondary);
  }

  /* New diagram: peg, hole and six mapping lines (lines are drawn by script) */
  .d-hole-ring { stroke: #1E4B8F; stroke-width: 2.5; fill: rgba(30, 75, 143, 0.05); }
  .d-hole-inner { stroke: #1E4B8F; stroke-width: 1.5; stroke-dasharray: 5 4; fill: none; opacity: 0.7; }
  :global(.dark) .d-hole-ring, :global(.dark) .d-hole-inner { stroke: #5B8FE0; }
  .d-ghost { opacity: 0; transition: opacity 0.4s ease; }
  .d-ghost-rect { stroke: #EE4B2B; stroke-width: 1.5; stroke-dasharray: 4 4; fill: none; }
  .d-clash { fill: #EE4B2B; animation: dClash 0.9s infinite alternate ease-in-out; transform-box: fill-box; transform-origin: center; }
  @keyframes dClash { from { transform: scale(1); opacity: 0.7; } to { transform: scale(1.7); opacity: 1; } }

  .d-line { fill: none; stroke: url(#mapLineGrad); stroke-width: 2; stroke-linecap: round; }
  .d-node { fill: #F7941D; opacity: 0; }
  .d-peg-rect { stroke: #EE4B2B; stroke-width: 2.5; fill: rgba(238, 75, 43, 0.1); }
  .d-peg-core { stroke: #EE4B2B; stroke-width: 1.5; fill: none; opacity: 0.55; }

  .d-label { font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; }
  .d-label-hole { fill: #1E4B8F; }
  :global(.dark) .d-label-hole { fill: #5B8FE0; }
  .d-label-peg { fill: #EE4B2B; }
  .d-label-adapter { fill: #F7941D; opacity: 0; transition: opacity 0.4s ease; }
  .d-sub { font-family: var(--font-sans); font-size: 11px; font-weight: 500; fill: var(--color-text-secondary); }
  .d-sub-fit { opacity: 0; transition: opacity 0.4s ease; }

  .diagram-surface[data-beat="1"] .d-ghost { opacity: 1; }
  .diagram-surface[data-beat="2"] .d-label-adapter { opacity: 1; }
  .diagram-surface[data-beat="3"] .d-label-adapter { opacity: 0; }
  .diagram-surface[data-beat="3"] .d-sub-fit { opacity: 1; }
  .diagram-surface[data-beat="3"] .d-sub-peg,
  .diagram-surface[data-beat="3"] .d-label-peg { opacity: 0; }
  .d-label-peg, .d-sub-peg { transition: opacity 0.3s ease; }
  .diagram-surface[data-beat="3"] .d-hole-glow { animation: dFit 1.6s ease-in-out infinite alternate; }
  @keyframes dFit { from { opacity: 0.6; } to { opacity: 1; } }

  .diagram-caption-footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
