---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Team from '../components/Team.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../config/site';

const { about } = siteConfig;
---

<BaseLayout
  title="About RHSP - Tech that adapts to business."
  description="Round Hole Square Peg is built on the Apollo 13 imperative: understand the challenge, then engineer the adapter to the solution. Technology consulting, implementation, and sovereign enterprise AI."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'About', item: '/about' }
  ]}
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. Our Origin: Apollo 13 "Our origin" story (starts the page directly, no hero) -->
    <section id="story" class="about-story-section" aria-labelledby="story-heading">
      <div class="container">
        <div class="story-box-wrapper card-mastercard reveal-on-scroll">
          <div class="story-header">
            <span class="eyebrow">OUR ORIGIN</span>
            <h1 id="story-heading" class="story-title">
              The Apollo 13 imperative.
            </h1>
          </div>

          <div class="story-body-grid">
            <!-- Left: 3 Short Origin Lines -->
            <div class="story-lines-col">
              <ol class="story-timeline" aria-label="Apollo 13 origin sequence steps">
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">01</span>
                  <p class="step-text">In April 1970, Apollo 13 suffered an oxygen tank explosion 200,000 miles from Earth.</p>
                </li>
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">02</span>
                  <p class="step-text">NASA engineers had to connect square lithium hydroxide canisters to round sockets using only what was on board.</p>
                </li>
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">03</span>
                  <p class="step-text">They engineered the adapter using only what was on board.</p>
                </li>
              </ol>

              <!-- Fact Chips -->
              <div class="story-fact-chips">
                <span class="fact-chip">April 1970</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">200,000 miles from Earth</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">Only materials on board</span>
              </div>

              <div class="story-conclusion-card">
                <p class="conclusion-statement">
                  Round Hole Square Peg is built on the same principle: understand the challenge, then engineer the adapter to the solution.
                </p>
              </div>
            </div>

            <!-- Right: Blueprint Line-Art Illustration -->
            <div class="story-illustration-col">
              <div class="blueprint-canvas">
                <svg
                  viewBox="0 0 320 280"
                  fill="none"
                  class="blueprint-svg"
                  role="img"
                  aria-label="Technical diagram: Round hole (The challenge), RHSP adapter (The adapter), and Square peg (The solution). From challenge to solution."
                >
                  <!-- Left: Round Hole / Socket (The challenge) -->
                  <ellipse cx="75" cy="115" rx="42" ry="42" stroke="#1E4B8F" stroke-width="1.75" />
                  <ellipse cx="75" cy="115" rx="28" ry="28" stroke="#1E4B8F" stroke-dasharray="4 4" stroke-width="1" />
                  <text x="75" y="111" font-family="var(--font-sans, sans-serif)" font-weight="600" font-size="8.5" fill="#1E4B8F" text-anchor="middle">ROUND HOLE</text>
                  <text x="75" y="125" font-family="var(--font-sans, sans-serif)" font-size="8" fill="var(--color-text-secondary, #5B5B5B)" text-anchor="middle">The challenge</text>

                  <!-- Center: The Engineered Adapter -->
                  <path d="M120,90 C140,80 160,80 180,90" stroke="#F7941D" stroke-width="2" stroke-linecap="round" />
                  <path d="M120,140 C140,150 160,150 180,140" stroke="#F7941D" stroke-width="2" stroke-linecap="round" />
                  <rect x="135" y="97" width="46" height="36" rx="8" fill="var(--color-surface-alt, #FFFFFF)" stroke="#F7941D" stroke-width="1.5" />
                  <text x="158" y="115" font-family="var(--font-sans, sans-serif)" font-weight="600" font-size="8" fill="#F7941D" text-anchor="middle">RHSP</text>
                  <text x="158" y="126" font-family="var(--font-sans, sans-serif)" font-size="6.5" fill="var(--color-text-secondary, #5B5B5B)" text-anchor="middle">The adapter</text>

                  <!-- Right: Square Peg (The solution) -->
                  <rect x="205" y="60" width="70" height="110" rx="4" stroke="#EE4B2B" stroke-width="1.75" stroke-dasharray="3 3" />
                  <text x="240" y="111" font-family="var(--font-sans, sans-serif)" font-weight="600" font-size="8.5" fill="#EE4B2B" text-anchor="middle">SQUARE PEG</text>
                  <text x="240" y="125" font-family="var(--font-sans, sans-serif)" font-size="8" fill="var(--color-text-secondary, #5B5B5B)" text-anchor="middle">The solution</text>

                  <!-- Bottom Measurement Baseline -->
                  <line x1="35" y1="200" x2="285" y2="200" stroke="var(--color-border, #E6E6E3)" stroke-width="1" />
                  <circle cx="35" cy="200" r="3" fill="#1E4B8F" />
                  <circle cx="285" cy="200" r="3" fill="#EE4B2B" />

                  <!-- Caption: From challenge to solution -->
                  <text x="160" y="235" font-family="var(--font-sans, sans-serif)" font-size="9.5" font-weight="600" letter-spacing="0.08em" fill="var(--color-text-secondary, #5B5B5B)" text-anchor="middle">From challenge to solution</text>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Mission · Purpose · Vision -->
    <section id="mission" class="about-mission-section" aria-labelledby="mission-heading">
      <div class="container">
        <div class="section-intro text-center reveal-on-scroll">
          <span class="eyebrow">{about.mandate.badge}</span>
          <h2 id="mission-heading" class="section-title">{about.mandate.headline}</h2>
          <p class="section-subline">{about.mandate.subline}</p>
        </div>

        <div class="mission-cards-grid">
          {about.mandate.cards.map((card, index) => {
            const colors = ['#1E4B8F', '#F7941D', '#EE4B2B'];
            const color = colors[index % colors.length];
            return (
              <article
                class="mission-card card-mastercard reveal-on-scroll"
                style={`transition-delay: ${index * 80}ms; border-top: 3px solid ${color};`}
              >
                <div class="mission-card-content">
                  <span class="mission-eyebrow-label" style={`color: ${color};`}>
                    0{index + 1} / {card.title.toUpperCase()}
                  </span>
                  <h3 class="mission-card-title">{card.title}</h3>
                  <p class="mission-card-body">{card.text}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 3. Leadership Team -->
    <Team />

    <!-- 4. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* 1. Origin Story Section: Starts the page directly, padded for fixed nav */
  .about-story-section {
    padding-top: calc(72px + var(--section-spacing-desktop));
    padding-bottom: var(--section-spacing-desktop);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  @media (max-width: 767px) {
    .about-story-section {
      padding-top: calc(60px + var(--section-spacing-mobile));
      padding-bottom: var(--section-spacing-mobile);
      scroll-margin-top: 76px;
    }
  }

  .story-box-wrapper {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 3.5rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .story-box-wrapper {
      padding: 2rem 1.5rem;
    }
  }

  .story-header {
    margin-bottom: 2.5rem;
    max-width: 680px;
  }

  .story-title {
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: 1.15;
    margin-top: -0.25rem;
    color: var(--color-text-primary);
  }

  .story-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 959px) {
    .story-illustration-col {
      order: -1;
      margin-bottom: 0.5rem;
    }
  }

  @media (min-width: 960px) {
    .story-body-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .story-timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .story-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .step-bullet {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  :global([data-theme="dark"]) .step-bullet {
    background-color: #1A1A1A;
    border-color: var(--color-border);
    color: var(--color-text-primary);
  }

  .step-text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    padding-top: 0.25rem;
  }

  .story-fact-chips {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .fact-chip {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .fact-chip-dot {
    color: var(--color-text-muted);
    font-weight: bold;
    user-select: none;
  }

  .story-conclusion-card {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-inner);
    padding: 1.5rem 1.75rem;
    border-left: 3px solid #F7941D;
  }

  .conclusion-statement {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-primary);
    font-weight: 500;
    margin: 0;
  }

  /* Blueprint Graphic Stage */
  .blueprint-canvas {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-inner);
    border: 1px solid var(--color-border);
    padding: 2.25rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .blueprint-svg {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  /* 2. Mission, Purpose, Vision Section */
  .about-mission-section {
    padding: var(--section-spacing-desktop) 0;
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .about-mission-section {
      padding: var(--section-spacing-mobile) 0;
    }
  }

  .section-intro {
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .section-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 auto;
  }

  .mission-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .mission-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .mission-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s var(--ease-out-expo), box-shadow 0.25s ease;
  }

  .mission-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .mission-card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mission-eyebrow-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    display: inline-block;
  }

  .mission-card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .mission-card-body {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>