---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MediaAsset from '../components/MediaAsset.astro';
import CurvedArc from '../components/CurvedArc.astro';
import PegCube from '../components/PegCube.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Team from '../components/Team.astro';
import ContactSection from '../components/ContactSection.astro';
import OriginVisual from '../components/OriginVisual.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';

const { about } = siteConfig;
---

<BaseLayout
  title="About RHSP - Tech that adapts to business."
  description="We don't fit pegs. We shape them. Practical enterprise low-code on OutSystems, high-code MERN engineering, and sovereign AI."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. About Hero: H1 "Tech that adapts to business." Subline "We don't fit pegs. We shape them." -->
    <section class="about-hero-section" aria-labelledby="about-hero-heading">
      <CurvedArc variant="hero-sweep" class="about-hero-arc" />

      <div class="container about-hero-container">
        <div class="about-hero-content">
          <span class="eyebrow">ABOUT ROUND HOLE SQUARE PEG</span>
          <h1 id="about-hero-heading" class="about-hero-title">
            Tech that adapts to business.
          </h1>
          <p class="about-hero-subline">
            We don't fit pegs. We shape them.
          </p>
          <div class="about-hero-actions">
            <a href="#story" class="btn btn-primary">
              <span>Read our story</span>
              <Icon name="arrow-right" size={16} />
            </a>
            <a href="#peg" class="btn btn-secondary">
              <span>The PEG Method</span>
            </a>
          </div>
        </div>

        <div class="about-hero-fullwidth-media reveal-on-scroll">
          <div class="about-hero-image-frame card-mastercard">
            <MediaAsset
              assetKey={about.hero.imageKey || "about-hero"}
              alt="Round Hole Square Peg team and technical engineering leadership in Mumbai"
              aspectRatio="16/9"
              crop="rounded"
              focus={about.hero.focus}
              loading="eager"
              fetchpriority="high"
              theme="warm"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Our Story: Apollo 13 in 3 Short Lines + Original Minimal Line-Art Illustration -->
    <section id="story" class="about-story-section" aria-labelledby="story-heading">
      <div class="container">
        <div class="story-box-wrapper card-mastercard reveal-on-scroll">
          <div class="story-header">
            <span class="eyebrow">OUR ORIGIN</span>
            <h2 id="story-heading" class="story-title">
              The Apollo 13 imperative.
            </h2>
          </div>

          <div class="story-body-grid">
            <!-- Left: 3 Short Origin Lines -->
            <div class="story-lines-col">
              <div class="story-timeline" role="tablist" aria-label="Apollo 13 origin sequence steps">
                <button
                  type="button"
                  class="story-step-item is-active"
                  id="story-step-01"
                  role="tab"
                  aria-selected="true"
                  aria-current="step"
                  aria-controls="origin-visual-card"
                  data-step="1"
                >
                  <span class="step-bullet">01</span>
                  <p class="step-text">In April 1970, Apollo 13 suffered an oxygen tank explosion 200,000 miles from Earth.</p>
                </button>
                <button
                  type="button"
                  class="story-step-item"
                  id="story-step-02"
                  role="tab"
                  aria-selected="false"
                  aria-controls="origin-visual-card"
                  data-step="2"
                >
                  <span class="step-bullet">02</span>
                  <p class="step-text">NASA ground crew had to fit square lithium hydroxide canisters into round sockets using only materials on board.</p>
                </button>
                <button
                  type="button"
                  class="story-step-item"
                  id="story-step-03"
                  role="tab"
                  aria-selected="false"
                  aria-controls="origin-visual-card"
                  data-step="3"
                >
                  <span class="step-bullet">03</span>
                  <p class="step-text">They didn't force the socket. They engineered the adapter.</p>
                </button>
              </div>

              <!-- Fact Chips -->
              <div class="story-fact-chips">
                <span class="fact-chip">April 1970</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">200,000 miles from Earth</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">Only materials on board</span>
              </div>

              <div class="story-conclusion-card">
                <p class="conclusion-statement">
                  Round Hole Square Peg was founded on the exact same imperative: we don't force your enterprise to conform to rigid software - we engineer the adapter around your operational reality.
                </p>
              </div>
            </div>

            <!-- Right: Interactive 3-Step Origin Visual -->
            <div class="story-illustration-col">
              <OriginVisual />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Our Mandate: Built on lasting enterprise value -->
    <section id="mission" class="about-mission-section" aria-labelledby="mission-heading">
      <div class="container">
        <div class="section-intro text-center reveal-on-scroll">
          <span class="eyebrow">{about.mandate.badge}</span>
          <h2 id="mission-heading" class="section-title">{about.mandate.headline}</h2>
          <p class="section-subline">{about.mandate.subline}</p>
        </div>

        <div class="mission-cards-grid">
          {about.mandate.cards.map((card, index) => (
            <article
              class="mission-card card-mastercard reveal-on-scroll"
              style={`transition-delay: ${index * 80}ms;`}
            >
              <div class="mission-circle-avatar">
                <MediaAsset
                  assetKey={card.imageKey}
                  alt=""
                  crop="circle"
                  sizes="(min-width: 960px) 88px, 72px"
                  width={88}
                  height={88}
                  theme="warm"
                />
              </div>

              <div class="mission-card-content">
                <span class="mission-eyebrow-label">{card.label}</span>
                <h3 class="mission-card-title">{card.title}</h3>
                <p class="mission-card-body">{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. The PEG Method (#peg): Reusing the Real 3D CSS PEG Cube Component -->
    <div id="peg">
      <PegCube />
    </div>

    <!-- 5. How We Work (#how) + Find Your Fit (Horizontal Stepper & Black Result Card) -->
    <div class="about-approach-banner">
      <div class="container">
        <!-- Wide Feature Visual for Approach with One-Rounded-Corner Crop -->
        <div class="about-feature-wide-wrap reveal-on-scroll">
          <div class="about-feature-image-frame card-mastercard">
            <MediaAsset
              assetKey="about-approach"
              alt="RHSP engineering team collaborating on iterative agile architecture delivery"
              aspectRatio="16/9"
              crop="quarter"
              theme="navy"
            />
          </div>
        </div>
      </div>
    </div>

    <HowWeWork />

    <!-- 6. Leadership Team (#team) -->
    <Team />

    <!-- 7. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* About Hero */
  .about-hero-section {
    padding: calc(72px + 44px) 0 44px;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .about-hero-section {
      padding: calc(72px + 24px) 0 32px;
    }
  }

  .about-hero-arc {
    top: -10%;
    right: -10%;
    width: 60%;
    height: 90%;
    opacity: 0.55;
  }

  .about-hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .about-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
  }

  .about-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .about-hero-fullwidth-media {
    width: 100%;
    margin-top: 2rem;
  }

  .about-hero-image-frame {
    width: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
  }

  .about-feature-wide-wrap {
    width: 100%;
    margin-bottom: 0;
  }

  .about-feature-image-frame {
    width: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
  }

  .about-approach-banner {
    padding-top: 48px;
    background-color: var(--color-bg);
  }

  @media (max-width: 767px) {
    .about-approach-banner {
      padding-top: 32px;
    }
  }

  .about-hero-title {
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .about-hero-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin-bottom: 2.25rem;
    max-width: 44ch;
  }

  .about-hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .about-hero-media {
    width: 100%;
  }

  .about-image-frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-surface-alt);
    box-shadow: var(--shadow-card-hover);
  }

  /* Story Section */
  .about-story-section {
    padding: 56px 0;
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  @media (max-width: 767px) {
    .about-story-section {
      padding: 40px 0;
    }
  }

  .story-box-wrapper {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 3rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .story-box-wrapper {
      padding: 2rem 1.5rem;
    }
  }

  .story-header {
    margin-bottom: 2rem;
    max-width: 640px;
  }

  .story-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-top: -0.25rem;
  }

  .story-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 959px) {
    .story-illustration-col {
      order: -1;
      margin-bottom: 0.5rem;
    }
  }

  @media (min-width: 960px) {
    .story-body-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .story-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .story-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: transparent;
    border: none;
    text-align: left;
    padding: 0.5rem 0.75rem;
    margin-left: -0.75rem;
    border-radius: 14px;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    width: calc(100% + 1.5rem);
  }

  .story-step-item:hover {
    background-color: var(--color-surface-hover, rgba(0, 0, 0, 0.03));
  }

  .story-step-item:focus-visible {
    outline: 2px solid #1E4B8F;
    outline-offset: 2px;
  }

  .step-bullet {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .story-step-item.is-active .step-bullet {
    background-color: #1E4B8F;
    border-color: #1E4B8F;
    color: #FFFFFF;
  }

  :global([data-theme="dark"]) .story-step-item.is-active .step-bullet {
    background-color: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
  }

  .step-text {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: 0.35rem;
    opacity: 0.65;
    transition: color 0.25s ease, opacity 0.25s ease;
  }

  .story-step-item.is-active .step-text {
    color: var(--color-text-primary);
    font-weight: 500;
    opacity: 1;
  }

  /* Fact Chips */
  .story-fact-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    margin-bottom: 2rem;
  }

  .fact-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  :global([data-theme="dark"]) .fact-chip {
    background-color: #1A1A1A;
    border-color: var(--color-border);
    color: #D4D4D4;
  }

  .fact-chip-dot {
    color: var(--color-text-muted);
    font-size: 14px;
    user-select: none;
  }

  .story-conclusion-card {
    background-color: var(--color-surface-alt);
    border-left: 3px solid var(--rhsp-peg-start);
    padding: 1.5rem 2rem;
    border-radius: 12px;
  }

  .conclusion-statement {
    font-size: var(--fs-body);
    color: var(--color-text-primary);
    font-weight: 500;
    line-height: 1.6;
  }

  /* Mission / Mandate Section */
  .about-mission-section {
    padding: 56px 0;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  @media (max-width: 767px) {
    .about-mission-section {
      padding: 40px 0;
    }
  }

  .section-intro {
    max-width: 680px;
    margin: 0 auto 32px auto;
  }

  /* PEG Cube Spacing on About Page */
  #peg :global(.peg-section) {
    padding: 56px 0;
  }

  #peg :global(.peg-header) {
    margin-bottom: 2.5rem;
  }

  @media (max-width: 767px) {
    #peg :global(.peg-section) {
      padding: 40px 0;
    }
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .section-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0 auto;
  }

  .mission-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 960px) {
    .mission-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .mission-card {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    height: 100%;
    min-height: 0;
    transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo);
  }

  .mission-circle-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #F6F6F4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 767px) {
    .mission-circle-avatar {
      width: 72px;
      height: 72px;
    }
  }

  :global([data-theme="dark"]) .mission-circle-avatar {
    background-color: #1A1A1A;
  }

  .mission-circle-avatar :global(.media-asset-container) {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  .mission-circle-avatar :global(.media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .mission-card:hover .mission-circle-avatar :global(.media-img) {
    transform: scale(1.06);
  }

  .mission-card-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
  }

  .mission-eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #5B5B5B;
    line-height: 1.2;
    margin-bottom: 0.25rem;
    display: inline-block;
  }

  :global([data-theme="dark"]) .mission-eyebrow-label {
    color: #A0A0A0;
  }

  .mission-card-title {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0;
  }

  .mission-card-body {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 55ch;
    margin: 0;
  }
</style>
