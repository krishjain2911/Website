---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Team from '../components/Team.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';

const { about } = siteConfig;

const theoryCards = [
  {
    id: 'hole',
    step: '01',
    label: 'ROUND HOLE',
    title: 'The round hole — your challenge',
    text: 'Defined by your people, processes and data.',
    color: '#1E4B8F'
  },
  {
    id: 'adapter',
    step: '02',
    label: 'THE ADAPTER',
    title: 'The adapter — RHSP',
    text: 'The engineering that lets the two work together, with no compromise on either side.',
    color: '#F7941D'
  },
  {
    id: 'peg',
    step: '03',
    label: 'SQUARE PEG',
    title: 'The square peg — the solution',
    text: 'Powerful technology, built for the general case.',
    color: '#EE4B2B'
  }
];

// Helper to bold key phrases in mandate cards without mutating site.ts
function formatMandateText(text: string) {
  return text
    .replace(/\badapts\b/g, '<strong>adapts</strong>')
    .replace(/\blatent revenue\b/g, '<strong>latent revenue</strong>')
    .replace(/\bintelligent automation\b/g, '<strong>intelligent automation</strong>')
    .replace(/\btrusted technology partner\b/g, '<strong>trusted technology partner</strong>');
}
---

<BaseLayout
  title="The RHSP theory - About RHSP"
  description="RHSP stands for Round Hole Square Peg. Every business challenge is a round hole. Every powerful technology is a square peg. We engineer the adapter between them."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'About', item: '/about' }
  ]}
>
  <Nav />

  <!-- Desktop Sticky Pill Sub-Nav (Hidden below 900px) -->
  <nav class="about-sticky-subnav" id="about-sticky-subnav" aria-label="About page sections">
    <div class="subnav-pill-container">
      <a href="#theory" class="subnav-link is-active" data-section="theory">Theory</a>
      <span class="subnav-sep" aria-hidden="true">·</span>
      <a href="#story" class="subnav-link" data-section="story">Origin</a>
      <span class="subnav-sep" aria-hidden="true">·</span>
      <a href="#mission" class="subnav-link" data-section="mission">Mission</a>
      <span class="subnav-sep" aria-hidden="true">·</span>
      <a href="#team" class="subnav-link" data-section="team">Leadership</a>
    </div>
  </nav>

  <main id="main-content" class="about-page-main" tabindex="-1">
    <!-- 1. Theory Hero + 3 Theory Cards (Single Fit-to-Screen Section) -->
    <section id="theory" class="about-fullscreen-section theory-section" aria-labelledby="hero-heading" data-layout="about-section">
      <div class="container fullscreen-container">
        <div class="hero-two-col-grid">
          <!-- Left Column: Eyebrow, H1, Expandable Definition Pill, Subline -->
          <div class="hero-text-col reveal-on-scroll">
            <span class="eyebrow">THE RHSP THEORY</span>
            <h1 id="hero-heading" class="hero-heading">The RHSP theory.</h1>

            <!-- Expandable Definition Pill (R · H · S · P expands on hover/focus) -->
            <div class="definition-chip-wrap">
              <button
                type="button"
                class="rhsp-expandable-pill"
                id="rhsp-expandable-pill"
                aria-expanded="false"
                aria-label="RHSP stands for Round Hole Square Peg"
              >
                <span class="sr-only">RHSP stands for Round Hole Square Peg.</span>
                <span class="pill-track" aria-hidden="true">
                  <span class="pill-chunk" data-letter="R">
                    <span class="chunk-letter letter-r">R</span><span class="chunk-word">ound</span>
                  </span>
                  <span class="pill-dot">·</span>
                  <span class="pill-chunk" data-letter="H">
                    <span class="chunk-letter letter-h">H</span><span class="chunk-word">ole</span>
                  </span>
                  <span class="pill-dot">·</span>
                  <span class="pill-chunk" data-letter="S">
                    <span class="chunk-letter letter-s">S</span><span class="chunk-word">quare</span>
                  </span>
                  <span class="pill-dot">·</span>
                  <span class="pill-chunk" data-letter="P">
                    <span class="chunk-letter letter-p">P</span><span class="chunk-word">eg</span>
                  </span>
                </span>
                <span class="pill-hint" aria-hidden="true">
                  <Icon name="chevron-right" size={12} class="pill-hint-icon" />
                </span>
              </button>
              <!-- Static text maintained in DOM for search engines and assistive technology -->
              <span class="definition-fallback-text sr-only">RHSP stands for Round Hole Square Peg.</span>
            </div>

            <p class="hero-subline">
              Every business challenge is a round hole. Every powerful technology is a square peg. We engineer the adapter between them.
            </p>
          </div>

          <!-- Right Column: Interactive 3-Beat Animated SVG Diagram -->
          <div class="hero-diagram-col reveal-on-scroll" style="transition-delay: 80ms;">
            <div class="diagram-surface card-mastercard" id="theory-diagram-wrapper" data-beat="1">
              <!-- Replay & Beat Indicator Header -->
              <div class="diagram-top-bar">
                <div class="diagram-beat-pills" role="status" aria-live="polite">
                  <span class="beat-pill" data-beat-target="1">1. Challenge</span>
                  <span class="beat-pill" data-beat-target="2">2. Adapter</span>
                  <span class="beat-pill" data-beat-target="3">3. Solution</span>
                </div>
                <button type="button" class="diagram-replay-btn" id="diagram-replay-btn" aria-label="Replay animation">
                  <Icon name="rotate-ccw" size={13} />
                  <span>Replay</span>
                </button>
              </div>

              <!-- Full-Panel Animated SVG Diagram -->
              <div class="svg-container">
                <svg
                  viewBox="0 0 560 320"
                  fill="none"
                  class="theory-interactive-svg"
                  id="theory-interactive-svg"
                  xmlns="http://www.w3.org/2000/svg"
                  role="img"
                  aria-label="Interactive RHSP animation: A square peg approaches a round hole, bumps its corners, the RHSP adapter ring slides in between, and the peg glides seamlessly through with zero compromise."
                >
                  <defs>
                    <!-- Socket Glow Gradient -->
                    <radialGradient id="socketGlowGrad" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#1E4B8F" stop-opacity="0.35" />
                      <stop offset="70%" stop-color="#1E4B8F" stop-opacity="0.08" />
                      <stop offset="100%" stop-color="#1E4B8F" stop-opacity="0" />
                    </radialGradient>
                    <!-- Adapter Glow Gradient -->
                    <radialGradient id="adapterGlowGrad" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#F7941D" stop-opacity="0.3" />
                      <stop offset="100%" stop-color="#F7941D" stop-opacity="0" />
                    </radialGradient>
                    <!-- Grid Pattern -->
                    <pattern id="diagGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--color-border)" stroke-width="0.5" stroke-opacity="0.4" />
                    </pattern>
                  </defs>

                  <!-- Technical Blueprint Background Grid -->
                  <rect width="560" height="320" fill="url(#diagGrid)" opacity="0.6" />

                  <!-- Center Guideline Axis -->
                  <line x1="40" y1="150" x2="520" y2="150" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4 4" />

                  <!-- COMPONENT 1: ROUND HOLE (SOCKET) -->
                  <g class="diagram-group group-hole" id="svg-group-hole" transform="translate(140, 150)">
                    <circle cx="0" cy="0" r="76" class="hole-ambient-glow" fill="url(#socketGlowGrad)" />
                    <circle cx="0" cy="0" r="56" class="hole-outer-ring" stroke="#1E4B8F" stroke-width="2.5" fill="rgba(30, 75, 143, 0.04)" />
                    <circle cx="0" cy="0" r="42" class="hole-inner-ring" stroke="#1E4B8F" stroke-width="1.5" stroke-dasharray="5 4" fill="none" />
                    <!-- Crosshair Ticks -->
                    <line x1="-62" y1="0" x2="-48" y2="0" stroke="#1E4B8F" stroke-width="2" />
                    <line x1="48" y1="0" x2="62" y2="0" stroke="#1E4B8F" stroke-width="2" />
                    <line x1="0" y1="-62" x2="0" y2="-48" stroke="#1E4B8F" stroke-width="2" />
                    <line x1="0" y1="48" x2="0" y2="62" stroke="#1E4B8F" stroke-width="2" />

                    <!-- Labels (>= 13px) -->
                    <text y="-76" class="diagram-svg-label label-hole-title" text-anchor="middle">ROUND HOLE</text>
                    <text y="92" class="diagram-svg-sublabel" text-anchor="middle">Your challenge</text>
                  </g>

                  <!-- COMPONENT 2: THE ADAPTER RING (RHSP) -->
                  <g class="diagram-group group-adapter" id="svg-group-adapter" transform="translate(260, 150)">
                    <circle cx="0" cy="0" r="64" class="adapter-ambient-glow" fill="url(#adapterGlowGrad)" opacity="0" />
                    <!-- Adapter Outer Profile: Round -->
                    <circle cx="0" cy="0" r="54" class="adapter-outer" stroke="#F7941D" stroke-width="2.5" fill="rgba(247, 148, 29, 0.08)" />
                    <!-- Adapter Inner Profile: Square Cutout -->
                    <rect x="-35" y="-35" width="70" height="70" rx="4" class="adapter-inner" stroke="#F7941D" stroke-width="2" stroke-dasharray="4 3" fill="none" />
                    <!-- Technical Corner Bevels -->
                    <path d="M -35 -20 L -35 -35 L -20 -35" stroke="#F7941D" stroke-width="2" fill="none" />
                    <path d="M 20 -35 L 35 -35 L 35 -20" stroke="#F7941D" stroke-width="2" fill="none" />
                    <path d="M 35 20 L 35 35 L 20 35" stroke="#F7941D" stroke-width="2" fill="none" />
                    <path d="M -20 35 L -35 35 L -35 20" stroke="#F7941D" stroke-width="2" fill="none" />

                    <!-- Labels (>= 13px) -->
                    <text y="-76" class="diagram-svg-label label-adapter-title" text-anchor="middle">RHSP ADAPTER</text>
                    <text y="92" class="diagram-svg-sublabel" text-anchor="middle">The engineered interface</text>
                  </g>

                  <!-- COMPONENT 3: SQUARE PEG (SOLUTION) -->
                  <g class="diagram-group group-peg" id="svg-group-peg" transform="translate(420, 150)">
                    <!-- Square Peg Body -->
                    <rect x="-35" y="-35" width="70" height="70" rx="4" class="peg-rect" stroke="#EE4B2B" stroke-width="2.5" fill="rgba(238, 75, 43, 0.08)" />
                    <!-- Center Core -->
                    <circle cx="0" cy="0" r="14" stroke="#EE4B2B" stroke-width="1.5" stroke-dasharray="3 2" fill="none" />
                    <line x1="-8" y1="0" x2="8" y2="0" stroke="#EE4B2B" stroke-width="1.5" />
                    <line x1="0" y1="-8" x2="0" y2="8" stroke="#EE4B2B" stroke-width="1.5" />

                    <!-- Corner Clash Indicators (shown in Beat 1) -->
                    <g class="peg-clash-marks">
                      <circle cx="-35" cy="-35" r="4" fill="#EE4B2B" class="clash-dot" />
                      <circle cx="35" cy="-35" r="4" fill="#EE4B2B" class="clash-dot" />
                      <circle cx="35" cy="35" r="4" fill="#EE4B2B" class="clash-dot" />
                      <circle cx="-35" cy="35" r="4" fill="#EE4B2B" class="clash-dot" />
                    </g>

                    <!-- Labels (>= 13px) -->
                    <text y="-76" class="diagram-svg-label label-peg-title" text-anchor="middle">SQUARE PEG</text>
                    <text y="92" class="diagram-svg-sublabel" text-anchor="middle">The technology solution</text>
                  </g>

                  <!-- Bottom Measurement Baseline with Coordinate Marks -->
                  <line x1="60" y1="285" x2="500" y2="285" stroke="var(--color-border)" stroke-width="1" />
                  <circle cx="140" cy="285" r="3" fill="#1E4B8F" />
                  <circle cx="260" cy="285" r="3" fill="#F7941D" />
                  <circle cx="420" cy="285" r="3" fill="#EE4B2B" />
                  <text x="280" y="305" font-family="var(--font-sans)" font-size="11" font-weight="600" letter-spacing="0.08em" text-transform="uppercase" fill="var(--color-text-muted)" text-anchor="middle">
                    Technical Architecture Interface · Apollo Principle
                  </text>
                </svg>
              </div>

              <!-- Narrative Beat Caption Bar -->
              <div class="diagram-caption-footer">
                <span class="caption-tag">Narrative</span>
                <p class="caption-text" id="diagram-caption-text">
                  Beat 1: The square peg approaches the round hole — its corners clash with the socket boundary.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Three Theory Cards in Equal-Height Row -->
        <div class="three-col-cards-grid theory-cards-row">
          {theoryCards.map((card, idx) => (
            <article
              class="theory-card card-mastercard reveal-on-scroll"
              id={`theory-card-${card.id}`}
              data-card-id={card.id}
              tabindex="0"
              role="region"
              aria-label={card.title}
              style={`transition-delay: ${idx * 60}ms; border-top: 3px solid ${card.color};`}
            >
              <div class="theory-card-header">
                <span class="theory-card-step" style={`color: ${card.color};`}>
                  {card.step} / {card.label}
                </span>
                <h2 class="theory-card-title">{card.title}</h2>
              </div>
              <p class="theory-card-copy">{card.text}</p>
              <div class="theory-card-link-cue">
                <span style={`color: ${card.color};`}>Highlight in architecture &rarr;</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. Our Origin: The Apollo 13 Imperative (Restored Master Boxed Section) -->
    <section id="story" class="about-fullscreen-section story-section" aria-labelledby="story-heading" data-layout="about-section">
      <div class="container fullscreen-container">
        <div class="story-box-wrapper card-mastercard reveal-on-scroll">
          <div class="story-header">
            <span class="eyebrow">OUR ORIGIN</span>
            <h2 id="story-heading" class="story-title">
              The Apollo 13 imperative.
            </h2>
          </div>

          <div class="story-body-grid">
            <!-- Left: 3 Numbered Steps + Fact Chips + Quote Card -->
            <div class="story-lines-col">
              <ol class="story-timeline" aria-label="Apollo 13 origin sequence steps">
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">01</span>
                  <p class="step-text">
                    In April 1970, Apollo 13 suffered an oxygen tank explosion 200,000 miles from Earth.
                  </p>
                </li>
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">02</span>
                  <p class="step-text">
                    NASA engineers had to connect square lithium hydroxide canisters to round sockets using only what was on board.
                  </p>
                </li>
                <li class="story-step-item">
                  <span class="step-bullet" aria-hidden="true">03</span>
                  <p class="step-text">
                    They engineered the adapter using only what was on board.
                  </p>
                </li>
              </ol>

              <!-- Fact Chips -->
              <div class="story-fact-chips">
                <span class="fact-chip">April 1970</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">200,000 miles from Earth</span>
                <span class="fact-chip-dot" aria-hidden="true">·</span>
                <span class="fact-chip">Only materials on board</span>
              </div>

              <!-- Quote Card -->
              <div class="story-conclusion-card">
                <p class="conclusion-statement">
                  Round Hole Square Peg is built on the same principle: understand the challenge, then engineer the adapter to the solution.
                </p>
              </div>
            </div>

            <!-- Right: Apollo 13 Imperative Image Illustration -->
            <div class="story-illustration-col">
              <div class="blueprint-canvas">
                <img
                  src="/media/raw/aboutus.png"
                  alt="Apollo 13 imperative: Connecting square lithium hydroxide canisters to round sockets using an engineered adapter"
                  class="apollo-story-image"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Mission · Purpose · Vision -->
    <section id="mission" class="about-fullscreen-section mission-section" aria-labelledby="mission-heading" data-layout="about-section">
      <div class="container fullscreen-container">
        <div class="section-header reveal-on-scroll">
          <span class="eyebrow">{about.mandate.badge}</span>
          <h2 id="mission-heading" class="section-title">{about.mandate.headline}</h2>
          <p class="section-subline">{about.mandate.subline}</p>
        </div>

        <div class="three-col-cards-grid">
          {about.mandate.cards.map((card, index) => {
            const colors = ['#1E4B8F', '#F7941D', '#EE4B2B'];
            const color = colors[index % colors.length];
            return (
              <article
                class="mandate-card card-mastercard reveal-on-scroll"
                style={`transition-delay: ${index * 60}ms; border-top: 3px solid ${color};`}
              >
                <div class="mandate-card-header">
                  <span class="mandate-card-step" style={`color: ${color};`}>
                    0{index + 1} / {card.title.toUpperCase()}
                  </span>
                  <h3 class="mandate-card-title">{card.title}</h3>
                </div>
                <p class="mandate-card-copy" set:html={formatMandateText(card.text)} />
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 5. Leadership Team -->
    <Team />

    <!-- 6. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* -------------------------------------------------------------
     Sticky Sub-Nav (Desktop >= 900px)
     ------------------------------------------------------------- */
  .about-sticky-subnav {
    position: sticky;
    top: calc(var(--nav-height, 72px) + 8px);
    z-index: 50;
    display: flex;
    justify-content: center;
    pointer-events: none;
    margin-bottom: -46px; /* Let hero flow beneath gracefully */
  }

  .subnav-pill-container {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
    pointer-events: auto;
  }

  :global(.dark) .subnav-pill-container {
    background: var(--color-surface-raised);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .subnav-link {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .subnav-link:hover,
  .subnav-link.is-active {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .subnav-sep {
    color: var(--color-border-strong);
    font-size: var(--fs-xs);
  }

  @media (max-width: 899px) {
    .about-sticky-subnav {
      display: none;
    }
  }

  /* -------------------------------------------------------------
     Theory Hero Section
     ------------------------------------------------------------- */
  .about-hero-section {
    padding-top: calc(72px + var(--section-spacing-desktop, 80px));
    padding-bottom: var(--section-spacing-desktop, 80px);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 100px;
  }

  @media (max-width: 767px) {
    .about-hero-section {
      padding-top: calc(64px + var(--section-spacing-mobile, 48px));
      padding-bottom: var(--section-spacing-mobile, 48px);
      scroll-margin-top: 80px;
    }
  }

  .hero-two-col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-two-col-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .hero-heading {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0.25rem 0 1.25rem 0;
    color: var(--color-text-primary);
  }

  .hero-subline {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 580px;
  }

  /* -------------------------------------------------------------
     Expandable Definition Pill (R · H · S · P)
     ------------------------------------------------------------- */
  .definition-chip-wrap {
    margin-bottom: 1.5rem;
  }

  .rhsp-expandable-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rhsp-expandable-pill:hover,
  .rhsp-expandable-pill:focus-visible,
  .rhsp-expandable-pill.is-expanded {
    background-color: var(--color-surface-raised);
    border-color: var(--color-border-strong);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .pill-track {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pill-chunk {
    display: inline-flex;
    align-items: baseline;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .chunk-letter {
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .letter-r { color: #1E4B8F; }
  .letter-h { color: #1E4B8F; }
  .letter-s { color: #F7941D; }
  .letter-p { color: #EE4B2B; }

  :global(.dark) .letter-r,
  :global(.dark) .letter-h {
    color: #5B8FE0;
  }

  .chunk-word {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-text-secondary);
    font-weight: 600;
    transition: max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, margin 0.2s ease;
  }

  .rhsp-expandable-pill:hover .chunk-word,
  .rhsp-expandable-pill:focus-visible .chunk-word,
  .rhsp-expandable-pill.is-expanded .chunk-word {
    max-width: 60px;
    opacity: 1;
    margin-left: 1px;
  }

  .pill-dot {
    color: var(--color-border-strong);
    font-weight: 700;
  }

  .pill-hint {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .rhsp-expandable-pill:hover .pill-hint,
  .rhsp-expandable-pill.is-expanded .pill-hint {
    transform: rotate(90deg);
  }

  /* -------------------------------------------------------------
     Diagram Surface & Interactive 3-Beat SVG
     ------------------------------------------------------------- */
  .diagram-surface {
    position: relative;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    padding: 1.25rem 1.25rem 1rem 1.25rem;
    box-shadow: var(--shadow-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  :global(.dark) .diagram-surface {
    background: var(--color-surface-raised);
  }

  .diagram-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .diagram-beat-pills {
    display: flex;
    gap: 0.35rem;
  }

  .beat-pill {
