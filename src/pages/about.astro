<script>
  function initAboutInteractions() {
    // 1. Definition Pill Expansion
    const pillBtn = document.getElementById('rhsp-expandable-pill');
    if (pillBtn) {
      pillBtn.addEventListener('click', () => {
        const isExpanded = pillBtn.getAttribute('aria-expanded') === 'true';
        pillBtn.setAttribute('aria-expanded', String(!isExpanded));
        pillBtn.classList.toggle('is-expanded', !isExpanded);
      });
    }

    // 2. Interactive SVG 3-Beat Diagram
    const diagramWrapper = document.getElementById('theory-diagram-wrapper');
    const replayBtn = document.getElementById('diagram-replay-btn');
    const captionEl = document.getElementById('diagram-caption-text');
    const beatPills = Array.from(document.querySelectorAll<HTMLElement>('.beat-pill'));

    const captions: Record<number, string> = {
      1: 'Beat 1: The square peg approaches the round hole — its corners clash with the socket boundary.',
      2: 'Beat 2: The RHSP adapter ring slides into position between the socket and peg.',
      3: 'Beat 3: The square peg glides smoothly through the adapter into the round hole — zero compromise.'
    };

    let animTimer: number | null = null;
    let isPausedByHover = false;

    function setBeat(beat: number) {
      if (!diagramWrapper) return;
      diagramWrapper.setAttribute('data-beat', String(beat));
      if (captionEl && captions[beat]) {
        captionEl.textContent = captions[beat];
      }
    }

    function runSequence() {
      if (isPausedByHover) return;
      setBeat(1);
      animTimer = window.setTimeout(() => {
        if (isPausedByHover) return;
        setBeat(2);
        animTimer = window.setTimeout(() => {
          if (isPausedByHover) return;
          setBeat(3);
        }, 1800);
      }, 1600);
    }

    // IntersectionObserver to auto-play when diagram enters view
    if (diagramWrapper && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          runSequence();
          io.disconnect();
        }
      }, { threshold: 0.35 });
      io.observe(diagramWrapper);
    } else {
      runSequence();
    }

    // Replay button
    replayBtn?.addEventListener('click', () => {
      if (animTimer) clearTimeout(animTimer);
      isPausedByHover = false;
      runSequence();
    });

    // Beat indicator pill clicks
    beatPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetBeat = Number(pill.getAttribute('data-beat-target') || '1');
        if (animTimer) clearTimeout(animTimer);
        setBeat(targetBeat);
      });
    });

    // 3. Linked Interaction: Hovering Theory Cards
    const cards = [
      { id: 'hole', beat: 1, class: 'is-hover-hole' },
      { id: 'adapter', beat: 2, class: 'is-hover-adapter' },
      { id: 'peg', beat: 3, class: 'is-hover-peg' }
    ];

    cards.forEach(({ id, beat, class: cls }) => {
      const cardEl = document.getElementById(`theory-card-${id}`);
      if (!cardEl || !diagramWrapper) return;

      const onEnter = () => {
        isPausedByHover = true;
        if (animTimer) clearTimeout(animTimer);
        diagramWrapper.classList.add(cls);
        setBeat(beat);
      };

      const onLeave = () => {
        diagramWrapper.classList.remove(cls);
        isPausedByHover = false;
        // Settle smoothly to completed beat 3
        setBeat(3);
      };

      cardEl.addEventListener('mouseenter', onEnter);
      cardEl.addEventListener('mouseleave', onLeave);
      cardEl.addEventListener('focusin', onEnter);
      cardEl.addEventListener('focusout', onLeave);
    });

    // 4. Sticky Pill Sub-Nav Scroll-Spy
    const subnavLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.about-sticky-subnav .subnav-link'));
    const sectionIds = ['theory', 'story', 'mission', 'team'];

    function updateSubnav() {
      const scrollPos = window.scrollY + 140;
      for (let i = sectionIds.length - 1; i >= 0; i--) {
        const sec = document.getElementById(sectionIds[i]);
        if (sec && sec.offsetTop <= scrollPos) {
          subnavLinks.forEach((link) => {
            const match = link.getAttribute('data-section') === sectionIds[i];
            link.classList.toggle('is-active', match);
          });
          break;
        }
      }
    }

    window.addEventListener('scroll', updateSubnav, { passive: true });
    updateSubnav();
  }

  initAboutInteractions();
  document.addEventListener('astro:after-swap', initAboutInteractions);
</script>
