  }

  .mandate-card-step {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .mandate-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
  }

  .mandate-card-copy {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Reduced motion: Jump instead of smooth transition */
  @media (prefers-reduced-motion: reduce) {
    .diagram-group,
    .clash-dot,
    .theory-row-card {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  function initAboutInteractions() {
    // 1. Definition pill toggle
    const defBtn = document.getElementById('rhsp-expandable-pill');
    if (defBtn) {
      defBtn.addEventListener('click', () => {
        const isExp = defBtn.classList.toggle('is-expanded');
        defBtn.setAttribute('aria-expanded', isExp ? 'true' : 'false');
      });
    }

    // 2. Interactive SVG Diagram beats
    const diagramWrapper = document.getElementById('theory-diagram-wrapper');
    const captionText = document.getElementById('diagram-caption-text');
    const beatPills = Array.from(document.querySelectorAll<HTMLElement>('.diagram-beat-pills .beat-pill'));
    const replayBtn = document.getElementById('diagram-replay-btn');

    const captions = [
      'The square peg meets the round hole. Its corners clash with the socket.',
      'The RHSP adapter maps every edge of the peg onto the circle.',
      'The peg sits inside the hole through the adapter. No compromise on either side.'
    ];

    // ---- Diagram animation: peg slides, six lines map square edges to the circle ----
    const dSvg = document.getElementById('theory-interactive-svg');
    const dPeg = document.getElementById('d-peg');
    const dLines = Array.from(document.querySelectorAll<SVGPathElement>('.d-line'));
    const dNodes = Array.from(document.querySelectorAll<SVGCircleElement>('.d-node'));
    const HOLE = { x: 420, y: 140 };
    const dHole = document.getElementById('d-hole');
    const RADIUS = 62;
    const PEG_START = 120;
    // anchor on the square (x, y, outward normal x, y), then target angle on the circle (left arc, then radial)
    const ANCHORS = [[-14, -38, 0, -1], [14, -38, 0, -1], [38, -14, 1, 0], [38, 14, 1, 0], [14, 38, 0, 1], [-14, 38, 0, 1]];
    const ANG_ARC = [240, 216, 192, 168, 144, 120];
    const ANG_RADIAL = [250, 290, 340, 380, 430, 470];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dState = { pegX: PEG_START, holeX: HOLE.x, draw: 0, merge: 0 };
    const dTargets = [
      { pegX: PEG_START, holeX: HOLE.x, draw: 0, merge: 0 },
      { pegX: PEG_START, holeX: HOLE.x, draw: 1, merge: 0 },
      { pegX: 280, holeX: 280, draw: 1, merge: 1 }
    ];
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    let dRaf = 0;

    function renderDiagram() {
      if (!dPeg) return;
      dPeg.setAttribute('transform', `translate(${dState.pegX.toFixed(1)}, ${HOLE.y})`);
      dHole?.setAttribute('transform', `translate(${dState.holeX.toFixed(1)}, ${HOLE.y})`);
      const m = ease(dState.merge);
      dLines.forEach((ln, i) => {
        const [ax, ay, nx, ny] = ANCHORS[i];
        const sx = dState.pegX + ax;
        const sy = HOLE.y + ay;
        const th = ((ANG_ARC[i] + (ANG_RADIAL[i] - ANG_ARC[i]) * m) * Math.PI) / 180;
        const ex = dState.holeX + RADIUS * Math.cos(th);
        const ey = HOLE.y + RADIUS * Math.sin(th);
        const k = Math.min(Math.hypot(ex - sx, ey - sy) * 0.45, 90);
        ln.setAttribute(
          'd',
          `M${sx.toFixed(1)},${sy.toFixed(1)} C${(sx + nx * k).toFixed(1)},${(sy + ny * k).toFixed(1)} ${(ex + (sx - ex) * 0.35).toFixed(1)},${(ey + (sy - ey) * 0.35).toFixed(1)} ${ex.toFixed(1)},${ey.toFixed(1)}`
        );
        const len = ln.getTotalLength();
        const p = clamp01(dState.draw * 1.6 - i * 0.12);
        ln.style.strokeDasharray = `${len}`;
        ln.style.strokeDashoffset = `${len * (1 - p)}`;
        const node = dNodes[i];
        if (node) {
          node.setAttribute('cx', ex.toFixed(1));
          node.setAttribute('cy', ey.toFixed(1));
          node.style.opacity = `${clamp01((p - 0.85) / 0.15)}`;
        }
      });
    }

    function animateDiagram(beatNum: number) {
      const to = dTargets[beatNum - 1] || dTargets[2];
      cancelAnimationFrame(dRaf);
      if (reduceMotion) {
        Object.assign(dState, to);
        renderDiagram();
        return;
      }
      const from = { ...dState };
      const t0 = performance.now();
      const dur = 1100;
      const step = (now: number) => {
        const t = clamp01((now - t0) / dur);
        const e = ease(t);
        dState.pegX = from.pegX + (to.pegX - from.pegX) * e;
        dState.holeX = from.holeX + (to.holeX - from.holeX) * e;
        dState.draw = from.draw + (to.draw - from.draw) * t;
        dState.merge = from.merge + (to.merge - from.merge) * t;
        renderDiagram();
        if (t < 1) dRaf = requestAnimationFrame(step);
      };
      dRaf = requestAnimationFrame(step);
    }

    function setBeat(beatNum: number) {
      if (!diagramWrapper) return;
      diagramWrapper.setAttribute('data-beat', String(beatNum));

      beatPills.forEach((p) => {
        const pBeat = Number(p.getAttribute('data-beat-target'));
        const isActive = pBeat === beatNum;
        p.classList.toggle('is-active', isActive);
        p.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      if (captionText) {
        captionText.textContent = captions[beatNum - 1] || captions[2];
      }
      animateDiagram(beatNum);
    }

    renderDiagram();
    // Play 1 -> 2 -> 3 once when the diagram scrolls into view
    if (dSvg && 'IntersectionObserver' in window) {
      let played = false;
      new IntersectionObserver((entries, obs) => {
        if (played || !entries[0]?.isIntersecting) return;
        played = true;
        obs.disconnect();
        setTimeout(() => setBeat(2), 900);
        setTimeout(() => setBeat(3), 2600);
      }, { threshold: 0.5 }).observe(dSvg);
    }

    // Auto-advance / Replay flow
    replayBtn?.addEventListener('click', () => {
      setBeat(1);
      setTimeout(() => {
        setBeat(2);
        setTimeout(() => {
          setBeat(3);
        }, 1700);
      }, 1500);
    });

    // Beat indicator pill clicks
    beatPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetBeat = Number(pill.getAttribute('data-beat-target') || '1');
        setBeat(targetBeat);
      });
    });

    // 3. Highlight in architecture links on cards & timeline steps
    const highlightBtns = Array.from(document.querySelectorAll<HTMLElement>('.theory-card-link-btn'));
    highlightBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetBeat = Number(btn.getAttribute('data-beat-target') || '1');
        setBeat(targetBeat);
        document.getElementById('apollo-block')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    const timelineItems = Array.from(document.querySelectorAll<HTMLElement>('.apollo-timeline-item'));
    timelineItems.forEach((item) => {
      item.addEventListener('click', () => {
        const targetBeat = Number(item.getAttribute('data-beat-target') || '1');
        setBeat(targetBeat);
        timelineItems.forEach((ti) => ti.classList.toggle('is-selected', ti === item));
      });
    });

    // Hover cards highlight diagram beat
    const cards = [
      { id: 'hole', beat: 1 },
      { id: 'adapter', beat: 2 },
      { id: 'peg', beat: 3 }
    ];

    cards.forEach(({ id, beat }) => {
      const cardEl = document.getElementById(`theory-card-${id}`);
      if (!cardEl) return;

      cardEl.addEventListener('mouseenter', () => setBeat(beat));
      cardEl.addEventListener('focusin', () => setBeat(beat));
    });

    // 4. Sticky Pill Sub-Nav Scroll-Spy
    const subnavLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.about-sticky-subnav .subnav-link'));
    const sectionIds = ['theory-hero', 'mission', 'team'];

    function updateSubnav() {
      const scrollPos = window.scrollY + 140;
      for (let i = sectionIds.length - 1; i >= 0; i--) {
        const sec = document.getElementById(sectionIds[i]);
        if (sec && sec.offsetTop <= scrollPos) {
          subnavLinks.forEach((link) => {
            const match = link.getAttribute('data-section') === sectionIds[i];
            link.classList.toggle('is-active', match);
          });
          break;
        }
      }
    }

    window.addEventListener('scroll', updateSubnav, { passive: true });
    updateSubnav();
  }

  initAboutInteractions();
  document.addEventListener('astro:after-swap', initAboutInteractions);
</script>
