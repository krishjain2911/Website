  }

  /* Mission Section */
  .mission-section {
    padding: var(--section-spacing-desktop, 80px) 0;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
