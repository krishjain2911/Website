---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MediaAsset from '../components/MediaAsset.astro';
import CurvedArc from '../components/CurvedArc.astro';
import PegCube from '../components/PegCube.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Team from '../components/Team.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';

const { about, pegMethod } = siteConfig;

const missionCards = [
  {
    title: 'Mission',
    text: 'We deploy Technology that adapts to your unique business process unlocking latent revenue.',
    imageKey: 'about/mission-circle',
    tag: null
  },
  {
    title: 'Purpose',
    text: 'To empower clients through intelligent automation that simplifies operations, reduces manual effort, and delivers clear, measurable business value.',
    imageKey: 'about/purpose-circle',
    tag: null
  },
  {
    title: 'Vision',
    text: "To be the trusted partner for India's medium-scale companies by delivering practical, intelligent automation solutions that enhance operational efficiency, reduce costs, and drive sustainable growth - making advanced AI technology accessible and impactful across the MSME landscape.",
    imageKey: 'about/vision-circle',
    tag: '[TO CONFIRM]'
  }
];
---

<BaseLayout
  title="About RHSP - Tech that adapts to business."
  description="We don't fit pegs. We shape them. Practical enterprise low-code on OutSystems, high-code MERN engineering, and sovereign AI."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <!-- 1. About Hero: H1 "Tech that adapts to business." Subline "We don't fit pegs. We shape them." -->
    <section class="about-hero-section" aria-labelledby="about-hero-heading">
      <CurvedArc variant="hero-sweep" class="about-hero-arc" />

      <div class="container about-hero-container">
        <div class="about-hero-content">
          <span class="eyebrow">ABOUT ROUND HOLE SQUARE PEG</span>
          <h1 id="about-hero-heading" class="about-hero-title">
            Tech that adapts to business.
          </h1>
          <p class="about-hero-subline">
            We don't fit pegs. We shape them.
          </p>
          <div class="about-hero-actions">
            <a href="#story" class="btn btn-primary">
              <span>Read our story</span>
              <Icon name="arrow-right" size={16} />
            </a>
            <a href="#peg" class="btn btn-secondary">
              <span>The PEG Method</span>
            </a>
          </div>
        </div>

        <div class="about-hero-media">
          <div class="about-image-frame card-mastercard">
            <MediaAsset
              assetKey="about/hero-team"
              alt="RHSP technical architects at work"
              aspectRatio="16/10"
              crop="quarter"
              theme="warm"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Our Story: Apollo 13 in 3 Short Lines + Original Minimal Line-Art Illustration -->
    <section id="story" class="about-story-section" aria-labelledby="story-heading">
      <div class="container">
        <div class="story-box-wrapper card-mastercard reveal-on-scroll">
          <div class="story-header">
            <span class="eyebrow">OUR ORIGIN</span>
            <h2 id="story-heading" class="story-title">
              The Apollo 13 imperative.
            </h2>
          </div>

          <div class="story-body-grid">
            <!-- Left: 3 Short Origin Lines -->
            <div class="story-lines-col">
              <div class="story-timeline">
                <div class="story-step-item">
                  <div class="step-bullet">01</div>
                  <p class="step-text">In April 1970, Apollo 13 suffered an oxygen tank explosion 200,000 miles from Earth.</p>
                </div>
                <div class="story-step-item">
                  <div class="step-bullet">02</div>
                  <p class="step-text">NASA ground crew had to fit square lithium hydroxide canisters into round sockets using only materials on board.</p>
                </div>
                <div class="story-step-item">
                  <div class="step-bullet">03</div>
                  <p class="step-text">They didn't force the socket. They engineered the adapter.</p>
                </div>
              </div>

              <div class="story-conclusion-card">
                <p class="conclusion-statement">
                  Round Hole Square Peg was founded on the exact same imperative: we don't force your enterprise to conform to rigid software - we engineer the adapter around your operational reality.
                </p>
              </div>
            </div>

            <!-- Right: Original Minimal Line-Art Illustration (No NASA marks) -->
            <div class="story-illustration-col">
              <div class="blueprint-canvas">
                <svg
                  viewBox="0 0 320 280"
                  fill="none"
                  class="blueprint-svg"
                  role="img"
                  aria-label="Original technical line illustration of square canister to round socket adapter"
                >
                  <!-- Left: Square Scrubber Silhouette -->
                  <rect x="30" y="70" width="70" height="110" rx="4" stroke="#EE4B2B" stroke-width="1.75" stroke-dasharray="3 3" />
                  <text x="65" y="130" font-family="sans-serif" font-weight="600" font-size="9" fill="#EE4B2B" text-anchor="middle">SQUARE PEG</text>
                  <text x="65" y="145" font-family="sans-serif" font-size="8" fill="#5B5B5B" text-anchor="middle">BUSINESS REALITY</text>

                  <!-- Center: The Engineered Adapter Bridge -->
                  <path d="M100,90 C140,80 170,95 200,105" stroke="#F7941D" stroke-width="2" stroke-linecap="round" />
                  <path d="M100,160 C140,170 170,165 200,155" stroke="#F7941D" stroke-width="2" stroke-linecap="round" />
                  <rect x="135" y="112" width="46" height="36" rx="8" fill="#FFFFFF" stroke="#F7941D" stroke-width="1.5" />
                  <text x="158" y="134" font-family="sans-serif" font-weight="600" font-size="8" fill="#F7941D" text-anchor="middle">RHSP</text>

                  <!-- Right: Round Socket Silhouette -->
                  <ellipse cx="245" cy="130" rx="42" ry="42" stroke="#1E4B8F" stroke-width="1.75" />
                  <ellipse cx="245" cy="130" rx="28" ry="28" stroke="#1E4B8F" stroke-dasharray="4 4" stroke-width="1" />
                  <text x="245" y="133" font-family="sans-serif" font-weight="600" font-size="8" fill="#1E4B8F" text-anchor="middle">ROUND HOLE</text>
                  <text x="245" y="147" font-family="sans-serif" font-size="8" fill="#5B5B5B" text-anchor="middle">TECHNOLOGY STACK</text>

                  <!-- Bottom Measurement Baseline -->
                  <line x1="30" y1="215" x2="287" y2="215" stroke="#E6E6E3" stroke-width="1" />
                  <circle cx="30" cy="215" r="3" fill="#EE4B2B" />
                  <circle cx="287" cy="215" r="3" fill="#1E4B8F" />
                  <text x="158" y="235" font-family="sans-serif" font-size="9" fill="#5B5B5B" text-anchor="middle">PERFECT REVERSIBLE INTERFACE</text>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Mission · Purpose · Vision: Full Text in 3 Large Rounded Cards -->
    <section id="mission" class="about-mission-section" aria-labelledby="mission-heading">
      <div class="container">
        <div class="section-intro text-center reveal-on-scroll">
          <span class="eyebrow">OUR MANDATE</span>
          <h2 id="mission-heading" class="section-title">Built on lasting enterprise value.</h2>
          <p class="section-subline">Three foundational principles guiding every architecture decision.</p>
        </div>

        <div class="mission-cards-grid">
          {missionCards.map((card) => (
            <article class="mission-card card-mastercard reveal-on-scroll">
              <div class="mission-circle-avatar">
                <MediaAsset
                  assetKey={card.imageKey}
                  alt={`${card.title} symbol`}
                  aspectRatio="1/1"
                  crop="circle"
                  theme="warm"
                />
              </div>

              <div class="mission-card-content">
                <div class="mission-title-row">
                  <h3 class="mission-card-title">{card.title}</h3>
                  {card.tag && <span class="confirm-badge">{card.tag}</span>}
                </div>
                <p class="mission-card-body">{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. The PEG Method (#peg): Reusing the Real 3D CSS PEG Cube Component -->
    <div id="peg">
      <PegCube />
    </div>

    <!-- 5. How We Work (#how) + Find Your Fit (Horizontal Stepper & Black Result Card) -->
    <HowWeWork />

    <!-- 6. Leadership Team (#team) -->
    <Team />

    <!-- 7. Universal Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* About Hero */
  .about-hero-section {
    padding: calc(72px + var(--section-spacing-desktop)) 0 var(--section-spacing-desktop);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .about-hero-arc {
    top: -10%;
    right: -10%;
    width: 60%;
    height: 90%;
    opacity: 0.55;
  }

  .about-hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 960px) {
    .about-hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 5rem;
    }
  }

  .about-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-hero-title {
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .about-hero-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin-bottom: 2.25rem;
    max-width: 44ch;
  }

  .about-hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .about-hero-media {
    width: 100%;
  }

  .about-image-frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-surface-alt);
    box-shadow: var(--shadow-card-hover);
  }

  /* Story Section */
  .about-story-section {
    padding: var(--section-spacing-desktop) 0;
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  .story-box-wrapper {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 4rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .story-box-wrapper {
      padding: 2.5rem 1.75rem;
    }
  }

  .story-header {
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .story-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-top: -0.25rem;
  }

  .story-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .story-body-grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 4.5rem;
    }
  }

  .story-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .story-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .step-bullet {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .step-text {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: 0.35rem;
  }

  .story-conclusion-card {
    background-color: var(--color-surface-alt);
    border-left: 3px solid var(--rhsp-peg-start);
    padding: 1.5rem 2rem;
    border-radius: 12px;
  }

  .conclusion-statement {
    font-size: var(--fs-body);
    color: var(--color-text-primary);
    font-weight: 500;
    line-height: 1.6;
  }

  .blueprint-canvas {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blueprint-svg {
    width: 100%;
    height: auto;
    max-height: 300px;
  }

  /* Mission Section */
  .about-mission-section {
    padding: var(--section-spacing-desktop) 0;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  .section-intro {
    max-width: 680px;
    margin: 0 auto 4.5rem auto;
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .section-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0 auto;
  }

  .mission-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .mission-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .mission-card {
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-card);
    padding: 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border: 1px solid var(--color-border-subtle);
  }

  .mission-circle-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .mission-card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .mission-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mission-card-title {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .confirm-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .mission-card-body {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }
</style>
