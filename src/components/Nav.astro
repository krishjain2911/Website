---
import LogoMark from './brand/LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import MediaAsset from './MediaAsset.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

const { nav } = siteConfig;
const currentPath = Astro.url.pathname;
const isAboutActive = currentPath === '/about' || currentPath.startsWith('/about/');
const isPegBoardActive = currentPath === '/peg-board' || currentPath.startsWith('/peg-board/');
const isCareersActive = currentPath === '/careers' || currentPath.startsWith('/careers/');
const isSolutionsActive = currentPath.startsWith('/solutions');

const allProducts = await getCollection('products');
const sortedProducts = [...allProducts].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<header id="main-nav-header" class="site-header">
  <div class="container header-inner">
    <!-- Left: Brand Logo -->
    <a href="/" class="brand-logo-link" aria-label="RHSP - Return to homepage">
      <LogoMark size="md" showText={true} />
    </a>

    <!-- Center: Main Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <!-- 1. About Us -->
        <li>
          <a
            href="/about"
            class={`nav-link ${isAboutActive ? 'is-active' : ''}`}
            aria-current={isAboutActive ? 'page' : undefined}
          >
            About Us
          </a>
        </li>

        <!-- 2. Solutions Dropdown (Non-clickable trigger button) -->
        <li class="nav-item-dropdown" id="solutions-dropdown-item">
          <button
            type="button"
            class={`nav-link nav-btn-dropdown ${isSolutionsActive ? 'is-active' : ''}`}
            id="solutions-menu-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="solutions-dropdown-panel"
          >
            <span>Solutions</span>
            <Icon name="chevron-down" size={14} class="dropdown-chevron" />
          </button>

          <!-- Flat 3-Column Dropdown Panel -->
          <div
            class="solutions-dropdown-panel"
            id="solutions-dropdown-panel"
            role="region"
            aria-label="Solutions Catalog"
            hidden
          >
            <div class="solutions-dropdown-inner">
              <div class="solutions-flat-grid" role="menu">
                {sortedProducts.map((proj) => {
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  return (
                    <a
                      href={`/solutions/${proj.slug}`}
                      class="solutions-card-link card-mastercard"
                      role="menuitem"
                      data-solution-card
                    >
                      <div class="sol-card-thumb">
                        <MediaAsset assetKey={assetKey} alt={proj.data.shortTitle || proj.data.title} aspectRatio="16/9" />
                      </div>
                      <div class="sol-card-info">
                        <div class="sol-card-top">
                          <span class="sol-card-badge">{proj.data.badge}</span>
                        </div>
                        <span class="sol-card-title">{proj.data.title}</span>
                        <p class="sol-card-desc">{proj.data.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </li>

        <!-- 3. PEG Board -->
        <li>
          <a
            href="/peg-board"
            class={`nav-link ${isPegBoardActive ? 'is-active' : ''}`}
            aria-current={isPegBoardActive ? 'page' : undefined}
          >
            PEG Board
          </a>
        </li>

        <!-- 4. Careers -->
        <li>
          <a
            href="/careers"
            class={`nav-link ${isCareersActive ? 'is-active' : ''}`}
            aria-current={isCareersActive ? 'page' : undefined}
            data-track="nav_careers_click"
          >
            Careers
          </a>
        </li>

        <!-- 5. Contact -->
        <li>
          <a href="/#contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Right: Theme + Black CTA + Mobile Toggle -->
    <div class="header-actions">
      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Primary Black Pill CTA -->
      <a href={nav.cta.href} class="btn btn-primary nav-cta-pill">
        <span>{nav.cta.label}</span>
      </a>

      <!-- Mobile Menu Hamburger -->
      <button
        type="button"
        id="mobile-menu-open-btn"
        class="mobile-menu-hamburger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Thin Scroll Progress Line -->
  <div id="scroll-progress-line" class="scroll-progress-bar" aria-hidden="true"></div>
</header>

<!-- Mobile Full-Screen Drawer Menu (rendered outside header so header transforms/filters don't contain it) -->
<div id="mobile-menu-drawer" class="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer-header">
    <LogoMark size="md" showText={true} />
    <button
      type="button"
      id="mobile-menu-close-btn"
      class="mobile-close-btn"
      aria-label="Close menu"
    >
      <Icon name="x" size={24} />
    </button>
  </div>

  <nav class="mobile-drawer-body" aria-label="Mobile navigation">
    <ul class="mobile-nav-list">
      <li class="mobile-nav-item">
        <a href="/about" class="mobile-nav-link">About Us</a>
      </li>
      <li class="mobile-nav-item">
        <details class="mobile-nav-accordion" open={isSolutionsActive}>
          <summary class="mobile-nav-summary">
            <span>Solutions</span>
            <Icon name="chevron-down" size={18} class="accordion-chevron" />
          </summary>
          <ul class="mobile-sublinks-list">
            {sortedProducts.map((proj) => (
              <li>
                <a href={`/solutions/${proj.slug}`} class="mobile-sublink">
                  {proj.data.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
      <li class="mobile-nav-item">
        <a href="/peg-board" class="mobile-nav-link">PEG Board</a>
      </li>
      <li class="mobile-nav-item">
        <a
          href="/careers"
          class={`mobile-nav-link ${isCareersActive ? 'is-active' : ''}`}
          aria-current={isCareersActive ? 'page' : undefined}
          data-track="mobile_nav_careers_click"
        >
          Careers
        </a>
      </li>
      <li class="mobile-nav-item">
        <a href="/#contact" class="mobile-nav-link">Contact</a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 72px;
    z-index: 1000;
    background-color: var(--header-bg, rgba(255, 255, 255, 0.95));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    transition: height 0.3s var(--ease-out-expo),
                box-shadow 0.3s var(--ease-out-expo),
                background-color 0.25s ease,
                transform 0.3s var(--ease-out-expo);
  }

  :global([data-theme="dark"]) .site-header,
  :global(html[data-theme="dark"]) .site-header {
    background-color: var(--header-bg);
  }

  @media (max-width: 767px) {
    .site-header {
      height: 60px;
    }

    .site-header.is-scrolled {
      height: 52px;
    }
  }

  @media (max-width: 1099px) {
    .site-header.is-hidden {
      transform: translateY(-100%);
    }
  }

  .site-header.is-scrolled {
    height: 60px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .site-header.is-scrolled :global(.rhsp-full-logo-img) {
    height: 46px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  /* Desktop Nav Links (Visible >= 1100px) */
  .desktop-nav {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .nav-links {
      gap: 0.65rem;
    }
    .nav-link {
      padding: 0.35rem 0.5rem;
      font-size: 0.8125rem;
    }
    .header-inner {
      padding: 0 0.75rem;
    }
    .nav-cta-pill {
      padding: 0 0.85rem;
      font-size: 0.8125rem;
      height: 36px;
      min-height: 36px;
    }
  }

  @media (min-width: 1025px) and (max-width: 1140px) {
    .nav-links {
      gap: 1rem;
    }
    .nav-link {
      padding: 0.35rem 0.65rem;
      font-size: var(--fs-sm);
    }
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-links > li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover, rgba(0,0,0,0.04));
    outline: none;
  }

  :global([data-theme="dark"]) .nav-link:hover,
  :global([data-theme="dark"]) .nav-link:focus-visible {
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Solutions Dropdown Trigger & Panel */
  .nav-item-dropdown {
    position: relative;
  }

  .nav-btn-dropdown {
    outline: none;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .nav-btn-dropdown[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  .solutions-dropdown-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    width: min(840px, calc(100vw - 32px));
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.16);
    z-index: 1050;
    padding: 1rem 1.15rem;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  :global([data-theme="dark"]) .solutions-dropdown-panel {
    background: var(--color-bg-alt, #131417);
    border-color: rgba(91, 143, 224, 0.22);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7);
  }

  .solutions-dropdown-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    display: block !important;
  }

  .solutions-flat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .solutions-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    padding: 0.6rem 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .solutions-card-link:hover,
  .solutions-card-link:focus-visible {
    border-color: #F7941D;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -4px rgba(247, 148, 29, 0.16);
    outline: none;
  }

  :global([data-theme="dark"]) .solutions-card-link {
    background: var(--color-surface, #1A1B20);
    border-color: rgba(255, 255, 255, 0.09);
    color: var(--text, #ECECEF);
  }

  :global([data-theme="dark"]) .solutions-card-link:hover,
  :global([data-theme="dark"]) .solutions-card-link:focus-visible {
    background: var(--color-surface-hover, #22232A);
    border-color: #F7941D;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.5), 0 0 16px -2px rgba(247, 148, 29, 0.25);
  }

  .sol-card-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    max-height: 100px;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 0.45rem;
    background: var(--color-surface-hover);
    flex-shrink: 0;
  }

  :global([data-theme="dark"]) .sol-card-thumb {
    background: var(--color-surface-hover, #22232A);
  }

  .sol-card-thumb :global(.media-asset-container) {
    width: 100%;
    height: 100%;
  }

  .sol-card-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sol-card-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex-grow: 1;
  }

  .sol-card-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary, #F7941D);
    background: rgba(247, 148, 29, 0.1);
    padding: 2px 5px;
    border-radius: 3px;
    display: inline-block;
    align-self: flex-start;
  }

  .sol-card-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.25;
  }

  :global([data-theme="dark"]) .sol-card-title {
    color: #FFFFFF;
  }

  .sol-card-desc {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global([data-theme="dark"]) .sol-card-desc {
    color: #94A3B8;
  }

  /* Right Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  /* Thin Scroll Progress Bar */
  .scroll-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #F7941D 0%, #EE4B2B 100%);
    pointer-events: none;
    z-index: 1001;
    transition: width 0.05s linear;
  }

  .nav-cta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    min-height: 40px;
    padding: 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .header-actions {
      gap: 0.5rem;
    }

    .nav-cta-pill {
      height: 34px;
      min-height: 34px;
      padding: 0 0.85rem;
      font-size: 13px;
    }

    .mobile-menu-hamburger {
      padding: 0.35rem;
    }
  }

  .mobile-menu-hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .mobile-menu-hamburger {
      display: none;
    }
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-16px);
    transition: opacity 0.25s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
                transform 0.25s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
                visibility 0.25s;
    touch-action: pan-y;
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(1.15rem, env(safe-area-inset-top)) 1.5rem 1.15rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    background-color: var(--color-bg);
  }

  .mobile-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-sm, 6px);
  }

  .mobile-close-btn:hover,
  .mobile-close-btn:focus-visible {
    color: #F7941D;
    outline: none;
  }

  .mobile-drawer-body {
    flex: 1;
    min-height: 0;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .mobile-nav-item:last-child {
    border-bottom: none;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    color: #F7941D;
  }

  .mobile-nav-accordion {
    padding: 0;
  }

  .mobile-nav-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .mobile-nav-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-summary:hover,
  .mobile-nav-summary:active {
    color: #F7941D;
  }

  .accordion-chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .mobile-nav-accordion[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .mobile-sublinks-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.85rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mobile-sublink {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .mobile-sublink:hover,
  .mobile-sublink:active {
    color: #F7941D;
    transform: translateX(3px);
  }
</style>

<script>
  function setupNavHandlers() {
    // 1. Mobile Menu Drawer
    const header = document.getElementById('main-nav-header');
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const drawerLinks = drawer?.querySelectorAll('a');

    let isDrawerOpen = false;
    let savedScrollY = 0;
    let prevHtmlOverflow = '';
    let prevBodyOverflow = '';
    let prevBodyTouchAction = '';

    function openDrawer() {
      if (!drawer || isDrawerOpen) return;
      isDrawerOpen = true;
      savedScrollY = window.scrollY;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');

      // Keep header visible and avoid transform conflicts
      header?.classList.remove('is-hidden');

      prevHtmlOverflow = document.documentElement.style.overflow;
      prevBodyOverflow = document.body.style.overflow;
      prevBodyTouchAction = document.body.style.touchAction;

      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';

      closeBtn?.focus({ preventScroll: true });
    }

    function closeDrawer() {
      if (!drawer || !isDrawerOpen) return;
      isDrawerOpen = false;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');

      document.documentElement.style.overflow = prevHtmlOverflow;
      document.body.style.overflow = prevBodyOverflow;
      document.body.style.touchAction = prevBodyTouchAction;

      // Restore exact scroll position
      window.scrollTo({ top: savedScrollY, behavior: 'instant' as ScrollBehavior });

      openBtn?.focus({ preventScroll: true });
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    drawerLinks?.forEach(link => link.addEventListener('click', closeDrawer));

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isDrawerOpen) {
        closeDrawer();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1100 && isDrawerOpen) {
        closeDrawer();
      }
    }, { passive: true });

    // 2. Solutions Dropdown Hover, Click & Keyboard Navigation
    const dropdownItem = document.getElementById('solutions-dropdown-item');
    const trigger = document.getElementById('solutions-menu-trigger');
    const panel = document.getElementById('solutions-dropdown-panel');
    const cards = Array.from(panel?.querySelectorAll<HTMLAnchorElement>('[data-solution-card]') || []);

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function alignDropdown() {
      if (!panel || !panel.classList.contains('is-open')) return;
      panel.style.transform = 'translateX(-50%) translateY(0)';
      const rect = panel.getBoundingClientRect();
      const pad = 16;
      const vw = window.innerWidth;
      let shiftX = 0;
      if (rect.right > vw - pad) {
        shiftX = (vw - pad) - rect.right;
      } else if (rect.left < pad) {
        shiftX = pad - rect.left;
      }
      if (shiftX !== 0) {
        panel.style.transform = `translateX(calc(-50% + ${Math.round(shiftX)}px)) translateY(0)`;
      }
    }

    function openDropdown() {
      if (closeTimer) clearTimeout(closeTimer);
      if (!panel || !trigger) return;
      panel.removeAttribute('hidden');
      panel.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      alignDropdown();
    }

    function closeDropdown(returnFocus = false) {
      if (closeTimer) clearTimeout(closeTimer);
      if (!panel || !trigger) return;
      panel.classList.remove('is-open');
      panel.setAttribute('hidden', '');
      panel.style.transform = '';
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus();
    }

    if (trigger && panel && dropdownItem) {
      // Click toggle
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = panel.classList.contains('is-open');
        if (isOpen) closeDropdown();
        else openDropdown();
      });

      // Hover
      dropdownItem.addEventListener('mouseenter', openDropdown);
      dropdownItem.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(closeDropdown, 180);
      });

      // Focus
      trigger.addEventListener('focus', openDropdown);

      // Trigger Keydown
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openDropdown();
          if (cards.length > 0) cards[0].focus();
        } else if (e.key === 'Escape') {
          closeDropdown(true);
        }
      });

      // Cards Arrow Key Navigation
      cards.forEach((card, index) => {
        card.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIdx = (index + 1) % cards.length;
            cards[nextIdx].focus();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIdx = (index - 1 + cards.length) % cards.length;
            cards[prevIdx].focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeDropdown(true);
          }
        });
      });

      // Outside click closes
      document.addEventListener('click', (e) => {
        if (!dropdownItem.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      // Window resize adjusts alignment
      window.addEventListener('resize', alignDropdown, { passive: true });
    }

    // 3. Scroll Progress Indicator & Header Scroll Hide
    const progressBar = document.getElementById('scroll-progress-line');
    let lastScrollY = window.scrollY;

    function handleScroll() {
      if (isDrawerOpen) return;
      const currentScrollY = window.scrollY;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;

      if (progressBar && totalHeight > 0) {
        const progress = Math.min(100, Math.max(0, (currentScrollY / totalHeight) * 100));
        progressBar.style.width = `${progress}%`;
      }

      if (header) {
        if (currentScrollY > 40) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }

        if (window.innerWidth < 1100) {
          if (!isDrawerOpen && currentScrollY > lastScrollY && currentScrollY > 120) {
            header.classList.add('is-hidden');
          } else {
            header.classList.remove('is-hidden');
          }
        }
      }
      lastScrollY = currentScrollY;
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupNavHandlers();
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    document.body.style.touchAction = '';
    setupNavHandlers();
  });
</script>