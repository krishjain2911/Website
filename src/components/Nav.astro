---
import LogoMark from './brand/LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';

const { nav } = siteConfig;
const currentPath = Astro.url.pathname;
const isAboutActive = currentPath === '/about' || currentPath.startsWith('/about/');
---

<header id="main-nav-header" class="site-header">
  <div class="container header-inner">
    <!-- Left: Brand Logo -->
    <a href="/" class="brand-logo-link" aria-label="RHSP - Return to homepage">
      <LogoMark size="md" showText={true} />
    </a>

    <!-- Center: Main Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li>
          <a
            href="/about"
            class={`nav-link ${isAboutActive ? 'is-active' : ''}`}
            aria-current={isAboutActive ? 'page' : undefined}
          >
            About Us
          </a>
        </li>
        <li>
          <span
            class="nav-link nav-link--pegboard"
            role="link"
            aria-disabled="true"
            title="PEG Board — coming soon"
          >
            <span>PEG Board</span>
            <span class="nav-coming-soon-pill">Coming soon</span>
          </span>
        </li>
        <li>
          <a href="/#contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Right: Theme + Black CTA + Mobile Toggle -->
    <div class="header-actions">
      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Primary Black Pill CTA -->
      <a href={nav.cta.href} class="btn btn-primary nav-cta-pill">
        <span>{nav.cta.label}</span>
      </a>

      <!-- Mobile Menu Hamburger -->
      <button
        type="button"
        id="mobile-menu-open-btn"
        class="mobile-menu-hamburger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Mobile Full-Screen Drawer Menu -->
  <div id="mobile-menu-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <LogoMark size="md" showText={true} />
      <button
        type="button"
        id="mobile-menu-close-btn"
        class="mobile-close-btn"
        aria-label="Close menu"
      >
        <Icon name="x" size={24} />
      </button>
    </div>

    <div class="mobile-drawer-body">
      <!-- Mobile Navigation Sections -->
      <div class="mobile-nav-sections">
        <!-- 1. About Us -->
        <div class="mobile-section">
          <span class="eyebrow">ABOUT US</span>
          <div class="mobile-links-grid">
            <a href="/about" class="mobile-nav-link">
              <strong>About RHSP</strong>
              <span>Our story &amp; mission</span>
            </a>
            <a href="/about#team" class="mobile-nav-link">
              <strong>Founders &amp; Team</strong>
              <span>Subramaniam Iyer &amp; Abhishek Bagwe</span>
            </a>
          </div>
        </div>

        <!-- 2. PEG Board (Coming Soon) -->
        <div class="mobile-section">
          <span class="eyebrow">PEG BOARD</span>
          <div class="mobile-links-grid">
            <div class="mobile-nav-link mobile-nav-link--disabled" title="PEG Board — coming soon">
              <div class="mobile-pegboard-title-row">
                <strong>PEG Board</strong>
                <span class="nav-coming-soon-pill">Coming soon</span>
              </div>
              <span>Proprietary enterprise board and frameworks</span>
            </div>
          </div>
        </div>

        <!-- 3. Contact -->
        <div class="mobile-section">
          <span class="eyebrow">CONTACT</span>
          <div class="mobile-links-grid">
            <a href="/#contact" class="mobile-nav-link">
              <strong>Get in Touch</strong>
              <span>Start a conversation with our technology architects</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mobile-drawer-footer">
      <div class="mobile-theme-row">
        <span>Dark Mode</span>
        <ThemeToggle />
      </div>
      <a href={nav.cta.href} class="btn btn-primary mobile-cta-pill" id="mobile-cta-btn">
        {nav.cta.label}
      </a>
    </div>
  </div>

  <!-- Thin Scroll Progress Line -->
  <div id="scroll-progress-line" class="scroll-progress-bar" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 72px;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    transition: height 0.3s var(--ease-out-expo),
                box-shadow 0.3s var(--ease-out-expo),
                background-color 0.25s ease,
                transform 0.3s var(--ease-out-expo);
  }

  :global([data-theme="dark"]) .site-header {
    background-color: rgba(14, 14, 14, 0.9);
  }

  @media (max-width: 767px) {
    .site-header {
      height: 60px;
    }

    .site-header.is-scrolled {
      height: 52px;
    }
  }

  @media (max-width: 1099px) {
    .site-header.is-hidden {
      transform: translateY(-100%);
    }
  }

  .site-header.is-scrolled {
    height: 60px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .site-header.is-scrolled :global(.rhsp-full-logo-img) {
    height: 46px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  /* Desktop Nav Links */
  .desktop-nav {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 1100px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links > li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
  }

  .nav-link.is-active {
    color: var(--color-text-primary);
    background-color: var(--color-surface-alt);
    font-weight: 600;
  }

  /* PEG Board Coming Soon Pill & Non-Clickable Link */
  .nav-link--pegboard {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: default;
    user-select: none;
    pointer-events: auto;
  }

  .nav-link--pegboard:hover {
    color: var(--color-text-secondary);
    background-color: transparent;
  }

  .nav-coming-soon-pill {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    background-color: rgba(247, 148, 29, 0.14);
    color: #F7941D;
    line-height: 1.1;
    border: 1px solid rgba(247, 148, 29, 0.3);
    white-space: nowrap;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  /* Thin Scroll Progress Bar */
  .scroll-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #F7941D 0%, #EE4B2B 100%);
    pointer-events: none;
    z-index: 1001;
    transition: width 0.05s linear;
  }

  .nav-cta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    min-height: 40px;
    padding: 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .header-actions {
      gap: 0.5rem;
    }

    .nav-cta-pill {
      height: 34px;
      min-height: 34px;
      padding: 0 0.85rem;
      font-size: 13px;
    }

    .mobile-menu-hamburger {
      padding: 0.35rem;
    }
  }

  .mobile-menu-hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 1100px) {
    .mobile-menu-hamburger {
      display: none;
    }
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
    transition: opacity 0.35s var(--ease-out-expo),
                transform 0.35s var(--ease-out-expo),
                visibility 0.35s;
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(1.25rem, env(safe-area-inset-top)) 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-close-btn {
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    padding: 0.5rem;
  }

  .mobile-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-nav-sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-links-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background-color: var(--color-surface-alt);
    text-decoration: none;
  }

  .mobile-nav-link strong {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .mobile-nav-link span {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .mobile-nav-link--disabled {
    cursor: default;
    opacity: 0.9;
  }

  .mobile-pegboard-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .mobile-drawer-footer {
    padding: 1.25rem 1.5rem max(1.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    bottom: 0;
    background-color: var(--color-bg);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.05);
    z-index: 10;
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .mobile-cta-pill {
    width: 100%;
    min-height: 50px;
    font-size: 1rem;
  }
</style>

<script>
  function setupNav() {
    const header = document.getElementById('main-nav-header');
    const mobileOpenBtn = document.getElementById('mobile-menu-open-btn');
    const mobileCloseBtn = document.getElementById('mobile-menu-close-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    const mobileCtaBtn = document.getElementById('mobile-cta-btn');

    if (!header) return;

    // Sticky header shrink & mobile hide on scroll down
    let lastScrollY = window.scrollY;
    let ticking = false;

    function handleScroll() {
      const currentScrollY = window.scrollY;
      if (currentScrollY > 30) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }

      if (window.innerWidth < 1100 && currentScrollY > 140) {
        if (currentScrollY > lastScrollY + 20) {
          header?.classList.add('is-hidden');
        } else if (currentScrollY < lastScrollY - 15) {
          header?.classList.remove('is-hidden');
        }
      } else {
        header?.classList.remove('is-hidden');
      }

      // Update thin scroll progress line
      const progressBar = document.getElementById('scroll-progress-line');
      if (progressBar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (currentScrollY / docHeight) * 100 : 0;
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }

      lastScrollY = Math.max(0, currentScrollY);
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });
    handleScroll();

    // Mobile Drawer Open / Close
    function openMobileMenu() {
      mobileDrawer?.classList.add('is-open');
      mobileDrawer?.setAttribute('aria-hidden', 'false');
      mobileOpenBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => mobileCloseBtn?.focus(), 60);
    }

    function closeMobileMenu() {
      mobileDrawer?.classList.remove('is-open');
      mobileDrawer?.setAttribute('aria-hidden', 'true');
      mobileOpenBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      mobileOpenBtn?.focus();
    }

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (mobileDrawer?.classList.contains('is-open')) closeMobileMenu();
      }
    });

    // Focus trap inside mobile drawer
    mobileDrawer?.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        const focusables = mobileDrawer.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    mobileOpenBtn?.addEventListener('click', openMobileMenu);
    mobileCloseBtn?.addEventListener('click', closeMobileMenu);
    mobileCtaBtn?.addEventListener('click', closeMobileMenu);

    // Close mobile drawer on link navigation
    const mobileLinks = mobileDrawer?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>