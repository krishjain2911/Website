---
import LogoMark from './brand/LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import MediaAsset from './MediaAsset.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

const { nav } = siteConfig;
const currentPath = Astro.url.pathname;
const isAboutActive = currentPath === '/about' || currentPath.startsWith('/about/');
const isSolutionsActive = currentPath.startsWith('/solutions');

const allProducts = await getCollection('products');
const sortedProducts = [...allProducts].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<header id="main-nav-header" class="site-header">
  <div class="container header-inner">
    <!-- Left: Brand Logo -->
    <a href="/" class="brand-logo-link" aria-label="RHSP - Return to homepage">
      <LogoMark size="md" showText={true} />
    </a>

    <!-- Center: Main Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <!-- 1. Solutions Dropdown (Non-clickable trigger button) -->
        <li class="nav-item-dropdown" id="solutions-dropdown-item">
          <button
            type="button"
            class={`nav-link nav-btn-dropdown ${isSolutionsActive ? 'is-active' : ''}`}
            id="solutions-menu-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="solutions-dropdown-panel"
          >
            <span>Solutions</span>
            <Icon name="chevron-down" size={14} class="dropdown-chevron" />
          </button>

          <!-- Flat 3-Column Dropdown Panel -->
          <div
            class="solutions-dropdown-panel"
            id="solutions-dropdown-panel"
            role="region"
            aria-label="Solutions Catalog"
            hidden
          >
            <div class="container solutions-dropdown-inner">
              <div class="solutions-flat-grid" role="menu">
                {sortedProducts.map((proj) => {
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  return (
                    <a
                      href={`/solutions/${proj.slug}`}
                      class="solutions-card-link card-mastercard"
                      role="menuitem"
                      data-solution-card
                    >
                      <div class="sol-card-thumb">
                        <MediaAsset assetKey={assetKey} alt={proj.data.shortTitle || proj.data.title} aspectRatio="16/10" />
                      </div>
                      <div class="sol-card-info">
                        <div class="sol-card-top">
                          <span class="sol-card-badge">{proj.data.badge}</span>
                        </div>
                        <h4 class="sol-card-title">{proj.data.title}</h4>
                        <p class="sol-card-desc">{proj.data.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </li>

        <!-- 2. About Us -->
        <li>
          <a
            href="/about"
            class={`nav-link ${isAboutActive ? 'is-active' : ''}`}
            aria-current={isAboutActive ? 'page' : undefined}
          >
            About Us
          </a>
        </li>

        <!-- 3. PEG Board (Coming Soon) -->
        <li>
          <span
            class="nav-link nav-link--pegboard"
            role="link"
            aria-disabled="true"
            title="PEG Board — coming soon"
          >
            <span>PEG Board</span>
            <span class="nav-coming-soon-pill">Coming soon</span>
          </span>
        </li>

        <!-- 4. Contact -->
        <li>
          <a href="/#contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Right: Theme + Black CTA + Mobile Toggle -->
    <div class="header-actions">
      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Primary Black Pill CTA -->
      <a href={nav.cta.href} class="btn btn-primary nav-cta-pill">
        <span>{nav.cta.label}</span>
      </a>

      <!-- Mobile Menu Hamburger -->
      <button
        type="button"
        id="mobile-menu-open-btn"
        class="mobile-menu-hamburger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Mobile Full-Screen Drawer Menu -->
  <div id="mobile-menu-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <LogoMark size="md" showText={true} />
      <button
        type="button"
        id="mobile-menu-close-btn"
        class="mobile-close-btn"
        aria-label="Close menu"
      >
        <Icon name="x" size={24} />
      </button>
    </div>

    <div class="mobile-drawer-body">
      <!-- Mobile Navigation Sections -->
      <div class="mobile-nav-sections">
        <!-- 0. Solutions (Expandable Accordion) -->
        <details class="mobile-section mobile-accordion" open={isSolutionsActive}>
          <summary class="mobile-accordion-summary">
            <span class="eyebrow">SOLUTIONS ({sortedProducts.length})</span>
            <Icon name="chevron-down" size={16} class="accordion-chevron" />
          </summary>
          <div class="mobile-links-grid mobile-solutions-column">
            {sortedProducts.map((proj) => (
              <a href={`/solutions/${proj.slug}`} class="mobile-nav-link">
                <span class="mobile-sol-badge">{proj.data.badge}</span>
                <strong>{proj.data.title}</strong>
                <span>{proj.data.oneLiner.replace(/^\[PLACEHOLDER\]\s*/i, '')}</span>
              </a>
            ))}
          </div>
        </details>

        <!-- 1. About Us -->
        <div class="mobile-section">
          <span class="eyebrow">ABOUT US</span>
          <div class="mobile-links-grid">
            <a href="/about" class="mobile-nav-link">
              <strong>About RHSP</strong>
              <span>Our story &amp; mission</span>
            </a>
            <a href="/about#team" class="mobile-nav-link">
              <strong>Founders &amp; Team</strong>
              <span>Subramaniam Iyer &amp; Abhishek Bagwe</span>
            </a>
          </div>
        </div>

        <!-- 2. PEG Board (Coming Soon) -->
        <div class="mobile-section">
          <span class="eyebrow">PEG BOARD</span>
          <div class="mobile-links-grid">
            <div class="mobile-nav-link mobile-nav-link--disabled" title="PEG Board — coming soon">
              <div class="mobile-pegboard-title-row">
                <strong>PEG Board</strong>
                <span class="nav-coming-soon-pill">Coming soon</span>
              </div>
              <span>Proprietary enterprise board and frameworks</span>
            </div>
          </div>
        </div>

        <!-- 3. Contact -->
        <div class="mobile-section">
          <span class="eyebrow">CONTACT</span>
          <div class="mobile-links-grid">
            <a href="/#contact" class="mobile-nav-link">
              <strong>Get in Touch</strong>
              <span>Start a conversation with our technology architects</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mobile-drawer-footer">
      <div class="mobile-theme-row">
        <span>Dark Mode</span>
        <ThemeToggle />
      </div>
      <a href={nav.cta.href} class="btn btn-primary mobile-cta-pill" id="mobile-cta-btn">
        {nav.cta.label}
      </a>
    </div>
  </div>

  <!-- Thin Scroll Progress Line -->
  <div id="scroll-progress-line" class="scroll-progress-bar" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 72px;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    transition: height 0.3s var(--ease-out-expo),
                box-shadow 0.3s var(--ease-out-expo),
                background-color 0.25s ease,
                transform 0.3s var(--ease-out-expo);
  }

  :global([data-theme="dark"]) .site-header {
    background-color: rgba(14, 14, 14, 0.95);
  }

  @media (max-width: 767px) {
    .site-header {
      height: 60px;
    }

    .site-header.is-scrolled {
      height: 52px;
    }
  }

  @media (max-width: 1099px) {
    .site-header.is-hidden {
      transform: translateY(-100%);
    }
  }

  .site-header.is-scrolled {
    height: 60px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .site-header.is-scrolled :global(.rhsp-full-logo-img) {
    height: 46px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  /* Desktop Nav Links (Visible >= 1100px) */
  .desktop-nav {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 1100px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-links > li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover, rgba(0,0,0,0.04));
    outline: none;
  }

  :global([data-theme="dark"]) .nav-link:hover,
  :global([data-theme="dark"]) .nav-link:focus-visible {
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Solutions Dropdown Trigger & Panel */
  .nav-item-dropdown {
    position: relative;
  }

  .nav-btn-dropdown {
    outline: none;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .nav-btn-dropdown[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  .solutions-dropdown-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -20px;
    width: 820px;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.16);
    z-index: 1050;
    padding: 1.5rem;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  :global([data-theme="dark"]) .solutions-dropdown-panel {
    background: #14171d;
    box-shadow: 0 24px 56px -8px rgba(0, 0, 0, 0.5);
  }

  .solutions-dropdown-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    display: block !important;
  }

  .solutions-flat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .solutions-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    padding: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .solutions-card-link:hover,
  .solutions-card-link:focus-visible {
    border-color: #F7941D;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -4px rgba(247, 148, 29, 0.16);
    outline: none;
  }

  .sol-card-thumb {
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 0.6rem;
    background: var(--color-surface-hover);
  }

  .sol-card-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sol-card-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary, #F7941D);
    background: rgba(247, 148, 29, 0.1);
    padding: 2px 5px;
    border-radius: 3px;
    display: inline-block;
    align-self: flex-start;
  }

  .sol-card-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.25;
  }

  .sol-card-desc {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* PEG Board link */
  .nav-link--pegboard {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .nav-coming-soon-pill {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  /* Right Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  /* Thin Scroll Progress Bar */
  .scroll-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #F7941D 0%, #EE4B2B 100%);
    pointer-events: none;
    z-index: 1001;
    transition: width 0.05s linear;
  }

  .nav-cta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    min-height: 40px;
    padding: 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .header-actions {
      gap: 0.5rem;
    }

    .nav-cta-pill {
      height: 34px;
      min-height: 34px;
      padding: 0 0.85rem;
      font-size: 13px;
    }

    .mobile-menu-hamburger {
      padding: 0.35rem;
    }
  }

  .mobile-menu-hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 1100px) {
    .mobile-menu-hamburger {
      display: none;
    }
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
    transition: opacity 0.35s var(--ease-out-expo),
                transform 0.35s var(--ease-out-expo),
                visibility 0.35s;
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(1.25rem, env(safe-area-inset-top)) 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-nav-sections {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-accordion {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .mobile-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .mobile-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .mobile-accordion[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .mobile-solutions-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .mobile-sol-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--color-primary);
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .mobile-links-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background-color: var(--color-surface-hover);
    border-color: #F7941D;
  }

  .mobile-nav-link strong {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .mobile-nav-link span {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .mobile-nav-link--disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .mobile-pegboard-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem max(1.25rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .mobile-cta-pill {
    width: 100%;
    height: 48px;
    font-size: var(--fs-body);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  function setupNavHandlers() {
    // 1. Mobile Menu Drawer
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const drawerLinks = drawer?.querySelectorAll('a');

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      openBtn?.focus();
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    drawerLinks?.forEach(link => link.addEventListener('click', closeDrawer));

    // 2. Solutions Dropdown Hover, Click & Keyboard Navigation
    const dropdownItem = document.getElementById('solutions-dropdown-item');
    const trigger = document.getElementById('solutions-menu-trigger');
    const panel = document.getElementById('solutions-dropdown-panel');
    const cards = Array.from(panel?.querySelectorAll<HTMLAnchorElement>('[data-solution-card]') || []);

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function openDropdown() {
      if (closeTimer) clearTimeout(closeTimer);
      if (!panel || !trigger) return;
      panel.removeAttribute('hidden');
      panel.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown(returnFocus = false) {
      if (closeTimer) clearTimeout(closeTimer);
      if (!panel || !trigger) return;
      panel.classList.remove('is-open');
      panel.setAttribute('hidden', '');
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus();
    }

    if (trigger && panel && dropdownItem) {
      // Click toggle
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = panel.classList.contains('is-open');
        if (isOpen) closeDropdown();
        else openDropdown();
      });

      // Hover
      dropdownItem.addEventListener('mouseenter', openDropdown);
      dropdownItem.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(closeDropdown, 180);
      });

      // Focus
      trigger.addEventListener('focus', openDropdown);

      // Trigger Keydown
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openDropdown();
          if (cards.length > 0) cards[0].focus();
        } else if (e.key === 'Escape') {
          closeDropdown(true);
        }
      });

      // Cards Arrow Key Navigation
      cards.forEach((card, index) => {
        card.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIdx = (index + 1) % cards.length;
            cards[nextIdx].focus();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIdx = (index - 1 + cards.length) % cards.length;
            cards[prevIdx].focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeDropdown(true);
          }
        });
      });

      // Outside click closes
      document.addEventListener('click', (e) => {
        if (!dropdownItem.contains(e.target as Node)) {
          closeDropdown();
        }
      });
    }

    // 3. Scroll Progress Indicator & Header Scroll Hide
    const header = document.getElementById('main-nav-header');
    const progressBar = document.getElementById('scroll-progress-line');
    let lastScrollY = window.scrollY;

    function handleScroll() {
      const currentScrollY = window.scrollY;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;

      if (progressBar && totalHeight > 0) {
        const progress = Math.min(100, Math.max(0, (currentScrollY / totalHeight) * 100));
        progressBar.style.width = `${progress}%`;
      }

      if (header) {
        if (currentScrollY > 40) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }

        if (window.innerWidth < 1100) {
          if (currentScrollY > lastScrollY && currentScrollY > 120) {
            header.classList.add('is-hidden');
          } else {
            header.classList.remove('is-hidden');
          }
        }
      }
      lastScrollY = currentScrollY;
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupNavHandlers();
  document.addEventListener('astro:after-swap', setupNavHandlers);
</script>
