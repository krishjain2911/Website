---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';
import MediaAsset from './MediaAsset.astro';

const { team } = siteConfig;

const founderExpertise: Record<string, string[]> = {
  'Subramaniam (Subu) Iyer': ['OT + IT', 'Robotics & ASRS', 'BFSI', 'OutSystems', 'Enterprise AI'],
  'Abhishek Bagwe': ['Strategy', 'Growth', 'Scalability', 'Client acquisition']
};
---

<section id="team" class="team-section" aria-labelledby="team-heading">
  <div class="container">
    <div class="team-header reveal-on-scroll">
      <span class="eyebrow">LEADERSHIP</span>
      <h2 id="team-heading" class="team-headline">Engineers and enterprise operators.</h2>
      <p class="team-subline">
        Direct technical oversight and strategic involvement from founders on every enterprise engagement.
      </p>
    </div>

    <!-- Founders Grid -->
    <div class="team-grid">
      {team.members.map((member) => (
        <article class="founder-card card-mastercard reveal-on-scroll">
          <div class="founder-top-row">
            <!-- Circular Photo Avatar (falls back to monogram) -->
            <div class="founder-avatar-circle" aria-hidden="true">
              {member.imageKey ? (
                <MediaAsset
                  assetKey={member.imageKey}
                  alt={member.name}
                  crop="circle"
                  aspectRatio="1/1"
                  width={80}
                  height={80}
                  loading="lazy"
                  theme="warm"
                />
              ) : (
                <span class="avatar-initials">{member.initials}</span>
              )}
            </div>
            <div class="founder-title-meta">
              <h3 class="founder-name">{member.name}</h3>
              <span class="founder-role-tag">{member.role}</span>
            </div>
          </div>

          <div class="founder-bio">
            {member.bio.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>

          {founderExpertise[member.name] && (
            <div class="founder-chips-row" aria-label={`Core domains for ${member.name}`}>
              {founderExpertise[member.name].map((chip) => (
                <span class="founder-expertise-chip">{chip}</span>
              ))}
            </div>
          )}

          <div class="founder-actions-footer">
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="team-linkedin-link"
              aria-label={`${member.name}'s LinkedIn Profile (opens in new tab)`}
            >
              <Icon name="external-link" size={15} />
              <span>LinkedIn Profile</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section {
    padding: 72px 0 80px;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  @media (max-width: 767px) {
    .team-section {
      padding: 48px 0 60px;
    }
  }

  .team-header {
    margin-bottom: 2.5rem;
    max-width: 680px;
  }

  .team-headline {
    font-size: var(--fs-h2);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .team-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 840px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  .founder-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-border);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .founder-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .founder-card {
    background-color: var(--color-surface-raised);
  }

  :global(.dark) .founder-card:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
  }

  .founder-top-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .founder-avatar-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--rhsp-peg-gradient);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    border: 2px solid var(--color-border);
  }

  .founder-avatar-circle :global(.media-asset-container) {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  .founder-avatar-circle :global(.media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .founder-card:hover .founder-avatar-circle :global(.media-img) {
    transform: scale(1.05);
  }

  .avatar-initials {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .founder-title-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .founder-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
  }

  .founder-role-tag {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .founder-bio {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0 0 1.25rem 0;
  }

  .founder-bio p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Core domain expertise chips */
  .founder-chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }

  .founder-expertise-chip {
    font-size: 11px;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  :global(.dark) .founder-expertise-chip {
    background: rgba(255, 255, 255, 0.04);
  }

  .founder-card:hover .founder-expertise-chip {
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
  }

  .founder-actions-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .team-linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .team-linkedin-link:hover {
    color: var(--color-primary-hover, #F7941D);
    transform: translateX(2px);
  }
</style>
