---
import MediaSlot from './MediaSlot.astro';
import MediaPicture from './MediaPicture.astro';
import MediaLoop from './MediaLoop.astro';
import StageComingSoon from './StageComingSoon.astro';

interface SampleTableRow {
  ref: string;
  vendor: string;
  stage: string;
  days: string;
}

interface AdminRow {
  label: string;
  description: string;
  buttonLabel: string;
}

interface Stage6Data {
  tagline: string;
  resultsHeadline: string;
  results: string[];
}

interface Props {
  slug?: string;
  stage6?: Stage6Data;
  impactData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    enablement?: string[];
    governance?: string[];
    monitoring?: string[];
    outcome?: string;
    media?: any[];
    // CLM fields
    bullets?: string[];
    sampleTable?: {
      headers: string[];
      rows: SampleTableRow[];
    };
    // Sonakshi fields
    adminRows?: AdminRow[];
    note?: string;
  };
  tagline?: string;
}

const { slug, stage6, impactData } = Astro.props;
const tagline = stage6?.tagline || Astro.props.tagline || impactData?.tagline;
const story = impactData?.story;
const hasContent = Boolean(
  stage6 ||
  (impactData &&
    (impactData.story ||
      impactData.bullets?.length ||
      impactData.adminRows?.length ||
      impactData.sampleTable ||
      impactData.enablement?.length ||
      impactData.governance?.length ||
      impactData.monitoring?.length ||
      impactData.outcome ||
      impactData.points?.length))
);

const primaryMedia = impactData?.media && impactData.media.length > 0 ? impactData.media[0] : undefined;
const isVernacularStage = tagline === 'Every request, accounted for.';
---

<section
  id="stage-06"
  class="project-chapter-section"
  aria-labelledby="heading-stage-06"
  data-stage-title="Enable and monitor"
  data-stage-color="#EE4B2B"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #EE4B2B;">Stage 6 of 6</span>
    <h2 id="heading-stage-06" class="chapter-heading">Enable and monitor</h2>
    {tagline && <p class="chapter-tagline" style="color: #EE4B2B;">{tagline}</p>}
    {!stage6 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage6 ? (
    <div class="stage-streamlined-body">
      <h3 class="results-headline">{stage6.resultsHeadline}</h3>
      <ul class="blue-bullet-list" aria-label="Results">
        {stage6.results.map((res) => (
          <li>{res}</li>
        ))}
      </ul>
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="06" stageTitle="Enable and monitor" color="#EE4B2B" />
  ) : (
    <>
      <!-- CLM Bullets (Audit history, turnaround reports, vendor dashboard, KPI tiles) -->
      {impactData?.bullets && impactData.bullets.length > 0 && (
        <div class="bullets-card card-mastercard">
          <ul class="impact-bullets-list">
            {impactData.bullets.map((b) => (
              <li class="bullet-item" set:html={b}></li>
            ))}
          </ul>
        </div>
      )}

      <!-- CLM Optional Sample Table with 6 rows (Reference, Vendor, Stage, Days in stage) -->
      {impactData?.sampleTable && (
        <div class="clm-sample-table-widget card-mastercard">
          <div class="table-widget-header">
            <span class="table-widget-caption">Sample rows</span>
            <div class="table-stage-filters" role="group" aria-label="Stage filters">
              <span class="filter-chip is-active">All</span>
              <span class="filter-chip">Draft</span>
              <span class="filter-chip">Legal evaluation</span>
              <span class="filter-chip">Signing</span>
            </div>
          </div>

          <div class="table-responsive-wrapper">
            <table class="clm-table" aria-label="Contract turnaround sample table">
              <thead>
                <tr>
                  {impactData.sampleTable.headers.map((h) => (
                    <th>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {impactData.sampleTable.rows.map((row) => (
                  <tr>
                    <td class="font-mono">{row.ref}</td>
                    <td>{row.vendor}</td>
                    <td>
                      <span class="table-stage-pill">{row.stage}</span>
                    </td>
                    <td>{row.days} days</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {slug === 'clm' && (
        <div class="stage-media-grid-2" style="margin-top: 1.5rem;">
          <MediaPicture
            slug="clm"
            file="image114.png"
            alt="Audit history table for a contract."
            caption="Audit history for every contract."
          />
          <MediaPicture
            slug="clm"
            file="image118.png"
            alt="Turnaround time report with filters and a download button."
            caption="Turnaround report."
          />
        </div>
      )}

      <!-- Vernacular Documents: Interactive Requests Table Component -->
      {isVernacularStage && (
        <>
          <div class="vernacular-requests-widget card-mastercard" id="vernacular-requests-widget">
            <div class="widget-top-row">
              <span class="table-widget-caption">Sample requests</span>
              <span class="live-action-hint">Click actions to test remediation</span>
            </div>

            <div class="table-responsive-wrapper">
              <table class="requests-table" aria-label="Document request recovery log">
                <thead>
                  <tr>
                    <th>Request</th>
                    <th>Template</th>
                    <th>Word</th>
                    <th>PDF</th>
                    <th>Callback</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr id="req-row-1">
                    <td class="font-mono">REQ-2026-9041</td>
                    <td>Affidavit cum undertaking · English</td>
                    <td><span class="status-cell is-done" id="r1-word">Done</span></td>
                    <td><span class="status-cell is-done" id="r1-pdf">Done</span></td>
                    <td><span class="status-cell is-done" id="r1-cb">Delivered</span></td>
                    <td><span class="text-muted">None needed</span></td>
                  </tr>
                  <tr id="req-row-2">
                    <td class="font-mono">REQ-2026-9042</td>
                    <td>Disbursement request · Hindi</td>
                    <td><span class="status-cell is-done" id="r2-word">Done</span></td>
                    <td><span class="status-cell is-done" id="r2-pdf">Done</span></td>
                    <td><span class="status-cell is-pending" id="r2-cb">Queued</span></td>
                    <td>
                      <button type="button" class="btn-table-action" id="btn-retrigger-cb">
                        Retrigger callback
                      </button>
                    </td>
                  </tr>
                  <tr id="req-row-3">
                    <td class="font-mono">REQ-2026-9043</td>
                    <td>Power of attorney · Marathi</td>
                    <td><span class="status-cell is-done" id="r3-word">Done</span></td>
                    <td><span class="status-cell is-failed" id="r3-pdf">Failed</span></td>
                    <td><span class="status-cell is-pending" id="r3-cb">Pending</span></td>
                    <td>
                      <button type="button" class="btn-table-action" id="btn-regen-pdf">
                        Regenerate PDF
                      </button>
                    </td>
                  </tr>
                  <tr id="req-row-4">
                    <td class="font-mono">REQ-2026-9044</td>
                    <td>Key fact statement · Tamil</td>
                    <td><span class="status-cell is-failed" id="r4-word">Failed</span></td>
                    <td><span class="status-cell is-pending" id="r4-pdf">Pending</span></td>
                    <td><span class="status-cell is-pending" id="r4-cb">Pending</span></td>
                    <td>
                      <button type="button" class="btn-table-action" id="btn-regen-word">
                        Regenerate Word
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <MediaPicture
              slug="vernacular-documents"
              file="image45v.png"
              alt="Document request screen with Regenerate callback and Download PDF buttons per row."
              caption="Every request, with repair actions."
            />
          </div>
        </>
      )}

      <!-- Sonakshi: Three Rows with Labels and Upload Buttons -->
      {impactData?.adminRows && impactData.adminRows.length > 0 && (
        <div class="sonakshi-admin-rows card-mastercard">
          <div class="admin-rows-list">
            {impactData.adminRows.map((row) => (
              <div class="admin-upload-row">
                <div class="admin-row-meta">
                  <h3 class="admin-row-label">{row.label}</h3>
                  <p class="admin-row-desc">{row.description}</p>
                </div>
                <button type="button" class="btn btn-secondary admin-upload-btn" disabled>
                  <span>{row.buttonLabel}</span>
                </button>
              </div>
            ))}
          </div>

          {impactData.note && <div class="admin-note-box">{impactData.note}</div>}
        </div>
      )}

      {slug === 'sonakshi' && (
        <div style="margin-top: 1.5rem;">
          <MediaLoop
            slug="sonakshi"
            name="sonakshi-admin-upload"
            caption="Upload a price sheet and a catalogue from the admin panel."
          />
        </div>
      )}

      <!-- Primary Stage Media (e.g. for untouched pages) -->
      {slug !== 'clm' && slug !== 'vernacular-documents' && slug !== 'sonakshi' && primaryMedia && (
        <div class="stage-media-wrapper">
          {primaryMedia.type === 'gif' ? (
            <div class="admin-gif-placeholder card-mastercard">
              <!-- TODO: Insert confirmed admin GIF / short video file of adding Excel and PDF files -->
              <div class="gif-frame-inner">
                <div class="gif-badge">Media asset</div>
                <span class="gif-caption">{primaryMedia.caption}</span>
                <span class="gif-todo-note">TODO: Founder recording of admin Excel &amp; PDF ingestion</span>
              </div>
            </div>
          ) : (
            <MediaSlot item={primaryMedia} />
          )}
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: #FFFFFF;
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  :global(.dark) .project-chapter-section {
    background-color: var(--color-surface);
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #F7941D;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .results-headline {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 1rem 0;
    max-width: 62ch;
  }

  .blue-bullet-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 62ch;
  }

  .blue-bullet-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .blue-bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #1E4B8F;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0 0;
    max-width: 780px;
  }

  /* Bullets Card */
  .bullets-card {
    padding: 1.5rem;
    border-radius: 12px;
    margin-top: 1.25rem;
  }

  .impact-bullets-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bullet-item {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    position: relative;
    padding-left: 1.25rem;
  }

  .bullet-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #EE4B2B;
  }

  .bullet-item :global(strong) {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .stage-media-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .stage-media-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Table Widgets */
  .clm-sample-table-widget,
  .vernacular-requests-widget {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .table-widget-header,
  .widget-top-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .table-widget-caption {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .live-action-hint {
    font-size: 0.75rem;
    font-style: italic;
    color: #1E4B8F;
  }

  :global(.dark) .live-action-hint {
    color: #60a5fa;
  }

  .table-stage-filters {
    display: flex;
    gap: 0.4rem;
  }

  .filter-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill, 9999px);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .filter-chip.is-active {
    background-color: #1E4B8F;
    color: #ffffff;
    border-color: #1E4B8F;
  }

  .table-responsive-wrapper {
    overflow-x: auto;
  }

  .clm-table,
  .requests-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .clm-table th,
  .requests-table th {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .clm-table td,
  .requests-table td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .font-mono {
    font-family: monospace;
    font-size: 0.82rem;
  }

  .table-stage-pill {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.75rem;
    font-weight: 600;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .status-cell {
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status-cell.is-done {
    background-color: rgba(16, 185, 129, 0.15);
    color: #10B981;
  }

  .status-cell.is-pending {
    background-color: rgba(247, 148, 29, 0.15);
    color: #F7941D;
  }

  .status-cell.is-failed {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .btn-table-action {
    background-color: #1E4B8F;
    color: #ffffff;
    border: none;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .btn-table-action:hover {
    opacity: 0.9;
  }

  /* Sonakshi Admin Rows */
  .sonakshi-admin-rows {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .admin-rows-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .admin-upload-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .admin-upload-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .admin-row-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .admin-row-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .admin-row-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .admin-upload-btn {
    font-size: 0.82rem;
    padding: 0.35rem 0.85rem;
  }

  .admin-note-box {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background-color: var(--color-bg);
    border-left: 3px solid #EE4B2B;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .stage-media-wrapper {
    margin-top: 1.5rem;
  }

  .admin-gif-placeholder {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gif-frame-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .gif-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill, 9999px);
    background-color: rgba(247, 148, 29, 0.2);
    color: #F7941D;
  }

  .gif-caption {
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .gif-todo-note {
    font-size: 0.78rem;
    color: #94a3b8;
  }
</style>

<script>
  function initVernacularRequests() {
    const btnRetrigger = document.getElementById('btn-retrigger-cb');
    const btnRegenPdf = document.getElementById('btn-regen-pdf');
    const btnRegenWord = document.getElementById('btn-regen-word');

    btnRetrigger?.addEventListener('click', () => {
      const cell = document.getElementById('r2-cb');
      if (cell) {
        cell.className = 'status-cell is-done';
        cell.textContent = 'Delivered';
        btnRetrigger.parentElement!.innerHTML = '<span class="status-cell is-done">Done</span>';
      }
    });

    btnRegenPdf?.addEventListener('click', () => {
      const pdfCell = document.getElementById('r3-pdf');
      const cbCell = document.getElementById('r3-cb');
      if (pdfCell) {
        pdfCell.className = 'status-cell is-done';
        pdfCell.textContent = 'Done';
      }
      if (cbCell) {
        cbCell.className = 'status-cell is-done';
        cbCell.textContent = 'Delivered';
      }
      btnRegenPdf.parentElement!.innerHTML = '<span class="status-cell is-done">Done</span>';
    });

    btnRegenWord?.addEventListener('click', () => {
      const wordCell = document.getElementById('r4-word');
      const pdfCell = document.getElementById('r4-pdf');
      const cbCell = document.getElementById('r4-cb');
      if (wordCell) {
        wordCell.className = 'status-cell is-done';
        wordCell.textContent = 'Done';
      }
      if (pdfCell) {
        pdfCell.className = 'status-cell is-done';
        pdfCell.textContent = 'Done';
      }
      if (cbCell) {
        cbCell.className = 'status-cell is-done';
        cbCell.textContent = 'Delivered';
      }
      btnRegenWord.parentElement!.innerHTML = '<span class="status-cell is-done">Done</span>';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVernacularRequests);
  } else {
    initVernacularRequests();
  }
  document.addEventListener('astro:page-load', initVernacularRequests);
</script>
