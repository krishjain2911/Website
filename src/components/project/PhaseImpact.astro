---
import MediaSlot from './MediaSlot.astro';
import Icon from '../Icon.astro';
import StageComingSoon from './StageComingSoon.astro';

interface Props {
  impactData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    enablement?: string[];
    governance?: string[];
    monitoring?: string[];
    outcome?: string;
    quote?: {
      text: string;
      role?: string;
    };
    media?: any[];
  };
  tagline?: string;
}

const { impactData } = Astro.props;
const tagline = Astro.props.tagline || impactData?.tagline;
const story = impactData?.story;
const hasContent = !!(impactData && (impactData.story || impactData.outcome || impactData.enablement?.length || impactData.governance?.length || impactData.monitoring?.length || impactData.points?.length));

const primaryMedia = impactData?.media && impactData.media.length > 0 ? impactData.media[0] : undefined;
---

<section
  id="stage-06"
  class="project-chapter-section"
  aria-labelledby="heading-stage-06"
  data-stage-title="Enable and monitor"
  data-stage-color="#EE4B2B"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #EE4B2B;">STAGE 06</span>
    <h2 id="heading-stage-06" class="chapter-heading">Enable and monitor</h2>
    {tagline && <p class="chapter-tagline" style="color: #EE4B2B;">{tagline}</p>}
    {story && <p class="chapter-story">{story}</p>}
  </div>

  {!hasContent ? (
    <StageComingSoon stageNumber="06" stageTitle="Enable and monitor" color="#EE4B2B" />
  ) : (
    <>
      <!-- Big Outcome Statement -->
      {impactData?.outcome && (
        <div class="outcome-highlight-banner card-mastercard">
          <div class="outcome-accent-bar" aria-hidden="true"></div>
          <div class="outcome-body">
            <span class="outcome-label">FINAL STRATEGIC OUTCOME</span>
            <blockquote class="outcome-quote">{impactData.outcome}</blockquote>
          </div>
        </div>
      )}

      <!-- Impact Media if Present -->
      {primaryMedia && (
        <div class="impact-media-slot-wrap">
          <MediaSlot item={primaryMedia} />
        </div>
      )}

      <!-- 3-Pillar Operational Foundation: Governance / Enablement / Monitoring -->
      {(impactData?.governance || impactData?.enablement || impactData?.monitoring) && (
        <div class="impact-pillars-grid">
          {impactData.enablement && impactData.enablement.length > 0 && (
            <div class="pillar-card card-mastercard">
              <div class="pillar-header">
                <span class="pillar-icon" aria-hidden="true">
                  <Icon name="users" size={18} />
                </span>
                <h3 class="pillar-title">Enablement &amp; Handover</h3>
              </div>
              <ul class="pillar-list">
                {impactData.enablement.map((item) => (
                  <li class="pillar-item">
                    <span class="pillar-bullet" aria-hidden="true">&bull;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {impactData.governance && impactData.governance.length > 0 && (
            <div class="pillar-card card-mastercard">
              <div class="pillar-header">
                <span class="pillar-icon" aria-hidden="true">
                  <Icon name="shield" size={18} />
                </span>
                <h3 class="pillar-title">Governance &amp; Controls</h3>
              </div>
              <ul class="pillar-list">
                {impactData.governance.map((item) => (
                  <li class="pillar-item">
                    <span class="pillar-bullet" aria-hidden="true">&bull;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {impactData.monitoring && impactData.monitoring.length > 0 && (
            <div class="pillar-card card-mastercard">
              <div class="pillar-header">
                <span class="pillar-icon" aria-hidden="true">
                  <Icon name="eye" size={18} />
                </span>
                <h3 class="pillar-title">Monitoring &amp; Telemetry</h3>
              </div>
              <ul class="pillar-list">
                {impactData.monitoring.map((item) => (
                  <li class="pillar-item">
                    <span class="pillar-bullet" aria-hidden="true">&bull;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <!-- Stakeholder Quote -->
      {impactData?.quote && impactData.quote.text && (
        <div class="impact-quote-card card-mastercard">
          <div class="quote-mark-icon" aria-hidden="true">&ldquo;</div>
          <p class="quote-body-text">{impactData.quote.text}</p>
          {impactData.quote.role && (
            <div class="quote-author-row">
              <span class="quote-author-role">{impactData.quote.role}</span>
            </div>
          )}
        </div>
      )}

      <!-- Key Impact Points -->
      {impactData?.points && impactData.points.length > 0 && (
        <div class="impact-points-card card-mastercard">
          <span class="block-mini-title">ENDURING CAPABILITY HIGHLIGHTS</span>
          <ul class="impact-points-grid">
            {impactData.points.map((pt) => (
              <li class="impact-point-item">
                <span class="pt-star" aria-hidden="true">&#x2714;</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    padding: clamp(2.5rem, 5vh, 3.75rem) 0;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--nav-height, 72px) + 2rem);
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .chapter-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .chapter-tagline {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .chapter-story {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0;
  }

  .block-mini-title {
    display: block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .outcome-highlight-banner {
    position: relative;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    margin-bottom: 2rem;
    overflow: hidden;
  }

  :global(.dark) .outcome-highlight-banner {
    background: var(--color-surface-raised);
  }

  .outcome-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 4px;
    background: #EE4B2B;
  }

  .outcome-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #EE4B2B;
    margin-bottom: 0.5rem;
  }

  .outcome-quote {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin: 0;
  }

  .impact-media-slot-wrap {
    margin-bottom: 2rem;
  }

  .impact-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .pillar-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .pillar-card {
    background: var(--color-surface-raised);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-icon {
    display: inline-flex;
    color: #EE4B2B;
  }

  .pillar-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .pillar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .pillar-bullet {
    color: #EE4B2B;
    font-size: 11px;
    flex-shrink: 0;
  }

  .impact-quote-card {
    position: relative;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    margin-bottom: 2rem;
  }

  :global(.dark) .impact-quote-card {
    background: var(--color-surface-raised);
  }

  .quote-mark-icon {
    font-size: 3rem;
    line-height: 1;
    color: #EE4B2B;
    opacity: 0.3;
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    font-family: Georgia, serif;
    pointer-events: none;
  }

  .quote-body-text {
    position: relative;
    z-index: 2;
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  .quote-author-row {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .impact-points-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .impact-points-card {
    background: var(--color-surface-raised);
  }

  .impact-points-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .impact-point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .pt-star {
    color: #EE4B2B;
    font-size: 0.85rem;
    margin-top: 2px;
  }
</style>
