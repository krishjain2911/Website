---
interface Props {
  id?: string;
  pageName: string;
  class?: string;
}

const { id, pageName, class: className = '' } = Astro.props;
  const raw = (id || '').trim();
  const match = raw.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/);
  const videoId = match ? match[1] : /^[\w-]{11}$/.test(raw) ? raw : '';
  const hasVideo = videoId.length === 11;
---

<div class:list={['video-embed-container', className]}>
  {hasVideo ? (
    <div class="video-embed-aspect">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={`${pageName} demo`}
        loading="lazy"
        allowfullscreen
        class="video-embed-iframe"
      ></iframe>
    </div>
  ) : (
    <div class="video-embed-aspect video-placeholder-frame">
      
      <div class="placeholder-icon-wrap" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" opacity="0.25" />
        </svg>
      </div>
      <span class="placeholder-title">Demo video coming soon</span>
      <span class="placeholder-sub">{pageName} recorded walkthrough</span>
    </div>
  )}
</div>

<style>
  .video-embed-container {
    width: 100%;
    margin-top: 1.5rem;
  }

  .video-embed-aspect {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .video-embed-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-placeholder-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, rgba(30, 75, 143, 0.04) 0%, rgba(247, 148, 29, 0.04) 100%);
    padding: 2rem;
    text-align: center;
  }

  :global([data-theme="dark"]) .video-placeholder-frame {
    background: linear-gradient(135deg, rgba(30, 75, 143, 0.12) 0%, rgba(247, 148, 29, 0.1) 100%);
  }

  .placeholder-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgba(30, 75, 143, 0.1);
    color: #1E4B8F;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  :global([data-theme="dark"]) .placeholder-icon-wrap {
    background-color: rgba(96, 165, 250, 0.15);
    color: #60a5fa;
  }

  .placeholder-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .placeholder-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
