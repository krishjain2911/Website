<script>
  function initVernacularPreview() {
    const dataEl = document.getElementById('vernacular-data');
    if (!dataEl) return;

    let samples: any[] = [];
    try {
      samples = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    const selectEl = document.getElementById('vernacular-lang-select') as HTMLSelectElement | null;
    const btnTemplate = document.getElementById('btn-mode-template');
    const btnSample = document.getElementById('btn-mode-sample');
    const bodyEl = document.getElementById('doc-rendered-body');
    const salutationEl = document.getElementById('doc-salutation');

    if (!selectEl || !btnTemplate || !btnSample || !bodyEl || !salutationEl) return;

    let currentMode: 'template' | 'sample' = 'template';
    let currentLang = 'en';

    function render() {
      const sample = samples.find((s) => s.code === currentLang) || samples[0];
      if (!sample) return;

      salutationEl!.textContent = `Salutation: ${sample.salutation}`;

      if (currentMode === 'template') {
        // Highlight tokens in blue
        const html = sample.templateText.replace(
          /\{\{([^}]+)\}\}/g,
          '<span class="tok-token tok-blue">{{$1}}</span>'
        );
        bodyEl!.innerHTML = html;
      } else {
        // Highlight filled values in orange
        const tokens = sample.tokens;
        let html = sample.templateText;
        html = html.replace('{{ApplicantName}}', `<span class="tok-token tok-orange">${tokens.name}</span>`);
        html = html.replace('{{ApplicantAge}}', `<span class="tok-token tok-orange">${tokens.age}</span>`);
        html = html.replace('{{ApplicantAddress}}', `<span class="tok-token tok-orange">${tokens.address}</span>`);
        html = html.replace('{{LoanAmount}}', `<span class="tok-token tok-orange">${tokens.amount}</span>`);
        bodyEl!.innerHTML = html;
      }
    }

    btnTemplate.addEventListener('click', () => {
      currentMode = 'template';
      btnTemplate.classList.add('is-active');
      btnTemplate.setAttribute('aria-checked', 'true');
      btnSample.classList.remove('is-active');
      btnSample.setAttribute('aria-checked', 'false');
      render();
    });

    btnSample.addEventListener('click', () => {
      currentMode = 'sample';
      btnSample.classList.add('is-active');
      btnSample.setAttribute('aria-checked', 'true');
      btnTemplate.classList.remove('is-active');
      btnTemplate.setAttribute('aria-checked', 'false');
      render();
    });

    selectEl.addEventListener('change', () => {
      currentLang = selectEl.value;
      render();
    });

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVernacularPreview);
  } else {
    initVernacularPreview();
  }
  document.addEventListener('astro:page-load', initVernacularPreview);
</script>
