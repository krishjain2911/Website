    code: 'en',
    label: 'English',
    salutation: 'Mr.',
    templateText: 'I, {{ApplicantName}}, aged {{ApplicantAge}} years, residing at {{ApplicantAddress}}, state that I have availed a loan of {{LoanAmount}} and undertake to repay it as agreed.',
    filledText: 'I, Rahul Sharma, aged 35 years, residing at Flat 204, Pune, state that I have availed a loan of Rs. 10,00,000 and undertake to repay it as agreed.',
    tokens: {
      name: 'Rahul Sharma',
      age: '35',
      address: 'Flat 204, Pune',
      amount: 'Rs. 10,00,000'
