---
import MediaSlot from './MediaSlot.astro';
import MediaPicture from './MediaPicture.astro';
import MediaLoop from './MediaLoop.astro';
import StageComingSoon from './StageComingSoon.astro';

interface ArchitectureLayer {
  name: string;
  items: { name: string; role: string }[];
}

interface FeatureItem {
  title: string;
  description: string;
}

interface Stage3Data {
  tagline: string;
  features: FeatureItem[];
  builtWith: string[];
  screenshot: {
    file: string;
    alt: string;
    caption: string;
  };
  loop?: {
    name: string;
    caption: string;
  };
}

interface Props {
  slug?: string;
  stage3?: Stage3Data;
  architectureData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    pattern?: string;
    layers?: ArchitectureLayer[];
    ai?: string[];
    security?: string;
    media?: any[];
    // CLM fields
    adminChips?: string[];
    volumeBullets?: string[];
    // Vernacular Documents fields
    guardRails?: string[];
    // Sonakshi fields
    builtWithPills?: string[];
  };
  tagline?: string;
}

const { slug, stage3, architectureData } = Astro.props;
const tagline = stage3?.tagline || Astro.props.tagline || architectureData?.tagline;
const story = architectureData?.story;
const hideScreenshot = slug === 'clm' || slug === 'vernacular-documents';
const hasContent = !!(
  stage3 ||
  (architectureData &&
    (architectureData.story ||
      architectureData.adminChips?.length ||
      architectureData.guardRails?.length ||
      architectureData.builtWithPills?.length ||
      architectureData.layers?.length ||
      architectureData.pattern ||
      architectureData.points?.length))
);

const primaryMedia = architectureData?.media && architectureData.media.length > 0 ? architectureData.media[0] : undefined;

// Vernacular Languages Data for Interactive Sample Preview Component
// NOTE: Non-Latin translations provided for Devanagari, Tamil, Bengali, Gujarati, Kannada and Telugu.
// Flagged for native-speaker review as requested.
const VERNACULAR_SAMPLES = [
