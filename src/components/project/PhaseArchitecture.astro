const isVernacularPage = !!architectureData?.guardRails?.length;
---

<section
  id="stage-03"
  class="project-chapter-section"
  aria-labelledby="heading-stage-03"
  data-stage-title="Design adaptive systems"
  data-stage-color="#B86B10"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #0072CE;">Stage 3 of 6</span>
    <h2 id="heading-stage-03" class="chapter-heading">Design adaptive systems</h2>
    {tagline && <p class="chapter-tagline" style="color: #0072CE;">{tagline}</p>}
    {!stage3 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage3 ? (
    <div class="stage-streamlined-body">
      <!-- 6 Feature Cards (2 Columns) -->
      <div class="feature-cards-grid" aria-label="Product features">
        {stage3.features.map((feat) => (
          <article class="feature-card">
            <div class="feature-card-header">
              <span class="feature-peg-marker" aria-hidden="true"></span>
              <h3 class="feature-title">{feat.title}</h3>
            </div>
            <p class="feature-desc">{feat.description}</p>
          </article>
        ))}
      </div>

      <!-- Built with Chips -->
      {stage3.builtWith && stage3.builtWith.length > 0 && (
        <div class="built-with-strip">
          <span class="built-with-label">Built with</span>
          <div class="chips-wrap">
            {stage3.builtWith.map((chip) => (
              <span class="meta-chip built-chip">{chip}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Media: Screenshot and optional loop clip beside it -->
{!hideScreenshot && (
  <div class="stage3-media-item">
    <MediaPicture
      slug={slug || ''}
      file={stage3.screenshot.file}
      alt={stage3.screenshot.alt}
      caption={stage3.screenshot.caption}
    />
  </div>
)}
        {stage3.loop && !hideScreenshot && (
          <div class="stage3-media-item" style={slug === 'sonakshi' ? 'order:-1' : undefined}>
            <MediaLoop
              slug={slug || ''}
              name={stage3.loop.name}
              caption={stage3.loop.caption}
              aspectRatio="1280 / 720"
            />
          </div>
        )}
      </div>
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="03" stageTitle="Design adaptive systems" color="#B86B10" />
  ) : (
    <>
      <!-- CLM: Set by Admins Chips & Made for Volume Bullets -->
      {architectureData?.adminChips && (
        <div class="stage-two-cols-grid">
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">Set by admins</h3>
            <div class="chips-cluster" style="margin-top: 0.5rem;">
              {architectureData.adminChips.map((chip) => (
                <span class="meta-chip admin-chip">{chip}</span>
              ))}
            </div>
          </div>

          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">Made for volume</h3>
            <ul class="volume-bullets-list">
              {architectureData.volumeBullets?.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <!-- Vernacular Documents: Interactive Document Card (Template vs With Sample Data + 8 Languages) -->
      {isVernacularPage && (
        <div class="vernacular-interactive-container card-mastercard" id="vernacular-doc-widget">
          <div class="vernacular-widget-header">
            <div class="mode-toggle-group" role="radiogroup" aria-label="Document preview mode">
              <button
                type="button"
                class="mode-toggle-btn is-active"
                id="btn-mode-template"
                data-mode="template"
                role="radio"
                aria-checked="true"
              >
                Template
              </button>
              <button
                type="button"
                class="mode-toggle-btn"
                id="btn-mode-sample"
                data-mode="sample"
                role="radio"
                aria-checked="false"
              >
                With sample data
              </button>
            </div>

            <div class="lang-select-wrapper">
              <label for="vernacular-lang-select" class="lang-label">Language:</label>
              <select id="vernacular-lang-select" class="vernacular-select">
                {VERNACULAR_SAMPLES.map((s) => (
                  <option value={s.code}>{s.label}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Document Canvas Sheet -->
          <div class="vernacular-sheet-frame">
            <div class="sheet-top-meta">
              <span class="sheet-title-tag">Affidavit cum undertaking</span>
              <span class="sheet-salutation" id="doc-salutation">Salutation: Mr.</span>
            </div>
            <div class="sheet-body-text" id="doc-rendered-body">
              <!-- Rendered via JavaScript and SSR fallback -->
              I, <span class="tok-token tok-blue">{`{{ApplicantName}}`}</span>, aged <span class="tok-token tok-blue">{`{{ApplicantAge}}`}</span> years, residing at <span class="tok-token tok-blue">{`{{ApplicantAddress}}`}</span>, state that I have availed a loan of <span class="tok-token tok-blue">{`{{LoanAmount}}`}</span> and undertake to repay it as agreed.
            </div>
            <div class="sheet-footer-caption">
              <span>Sample customer data.</span>
            </div>
          </div>

          <!-- Hidden JSON data bank for client script -->
          <script id="vernacular-data" type="application/json" set:html={JSON.stringify(VERNACULAR_SAMPLES)}></script>
        </div>
      )}

      <!-- Vernacular Guard Rails -->
      {architectureData?.guardRails && (
        <div class="guard-rails-card card-mastercard">
          <h3 class="col-card-title">Guard rails</h3>
          <ul class="guard-rails-list">
            {architectureData.guardRails.map((rail) => (
              <li>{rail}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Sonakshi: 5-Layer Component & Built with Chips -->
      {architectureData?.layers && architectureData.layers.length > 0 && (
        <div class="sonakshi-arch-block">
          <div class="layers-stack-grid">
            {architectureData.layers.map((layer, idx) => (
              <div class="layer-band-card card-mastercard">
                <div class="layer-header">
                  <span class="layer-step-num">0{idx + 1}</span>
                  <span class="layer-name">{layer.name}</span>
                </div>
                <div class="layer-items-grid">
                  {layer.items.map((it) => (
                    <div class="layer-item-pill">
                      <span class="item-name">{it.name}</span>
                      <span class="item-role">{it.role}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Built With Chip Row -->
          {architectureData?.builtWithPills && architectureData.builtWithPills.length > 0 && (
            <div class="built-with-wrapper card-mastercard">
              <span class="built-with-label">Built with</span>
              <div class="built-with-chips">
                {architectureData.builtWithPills.map((chip) => (
                  <span class="tech-chip">{chip}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Bullet Points -->
          {architectureData?.points && architectureData.points.length > 0 && (
            <ul class="arch-bullets-list">
              {architectureData.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          )}
        </div>
      )}

      <!-- Stage 3 Media: Side-by-side on desktop, stack on mobile -->
      {slug === 'clm' ? (
        <div class="stage-media-grid-2">
          <MediaPicture
            slug="clm"
            file="image154.png"
            alt="Document nature master list with active and legacy toggles."
            caption="Document natures, managed by admins."
          />
          <MediaPicture
            slug="clm"
            file="image173.png"
            alt="Create document type form with an e-stamp required checkbox."
            caption="Document types, with e-stamp switched on per type."
          />
        </div>
      ) : slug === 'vernacular-documents' ? (
        <div class="stage-media-grid-2">
          <MediaPicture
            slug="vernacular-documents"
            file="image7v.png"
            alt="Template preview showing a Word document with placeholder tokens and buttons to view request, preview and download."
            caption="A template with its placeholders."
          />
          <MediaPicture
            slug="vernacular-documents"
            file="image9v.png"
            alt="Same template filled with sample customer data after Preview is selected."
            caption="The same template with sample data."
          />
        </div>
      ) : primaryMedia ? (
        <div class="stage-media-wrapper">
          <MediaSlot item={primaryMedia} />
        </div>
      ) : null}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: var(--color-bg);
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #1E4B8F;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  /* Rebuilt Feature Cards Grid */
  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .feature-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
