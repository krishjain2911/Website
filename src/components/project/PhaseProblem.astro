---
import MediaSlot from './MediaSlot.astro';
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
import StageComingSoon from './StageComingSoon.astro';

interface Props {
  slug?: string;
  stage1?: {
    tagline: string;
    problem: string;
    painPoints: string[];
  };
  problemData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    process?: string[];
    friction?: { title: string; detail: string }[];
    media?: any[];
    twoColumns?: {
      col1Title: string;
      col1Text: string;
      col2Title: string;
      col2Text: string;
    };
    documentsCovered?: string[];
    languages?: string[];
  };
  beforeAfterId?: 'clm' | 'dms' | 'whatsapp';
  tagline?: string;
}

const { stage1, problemData, beforeAfterId } = Astro.props;
const tagline = stage1?.tagline || Astro.props.tagline || problemData?.tagline;
const story = problemData?.story;
const hasContent = !!(
  stage1 ||
  (problemData &&
    (problemData.story ||
      problemData.twoColumns ||
      problemData.documentsCovered?.length ||
      problemData.process?.length ||
      problemData.friction?.length ||
      problemData.points?.length))
);

const primaryMedia = problemData?.media && problemData.media.length > 0 ? problemData.media[0] : undefined;
---

<section
  id="stage-01"
  class="project-chapter-section"
  aria-labelledby="heading-stage-01"
  data-stage-title="Understand the business"
  data-stage-color="#1E4B8F"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #1E4B8F;">Stage 1 of 6</span>
    <h2 id="heading-stage-01" class="chapter-heading">Understand the business</h2>
    {tagline && <p class="chapter-tagline" style="color: #1E4B8F;">{tagline}</p>}
    {!stage1 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage1 ? (
    <div class="stage-streamlined-body">
      <p class="chapter-problem-text">{stage1.problem}</p>
      <ul class="blue-bullet-list" aria-label="Pain points">
        {stage1.painPoints.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="01" stageTitle="Understand the business" color="#1E4B8F" />
  ) : (
    <>
      <!-- Two Columns Layout (e.g. CLM: Who we mapped / What had to hold) -->
      {problemData?.twoColumns && (
        <div class="stage-two-cols-grid">
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">{problemData.twoColumns.col1Title}</h3>
            <p class="col-card-text">{problemData.twoColumns.col1Text}</p>
          </div>
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">{problemData.twoColumns.col2Title}</h3>
            <p class="col-card-text">{problemData.twoColumns.col2Text}</p>
          </div>
        </div>
      )}

      <!-- Chips Layout (e.g. Vernacular Documents: Documents Covered & Languages) -->
      {(problemData?.documentsCovered || problemData?.languages) && (
        <div class="chips-stage-container card-mastercard">
          {problemData?.documentsCovered && (
            <div class="chips-subgroup">
              <span class="chips-group-heading">Documents covered</span>
              <div class="chips-cluster">
                {problemData.documentsCovered.map((doc) => (
                  <span class="meta-chip doc-chip">{doc}</span>
                ))}
              </div>
            </div>
          )}

          {problemData?.languages && (
            <div class="chips-subgroup">
              <span class="chips-group-heading">Languages</span>
              <div class="chips-cluster">
                {problemData.languages.map((lang) => (
                  <span class="meta-chip lang-chip">{lang}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      <!-- Baseline Operational Flow Strip (if present) -->
      {problemData?.process && problemData.process.length > 0 && (
        <div class="problem-process-block">
          <span class="block-mini-title">BASELINE OPERATIONAL FLOW</span>
          <ol class="process-steps-track" aria-label="Original operational steps">
            {problemData.process.map((step, idx) => (
              <li class="process-step-item">
                <span class="process-step-num">0{idx + 1}</span>
                <span class="process-step-text">{step}</span>
                {idx < problemData.process!.length - 1 && (
                  <span class="process-step-arrow" aria-hidden="true">&rarr;</span>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- Friction Grid (if present) -->
      {problemData?.friction && problemData.friction.length > 0 && (
        <div class="problem-split-grid">
          <div class="friction-cards-column">
            <span class="block-mini-title">SYSTEM FRICTION POINTS</span>
            <div class="friction-cards-list">
              {problemData.friction.map((item, idx) => (
                <div class="friction-card card-mastercard" tabindex="0" role="region" aria-label={item.title}>
                  <div class="friction-card-top">
                    <span class="friction-dot-num">{idx + 1}</span>
                    <h3 class="friction-title">{item.title}</h3>
                  </div>
                  <p class="friction-detail">{item.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="friction-media-column">
            {primaryMedia && <MediaSlot item={primaryMedia} />}
          </div>
        </div>
      )}

      <!-- Only show interactive BeforeAfterSlider for DMS or WhatsApp (CLM invented numbers removed) -->
      {beforeAfterId && beforeAfterId !== 'clm' && (
        <div class="problem-interactive-section">
          <BeforeAfterSlider initialTab={beforeAfterId} hideTabs={true} />
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: var(--color-bg);
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  :global(.dark) .project-chapter-section {
    background-color: var(--color-surface-raised);
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #1E4B8F;
    z-index: 2;
  }

  :global(.dark) .project-chapter-section::before {
    background-color: #5B8FE0;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  .chapter-problem-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem 0;
    max-width: 62ch;
  }

  .blue-bullet-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 62ch;
  }

  .blue-bullet-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .blue-bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #1E4B8F;
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0 0;
    max-width: 780px;
  }

  /* Two Columns Layout */
  .stage-two-cols-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .stage-two-cols-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stage-col-card {
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .col-card-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Chips Container */
  .chips-stage-container {
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .chips-subgroup {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chips-group-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .chips-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-chip {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.85rem;
    font-weight: 500;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .lang-chip {
    background-color: rgba(30, 75, 143, 0.08);
    border-color: rgba(30, 75, 143, 0.25);
    color: #1E4B8F;
    font-weight: 600;
  }

  :global(.dark) .lang-chip {
    background-color: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.3);
    color: #60a5fa;
  }

  .problem-process-block {
    margin-top: 1.5rem;
  }

  .block-mini-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.75rem;
  }

  .process-steps-track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .process-step-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .process-step-num {
    font-weight: 700;
    color: #1E4B8F;
  }

  .problem-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .problem-split-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .friction-cards-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .friction-card {
    padding: 1rem 1.25rem;
    border-radius: 8px;
  }

  .friction-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .friction-dot-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgba(238, 75, 43, 0.15);
    color: #EE4B2B;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .friction-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
  }

  .friction-detail {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
