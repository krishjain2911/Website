---
import MediaSlot from './MediaSlot.astro';

interface ScaleItem {
  value: string;
  label: string;
}

interface Props {
  rolloutData?: {
    headline?: string;
    story?: string;
    points?: string[];
    hardening?: string[];
    steps?: string[];
    scale?: ScaleItem[];
    media?: any[];
  };
}

const { rolloutData } = Astro.props;
if (!rolloutData) return null;

const primaryMedia = rolloutData.media && rolloutData.media.length > 0 ? rolloutData.media[0] : undefined;
---

<section id="chapter-rollout" class="project-chapter-section" aria-labelledby="heading-rollout">
  <div class="chapter-header">
    <div class="chapter-badge-wrap">
      <span class="chapter-num-badge">05</span>
      <span class="chapter-phase-tag">ENTERPRISE ROLLOUT</span>
    </div>
    <h2 id="heading-rollout" class="chapter-heading">{rolloutData.headline || 'Hardened Deployment at Scale'}</h2>
    {rolloutData.story && <p class="chapter-story">{rolloutData.story}</p>}
  </div>

  <!-- Scale Metrics Strip -->
  {rolloutData.scale && rolloutData.scale.length > 0 && (
    <div class="rollout-scale-strip">
      {rolloutData.scale.map((item) => (
        <div class="scale-stat-card card-mastercard">
          <span class="scale-stat-val">{item.value}</span>
          <span class="scale-stat-label">{item.label}</span>
        </div>
      ))}
    </div>
  )}

  <div class="rollout-grid">
    <!-- Left Column: Hardening Checklist -->
    {rolloutData.hardening && rolloutData.hardening.length > 0 && (
      <div class="hardening-card card-mastercard">
        <span class="block-mini-title">PRODUCTION HARDENING CHECKLIST</span>
        <ul class="hardening-list">
          {rolloutData.hardening.map((item) => (
            <li class="hardening-item">
              <span class="hardening-check-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>
              <span class="hardening-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Right Column: Rollout Sequence & Media -->
    <div class="rollout-right-column">
      {rolloutData.steps && rolloutData.steps.length > 0 && (
        <div class="rollout-steps-card card-mastercard">
          <span class="block-mini-title">PROGRESSIVE ROLLOUT SCHEDULE</span>
          <ol class="rollout-stepper">
            {rolloutData.steps.map((st, idx) => (
              <li class="stepper-node">
                <div class="stepper-marker">
                  <span class="stepper-circle">{idx + 1}</span>
                  {idx < rolloutData.steps!.length - 1 && <span class="stepper-line"></span>}
                </div>
                <div class="stepper-body">
                  <span class="stepper-text">{st}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}

      {primaryMedia ? (
        <MediaSlot
          media={primaryMedia}
          fallbackTitle="Enterprise Rollout Topology"
          fallbackDescription="Cross-region telemetry, distributed clusters, and load stabilization."
        />
      ) : null}

      {rolloutData.points && rolloutData.points.length > 0 && (
        <div class="rollout-points-card card-mastercard">
          <span class="block-mini-title">OPERATIONAL ASSURANCE</span>
          <ul class="rollout-points-list">
            {rolloutData.points.map((pt) => (
              <li class="rollout-point-item">
                <span class="point-dash" aria-hidden="true">&ndash;</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .project-chapter-section {
    padding: var(--space-8, 2rem) 0 var(--space-12, 3rem);
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: calc(var(--header-height, 64px) + 2rem);
  }

  .chapter-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .chapter-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .chapter-num-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--surface-secondary, rgba(0,0,0,0.05));
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .chapter-phase-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .chapter-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: var(--space-3, 0.75rem);
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 780px;
    margin: 0;
  }

  .block-mini-title {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4, 1rem);
  }

  .rollout-scale-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4, 1rem);
    margin-bottom: var(--space-6, 1.5rem);
  }

  .scale-stat-card {
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .scale-stat-val {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .scale-stat-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .rollout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6, 1.5rem);
    align-items: start;
  }

  .hardening-card, .rollout-steps-card, .rollout-points-card {
    padding: var(--space-5, 1.25rem);
  }

  .hardening-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .hardening-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  .hardening-check-icon {
    display: inline-flex;
    color: var(--color-primary);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .hardening-text {
    font-size: 0.9rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .rollout-right-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .rollout-stepper {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .stepper-node {
    display: flex;
    gap: 1rem;
    position: relative;
    padding-bottom: 1.25rem;
  }

  .stepper-node:last-child {
    padding-bottom: 0;
  }

  .stepper-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 28px;
    flex-shrink: 0;
  }

  .stepper-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--surface-secondary);
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .stepper-line {
    flex: 1;
    width: 2px;
    background: var(--border-subtle);
    margin: 4px 0;
    min-height: 20px;
  }

  .stepper-body {
    padding-top: 3px;
  }

  .stepper-text {
    font-size: 0.9rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .rollout-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rollout-point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .point-dash {
    color: var(--color-primary);
    font-weight: bold;
  }

  @media (max-width: 900px) {
    .rollout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
