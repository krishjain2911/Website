---
import MediaSlot from './MediaSlot.astro';
import MediaPicture from './MediaPicture.astro';
import MediaLoop from './MediaLoop.astro';
import StageComingSoon from './StageComingSoon.astro';

interface ScaleItem {
  value: string;
  label: string;
}

interface Stage5Data {
  tagline: string;
  makeItYours: string;
}

interface Props {
  slug?: string;
  stage5?: Stage5Data;
  rolloutData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    hardening?: string[];
    steps?: string[];
    scale?: ScaleItem[];
    media?: any[];
    // CLM fields
    stampingBullets?: string[];
    signingSequence?: string[];
    // Vernacular Documents fields
    threeColumns?: {
      col1Title: string;
      col1Text: string;
      col2Title: string;
      col2Text: string;
      col3Title: string;
      col3Text: string;
    };
    // Sonakshi sequence
    sequence?: string[];
  };
  tagline?: string;
}

const { slug, stage5, rolloutData } = Astro.props;
const tagline = stage5?.tagline || Astro.props.tagline || rolloutData?.tagline;
const story = rolloutData?.story;
const hasContent = Boolean(
  stage5 ||
  (rolloutData &&
    (rolloutData.story ||
      rolloutData.stampingBullets?.length ||
      rolloutData.signingSequence?.length ||
      rolloutData.threeColumns ||
      rolloutData.sequence?.length ||
      rolloutData.steps?.length ||
      rolloutData.hardening?.length ||
      rolloutData.points?.length))
);

const primaryMedia = rolloutData?.media && rolloutData.media.length > 0 ? rolloutData.media[0] : undefined;
---

<section
  id="stage-05"
  class="project-chapter-section"
  aria-labelledby="heading-stage-05"
  data-stage-title="Refine and deploy"
  data-stage-color="#F25F22"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #F25F22;">Stage 5 of 6</span>
    <h2 id="heading-stage-05" class="chapter-heading">Refine and deploy</h2>
    {tagline && <p class="chapter-tagline" style="color: #F25F22;">{tagline}</p>}
    {!stage5 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage5 ? (
    <div class="stage-streamlined-body">
      <p class="make-it-yours-text">{stage5.makeItYours}</p>
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="05" stageTitle="Refine and deploy" color="#F25F22" />
  ) : (
    <>
      <!-- CLM: Stamping Bullets & Signing Sequence (Two Columns) -->
      {(rolloutData?.stampingBullets || rolloutData?.signingSequence) && (
        <div class="stage-two-cols-grid">
          {rolloutData.stampingBullets && (
            <div class="stage-col-card card-mastercard">
              <h3 class="col-card-title">Stamping</h3>
              <ul class="rollout-bullets-list">
                {rolloutData.stampingBullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          )}

          {rolloutData.signingSequence && (
            <div class="stage-col-card card-mastercard">
              <h3 class="col-card-title">Signing, in order</h3>
              <ol class="rollout-sequence-list">
                {rolloutData.signingSequence.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>

              {slug === 'clm' && (
                <div style="margin-top: 1.25rem;">
                  <MediaPicture
                    slug="clm"
                    file="image103.png"
                    alt="Internal and vendor signee lists with up and down arrows to reorder them."
                    caption="Signers, in the order legal sets."
                  />
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {slug === 'clm' && (
        <div style="margin-top: 1.5rem;">
          <MediaLoop
            slug="clm"
            name="clm-esign"
            caption="Legal sets up e-sign: add signers, reorder, initiate."
          />
        </div>
      )}

      <!-- Vernacular Documents: Three Columns (Minor Revision, Major Revision, New Language) -->
      {rolloutData?.threeColumns && (
        <div class="stage-three-cols-grid">
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">{rolloutData.threeColumns.col1Title}</h3>
            <p class="col-card-text">{rolloutData.threeColumns.col1Text}</p>
          </div>
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">{rolloutData.threeColumns.col2Title}</h3>
            <p class="col-card-text">{rolloutData.threeColumns.col2Text}</p>
          </div>
          <div class="stage-col-card card-mastercard">
            <h3 class="col-card-title">{rolloutData.threeColumns.col3Title}</h3>
            <p class="col-card-text">{rolloutData.threeColumns.col3Text}</p>
          </div>
        </div>
      )}

      {slug === 'vernacular-documents' && (
        <div style="margin-top: 1.5rem;">
          <MediaPicture
            slug="vernacular-documents"
            file="image20v.png"
            alt="Edit template screen with a language dropdown listing Indian languages."
            caption="Clone a template for a new language."
          />
        </div>
      )}

      <!-- Sonakshi: Numbered Sequence 1-3 -->
      {rolloutData?.sequence && (
        <div class="sequence-container card-mastercard">
          <ol class="sonakshi-sequence-list">
            {rolloutData.sequence.map((item, idx) => (
              <li class="seq-step-item">
                <span class="seq-step-badge">Phase 0{idx + 1}</span>
                <span class="seq-step-desc">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- Legacy / Un-refactored Steps (Only if present in untouched pages) -->
      {rolloutData?.steps && rolloutData.steps.length > 0 && !rolloutData.signingSequence && !rolloutData.sequence && (
        <div class="rollout-steps-block">
          <ol class="rollout-steps-list">
            {rolloutData.steps.map((st) => (
              <li>{st}</li>
            ))}
          </ol>
        </div>
      )}

      <!-- Media Slot (e.g. for untouched pages) -->
      {slug !== 'clm' && slug !== 'vernacular-documents' && slug !== 'sonakshi' && primaryMedia && (
        <div class="stage-media-wrapper">
          <MediaSlot item={primaryMedia} />
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: var(--color-bg);
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  :global(.dark) .project-chapter-section {
    background-color: var(--color-surface-raised);
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #1E4B8F;
    z-index: 2;
  }

  :global(.dark) .project-chapter-section::before {
    background-color: #5B8FE0;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .make-it-yours-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 62ch;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0 0;
    max-width: 780px;
  }

  /* Two Columns */
  .stage-two-cols-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .stage-two-cols-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Three Columns */
  .stage-three-cols-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .stage-three-cols-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stage-col-card {
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .col-card-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .rollout-bullets-list,
  .rollout-sequence-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Sonakshi Sequence */
  .sequence-container {
    margin-top: 1.25rem;
    padding: 1.5rem;
    border-radius: 12px;
  }

  .sonakshi-sequence-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .seq-step-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (min-width: 640px) {
    .seq-step-item {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
  }

  .seq-step-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #F25F22;
    background-color: rgba(242, 95, 34, 0.1);
    border: 1px solid rgba(242, 95, 34, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill, 9999px);
    width: fit-content;
    white-space: nowrap;
  }

  .seq-step-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .stage-media-wrapper {
    margin-top: 1.5rem;
  }
</style>
