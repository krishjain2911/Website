---
import MediaSlot from './MediaSlot.astro';
import StageComingSoon from './StageComingSoon.astro';

interface ScaleItem {
  value: string;
  label: string;
}

interface Props {
  rolloutData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    hardening?: string[];
    steps?: string[];
    scale?: ScaleItem[];
    media?: any[];
  };
  tagline?: string;
}

const { rolloutData } = Astro.props;
const tagline = Astro.props.tagline || rolloutData?.tagline;
const story = rolloutData?.story;
const hasContent = !!(rolloutData && (rolloutData.story || rolloutData.hardening?.length || rolloutData.steps?.length || rolloutData.scale?.length || rolloutData.points?.length));

const primaryMedia = rolloutData?.media && rolloutData.media.length > 0 ? rolloutData.media[0] : undefined;
---

<section
  id="stage-05"
  class="project-chapter-section"
  aria-labelledby="heading-stage-05"
  data-stage-title="Refine and deploy"
  data-stage-color="#F25F22"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #F25F22;">STAGE 05</span>
    <h2 id="heading-stage-05" class="chapter-heading">Refine and deploy</h2>
    {tagline && <p class="chapter-tagline" style="color: #F25F22;">{tagline}</p>}
    {story && <p class="chapter-story">{story}</p>}
  </div>

  {!hasContent ? (
    <StageComingSoon stageNumber="05" stageTitle="Refine and deploy" color="#F25F22" />
  ) : (
    <>
      <!-- Scale Metrics Strip -->
      {rolloutData?.scale && rolloutData.scale.length > 0 && (
        <div class="rollout-scale-strip">
          {rolloutData.scale.map((item) => (
            <div class="scale-stat-card card-mastercard">
              <span class="scale-stat-val">{item.value}</span>
              <span class="scale-stat-label">{item.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="rollout-grid">
        <!-- Left Column: Hardening Checklist -->
        {rolloutData?.hardening && rolloutData.hardening.length > 0 && (
          <div class="hardening-card card-mastercard">
            <span class="block-mini-title">PRODUCTION HARDENING CHECKLIST</span>
            <ul class="hardening-list">
              {rolloutData.hardening.map((item) => (
                <li class="hardening-item">
                  <span class="hardening-check-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                  </span>
                  <span class="hardening-text">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Right Column: Rollout Sequence & Media -->
        <div class="rollout-right-column">
          {rolloutData?.steps && rolloutData.steps.length > 0 && (
            <div class="rollout-steps-card card-mastercard">
              <span class="block-mini-title">PROGRESSIVE ROLLOUT SCHEDULE</span>
              <ol class="rollout-stepper">
                {rolloutData.steps.map((st, idx) => (
                  <li class="stepper-node">
                    <div class="stepper-marker">
                      <span class="stepper-circle">{idx + 1}</span>
                      {idx < rolloutData.steps!.length - 1 && <span class="stepper-line"></span>}
                    </div>
                    <div class="stepper-body">
                      <span class="stepper-text">{st}</span>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {primaryMedia ? (
            <MediaSlot item={primaryMedia} />
          ) : null}

          {rolloutData?.points && rolloutData.points.length > 0 && (
            <div class="rollout-points-card card-mastercard">
              <span class="block-mini-title">OPERATIONAL ASSURANCE</span>
              <ul class="rollout-points-list">
                {rolloutData.points.map((pt) => (
                  <li class="rollout-point-item">
                    <span class="point-dash" aria-hidden="true">&ndash;</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </>
  )}
</section>

<style>
  .project-chapter-section {
    padding: clamp(2.5rem, 5vh, 3.75rem) 0;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--nav-height, 72px) + 2rem);
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .chapter-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .chapter-tagline {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .chapter-story {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0;
  }

  .block-mini-title {
    display: block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .rollout-scale-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .scale-stat-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .scale-stat-card {
    background: var(--color-surface-raised);
  }

  .scale-stat-val {
    font-size: 1.75rem;
    font-weight: 800;
    color: #F25F22;
    line-height: 1;
  }

  .scale-stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .rollout-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.5rem;
    align-items: start;
  }

  .hardening-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .hardening-card {
    background: var(--color-surface-raised);
  }

  .hardening-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hardening-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-text-primary);
  }

  .hardening-check-icon {
    display: inline-flex;
    color: #F25F22;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .rollout-right-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rollout-steps-card, .rollout-points-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .rollout-steps-card,
  :global(.dark) .rollout-points-card {
    background: var(--color-surface-raised);
  }

  .rollout-stepper {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .stepper-node {
    display: flex;
    gap: 1rem;
    min-height: 48px;
  }

  .stepper-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    flex-shrink: 0;
  }

  .stepper-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(242, 95, 34, 0.12);
    border: 1px solid #F25F22;
    color: #F25F22;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stepper-line {
    width: 2px;
    flex: 1;
    background: var(--color-border);
    margin: 4px 0;
  }

  .stepper-body {
    padding-bottom: 1rem;
  }

  .stepper-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .rollout-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rollout-point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .point-dash {
    color: #F25F22;
    font-weight: bold;
  }

  @media (max-width: 900px) {
    .rollout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
