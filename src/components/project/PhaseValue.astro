---
import Icon from '../Icon.astro';
import StageComingSoon from './StageComingSoon.astro';

interface MetricItem {
  label: string;
  before?: string;
  after?: string;
  note?: string;
}

interface Props {
  slug?: string;
  stage2?: {
    tagline: string;
    intro: string;
    points: string[];
  };
  valueData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    metrics?: MetricItem[];
    levers?: string[];
    media?: any[];
  };
  tagline?: string;
}

const { stage2, valueData } = Astro.props;
const tagline = stage2?.tagline || Astro.props.tagline || valueData?.tagline;
const story = valueData?.story;
const hasContent = !!(
  stage2 ||
  (valueData &&
    (valueData.story || valueData.metrics?.length || valueData.levers?.length || valueData.points?.length))
);
---

<section
  id="stage-02"
  class="project-chapter-section"
  aria-labelledby="heading-stage-02"
  data-stage-title="Identify latent revenue"
  data-stage-color="#163666"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #163666;">Stage 2 of 6</span>
    <h2 id="heading-stage-02" class="chapter-heading">Identify latent revenue</h2>
    {tagline && <p class="chapter-tagline" style="color: #163666;">{tagline}</p>}
    {!stage2 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage2 ? (
    <div class="stage-streamlined-body">
      <p class="chapter-intro-text">{stage2.intro}</p>
      <ul class="blue-bullet-list" aria-label="Value points">
        {stage2.points.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="02" stageTitle="Identify latent revenue" color="#163666" />
  ) : (
    <>
      <!-- Value Levers List (with bold lead-ins) -->
      {valueData?.levers && valueData.levers.length > 0 && (
        <div class="value-levers-block">
          <ul class="value-levers-grid" aria-label="Value levers">
            {valueData.levers.map((lever) => (
              <li class="value-lever-card card-mastercard">
                <span class="lever-peg-dot" aria-hidden="true"></span>
                <div class="lever-content" set:html={lever}></div>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Legacy / Un-refactored Metrics (Only for untouched pages if present) -->
      {valueData?.metrics && valueData.metrics.length > 0 && (
        <div class="value-metrics-block">
          <span class="block-mini-title">MEASURED PERFORMANCE SHIFTS</span>
          <div class="metrics-grid">
            {valueData.metrics.map((m, idx) => (
              <div class="metric-card card-mastercard">
                <div class="metric-card-header">
                  <span class="metric-badge">KPI 0{idx + 1}</span>
                  <span class="metric-label">{m.label}</span>
                </div>
                <div class="metric-delta-row">
                  <div class="metric-before-box">
                    <span class="delta-label">BEFORE</span>
                    <span class="delta-value before-val">{m.before}</span>
                  </div>
                  <div class="metric-arrow" aria-hidden="true">
                    <Icon name="arrow-right" size={18} />
                  </div>
                  <div class="metric-after-box">
                    <span class="delta-label">AFTER</span>
                    <span class="delta-value after-val">{m.after}</span>
                  </div>
                </div>
                {m.note && <div class="metric-note">{m.note}</div>}
              </div>
            ))}
          </div>
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: #FFFFFF;
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #F7941D;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  .chapter-intro-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem 0;
    max-width: 62ch;
  }

  .blue-bullet-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 62ch;
  }

  .blue-bullet-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .blue-bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #1E4B8F;
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0 0;
    max-width: 780px;
  }

  /* Value Levers Grid */
  .value-levers-block {
    margin-top: 1.25rem;
  }

  .value-levers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .value-levers-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .value-lever-card {
    padding: 1.25rem;
    border-radius: 10px;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .lever-peg-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background-color: #F7941D;
    margin-top: 6px;
    flex-shrink: 0;
  }

  .lever-content {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .lever-content :global(strong) {
    color: var(--color-text-primary);
    font-weight: 700;
    display: block;
    margin-bottom: 0.2rem;
  }

  /* Metrics Block */
  .value-metrics-block {
    margin-top: 1.75rem;
  }

  .block-mini-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.75rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .metric-card {
    padding: 1.25rem;
    border-radius: 10px;
  }

  .metric-card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .metric-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #163666;
  }

  .metric-delta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .metric-before-box,
  .metric-after-box {
    display: flex;
    flex-direction: column;
  }

  .delta-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .delta-value {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .after-val {
    color: #10B981;
  }

  .metric-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
</style>
