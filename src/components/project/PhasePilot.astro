---
import MediaSlot from './MediaSlot.astro';
import MediaPicture from './MediaPicture.astro';
import MediaLoop from './MediaLoop.astro';
import VideoEmbed from './VideoEmbed.astro';
import StageComingSoon from './StageComingSoon.astro';

interface RoleTab {
  role: string;
  pill: string;
  action: string;
  tasks: string[];
}

interface RoleCard {
  role: string;
  desc: string;
}

interface Stage4Data {
  tagline: string;
  intro: string;
  videoId?: string;
}

interface Props {
  slug?: string;
  stage4?: Stage4Data;
  pageName?: string;
  pilotData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    media?: any[];
    // CLM 6 Tabs
    roleTabs?: RoleTab[];
    note?: string;
    // Sonakshi Role Cards
    roleCards?: RoleCard[];
  };
  tagline?: string;
}

const { slug, stage4, pageName, pilotData } = Astro.props;
const tagline = stage4?.tagline || Astro.props.tagline || pilotData?.tagline;
const story = pilotData?.story;
const hasContent = !!(
  stage4 ||
  (pilotData &&
    (pilotData.story ||
      pilotData.roleTabs?.length ||
      pilotData.roleCards?.length ||
      pilotData.points?.length))
);

const clmRoleMedia: Record<string, { file: string; alt: string; caption: string }> = {
  'Requestor': {
    file: 'image5.png',
    alt: 'Add contract request form with currency, value, nature, dates and department.',
    caption: 'Requestor: create a request.'
  },
  'Risk reviewer': {
    file: 'image47.png',
    alt: 'Contract request showing outsourcing type checkboxes and a Submit for legal review button.',
    caption: 'Risk reviewer: classify outsourcing type.'
  },
  'Legal': {
    file: 'image67.png',
    alt: 'Documents tab with supporting documents, agreement document, revision history and accept or upload revision buttons.',
    caption: 'Legal: manage agreement versions.'
  }
};

const primaryMedia = pilotData?.media && pilotData.media.length > 0 ? pilotData.media[0] : undefined;
---

<section
  id="stage-04"
  class="project-chapter-section"
  aria-labelledby="heading-stage-04"
  data-stage-title="Pilot with on-ground teams"
  data-stage-color="#F7941D"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #F7941D;">Stage 4 of 6</span>
    <h2 id="heading-stage-04" class="chapter-heading">Pilot with on-ground teams</h2>
    {tagline && <p class="chapter-tagline" style="color: #F7941D;">{tagline}</p>}
    {!stage4 && story && <p class="chapter-story">{story}</p>}
  </div>

  {stage4 ? (
    <div class="stage-streamlined-body">
      <p class="chapter-intro-text">{stage4.intro}</p>
      <VideoEmbed id={stage4.videoId} pageName={pageName || 'Solution'} />
    </div>
  ) : !hasContent ? (
    <StageComingSoon stageNumber="04" stageTitle="Pilot with on-ground teams" color="#F7941D" />
  ) : (
    <>
      <!-- CLM: Six Roles Interactive Dashboard Tabs Component -->
      {pilotData?.roleTabs && pilotData.roleTabs.length > 0 && (
        <div class="clm-role-tabs-widget card-mastercard" id="clm-role-tabs">
          <div class="role-tabs-nav" role="tablist" aria-label="Role queues">
            {pilotData.roleTabs.map((tab, idx) => (
              <button
                type="button"
                class:list={['role-tab-btn', { 'is-active': idx === 0 }]}
                data-role-idx={idx}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`role-panel-${idx}`}
                id={`role-tab-${idx}`}
              >
                {tab.role}
              </button>
            ))}
          </div>

          <div class="role-panels-container">
            {pilotData.roleTabs.map((tab, idx) => (
              <div
                class:list={['role-panel-card', { 'is-active': idx === 0 }]}
                id={`role-panel-${idx}`}
                role="tabpanel"
                aria-labelledby={`role-tab-${idx}`}
                hidden={idx !== 0}
              >
                <div class="role-panel-header">
                  <div class="role-panel-title-row">
                    <h3 class="role-title">{tab.role} queue</h3>
                    <span class="stage-pill-badge">{tab.pill}</span>
                  </div>
                  <button type="button" class="btn btn-secondary role-action-btn" disabled>
                    <span>{tab.action}</span>
                  </button>
                </div>

                {slug === 'clm' && clmRoleMedia[tab.role] ? (
                  <div class="role-panel-content-split">
                    <div class="role-panel-info">
                      <div class="role-tasks-block">
                        <span class="role-tasks-heading">Role responsibilities</span>
                        <ul class="role-tasks-list">
                          {tab.tasks.map((task) => (
                            <li>{task}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                    <div class="role-panel-media">
                      <MediaPicture
                        slug="clm"
                        file={clmRoleMedia[tab.role].file}
                        alt={clmRoleMedia[tab.role].alt}
                        caption={clmRoleMedia[tab.role].caption}
                      />
                    </div>
                  </div>
                ) : (
                  <div class="role-tasks-block">
                    <span class="role-tasks-heading">Role responsibilities</span>
                    <ul class="role-tasks-list">
                      {tab.tasks.map((task) => (
                        <li>{task}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>

          {pilotData.note && <div class="component-note">{pilotData.note}</div>}
        </div>
      )}

      <!-- Vernacular Documents: Maker / Checker Interactive Simulation -->
      {tagline === 'Maker proposes, checker confirms.' && (
        <div class="maker-checker-widget card-mastercard" id="maker-checker-widget">
          <div class="mc-header">
            <div class="mc-role-toggle" role="radiogroup" aria-label="Simulated role">
              <button
                type="button"
                class="mc-role-btn is-active"
                id="btn-role-maker"
                data-role="maker"
                role="radio"
                aria-checked="true"
              >
                Maker
              </button>
              <button
                type="button"
                class="mc-role-btn"
                id="btn-role-checker"
                data-role="checker"
                role="radio"
                aria-checked="false"
              >
                Checker
              </button>
            </div>
            <span class="mc-sim-badge">Interactive role pilot</span>
          </div>

          <div class="mc-template-card">
            <div class="mc-template-header">
              <div>
                <h3 class="mc-template-name">Affidavit cum undertaking · English</h3>
                <span class="mc-revision-label" id="mc-revision-text">Revision: v1.0 (Draft)</span>
              </div>
              <span class="mc-status-pill is-draft" id="mc-status-pill">Draft</span>
            </div>

            <!-- Dynamic Actions Area depending on role and status -->
            <div class="mc-actions-area" id="mc-actions-area">
              <!-- Rendered via JS -->
            </div>

            <!-- Rejection reason dialog input if needed -->
            <div class="mc-rejection-box" id="mc-rejection-box" style="display: none;">
              <label for="mc-rejection-reason" class="mc-label">Required reason for rejection:</label>
              <input
                type="text"
                id="mc-rejection-reason"
                class="mc-input"
                placeholder="e.g. Placeholder format in section 3 requires correction"
              />
              <button type="button" class="btn btn-secondary mc-btn-reject-confirm" id="btn-confirm-reject">
                Confirm rejection
              </button>
            </div>

            <!-- Toast / Status Message -->
            <div class="mc-message-banner" id="mc-message-banner">
              Select Maker or Checker to test the sign-off handoff.
            </div>
          </div>
        </div>
      )}

      {slug === 'vernacular-documents' && (
        <div class="stage-media-grid-2" style="margin-top: 1.75rem;">
          <MediaPicture
            slug="vernacular-documents"
            file="image23v.png"
            alt="Template under review with Approve and Reject buttons."
            caption="Checker: approve or reject."
          />
          <MediaLoop
            slug="vernacular-documents"
            name="vernacular-template-flow"
            caption="Add a template, preview it with sample data, submit for review."
          />
        </div>
      )}

      <!-- Sonakshi: Three Small Role Cards -->
      {pilotData?.roleCards && pilotData.roleCards.length > 0 && (
        <div class="sonakshi-roles-grid">
          {pilotData.roleCards.map((rc) => (
            <div class="sonakshi-role-card card-mastercard">
              <span class="sonakshi-role-badge">{rc.role}</span>
              <p class="sonakshi-role-desc">{rc.desc}</p>
            </div>
          ))}
        </div>
      )}

      {slug === 'sonakshi' && (
        <div class="stage-media-grid-3" style="margin-top: 1.75rem;">
          <MediaPicture
            slug="sonakshi"
            file="sonakshi-onboarding.png"
            alt="WhatsApp screen showing language selection and retail onboarding."
            caption="1. Retail onboarding."
          />
          <MediaPicture
            slug="sonakshi"
            file="sonakshi-voice-stage.png"
            alt="Audio waveform card with transliterated voice note and parsed items."
            caption="2. Voice parsing."
          />
          <MediaPicture
            slug="sonakshi"
            file="sonakshi-cart-qr.png"
            alt="Confirmed cart with UPI payment QR code."
            caption="3. Cart and QR."
          />
        </div>
      )}

      <!-- Stage Media (e.g. YouTube Demo Placeholder) -->
      {slug !== 'sonakshi' && slug !== 'vernacular-documents' && slug !== 'clm' && primaryMedia && (
        <div class="stage-media-wrapper">
          {primaryMedia.type === 'video' ? (
            <div class="youtube-demo-placeholder card-mastercard">
              <!-- TODO: Insert confirmed YouTube video ID from founder when available -->
              <div class="video-placeholder-frame">
                <div class="play-button-icon" aria-hidden="true">▶</div>
                <span class="video-caption-label">{primaryMedia.caption}</span>
              </div>
            </div>
          ) : (
            <MediaSlot item={primaryMedia} />
          )}
        </div>
      )}
    </>
  )}
</section>

<style>
  .project-chapter-section {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    padding: 40px;
    background-color: #FFFFFF;
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-height, 72px) + 24px);
    outline: none;
    box-sizing: border-box;
  }

  :global(.dark) .project-chapter-section {
    background-color: var(--color-surface);
  }

  .project-chapter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #F7941D;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .project-chapter-section {
      padding: 24px;
      border-radius: 24px;
    }
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .chapter-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
    overflow: visible;
    padding-left: 1px;
  }

  .chapter-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.2rem 0 0 0;
  }

  .chapter-intro-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem 0;
    max-width: 62ch;
  }

  .chapter-story {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0 0;
    max-width: 780px;
  }

  /* CLM 6 Tabs Widget */
  .clm-role-tabs-widget {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 12px;
  }

  .role-tabs-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .role-tab-btn {
    border: none;
    background: transparent;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .role-tab-btn:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg);
  }

  .role-tab-btn.is-active {
    background-color: #1E4B8F;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(30, 75, 143, 0.25);
  }

  .role-panels-container {
    margin-top: 1.25rem;
  }

  .role-panel-card {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
  }

  .role-panel-card.is-active {
    display: flex;
  }

  .role-panel-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .role-panel-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .role-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .stage-pill-badge {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(247, 148, 29, 0.12);
    border: 1px solid rgba(247, 148, 29, 0.3);
    color: #F7941D;
  }

  .role-action-btn {
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    opacity: 0.9;
  }

  .role-panel-content-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 860px) {
    .role-panel-content-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stage-media-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .stage-media-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stage-media-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .stage-media-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .role-tasks-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .role-tasks-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .role-tasks-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .component-note {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* Vernacular Maker / Checker Widget */
  .maker-checker-widget {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mc-role-toggle {
    display: inline-flex;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill, 9999px);
    padding: 3px;
  }

  .mc-role-btn {
    border: none;
    background: transparent;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mc-role-btn.is-active {
    background-color: #F7941D;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(247, 148, 29, 0.3);
  }

  .mc-sim-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .mc-template-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mc-template-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .mc-template-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .mc-revision-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .mc-status-pill {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .mc-status-pill.is-draft {
    background-color: rgba(100, 116, 139, 0.15);
    color: #64748b;
  }

  .mc-status-pill.is-review {
    background-color: rgba(247, 148, 29, 0.15);
    color: #F7941D;
  }

  .mc-status-pill.is-active {
    background-color: rgba(16, 185, 129, 0.15);
    color: #10B981;
  }

  .mc-actions-area {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .mc-btn-primary {
    background-color: #1E4B8F;
    color: #ffffff;
    border: none;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .mc-btn-reject {
    background-color: transparent;
    color: #EE4B2B;
    border: 1px solid #EE4B2B;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .mc-rejection-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background-color: var(--color-bg);
    border-radius: 6px;
  }

  .mc-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .mc-input {
    padding: 0.4rem 0.65rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 0.85rem;
  }

  .mc-btn-reject-confirm {
    align-self: flex-start;
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
  }

  .mc-message-banner {
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    background-color: var(--color-bg);
    border-left: 3px solid #F7941D;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* Sonakshi 3 Role Cards */
  .sonakshi-roles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .sonakshi-roles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sonakshi-role-card {
    padding: 1.25rem;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sonakshi-role-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: #F7941D;
  }

  .sonakshi-role-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Video Demo Placeholder */
  .stage-media-wrapper {
    margin-top: 1.5rem;
  }

  .video-placeholder-frame {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .play-button-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #F7941D;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    padding-left: 4px;
    box-shadow: 0 4px 16px rgba(247, 148, 29, 0.4);
  }

  .video-caption-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #cbd5e1;
  }
</style>

<script>
  // CLM Role Tabs switching
  function initClmTabs() {
    const tabsContainer = document.getElementById('clm-role-tabs');
    if (!tabsContainer) return;

    const tabButtons = tabsContainer.querySelectorAll<HTMLButtonElement>('.role-tab-btn');
    const panels = tabsContainer.querySelectorAll<HTMLElement>('.role-panel-card');

    tabButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => {
          p.classList.remove('is-active');
          p.hidden = true;
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        if (panels[idx]) {
          panels[idx].classList.add('is-active');
          panels[idx].hidden = false;
        }
      });
    });
  }

  // Vernacular Maker/Checker State Machine
  function initMakerChecker() {
    const widget = document.getElementById('maker-checker-widget');
    if (!widget) return;

    const btnMaker = document.getElementById('btn-role-maker');
    const btnChecker = document.getElementById('btn-role-checker');
    const revisionEl = document.getElementById('mc-revision-text');
    const statusPill = document.getElementById('mc-status-pill');
    const actionsArea = document.getElementById('mc-actions-area');
    const messageBanner = document.getElementById('mc-message-banner');
    const rejectionBox = document.getElementById('mc-rejection-box');
    const rejectionInput = document.getElementById('mc-rejection-reason') as HTMLInputElement | null;
    const btnConfirmReject = document.getElementById('btn-confirm-reject');

    if (!btnMaker || !btnChecker || !revisionEl || !statusPill || !actionsArea || !messageBanner) return;

    let role: 'maker' | 'checker' = 'maker';
    let status: 'draft' | 'under_review' | 'active' = 'draft';
    let minorVersion = 0;
    let lastRejectionReason = '';

    function updateView() {
      // Update Pill
      statusPill!.className = 'mc-status-pill';
      if (status === 'draft') {
        statusPill!.classList.add('is-draft');
        statusPill!.textContent = 'Draft';
      } else if (status === 'under_review') {
        statusPill!.classList.add('is-review');
        statusPill!.textContent = 'Under review';
      } else if (status === 'active') {
        statusPill!.classList.add('is-active');
        statusPill!.textContent = 'Active';
      }

      revisionEl!.textContent = `Revision: v1.${minorVersion} (${statusPill!.textContent})`;

      // Render Actions
      actionsArea!.innerHTML = '';
      if (rejectionBox) rejectionBox.style.display = 'none';

      if (role === 'maker') {
        if (status === 'draft') {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'mc-btn-primary';
          btn.textContent = 'Submit for review';
          btn.addEventListener('click', () => {
            status = 'under_review';
            messageBanner!.textContent = 'Template is submitted for review.';
            updateView();
          });
          actionsArea!.appendChild(btn);
        } else if (status === 'under_review') {
          const info = document.createElement('span');
          info.className = 'mc-label';
          info.textContent = 'Waiting for Checker sign-off. Switch to Checker role to review.';
          actionsArea!.appendChild(info);
        } else if (status === 'active') {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'mc-btn-primary';
          btn.textContent = 'Create revision';
          btn.addEventListener('click', () => {
            minorVersion++;
            status = 'draft';
            messageBanner!.textContent = 'The previous version stays active until this one is approved.';
            updateView();
          });
          actionsArea!.appendChild(btn);
        }
      } else if (role === 'checker') {
        if (status === 'under_review') {
          const btnApprove = document.createElement('button');
          btnApprove.type = 'button';
          btnApprove.className = 'mc-btn-primary';
          btnApprove.textContent = 'Approve';
          btnApprove.addEventListener('click', () => {
            status = 'active';
            messageBanner!.textContent = 'Template approved. It can now serve document requests.';
            updateView();
          });

          const btnReject = document.createElement('button');
          btnReject.type = 'button';
          btnReject.className = 'mc-btn-reject';
          btnReject.textContent = 'Reject';
          btnReject.addEventListener('click', () => {
            if (rejectionBox) rejectionBox.style.display = 'flex';
          });

          actionsArea!.appendChild(btnApprove);
          actionsArea!.appendChild(btnReject);
        } else if (status === 'draft') {
          const info = document.createElement('span');
          info.className = 'mc-label';
          info.textContent = lastRejectionReason
            ? `Returned to Draft. Reason: "${lastRejectionReason}". Waiting for Maker submission.`
            : 'Template is currently in Draft by Maker.';
          actionsArea!.appendChild(info);
        } else if (status === 'active') {
          const info = document.createElement('span');
          info.className = 'mc-label';
          info.textContent = 'Template is approved and actively serving document requests.';
          actionsArea!.appendChild(info);
        }
      }
    }

    btnConfirmReject?.addEventListener('click', () => {
      const reason = rejectionInput?.value.trim() || 'Required corrections needed.';
      lastRejectionReason = reason;
      status = 'draft';
      messageBanner!.textContent = `Template rejected: ${reason}`;
      updateView();
    });

    btnMaker.addEventListener('click', () => {
      role = 'maker';
      btnMaker.classList.add('is-active');
      btnMaker.setAttribute('aria-checked', 'true');
      btnChecker.classList.remove('is-active');
      btnChecker.setAttribute('aria-checked', 'false');
      updateView();
    });

    btnChecker.addEventListener('click', () => {
      role = 'checker';
      btnChecker.classList.add('is-active');
      btnChecker.setAttribute('aria-checked', 'true');
      btnMaker.classList.remove('is-active');
      btnMaker.setAttribute('aria-checked', 'false');
      updateView();
    });

    updateView();
  }

  function initStage4Components() {
    initClmTabs();
    initMakerChecker();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStage4Components);
  } else {
    initStage4Components();
  }
  document.addEventListener('astro:page-load', initStage4Components);
</script>
