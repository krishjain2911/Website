---
import MediaSlot from './MediaSlot.astro';
import Icon from '../Icon.astro';
import StageComingSoon from './StageComingSoon.astro';

interface FeedbackItem {
  heard: string;
  changed: string;
}

interface Props {
  pilotData?: {
    tagline?: string;
    headline?: string;
    story?: string;
    points?: string[];
    scope?: {
      who?: string;
      where?: string;
      duration?: string;
    };
    feedback?: FeedbackItem[];
    media?: any[];
  };
  tagline?: string;
}

const { pilotData } = Astro.props;
const tagline = Astro.props.tagline || pilotData?.tagline;
const story = pilotData?.story;
const hasContent = !!(pilotData && (pilotData.story || pilotData.feedback?.length || pilotData.scope || pilotData.points?.length));

const primaryMedia = pilotData?.media && pilotData.media.length > 0 ? pilotData.media[0] : undefined;
---

<section
  id="stage-04"
  class="project-chapter-section"
  aria-labelledby="heading-stage-04"
  data-stage-title="Pilot with on-ground teams"
  data-stage-color="#F7941D"
  tabindex="-1"
>
  <div class="chapter-header">
    <span class="chapter-eyebrow" style="color: #F7941D;">STAGE 04</span>
    <h2 id="heading-stage-04" class="chapter-heading">Pilot with on-ground teams</h2>
    {tagline && <p class="chapter-tagline" style="color: #F7941D;">{tagline}</p>}
    {story && <p class="chapter-story">{story}</p>}
  </div>

  {!hasContent ? (
    <StageComingSoon stageNumber="04" stageTitle="Pilot with on-ground teams" color="#F7941D" />
  ) : (
    <>
      <!-- Pilot Scope Strip -->
      {pilotData?.scope && (pilotData.scope.who || pilotData.scope.where || pilotData.scope.duration) && (
        <div class="pilot-scope-strip card-mastercard">
          <div class="scope-col">
            <span class="scope-icon" aria-hidden="true">
              <Icon name="users" size={18} />
            </span>
            <div class="scope-content">
              <span class="scope-label">PARTICIPANTS</span>
              <span class="scope-value">{pilotData.scope.who || 'Target Operational Unit'}</span>
            </div>
          </div>
          <div class="scope-divider" aria-hidden="true"></div>
          <div class="scope-col">
            <span class="scope-icon" aria-hidden="true">
              <Icon name="map-pin" size={18} />
            </span>
            <div class="scope-content">
              <span class="scope-label">ENVIRONMENT / SITE</span>
              <span class="scope-value">{pilotData.scope.where || 'Live Production Sandbox'}</span>
            </div>
          </div>
          <div class="scope-divider" aria-hidden="true"></div>
          <div class="scope-col">
            <span class="scope-icon" aria-hidden="true">
              <Icon name="compass" size={18} />
            </span>
            <div class="scope-content">
              <span class="scope-label">TRIAL WINDOW</span>
              <span class="scope-value">{pilotData.scope.duration || 'Initial Deployment Sprint'}</span>
            </div>
          </div>
        </div>
      )}

      <!-- Two-Column Feedback & Media -->
      <div class="pilot-content-grid">
        <!-- "We heard -> We changed" Column -->
        {pilotData?.feedback && pilotData.feedback.length > 0 && (
          <div class="pilot-feedback-column">
            <span class="block-mini-title">GROUND FEEDBACK ITERATIONS</span>
            <div class="feedback-cards-list">
              {pilotData.feedback.map((item) => (
                <div class="feedback-card card-mastercard">
                  <div class="feedback-sub-box heard-box">
                    <div class="feedback-tag tag-heard">WE HEARD</div>
                    <p class="feedback-text heard-text">"{item.heard}"</p>
                  </div>
                  <div class="feedback-bridge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 5v14M5 12l7 7 7-7" />
                    </svg>
                  </div>
                  <div class="feedback-sub-box changed-box">
                    <div class="feedback-tag tag-changed">WE ENGINEERED</div>
                    <p class="feedback-text changed-text">{item.changed}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Media / Points Column -->
        <div class="pilot-side-column">
          {primaryMedia ? (
            <MediaSlot item={primaryMedia} />
          ) : null}

          {pilotData?.points && pilotData.points.length > 0 && (
            <div class="pilot-points-card card-mastercard">
              <span class="block-mini-title">PILOT LEARNINGS &amp; MILESTONES</span>
              <ul class="pilot-points-list">
                {pilotData.points.map((pt) => (
                  <li class="pilot-point-item">
                    <span class="point-marker" aria-hidden="true">&bull;</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </>
  )}
</section>

<style>
  .project-chapter-section {
    padding: clamp(2.5rem, 5vh, 3.75rem) 0;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--nav-height, 72px) + 2rem);
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .chapter-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .chapter-heading {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .chapter-tagline {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .chapter-story {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0;
  }

  .block-mini-title {
    display: block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .pilot-scope-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .pilot-scope-strip {
    background: var(--color-surface-raised);
  }

  .scope-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 180px;
  }

  .scope-icon {
    display: inline-flex;
    color: #F7941D;
    background: rgba(247, 148, 29, 0.1);
    padding: 8px;
    border-radius: 8px;
  }

  .scope-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .scope-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .scope-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .scope-divider {
    width: 1px;
    height: 36px;
    background: var(--color-border);
  }

  .pilot-content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .feedback-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feedback-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.dark) .feedback-card {
    background: var(--color-surface-raised);
  }

  .feedback-sub-box {
    padding: 0.75rem;
    border-radius: 6px;
  }

  .heard-box {
    background: rgba(238, 75, 43, 0.06);
    border: 1px solid rgba(238, 75, 43, 0.18);
  }

  .changed-box {
    background: rgba(247, 148, 29, 0.08);
    border: 1px solid rgba(247, 148, 29, 0.22);
  }

  .feedback-tag {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .tag-heard {
    color: #EE4B2B;
  }

  .tag-changed {
    color: #F7941D;
  }

  .feedback-text {
    font-size: 0.85rem;
    line-height: 1.45;
    margin: 0;
  }

  .heard-text {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .changed-text {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .feedback-bridge {
    display: flex;
    justify-content: center;
    color: #F7941D;
    opacity: 0.8;
  }

  .pilot-side-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pilot-points-card {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  :global(.dark) .pilot-points-card {
    background: var(--color-surface-raised);
  }

  .pilot-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pilot-point-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .point-marker {
    color: #F7941D;
    font-weight: bold;
    font-size: 1.1rem;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .pilot-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
