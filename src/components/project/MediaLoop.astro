---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  slug: string;
  name: string; // e.g. "clm-esign", "vernacular-template-flow", "sonakshi-admin-upload"
  caption: string;
  alt?: string;
  aspectRatio?: string;
  class?: string;
}

const {
  slug,
  name,
  caption,
  alt = caption,
  aspectRatio = '16 / 9',
  class: className = ''
} = Astro.props;

const base = `public/images/solutions/${slug}/loops/${name}`;
const hasMp4 = fs.existsSync(path.resolve(`${base}.mp4`));
const hasWebm = fs.existsSync(path.resolve(`${base}.webm`));
const hasPoster = fs.existsSync(path.resolve(`${base}.jpg`));
const url = `/images/solutions/${slug}/loops/${name}`;
const gifPath = path.resolve(`${base}.gif`);
const webpPath = path.resolve(`${base}.webp`);
const hasGif = fs.existsSync(gifPath);
const hasWebp = fs.existsSync(webpPath);
---

<figure class={`media-loop-figure ${className}`}>
  {hasMp4 ? (
    <div class="media-loop-wrapper" style={`aspect-ratio: ${aspectRatio};`}>
      <video
        class="media-loop-video js-media-loop"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        aria-label={alt}
        poster={hasPoster ? `${url}.jpg` : undefined}
      >
        {hasWebm && <source src={`${url}.webm`} type="video/webm" />}
        <source src={`${url}.mp4`} type="video/mp4" />
      </video>
      <button
        type="button"
        class="media-loop-toggle js-loop-toggle"
        aria-label="Pause animation"
        aria-pressed="false"
      >
        <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
  ) : hasGif || hasWebp ? (
    <div class="media-loop-wrapper" style={`aspect-ratio: ${aspectRatio};`}>
      <img
        src={`/images/solutions/${slug}/loops/${name}.${hasWebp ? 'webp' : 'gif'}`}
        alt={alt}
        loading="lazy"
        class="media-loop-img"
      />
    </div>
  ) : (
    <div class="media-loop-placeholder" style={`aspect-ratio: ${aspectRatio};`}>
    
      <div class="placeholder-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="9" />
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" opacity="0.3" />
        </svg>
      </div>
      <span class="placeholder-name">{name}.mp4</span>
      <span class="placeholder-label">Workflow animation incoming</span>
    </div>
  )}
  <figcaption class="media-loop-caption">{caption}</figcaption>
</figure>

<script>
  function initMediaLoops() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (v.dataset.userPaused === '1' || reduce) return;
          e.isIntersecting ? v.play().catch(() => {}) : v.pause();
        }), { threshold: 0.25 })
      : null;
    document.querySelectorAll<HTMLVideoElement>('.js-media-loop:not([data-loop-init])').forEach((v) => {
      v.dataset.loopInit = '1'; v.muted = true; v.defaultMuted = true;
      const btn = v.parentElement?.querySelector<HTMLButtonElement>('.js-loop-toggle');
      const sync = () => { const paused = v.paused; btn?.setAttribute('aria-pressed', String(paused));
        btn?.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation'); btn?.classList.toggle('is-paused', paused); };
      if (reduce) { v.pause(); v.currentTime = 0; v.dataset.userPaused = '1'; }
      v.addEventListener('play', sync); v.addEventListener('pause', sync); sync();
      btn?.addEventListener('click', () => {
        if (v.paused) { v.dataset.userPaused = '0'; v.play().catch(() => {}); } else { v.dataset.userPaused = '1'; v.pause(); }
      });
      io?.observe(v);
    });
  }
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', initMediaLoops) : initMediaLoops();
  document.addEventListener('astro:page-load', initMediaLoops);
</script>

<style>
  .media-loop-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .media-loop-wrapper {
    position: relative;
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    background: var(--color-surface);
  }

  .media-loop-toggle {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 0;
    display: grid;
    place-items: center;
    background: rgba(10, 12, 18, 0.62);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  .media-loop-wrapper:hover .media-loop-toggle,
  .media-loop-toggle:focus-visible,
  .media-loop-toggle.is-paused {
    opacity: 1;
  }

  @media (hover: none) {
    .media-loop-toggle {
      opacity: 0.85;
    }
  }

  .media-loop-toggle .icon-play {
    display: none;
  }

  .media-loop-toggle.is-paused .icon-play {
    display: block;
  }

  .media-loop-toggle.is-paused .icon-pause {
    display: none;
  }

  .media-loop-toggle:focus-visible {
    outline: 2px solid #F7941D;
    outline-offset: 2px;
  }

  .media-loop-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-loop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.is-portrait) .media-loop-wrapper {
    max-width: 360px;
    margin-inline: auto;
  }

  .media-loop-placeholder {
    width: 100%;
    min-width: 0;
    border-radius: 12px;
    border: 1px dashed var(--color-border);
    background: var(--color-surface-subtle, rgba(0, 0, 0, 0.02));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
  }

  .placeholder-icon {
    opacity: 0.6;
  }

  .placeholder-name {
    font-family: monospace;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .placeholder-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
  }

  .media-loop-caption {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    padding-left: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .media-loop-video {
      animation: none;
    }
  }
</style>
