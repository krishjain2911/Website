---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';

const { approach } = siteConfig;
const steps = approach.steps;
---

<section id="approach" class="approach-section" aria-labelledby="approach-heading">
  <div class="container approach-container">
    <!-- Section Header (Left-aligned, leaving right side clear for thread path) -->
    <div class="approach-header">
      <span class="eyebrow">{approach.badge}</span>
      <h2 id="approach-heading" class="approach-title">{approach.headline}</h2>
      <p class="approach-subline">{approach.subline}</p>
    </div>

    <!-- Vertical Journey Stops Stage -->
    <div class="approach-journey-stage" id="approach-journey-stage">
      <!-- Semantic Accessible Stops List (<ol>) -->
      <ol class="journey-stops-list" id="journey-stops-list">
        {steps.map((step, idx) => {
          const isLeft = idx % 2 === 0;
          return (
            <li
              class={`journey-stop journey-stop--${isLeft ? 'left' : 'right'} is-upcoming`}
              id={`journey-stop-${idx}`}
              data-stop={idx}
              style={`--step-accent: ${step.color};`}
            >
              <!-- Pin Marker on Road -->
              <div class="road-pin-marker" aria-hidden="true">
                <span class="pin-ring-pulse"></span>
                <div class="pin-inner-badge">
                  <span class="pin-num">0{step.number}</span>
                  <Icon name={step.icon} size={13} class="pin-glyph" />
                </div>
              </div>

              <!-- Stop Card -->
              <article class="stop-content-card card-mastercard">
                <div class="card-accent-bar" style={`background-color: ${step.color};`}></div>
                <div class="card-meta-row">
                  <span class="card-stage-eyebrow" style={`color: ${step.color};`}>
                    STAGE 0{step.number}
                  </span>
                </div>
                <h3 class="card-heading">{step.title}</h3>
                <p class="card-copy">{step.description}</p>
              </article>
            </li>
          );
        })}
      </ol>

      <!-- Finish Marker at the End of Journey -->
      <div class="journey-finish-marker" id="journey-finish-marker" aria-hidden="true">
        <div class="finish-ring-outer"></div>
        <div class="finish-ring-mid"></div>
        <div class="finish-ring-center"></div>
      </div>
    </div>

    <!-- Closing Callout under the road -->
    <div class="approach-closing">
      <a href={approach.closingCta.href} class="btn btn-secondary approach-cta-link">
        <span>{approach.closingCta.label}</span>
        <Icon name="arrow-right" size={18} class="cta-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .approach-section {
    padding-top: 48px;
    padding-bottom: 72px;
    background-color: var(--color-bg);
    position: relative;
    overflow: visible;
  }

  .approach-container {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  /* Left-aligned Header leaving right column clear for incoming thread */
  .approach-header {
    text-align: left;
    max-width: 540px;
    margin-bottom: 3.5rem;
  }

  .approach-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .approach-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Vertical Stage Container */
  .approach-journey-stage {
    position: relative;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Stops List (<ol>) */
  .journey-stops-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 8rem;
    position: relative;
    z-index: 4;
  }

  .journey-stop {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Desktop Alternating Cards: Left vs Right of Road */
  @media (min-width: 900px) {
    .journey-stop--left {
      justify-content: flex-start;
      padding-right: 54%;
    }

    .journey-stop--left .road-pin-marker {
      right: calc(50% - 24px);
      left: auto;
    }

    .journey-stop--right {
      justify-content: flex-end;
      padding-left: 54%;
    }

    .journey-stop--right .road-pin-marker {
      left: calc(50% - 24px);
      right: auto;
    }
  }

  /* Road Pin Marker */
  .road-pin-marker {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    pointer-events: none;
  }

  .pin-inner-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-surface);
    border: 2px solid var(--step-accent, #1E4B8F);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.25, 0.64, 1), background-color 0.3s ease, border-color 0.3s ease;
  }

  .pin-num {
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    color: var(--step-accent, #1E4B8F);
  }

  .pin-glyph {
    color: var(--step-accent, #1E4B8F);
    margin-top: 1px;
  }

  .pin-ring-pulse {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 2px solid var(--step-accent, #1E4B8F);
    opacity: 0;
    transform: scale(0.7);
    pointer-events: none;
  }

  /* Stop Card */
  .stop-content-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }

  .card-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    border-top-left-radius: var(--radius-card);
    border-top-right-radius: var(--radius-card);
  }

  .card-meta-row {
    margin-bottom: 0.5rem;
  }

  .card-stage-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-heading {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .card-copy {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Stop Status Classes */
  .journey-stop.is-upcoming {
    opacity: 0.45;
  }

  .journey-stop.is-active {
    opacity: 1;
  }

  .journey-stop.is-active .pin-inner-badge {
    transform: scale(1.18);
    background-color: var(--step-accent, #1E4B8F);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .journey-stop.is-active .pin-num,
  .journey-stop.is-active .pin-glyph {
    color: #FFFFFF;
  }

  .journey-stop.is-active .pin-ring-pulse {
    animation: pulseRing 2s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  @keyframes pulseRing {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .journey-stop.is-active .stop-content-card {
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--step-accent, #1E4B8F);
  }

  .journey-stop.is-passed {
    opacity: 0.9;
  }

  .journey-stop.is-passed .pin-inner-badge {
    background-color: var(--step-accent, #1E4B8F);
  }

  .journey-stop.is-passed .pin-num,
  .journey-stop.is-passed .pin-glyph {
    color: #FFFFFF;
  }

  /* Finish Marker at end of stage */
  .journey-finish-marker {
    position: relative;
    width: 56px;
    height: 56px;
    margin-top: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .finish-ring-outer {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px dashed #EE4B2B;
    animation: spinSlow 12s linear infinite;
  }

  .finish-ring-mid {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #EE4B2B;
    opacity: 0.6;
  }

  .finish-ring-center {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #EE4B2B;
  }

  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Closing Callout */
  .approach-closing {
    margin-top: 3.5rem;
    text-align: center;
    display: flex;
    justify-content: center;
  }

  .approach-cta-link {
    min-height: 48px;
    padding: 0 1.75rem;
    font-size: var(--fs-body);
  }

  /* Mobile Layout (< 900px) */
  @media (max-width: 899px) {
    .approach-header {
      text-align: left;
      margin-bottom: 2.5rem;
    }

    .journey-stops-list {
      gap: 4.5rem;
    }

    .journey-stop {
      padding-left: 60px;
      justify-content: flex-start;
    }

    .road-pin-marker {
      left: 0;
      right: auto;
    }

    .journey-stop--left,
    .journey-stop--right {
      padding-right: 0;
      padding-left: 60px;
    }
  }

  /* Reduced Motion Fallback */
  @media (prefers-reduced-motion: reduce) {
    .journey-stop {
      opacity: 1 !important;
      transform: none !important;
    }
    .pin-ring-pulse {
      display: none !important;
    }
  }
</style>

<script>
  import { getScrollStory } from '../scripts/scrollStory';

  function initApproachStops() {
    const stops = Array.from(document.querySelectorAll<HTMLElement>('.journey-stop'));
    const section = document.getElementById('approach');
    if (!section || stops.length === 0) return;

    let stopOffsets: number[] = [];

    const story = getScrollStory();

    story.subscribe({
      id: 'approach-stops',
      gateElement: section,
      measure: (vp) => {
        stopOffsets = stops.map((s) => {
          const rect = s.getBoundingClientRect();
          return rect.top + vp.scrollY + rect.height * 0.5;
        });
      },
      update: (vp) => {
        const currentMid = vp.scrollY + vp.viewportHeight * 0.55;

        stops.forEach((stop, idx) => {
          const pinCenter = stopOffsets[idx];
          if (!pinCenter) return;

          const diff = currentMid - pinCenter;

          if (diff < -140) {
            stop.classList.remove('is-active', 'is-passed');
            stop.classList.add('is-upcoming');
          } else if (diff >= -140 && diff <= 180) {
            stop.classList.remove('is-upcoming', 'is-passed');
            stop.classList.add('is-active');
          } else {
            stop.classList.remove('is-upcoming', 'is-active');
            stop.classList.add('is-passed');
          }
        });
      }
    });
  }

  initApproachStops();
  document.addEventListener('astro:after-swap', initApproachStops);
</script>