</style>

<script>
  import { getScrollStory, clamp, lerp } from '../scripts/scrollStory';

  function initApproachJourney() {
    const stage = document.getElementById('approach-journey-stage');
    const section = document.getElementById('approach');
    const heading = document.getElementById('approach-heading');
    const rail = document.getElementById('journey-progress-rail');
    const railText = document.getElementById('rail-indicator-text');
    const railDots = Array.from(document.querySelectorAll<HTMLElement>('.rail-dot'));
    const stops = Array.from(document.querySelectorAll<HTMLElement>('.journey-stop'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.stop-content-card'));
    const pins = Array.from(document.querySelectorAll<HTMLElement>('.road-pin-marker'));

    const bgAperture = document.getElementById('bg-parallax-aperture');
    const bgSquare = document.getElementById('bg-parallax-square');

    if (!section || !stage || stops.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isDesktop = window.innerWidth >= 900;
    const path = (isDesktop
      ? document.getElementById('journey-desktop-path')
      : document.getElementById('journey-mobile-path')) as SVGPathElement | null;

    const cube = (isDesktop
      ? document.getElementById('guide-cube-desktop')
      : document.getElementById('guide-cube-mobile')) as SVGGElement | null;

    const ripple = (isDesktop
      ? document.getElementById('socket-pop-ripple-desktop')
      : document.getElementById('socket-pop-ripple-mobile')) as SVGElement | null;

    if (!path || !cube) return;

    const totalPathLength = path.getTotalLength();
    path.style.strokeDasharray = `${totalPathLength}`;

    if (prefersReducedMotion) {
      path.style.strokeDashoffset = '0';
      stops.forEach((s) => {
        s.classList.remove('is-upcoming');
        s.classList.add('is-passed');
      });
      return;
    }

    /**
     * Binary search to find path length at a target Y coordinate.
     * Guaranteed sub-pixel accuracy since Y is strictly monotonic.
     */
    function getLengthAtY(pathEl: SVGPathElement, targetY: number, totalLen: number): number {
      const startBound = isDesktop ? 60 : 50;
      if (targetY <= startBound) return 0;
      let low = 0;
      let high = totalLen;
      for (let i = 0; i < 14; i++) {
        const mid = (low + high) * 0.5;
        const pt = pathEl.getPointAtLength(mid);
        if (pt.y < targetY) {
          low = mid;
        } else {
          high = mid;
        }
      }
      return (low + high) * 0.5;
    }

    /**
     * Dwell: within +/- 70px of a pin's centre Y, ease the cube onto the pin
     * (smoothstep snap) so it visibly stops there; between pins it glides.
     */
    function calculateDwellY(rawY: number, pinYs: number[]): number {
      if (pinYs.length === 0) return rawY;

      let nearestPin = pinYs[0];
      let minDiff = Math.abs(rawY - nearestPin);
      for (let i = 1; i < pinYs.length; i++) {
        const diff = Math.abs(rawY - pinYs[i]);
        if (diff < minDiff) {
          minDiff = diff;
          nearestPin = pinYs[i];
        }
      }

      const delta = rawY - nearestPin;
      const THRESHOLD = 70; // +/- 70px dwell window

      if (Math.abs(delta) < THRESHOLD) {
        const x = delta / THRESHOLD; // [-1, 1]
        // Deadband within |delta| <= 28px (40%) where the cube completely rests on the pin
        const deadband = 0.40;
        if (Math.abs(x) <= deadband) {
          return nearestPin;
        }
        // Smoothstep snap transition back to linear gliding
        const s = (Math.abs(x) - deadband) / (1 - deadband); // [0, 1]
        const eased = s * s * (3 - 2 * s);
        return nearestPin + Math.sign(delta) * (deadband * THRESHOLD + (1 - deadband) * THRESHOLD * eased);
      }

      return rawY;
    }

    let sectionTop = 0;
    let sectionHeight = 0;
    let stageTop = 0;
    let unit = 1; // screen px per SVG unit (html zoom 0.9 makes this 0.9)
    let pinYList: number[] = [];
    let headingRevealed = false;
    let currentDistance = 0;

    const startX = isDesktop ? 500 : 28;
    const startY = isDesktop ? 60 : 50;
    const finishY = isDesktop ? 2520 : 2160;

    const story = getScrollStory();

    story.subscribe({
      id: 'approach-journey',
      gateElement: section,
      measure: (vp) => {
        const sRect = section.getBoundingClientRect();
        sectionTop = sRect.top + vp.scrollY;
        sectionHeight = sRect.height;

        const stRect = stage.getBoundingClientRect();
        stageTop = stRect.top + vp.scrollY;

        // Screen px per SVG user unit: the road, pins and cube live in SVG units
        const svgEl = document.querySelector<SVGSVGElement>('.journey-desktop-svg');
        unit = isDesktop && svgEl && svgEl.getBoundingClientRect().height > 0
          ? svgEl.getBoundingClientRect().height / 2680
          : 1;

        // Measure live pin center Y in container coordinates from the DOM
        pinYList = pins.map((pin) => {
          const pRect = pin.getBoundingClientRect();
          return ((pRect.top + vp.scrollY + pRect.height * 0.5) - stageTop) / unit;
        });
      },
      update: (vp) => {
        // Trigger word reveal on section heading
        if (!headingRevealed && heading) {
          const hRect = heading.getBoundingClientRect();
          if (hRect.top < vp.viewportHeight * 0.85) {
            heading.classList.add('is-revealed');
            headingRevealed = true;
          }
        }

        // Background Parallax Drift
        if (vp.viewportWidth >= 900) {
          const relScroll = vp.scrollY - sectionTop;
          if (bgAperture) bgAperture.style.transform = `translateY(${relScroll * 0.18}px)`;
          if (bgSquare) bgSquare.style.transform = `rotate(45deg) translateY(${relScroll * -0.14}px)`;
        }

        // Rail visibility handled cleanly by IntersectionObserver below
        // Viewport center line in container coordinates
        const viewportCenterY = ((vp.scrollY + vp.viewportHeight * 0.5) - stageTop) / unit;

        // Sequence: Pop-out when viewport center approaches start socket, then travel
        if (viewportCenterY < startY) {
          const distToStart = startY - viewportCenterY;

          if (distToStart > 220) {
            // Dormant inside hole
            cube.setAttribute('transform', `translate(${startX}, ${startY + 10}) scale(0.2)`);
            cube.style.opacity = '0';
            path.style.strokeDashoffset = `${totalPathLength}`;
            if (ripple) ripple.style.opacity = '0';
            currentDistance = 0;

            stops.forEach((s) => {
              s.classList.remove('is-active', 'is-passed');
              s.classList.add('is-upcoming');
            });
          } else {
            // Pop-Out Sequence: scale 0.2 -> 1, squash-and-stretch, one ripple ring
            const u = 1 - (distToStart / 220); // 0 to 1

            let scale = 1;
            let translateY = 0;
            if (u < 0.7) {
              const t = u / 0.7;
              const eased = Math.sin((t * Math.PI) / 2);
              scale = 0.2 + 0.95 * eased; // 0.2 to 1.15
              translateY = (1 - eased) * 12;
            } else {
              const t = (u - 0.7) / 0.3;
              scale = 1.15 - 0.15 * (t * t); // settles from 1.15 to 1.0
              translateY = 0;
            }

            const alpha = clamp(u / 0.25, 0, 1);
            cube.style.opacity = `${alpha}`;
            cube.setAttribute(
              'transform',
              `translate(${startX}, ${startY - translateY}) scale(${scale.toFixed(3)})`
            );

            // Ripple Ring
            if (ripple) {
              if (u > 0.35) {
                const rT = (u - 0.35) / 0.65;
                const rScale = 0.7 + rT * 1.1; // 0.7 to 1.8
                const rOpacity = (1 - rT) * 0.85;
                ripple.setAttribute('transform', `scale(${rScale.toFixed(2)})`);
                ripple.style.opacity = `${rOpacity}`;
              } else {
                ripple.style.opacity = '0';
              }
            }

            // Road stays completely hidden before cube finishes emergence
            path.style.strokeDashoffset = `${totalPathLength}`;
            currentDistance = 0;

            stops.forEach((s) => {
              s.classList.remove('is-active', 'is-passed');
              s.classList.add('is-upcoming');
            });
          }
        } else {
          // Travel Sequence: Road draw ends at the cube; cube dwells at pins
          if (ripple) ripple.style.opacity = '0';
          cube.style.opacity = '1';

          // Clamp between start and finish
          const clampedRawY = clamp(viewportCenterY, startY, finishY);

          // Apply Dwell snap (+/- 70px) onto nearest pin
          const dwellY = calculateDwellY(clampedRawY, pinYList);

          // Find exact path distance corresponding to dwell Y
          const targetDistance = getLengthAtY(path, dwellY, totalPathLength);

          // Lerp smoothing (~0.12) with instant snap-convergence when stopped
          currentDistance = lerp(currentDistance, targetDistance, 0.12);
          if (Math.abs(currentDistance - targetDistance) < 0.4) {
            currentDistance = targetDistance;
          } else {
            requestAnimationFrame(() => story.requestTick());
          }

          // 1. Road draw (travelled part) ends exactly at the cube
          path.style.strokeDashoffset = `${totalPathLength - currentDistance}`;

          // 2. Guide cube follows path via getPointAtLength
          if (totalPathLength > 0) {
            const pt = path.getPointAtLength(currentDistance);
            const ptNext = path.getPointAtLength(Math.min(totalPathLength, currentDistance + 2));
            const ptPrev = path.getPointAtLength(Math.max(0, currentDistance - 2));

            const angleRad = Math.atan2(ptNext.y - ptPrev.y, ptNext.x - ptPrev.x);
            const angleDeg = (angleRad * 180 / Math.PI) - 90;
            const subtleRotation = Math.max(-16, Math.min(16, angleDeg * 0.35));

            cube.setAttribute(
              'transform',
              `translate(${pt.x.toFixed(1)}, ${pt.y.toFixed(1)}) rotate(${subtleRotation.toFixed(1)}) scale(1.0)`
            );
          }

          // 3. Find nearest pin to viewport centre line
          let nearestIdx = 0;
          let minDistanceToCenter = Infinity;
          pinYList.forEach((pinY, idx) => {
            const dist = Math.abs(viewportCenterY - pinY);
            if (dist < minDistanceToCenter) {
              minDistanceToCenter = dist;
              nearestIdx = idx;
            }
          });

          // 4. Update Stop States: Active = nearest pin; Passed = above centre line
          stops.forEach((stop, idx) => {
            const pinY = pinYList[idx] ?? 0;
            const card = cards[idx];
            const isLeft = idx % 2 === 0;

            stop.classList.remove('is-passed', 'is-active', 'is-upcoming');

            if (viewportCenterY >= pinY + 70) {
              // Passed stops = above the centre line
              stop.classList.add('is-passed');
              if (card && vp.viewportWidth >= 900) {
                card.style.transform = 'translateX(0) translateY(0)';
              }
            } else if (idx === nearestIdx && Math.abs(viewportCenterY - pinY) <= 160) {
              // Active stage = pin nearest the viewport centre
              stop.classList.add('is-active');
              if (card && vp.viewportWidth >= 900) {
                const pRatio = clamp((viewportCenterY - (pinY - 160)) / 320, 0, 1);
                const slideX = (1 - pRatio) * (isLeft ? -8 : 8);
                card.style.transform = `translateX(${slideX.toFixed(1)}px) translateY(-4px) scale(1.02)`;
              }
            } else {
              // Upcoming
              stop.classList.add('is-upcoming');
              if (card && vp.viewportWidth >= 900) {
                card.style.transform = `translateX(${isLeft ? '-4px' : '4px'}) translateY(0)`;
              }
            }
          });

          // 5. Update Rail Indicator & Dots
          if (railText) {
            railText.textContent = `STAGE ${nearestIdx + 1} / 6`;
          }
          railDots.forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === nearestIdx);
            dot.classList.toggle('is-passed', idx < nearestIdx);
            if (idx === nearestIdx) dot.setAttribute('aria-current', 'step');
            else dot.removeAttribute('aria-current');
          });
        }
      }
    });

    // Pill dot click: scroll so that stop's pin sits on the viewport centre line, so the cube parks on it
    railDots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const pinY = pinYList[idx];
        if (pinY === undefined) return;
        const top = stageTop + pinY * unit - window.innerHeight * 0.5;
        window.scrollTo({ top: Math.max(0, Math.round(top)), behavior: 'smooth' });
      });
    });

    // IntersectionObserver to fade pill in/out in 150ms strictly within approach journey section
    if (rail && 'IntersectionObserver' in window) {
      const approachObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          rail.classList.toggle('is-visible', entry.isIntersecting && window.innerWidth >= 900);
        });
      }, {
        threshold: 0,
        rootMargin: '-30px 0px -30px 0px'
      });
      approachObserver.observe(section);
    }

    // Recompute on DOM resize / font load
    const triggerRemount = () => {
      story.invalidate();
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(triggerRemount);
    }

    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(triggerRemount);
      ro.observe(stage);
      ro.observe(section);
      stops.forEach((s) => ro.observe(s));
    }

    window.addEventListener('resize', triggerRemount, { passive: true });
  }

  initApproachJourney();
  document.addEventListener('astro:after-swap', initApproachJourney);
</script>
