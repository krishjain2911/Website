---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const { size = 'md', showText = true, class: className = '' } = Astro.props;
---

<div class={`rhsp-logo-wrapper ${className}`} data-size={size}>
  {showText ? (
    <>
      <img
        src="/brand/Picture1.png"
        alt="RHSP - Round Hole Square Peg"
        class="rhsp-full-logo-img logo-theme-light"
        loading="eager"
        decoding="async"
      />
      <img
        src="/brand/logo-dark-og.png"
        alt="RHSP - Round Hole Square Peg"
        class="rhsp-full-logo-img logo-theme-dark"
        loading="eager"
        decoding="async"
      />
    </>
  ) : (
    <div class="rhsp-glyph-container">
      <img
        src="/brand/rhsp-logo.png"
        alt="RHSP Logo Mark"
        class="rhsp-glyph-img"
        loading="eager"
        decoding="async"
      />
    </div>
  )}
</div>

<style>
  .rhsp-logo-wrapper {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    user-select: none;
  }

  .rhsp-full-logo-img {
    height: 56px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    transition: height 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-size="sm"] .rhsp-full-logo-img {
    height: 48px;
  }

  [data-size="md"] .rhsp-full-logo-img {
    height: 56px;
  }

  [data-size="lg"] .rhsp-full-logo-img {
    height: 72px;
  }

  @media (max-width: 767px) {
    .rhsp-full-logo-img,
    [data-size="sm"] .rhsp-full-logo-img,
    [data-size="md"] .rhsp-full-logo-img,
    [data-size="lg"] .rhsp-full-logo-img {
      height: 42px;
    }
  }

  .rhsp-logo-wrapper:hover .rhsp-full-logo-img,
  .rhsp-logo-wrapper:hover .rhsp-glyph-container {
    transform: scale(1.03);
  }

  .rhsp-glyph-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-size="sm"] .rhsp-glyph-container {
    width: 36px;
    height: 34px;
  }

  [data-size="md"] .rhsp-glyph-container {
    width: 48px;
    height: 46px;
  }

  [data-size="lg"] .rhsp-glyph-container {
    width: 64px;
    height: 61px;
  }

  .rhsp-glyph-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Theme swap: light mode displays .logo-theme-light, dark mode displays .logo-theme-dark */
  .logo-theme-dark {
    display: none !important;
    filter: drop-shadow(0 0 10px rgba(247, 148, 29, 0.18));
  }
  .logo-theme-light {
    display: block !important;
  }

  :global(html[data-theme="dark"]) .logo-theme-light,
  :global([data-theme="dark"]) .logo-theme-light {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .logo-theme-dark,
  :global([data-theme="dark"]) .logo-theme-dark {
    display: block !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-theme-light {
      display: none !important;
    }
    :global(:root:not([data-theme="light"])) .logo-theme-dark {
      display: block !important;
    }
  }
</style>
