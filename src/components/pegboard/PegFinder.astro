---
import Icon from '../Icon.astro';
import { finderQuestions } from '../../data/pegBoard';
---

<div class="peg-finder-container" id="peg-finder-root">
  <!-- Finder Modal (Centered dialog on desktop, bottom sheet on mobile) -->
  <div
    class="finder-panel-wrapper"
    id="finder-sheet-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="finder-heading"
    aria-hidden="true"
  >
    <div class="finder-panel-backdrop" id="finder-sheet-backdrop" tabindex="-1"></div>

    <div class="finder-card card-mastercard" id="finder-card">
      <div class="finder-header">
        <div class="finder-title-group">
          <span class="finder-eyebrow">PEG FINDER</span>
          <h2 class="finder-heading" id="finder-heading">Not sure where to start?</h2>
          <p class="finder-subline">Answer three quick questions. The board highlights your best starting point.</p>
        </div>
        <div class="finder-header-actions">
          <button type="button" class="finder-reset-btn" id="finder-clear-btn" style="display: none;">
            Clear
          </button>
          <button type="button" class="finder-sheet-close-btn" id="finder-sheet-close-btn" aria-label="Close peg finder">
            <Icon name="x" size={16} />
          </button>
        </div>
      </div>

      <!-- Question Groups (fieldset + legend for a11y) -->
      <form class="finder-form" id="finder-form" onsubmit="return false;">
        <div class="finder-questions-row">
          {finderQuestions.slice(0, 3).map((q) => (
            <fieldset class="finder-fieldset" data-question-id={q.id}>
              <legend class="finder-legend">{q.legend}</legend>
              <div class="finder-pills-group" role="radiogroup" aria-label={q.legend}>
                {q.options.map((opt) => (
                  <button
                    type="button"
                    class="finder-pill-btn"
                    data-question={q.id}
                    data-value={opt.value}
                    role="radio"
                    aria-checked="false"
                  >
                    <span>{opt.label}</span>
                  </button>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <!-- Optional 4th chip for existing O11 estate -->
        <div class="finder-optional-row">
          <button
            type="button"
            class="finder-estate-chip"
            id="finder-estate-chip"
            data-value="o11"
            aria-pressed="false"
          >
            <span>+ We already run OutSystems 11</span>
          </button>
        </div>
      </form>

      <!-- Live Dynamic Recommendation Result (aria-live="polite") -->
      <div class="finder-result-box" id="finder-result-box" aria-live="polite" style="display: none;">
        <div class="finder-result-text-col">
          <span class="finder-rec-badge">RECOMMENDED START</span>
          <p class="finder-result-sentence" id="finder-result-sentence">
            <!-- Dynamic sentence -->
          </p>
        </div>
        <div class="finder-result-actions">
          <a href="#" class="btn btn-primary btn-sm finder-open-guide-btn" id="finder-open-guide-btn">
            <span>Open the guide</span>
            <Icon name="arrow-right" size={13} />
          </a>
          <button type="button" class="btn btn-secondary btn-sm" id="finder-view-board-btn">
            <span>View on board</span>
          </button>
          <button type="button" class="btn btn-secondary btn-sm finder-pin-btn" id="finder-pin-btn">
            <Icon name="bookmark" size={13} />
            <span id="finder-pin-btn-text">Pin it</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { togglePin, isPinned } from '../../scripts/pegBoardState';

  function initPegFinder() {
    const root = document.getElementById('peg-finder-root');
    const form = document.getElementById('finder-form');
    const resultBox = document.getElementById('finder-result-box');
    const resultSentence = document.getElementById('finder-result-sentence');
    const openGuideBtn = document.getElementById('finder-open-guide-btn') as HTMLAnchorElement | null;
    const viewBoardBtn = document.getElementById('finder-view-board-btn');
    const pinBtn = document.getElementById('finder-pin-btn') as HTMLButtonElement | null;
    const pinBtnText = document.getElementById('finder-pin-btn-text');
    const clearBtn = document.getElementById('finder-clear-btn');
    const estateChip = document.getElementById('finder-estate-chip');

    // Modal elements
    const sheetDialog = document.getElementById('finder-sheet-dialog');
    const sheetBackdrop = document.getElementById('finder-sheet-backdrop');
    const sheetCloseBtn = document.getElementById('finder-sheet-close-btn');

    if (!root || !form || !resultBox || !resultSentence || !openGuideBtn || !sheetDialog) return;

    const elSheetDialog = sheetDialog;
    const elResultBox = resultBox;
    const elResultSentence = resultSentence;
    const elOpenGuideBtn = openGuideBtn;
    const elClearBtn = clearBtn;

    let answers: Record<string, string> = {};
    let currentBestSlug = '';

    let previousOverflow = '';
    let lastActiveElement: HTMLElement | null = null;
    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement | null;
      elSheetDialog.classList.add('is-sheet-open');
      elSheetDialog.setAttribute('aria-hidden', 'false');
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      sheetCloseBtn?.focus();
    }

    function closeModal() {
      elSheetDialog.classList.remove('is-sheet-open');
      elSheetDialog.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = previousOverflow;
      document.body.style.overflow = '';
      lastActiveElement?.focus();
    }

    // Trigger open from anywhere on the page with data-action="open-finder"
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-action="open-finder"]');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    sheetCloseBtn?.addEventListener('click', closeModal);
    sheetBackdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheetDialog.classList.contains('is-sheet-open')) {
        closeModal();
      }
    });

    viewBoardBtn?.addEventListener('click', () => {
      closeModal();
      if (currentBestSlug) {
        const targetTile = document.querySelector(`[data-tile-slug="${currentBestSlug}"]`);
        targetTile?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Pill click handlers
    const pillButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.finder-pill-btn'));
    pillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const qId = btn.getAttribute('data-question') || '';
        const val = btn.getAttribute('data-value') || '';

        // Deselect other pills in the same group
        root.querySelectorAll<HTMLButtonElement>(`.finder-pill-btn[data-question="${qId}"]`).forEach((b) => {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('is-active');
        });

        // Toggle or set
        if (answers[qId] === val) {
          delete answers[qId];
        } else {
          answers[qId] = val;
          btn.setAttribute('aria-checked', 'true');
          btn.classList.add('is-active');
        }

        evaluateFinder();
      });
    });

    // Optional 4th estate chip
    estateChip?.addEventListener('click', () => {
      const isPressed = estateChip.getAttribute('aria-pressed') === 'true';
      estateChip.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
      estateChip.classList.toggle('is-active', !isPressed);
      if (!isPressed) {
        answers['estate'] = 'o11';
      } else {
        delete answers['estate'];
      }
      evaluateFinder();
    });

    // Clear answers
    function clearFinder() {
      answers = {};
      currentBestSlug = '';
      pillButtons.forEach((b) => {
        b.setAttribute('aria-checked', 'false');
        b.classList.remove('is-active');
      });
      if (estateChip) {
        estateChip.setAttribute('aria-pressed', 'false');
        estateChip.classList.remove('is-active');
      }
      elResultBox.style.display = 'none';
      if (elClearBtn) elClearBtn.style.display = 'none';

      // Restore all tiles on the board to normal
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((tile) => {
        tile.classList.remove('is-lit', 'is-dimmed', 'is-start-here');
      });
    }

    clearBtn?.addEventListener('click', clearFinder);

    // Evaluate matching guide and update board lighting
    function evaluateFinder() {
      const hasAnswers = Object.keys(answers).length > 0;
      if (elClearBtn) elClearBtn.style.display = hasAnswers ? 'inline-block' : 'none';

      if (!hasAnswers) {
        clearFinder();
        return;
      }

      // Mapping rules:
      // 1. "inside our walls" -> Cloud vs on-premises
      // 2. estate == 'o11' -> O11 vs ODC
      // 3. very unique -> Low-code vs high-code vs hybrid
      // 4. weeks + standard-ish -> OutSystems vs MERN
      let bestSlug = 'outsystems-vs-mern';
      let sentence = 'OutSystems vs MERN is your clearest comparison: fast visual workflows alongside full code freedom.';

      if (answers['estate'] === 'o11') {
        bestSlug = 'o11-vs-odc';
        sentence = 'Since you already run OutSystems 11, the O11 vs ODC guide charts where to keep existing applications and where to start new cloud builds.';
      } else if (answers['data'] === 'inside our walls') {
        bestSlug = 'cloud-vs-on-premises';
        sentence = 'Because your data must stay inside your perimeter, the Cloud vs on-premises guide maps sovereign hosting controls against private cloud options.';
      } else if (answers['custom'] === 'very unique') {
        bestSlug = 'low-code-vs-high-code';
        sentence = 'For highly unique logic and experiences, the Low-code vs high-code vs hybrid guide compares bespoke engineering against platform velocity.';
      } else if (answers['speed'] === 'weeks' && answers['custom'] === 'standard-ish') {
        bestSlug = 'outsystems-vs-mern';
        sentence = 'For rapid launch on standard enterprise workflows, OutSystems vs MERN highlights short paths to production with governance.';
      }

      currentBestSlug = bestSlug;

      // When questions answered, display result box
      const coreAnswered = !!(answers['speed'] && answers['custom'] && answers['data']) || !!answers['estate'];
      if (coreAnswered) {
        elResultBox.style.display = 'flex';
        elResultSentence.textContent = sentence;
        elOpenGuideBtn.href = `/peg-board/${bestSlug}`;
        syncPinBtn();
      } else {
        elResultBox.style.display = 'none';
      }

      // Board tile lighting: matching tile is lit, others dim to 35%
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((tileEl) => {
        const slug = tileEl.getAttribute('data-tile-slug');
        if (slug === bestSlug) {
          tileEl.classList.add('is-lit', 'is-start-here');
          tileEl.classList.remove('is-dimmed');
        } else {
          tileEl.classList.add('is-dimmed');
          tileEl.classList.remove('is-lit', 'is-start-here');
        }
      });
    }

    function syncPinBtn() {
      if (!pinBtn || !pinBtnText || !currentBestSlug) return;
      const pinned = isPinned(currentBestSlug);
      pinBtn.classList.toggle('is-pinned', pinned);
      pinBtnText.textContent = pinned ? 'Pinned' : 'Pin it';
    }

    pinBtn?.addEventListener('click', () => {
      if (currentBestSlug) {
        togglePin(currentBestSlug);
        syncPinBtn();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPegFinder);
  } else {
    initPegFinder();
  }
</script>

<style>
  .peg-finder-container {
    position: relative;
    z-index: 10;
  }

  /* Fixed modal overlay */
  .finder-panel-wrapper {
    position: fixed;
    inset: 0;
    z-index: 3500;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    padding: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  .finder-panel-wrapper.is-sheet-open {
    opacity: 1;
    visibility: visible;
  }

  .finder-panel-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .finder-card {
    position: relative;
    width: 100%;
    max-width: 680px;
    max-height: 85dvh;
    overflow-y: auto;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line, var(--color-border));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    z-index: 2;
    transform: scale(0.96);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .finder-panel-wrapper.is-sheet-open .finder-card {
    transform: scale(1);
  }

  @media (max-width: 639px) {
    .finder-panel-wrapper {
      align-items: flex-end;
      padding: 0;
    }

    .finder-card {
      max-width: 100%;
      border-radius: 20px 20px 0 0;
      padding: 1.5rem 1.25rem;
      transform: translateY(100%);
    }

    .finder-panel-wrapper.is-sheet-open .finder-card {
      transform: translateY(0);
    }
  }

  .finder-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .finder-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .finder-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pb-accent, #F7941D);
  }

  .finder-heading {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--pb-text, var(--color-text-primary));
  }

  .finder-subline {
    font-size: 0.875rem;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  .finder-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .finder-reset-btn {
    background: transparent;
    border: none;
    color: var(--pb-accent, #F7941D);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    padding: 0.25rem 0.5rem;
  }

  .finder-sheet-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--pb-line, var(--color-border));
    background: transparent;
    color: var(--pb-text-2, var(--color-text-secondary));
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .finder-sheet-close-btn:hover {
    color: var(--pb-text);
    border-color: var(--pb-accent);
  }

  .finder-questions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .finder-fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .finder-legend {
    font-size: 11px;
    font-weight: 600;
    color: var(--pb-text-2, var(--color-text-muted));
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .finder-pills-group {
    display: flex;
    gap: 0.45rem;
  }

  .finder-pill-btn {
    padding: 0.45rem 0.95rem;
    font-size: 12.5px;
    font-weight: 500;
    border-radius: 999px;
    border: 1px solid var(--pb-line, var(--color-border));
    background-color: var(--pb-tile, #FFFFFF);
    color: var(--pb-text-2, var(--color-text-secondary));
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .finder-pill-btn:hover {
    color: var(--pb-text, var(--color-text-primary));
    border-color: var(--pb-accent, #F7941D);
  }

  .finder-pill-btn.is-active,
  .finder-pill-btn[aria-checked="true"] {
    background-color: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
    border-color: var(--pb-accent, #F7941D);
    color: var(--pb-accent, #F7941D);
    font-weight: 600;
  }

  .finder-optional-row {
    margin-bottom: 1.25rem;
  }

  .finder-estate-chip {
    padding: 0.4rem 0.85rem;
    font-size: 11.5px;
    font-weight: 500;
    border-radius: 6px;
    border: 1px dashed var(--pb-line, var(--color-border));
    background: transparent;
    color: var(--pb-text-2, var(--color-text-secondary));
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .finder-estate-chip:hover {
    color: var(--pb-text);
    border-color: var(--pb-accent);
  }

  .finder-estate-chip.is-active,
  .finder-estate-chip[aria-pressed="true"] {
    background-color: var(--pb-accent-wash);
    border: 1px solid var(--pb-accent);
    color: var(--pb-accent);
    font-weight: 600;
  }

  /* Result Box */
  .finder-result-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--pb-accent-wash, rgba(247, 148, 29, 0.08));
    border: 1px solid var(--pb-accent, #F7941D);
    border-radius: 12px;
    animation: fadeInResult 0.25s ease-out;
  }

  @keyframes fadeInResult {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .finder-result-text-col {
    flex: 1;
    min-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .finder-rec-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--pb-accent, #F7941D);
  }

  .finder-result-sentence {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--pb-text, var(--color-text-primary));
    margin: 0;
    font-weight: 500;
  }

  .finder-result-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .finder-open-guide-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .finder-pin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .finder-pin-btn.is-pinned {
    color: var(--pb-accent, #F7941D);
    border-color: var(--pb-accent, #F7941D);
  }
</style>
