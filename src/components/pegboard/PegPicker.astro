---
import Icon from '../Icon.astro';
import type { PickerData } from '../../data/pegBoard';

interface Props {
  guideSlug: string;
  picker: PickerData;
}

const { guideSlug, picker } = Astro.props;
---

<section class="peg-picker-section" aria-labelledby="picker-heading">
  <div class="picker-header">
    <span class="eyebrow">PICK YOUR PRIORITIES</span>
    <h2 id="picker-heading" class="picker-title">Compare your priorities</h2>
    <p class="picker-sub">Select the factors that matter to your initiative. The recommendation adapts live.</p>
  </div>

  <!-- Priority Chips Grid -->
  <div
    class="picker-chips-grid"
    role="group"
    aria-label="Priorities selection"
    id="picker-chips-container"
    data-guide-slug={guideSlug}
  >
    {picker.chips.map((chip) => (
      <button
        type="button"
        class="picker-chip"
        data-chip-id={chip.id}
        data-chip-weights={JSON.stringify(chip.weights)}
        aria-pressed="false"
      >
        <span class="chip-check" aria-hidden="true">✓</span>
        <span class="chip-label">{chip.label}</span>
      </button>
    ))}
  </div>

  <!-- Live Dynamic Result Card -->
  <div
    class="picker-result-card card-mastercard"
    id="picker-result-card"
    aria-live="polite"
    aria-atomic="true"
    data-picker-config={JSON.stringify({
      options: picker.options,
      blendLabel: picker.blendLabel,
      blendReason: picker.blendReason
    })}
  >
    <div class="result-badge-row">
      <span class="result-eyebrow">SUGGESTED PEG</span>
      <span id="result-peg-label" class="result-peg-name">Choose what matters to you.</span>
    </div>

    <div class="result-body">
      <p id="result-reason" class="result-reason-p">
        Select one or more priorities above to compare approaches against your project goals.
      </p>
      <p class="result-disclaimer">
        A starting point. We finalise the approach together.
      </p>
    </div>

    <div class="result-actions-row">
      <a href="/#contact" class="btn btn-primary result-cta-btn">
        <span>Talk to us about this</span>
        <Icon name="arrow-right" size={14} />
      </a>
      <button
        type="button"
        class="btn btn-secondary result-pin-btn"
        id="picker-pin-guide-btn"
        data-guide-slug={guideSlug}
      >
        <Icon name="bookmark" size={14} />
        <span id="picker-pin-btn-text">Pin this guide</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { togglePin, isPinned } from '../../scripts/pegBoardState';

  function initPegPicker() {
    const container = document.getElementById('picker-chips-container');
    const resultCard = document.getElementById('picker-result-card');
    const pegLabel = document.getElementById('result-peg-label');
    const reasonP = document.getElementById('result-reason');
    const pinBtn = document.getElementById('picker-pin-guide-btn') as HTMLButtonElement | null;
    const pinBtnText = document.getElementById('picker-pin-btn-text');

    if (!container || !resultCard || !pegLabel || !reasonP) return;

    const elContainer = container;
    const elPegLabel = pegLabel;
    const elReasonP = reasonP;

    const guideSlug = container.getAttribute('data-guide-slug') || '';
    let config: any = {};
    try {
      config = JSON.parse(resultCard.getAttribute('data-picker-config') || '{}');
    } catch {
      config = {};
    }

    const { options = [], blendLabel = '', blendReason = '' } = config;
    const selectedChips = new Set<string>();

    // Calculate score
    function recalculate() {
      if (selectedChips.size === 0) {
        elPegLabel.textContent = 'Choose what matters to you.';
        elReasonP.textContent = 'Select one or more priorities above to compare approaches against your project goals.';
        return;
      }

      // Sum weights per option
      const totals: Record<string, number> = {};
      options.forEach((opt: any) => {
        totals[opt.id] = 0;
      });

      selectedChips.forEach((chipId) => {
        const btn = elContainer.querySelector(`[data-chip-id="${chipId}"]`);
        if (!btn) return;
        try {
          const weights = JSON.parse(btn.getAttribute('data-chip-weights') || '{}');
          Object.entries(weights).forEach(([optId, weight]) => {
            totals[optId] = (totals[optId] || 0) + (weight as number);
          });
        } catch {}
      });

      // Find top score
      const sorted = Object.entries(totals).sort((a, b) => b[1] - a[1]);
      const topOption = sorted[0];
      const runnerUp = sorted[1];

      // Check if tie or within 1 point
      const isTieOrClose = runnerUp && Math.abs(topOption[1] - runnerUp[1]) <= 1 && topOption[1] > 0;

      if (isTieOrClose && blendLabel) {
        elPegLabel.textContent = blendLabel;
        elReasonP.textContent = blendReason;
      } else if (topOption && topOption[1] > 0) {
        const matchingOpt = options.find((o: any) => o.id === topOption[0]);
        if (matchingOpt) {
          elPegLabel.textContent = matchingOpt.name;
          elReasonP.textContent = matchingOpt.reason;
        }
      }
    }

    // Chip click handler
    container.querySelectorAll<HTMLButtonElement>('.picker-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const chipId = btn.getAttribute('data-chip-id');
        if (!chipId) return;

        if (selectedChips.has(chipId)) {
          selectedChips.delete(chipId);
          btn.classList.remove('is-selected');
          btn.setAttribute('aria-pressed', 'false');
        } else {
          selectedChips.add(chipId);
          btn.classList.add('is-selected');
          btn.setAttribute('aria-pressed', 'true');
        }

        recalculate();
      });
    });

    // Pin button in picker
    function syncPinBtn() {
      if (!pinBtn || !pinBtnText) return;
      const p = isPinned(guideSlug);
      pinBtn.classList.toggle('is-pinned', p);
      pinBtnText.textContent = p ? 'Pinned to my board' : 'Pin this guide';
    }

    pinBtn?.addEventListener('click', () => {
      togglePin(guideSlug);
      syncPinBtn();
    });

    window.addEventListener('rhsp:pegboard:pins-changed', syncPinBtn);
    syncPinBtn();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPegPicker);
  } else {
    initPegPicker();
  }
</script>

<style>
  .peg-picker-section {
    margin: 3.5rem 0;
    padding: 2.25rem;
    border-radius: 22px;
    background-color: var(--pb-tile, var(--color-surface));
    border: 1px solid var(--pb-line, var(--color-border));
  }

  @media (max-width: 639px) {
    .peg-picker-section {
      padding: 1.5rem 1.25rem;
      margin: 2.5rem 0;
    }
  }

  .picker-header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--pb-accent, #F7941D);
    text-transform: uppercase;
  }

  .picker-title {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0.35rem 0 0.5rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .picker-sub {
    font-size: 0.9375rem;
    color: var(--pb-text-2, var(--color-text-secondary));
    line-height: 1.5;
    margin: 0;
  }

  .picker-chips-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .picker-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background-color: var(--pb-tile, var(--color-bg));
    border: 1px solid var(--pb-line, var(--color-border));
    color: var(--pb-text-2, var(--color-text-secondary));
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .picker-chip:hover {
    color: var(--pb-text);
    border-color: var(--pb-accent);
  }

  .picker-chip:focus-visible {
    outline: 2px var(--pb-focus-ring) solid;
    outline-offset: 2px;
  }

  .chip-check {
    display: inline-block;
    font-size: 11px;
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.18s ease;
  }

  .picker-chip.is-selected {
    background-color: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
    color: var(--pb-accent, #F7941D);
    border-color: var(--pb-accent, #F7941D);
  }

  .picker-chip.is-selected .chip-check {
    opacity: 1;
    transform: scale(1);
    color: var(--pb-accent);
  }

  .picker-result-card {
    padding: 1.75rem;
    border-radius: 18px;
    background-color: var(--pb-tile, var(--color-bg));
    border: 1px solid var(--pb-line, var(--color-border));
    border-left: 3px solid var(--pb-accent, #F7941D);
    background-image: linear-gradient(to right, var(--pb-accent-wash, rgba(247, 148, 29, 0.08)) 0%, transparent 60%);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .result-badge-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
  }

  .result-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pb-accent, #F7941D);
  }

  .result-peg-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pb-text, var(--color-text-primary));
    line-height: 1.3;
  }

  .result-body {
    margin-bottom: 1.5rem;
  }

  .result-reason-p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--pb-text, var(--color-text-primary));
    margin: 0 0 0.5rem;
  }

  .result-disclaimer {
    font-size: 0.8125rem;
    color: var(--pb-text-3, var(--color-text-muted));
    line-height: 1.4;
    margin: 0;
  }

  .result-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .result-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 999px;
    background-color: var(--pb-accent, #F7941D);
    color: var(--pb-on-accent, #14110F);
    border: 1px solid var(--pb-accent-lo, #B86200);
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .result-cta-btn:hover {
    background-color: var(--pb-accent-hi, #FFAE4A);
    transform: translateY(-1px);
  }

  .result-cta-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .result-pin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.15rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 999px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line);
    color: var(--pb-text);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .result-pin-btn:hover {
    border-color: var(--pb-accent);
    color: var(--pb-accent);
  }

  .result-pin-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .result-pin-btn.is-pinned {
    background-color: var(--pb-accent-wash);
    border-color: var(--pb-accent);
    color: var(--pb-accent);
  }
</style>
