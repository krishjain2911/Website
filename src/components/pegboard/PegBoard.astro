---
import Icon from '../Icon.astro';
import BoardTile from './BoardTile.astro';
import MyBoardDrawer from './MyBoardDrawer.astro';
import PegFinder from './PegFinder.astro';
import AdapterWidget from './AdapterWidget.astro';
import { zones, tiles, ZONE_ORDER, FEATURES } from '../../data/pegBoard';
---

<div class="peg-board-component" id="peg-board-root">
  <!-- Perforated Panel Container -->
  <section class="pb-board peg-board-panel" id="peg-board-panel" aria-label="PEG Board interactive panel">
    <!-- Board Header -->
    <header class="board-header">
      <div class="board-header-left">
        <span class="board-eyebrow">PEG BOARD</span>
        <h1 class="board-heading">Everything on one board.</h1>
        <p class="board-subline">
          Guides, comparisons and our approach. Pin what matters and we'll talk it through.
        </p>
      </div>

      <!-- Single Action Row: My board & Explorer progress ring -->
      <div class="board-header-actions">
        <!-- Explorer progress ring (smaller, 38px) -->
        <div class="explorer-ring-widget" id="explorer-ring-widget" title="Explore pegs on the board">
          <svg class="explorer-svg" width="38" height="38" viewBox="0 0 38 38" aria-hidden="true">
            <circle class="ring-bg" cx="19" cy="19" r="15" fill="none" stroke-width="3"></circle>
            <circle
              class="ring-progress"
              id="explorer-progress-circle"
              cx="19"
              cy="19"
              r="15"
              fill="none"
              stroke-width="3"
              stroke-dasharray="94.248"
              stroke-dashoffset="94.248"
              transform="rotate(-90 19 19)"
            ></circle>
          </svg>
          <div class="explorer-stat-box">
            <span class="explorer-num" id="explorer-count-text">0 of {tiles.length}</span>
            <span class="explorer-label">pegs explored</span>
          </div>
        </div>

        <!-- Completed Pill (hidden until full exploration) -->
        <a
          href="/#contact"
          class="explorer-completed-pill"
          id="explorer-completed-pill"
          style="display: none;"
        >
          <span>All explored. Book a call</span>
          <Icon name="arrow-right" size={12} />
        </a>

        <!-- My board button -->
        <button
          type="button"
          class="btn btn-secondary my-board-trigger-btn"
          id="my-board-open-btn"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="my-board-drawer"
        >
          <Icon name="bookmark" size={14} />
          <span id="my-board-btn-label">My board (0)</span>
        </button>
      </div>
    </header>

    <!-- Sentinel to detect when sticky bar is stuck -->
    <div id="board-filter-sentinel" class="board-filter-sentinel" aria-hidden="true"></div>

    <!-- Single Sticky Filter Row (Ledge under header, hidden on mobile <640px) -->
    {FEATURES.search && (
      <div class="board-filter-ledge" id="board-filter-bar">
        <div class="board-zone-chips" role="tablist" aria-label="Zone filter">
          <button type="button" class="zone-filter-chip is-active" data-zone-filter="all">All</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="solutions">Solutions</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="case-studies">Case studies</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="resources">Resources</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="playground">Playground</button>
        </div>

        <div class="board-search-box">
          <Icon name="search" size={15} class="board-search-icon" />
          <input
            type="search"
            class="board-search-input"
            id="board-search-input"
            placeholder="Search guides, solutions and topics"
            aria-label="Search the board"
            autocomplete="off"
          />
          <button
            type="button"
            class="board-search-clear-btn"
            id="board-search-clear-btn"
            aria-label="Clear search"
            style="display: none;"
          >
            ✕
          </button>
          <span class="sr-only" id="search-live-status" aria-live="polite">All shown</span>
        </div>
        <button type="button" class="board-reset-layout-btn" id="board-reset-layout-btn">Reset layout</button>
      </div>
    )}

    <!-- Empty Search State -->
    <div class="board-search-empty-state" id="board-search-empty" style="display: none;">
      <p class="empty-state-p">No pegs match. Try another word.</p>
      <button type="button" class="btn btn-secondary btn-sm" id="empty-state-clear-btn">
        Clear search
      </button>
    </div>

    <!-- Free mode canvas (desktop >= 900px, fine pointer) -->
    <div class="pb-canvas" id="pb-canvas" aria-hidden="false" hidden>
      <div class="pb-ghost" id="pb-ghost" hidden aria-hidden="true"></div>
      <div class="pb-hole-origin" id="pb-hole-origin" hidden aria-hidden="true"></div>
      {zones.map((z) => (
        <div class="pb-plaque-row" data-plaque={z.id}>
          <span class={`zone-plaque ${z.accentClass}`} style={`--zone-accent:${z.accentColor};`}>
            <span class="plaque-dot" aria-hidden="true"></span><span>{z.label}</span>
          </span>
          <div class="zone-shelf-line" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    <!-- Board Zones Container (Rendered in ZONE_ORDER) -->
    <div class="board-zones-container">
      {ZONE_ORDER.map((zoneId) => {
        const zone = zones.find((z) => z.id === zoneId);
        if (!zone) return null;
        const zoneTiles = tiles.filter((t) => t.zoneId === zone.id);

        return (
          <section class="board-zone-band" data-zone-id={zone.id} id={`zone-band-${zone.id}`}>
            <!-- Zone Plaque with Shelf Rail -->
            <div class="zone-plaque-row">
              <span class={`zone-plaque ${zone.accentClass}`} style={`--zone-accent: ${zone.accentColor};`}>
                <span class="plaque-dot" aria-hidden="true"></span>
                <span>{zone.label}</span>
              </span>
              <span class="zone-count-chip">
                {zoneTiles.length} {zone.id === 'solutions' ? 'solutions' : zone.id === 'resources' ? 'guides' : zone.id === 'case-studies' ? 'case studies' : 'tools'}
              </span>
              <span class="zone-reorder-hint" aria-hidden="true">
                Drag or Alt+arrows to reorder
              </span>
              <div class="zone-shelf-line" aria-hidden="true"></div>
            </div>

            <!-- Tiles Track: 4 cols desktop, 3 tablet, 2 small tablet, swipe rail on mobile -->
            <div class="zone-tiles-track" id={`zone-track-${zone.id}`} data-zone={zone.id} data-zone-id={zone.id}>
              {zoneTiles.map((tile, idx) => (
                <BoardTile tile={tile} index={idx} />
              ))}
            </div>

            <!-- Rail Dots for Mobile (<640px) -->
            <div class="zone-rail-dots" data-zone-dots={zone.id} aria-hidden="true">
              {zoneTiles.map((_, dIdx) => (
                <button
                  type="button"
                  class={`rail-dot ${dIdx === 0 ? 'is-active' : ''}`}
                  data-dot-index={dIdx}
                  aria-label={`Go to item ${dIdx + 1}`}
                ></button>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <!-- Interactive Modals for Playground Tools -->
  <PegFinder />
  <AdapterWidget />

  <!-- My Board Pinned Items Drawer -->
  <MyBoardDrawer />

  <!-- Unpin Undo Toast Notification -->
  <div id="pb-toast-container" class="pb-toast-container" aria-live="polite">
    <div id="pb-toast" class="pb-toast" role="status" style="display: none;">
      <span class="toast-message">Removed from your board.</span>
      <button type="button" class="toast-undo-btn" id="toast-undo-btn">Undo</button>
    </div>
  </div>
</div>

<script>
  import {
    getPinnedSlugs,
    togglePin,
    getExploredSlugs,
    markExplored,
    initExploredState,
    resetTileOrder,
    clearLayout,
    setArrivalVisited,
    hasVisitedArrival
  } from '../../scripts/pegBoardState';
  import { initPegLayout } from '../../scripts/pegLayout';
  import { tiles, FEATURES } from '../../data/pegBoard';

  function initPegBoard() {
    const board = document.getElementById('peg-board-panel');
    if (!board) return;

    // Initialize/reset explored progress on page reload or fresh visit
    initExploredState();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. PIN FUNCTIONALITY & DRAWER & UNDO TOAST
    const drawerOverlay = document.getElementById('my-board-drawer');
    const drawerBackdrop = document.getElementById('my-board-backdrop');
    const drawerCloseBtn = document.getElementById('my-board-close-btn');
    const drawerOpenBtn = document.getElementById('my-board-open-btn');
    const myBoardBtnLabel = document.getElementById('my-board-btn-label');
    const pinnedListEl = document.getElementById('pinned-tiles-list');
    const emptyStateEl = document.getElementById('pinned-empty-state');
    const discussBtn = document.getElementById('discuss-board-btn') as HTMLAnchorElement | null;
    const copyEmailBtn = document.getElementById('copy-contact-email-btn');
    const copyEmailFeedback = document.getElementById('copy-email-feedback');
    const selectableEmail = document.getElementById('selectable-contact-email');
    const drawerResetBtn = document.getElementById('drawer-reset-board-btn');

    // Toast element
    const toastEl = document.getElementById('pb-toast');
    const toastUndoBtn = document.getElementById('toast-undo-btn');
    let toastTimeout: any = null;
    let lastUnpinnedSlug: string | null = null;

    function showUnpinToast(slug: string) {
      if (!toastEl) return;
      lastUnpinnedSlug = slug;
      toastEl.style.display = 'flex';
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        if (toastEl) toastEl.style.display = 'none';
        lastUnpinnedSlug = null;
      }, 6000);
    }

    toastUndoBtn?.addEventListener('click', () => {
      if (lastUnpinnedSlug) {
        togglePin(lastUnpinnedSlug, 'undo-toast');
        if (toastEl) toastEl.style.display = 'none';
        lastUnpinnedSlug = null;
        syncPinsUI();
      }
    });

    function syncPinsUI() {
      const pinnedSlugs = getPinnedSlugs();

      // Update tile pin buttons and card state on the board
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
        const slug = wrapper.getAttribute('data-tile-slug') || '';
        const isP = pinnedSlugs.includes(slug);
        wrapper.setAttribute('data-pinned', isP ? 'true' : 'false');
        const pinBtn = wrapper.querySelector<HTMLButtonElement>('[data-pin-btn]');
        if (pinBtn) {
          pinBtn.setAttribute('aria-pressed', isP ? 'true' : 'false');
        }
      });

      // Update header button count
      const countLabel = `My board (${pinnedSlugs.length})`;
      if (myBoardBtnLabel) myBoardBtnLabel.textContent = countLabel;

      // Render drawer items
      if (pinnedListEl && emptyStateEl) {
        if (pinnedSlugs.length === 0) {
          emptyStateEl.style.display = 'flex';
          pinnedListEl.innerHTML = '';
        } else {
          emptyStateEl.style.display = 'none';
          pinnedListEl.innerHTML = pinnedSlugs
            .map((slug) => {
              const tile = tiles.find((t) => t.slug === slug);
              if (!tile) return '';
              return `
                <li class="pinned-item-row" data-pinned-slug="${tile.slug}">
                  <div class="pinned-item-info">
                    <a href="${tile.href}" class="pinned-item-title">${tile.title}</a>
                    <span class="pinned-item-tag">${tile.tag}</span>
                  </div>
                  <button type="button" class="pinned-remove-btn" data-remove-slug="${tile.slug}" aria-label="Remove ${tile.title} from pins">
                    ✕
                  </button>
                </li>
              `;
            })
            .join('');

          // Wire remove buttons inside drawer
          pinnedListEl.querySelectorAll<HTMLButtonElement>('[data-remove-slug]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const slug = btn.getAttribute('data-remove-slug');
              if (slug) {
                const res = togglePin(slug, 'drawer');
                if (!res.pinned) {
                  showUnpinToast(slug);
                }
                syncPinsUI();
              }
            });
          });
        }
      }

      // Update discuss mailto URL
      if (discussBtn) {
        const pinnedTitles = pinnedSlugs
          .map((s) => tiles.find((t) => t.slug === s)?.title)
          .filter(Boolean);
        const subject = encodeURIComponent('PEG Board: my pinned topics');
        const bodyLines = [
          'Pinned topics from RHSP PEG Board:',
          ...pinnedTitles.map((t) => `- ${t}`),
          '',
          'Tell us a little about your project:'
        ].join('\n');
        const body = encodeURIComponent(bodyLines);
        discussBtn.href = `mailto:letstalk@rhsp.solutions?subject=${subject}&body=${body}`;
      }
    }

    // Toggle pin click on tiles
    board.addEventListener('click', (e) => {
      const pinBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pin-btn]');
      if (pinBtn) {
        e.preventDefault();
        e.stopPropagation();
        const slug = pinBtn.getAttribute('data-pin-btn');
        if (slug) {
          const res = togglePin(slug, 'tile');
          const tileCard = pinBtn.closest<HTMLElement>('.pb-tile');
          if (tileCard && res.pinned) {
            tileCard.classList.add('is-peg-pulsing');
            setTimeout(() => tileCard.classList.remove('is-peg-pulsing'), 350);
            tileCard.classList.add('is-swinging');
            setTimeout(() => tileCard.classList.remove('is-swinging'), 1200);
          }
          if (!res.pinned) {
            showUnpinToast(slug);
          }
          syncPinsUI();
        }
      }
    });

    // Drawer open / close
    let drawerPrevOverflow = '';
    let drawerLastActive: HTMLElement | null = null;
    function openDrawer() {
      if (!drawerOverlay) return;
      drawerLastActive = document.activeElement as HTMLElement | null;
      drawerOverlay.classList.add('is-open');
      drawerOverlay.setAttribute('aria-hidden', 'false');
      drawerOpenBtn?.setAttribute('aria-expanded', 'true');
      drawerCloseBtn?.focus();
      drawerPrevOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawerOverlay) return;
      drawerOverlay.classList.remove('is-open');
      drawerOverlay.setAttribute('aria-hidden', 'true');
      drawerOpenBtn?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = drawerPrevOverflow;
      document.body.style.overflow = '';
      (drawerLastActive || drawerOpenBtn)?.focus();
    }

    drawerOpenBtn?.addEventListener('click', openDrawer);
    drawerCloseBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawerOverlay?.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Reset board from inside drawer
    drawerResetBtn?.addEventListener('click', () => {
      resetTileOrder();
      clearLayout();
      closeDrawer();
    });

    // Copy email handler
    copyEmailBtn?.addEventListener('click', async () => {
      const email = selectableEmail?.textContent || 'letstalk@rhsp.solutions';
      try {
        await navigator.clipboard.writeText(email);
        if (copyEmailFeedback) {
          copyEmailFeedback.textContent = 'Copied!';
          setTimeout(() => {
            copyEmailFeedback.textContent = 'Copy';
          }, 2000);
        }
      } catch {}
    });

    // 2. EXPLORER PROGRESS
    const countText = document.getElementById('explorer-count-text');
    const progressCircle = document.getElementById('explorer-progress-circle');
    const completedPill = document.getElementById('explorer-completed-pill');
    const TOTAL_PEGS = tiles.length;
    const CIRCUMFERENCE = 2 * Math.PI * 15; // ~94.248

    function syncExploredUI() {
      const explored = getExploredSlugs();
      const count = Math.min(explored.length, TOTAL_PEGS);
      if (countText) {
        countText.textContent = `${count} of ${TOTAL_PEGS}`;
      }

      if (progressCircle) {
        const offset = CIRCUMFERENCE * (1 - count / TOTAL_PEGS);
        progressCircle.style.strokeDashoffset = `${offset}`;
        progressCircle.style.stroke = 'var(--pb-accent, #F7941D)';
      }

      // Update explored peg state on tiles (keeps original tag untouched)
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
        const slug = wrapper.getAttribute('data-tile-slug') || '';
        const isExplored = explored.includes(slug);
        wrapper.setAttribute('data-explored', isExplored ? 'true' : 'false');
      });

      if (completedPill) {
        completedPill.style.display = count >= TOTAL_PEGS ? 'inline-flex' : 'none';
      }
    }

    // Mark peg explored on tile click
    document.querySelectorAll<HTMLAnchorElement>('[data-tile-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-tile-link');
        if (slug) {
          markExplored(slug);
          syncExploredUI();
        }
      });
    });

    // 3. ARRIVAL MOMENT (first viewport only, 160ms drop, 30ms stagger per session)
    if (FEATURES.arrival && !prefersReducedMotion && !hasVisitedArrival()) {
      const vh = window.innerHeight;
      const allTileWrappers = Array.from(document.querySelectorAll<HTMLElement>('.board-tile-wrapper'));
      const firstViewportTiles = allTileWrappers.filter((w) => {
        const r = w.getBoundingClientRect();
        return r.top < vh + 100;
      });

      firstViewportTiles.forEach((wrapper, index) => {
        wrapper.style.opacity = '0';
        wrapper.style.transform = 'translateY(-12px)';
        wrapper.style.transition = 'transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms ease';

        setTimeout(() => {
          wrapper.style.opacity = '1';
          wrapper.style.transform = 'translateY(0)';
        }, index * 30);
      });

      setTimeout(() => {
        firstViewportTiles.forEach((w) => {
          w.style.transform = '';
          w.style.transition = '';
        });
        setArrivalVisited();
      }, firstViewportTiles.length * 30 + 200);
    }

    // 4. SEARCH & ZONE FILTERING
    if (FEATURES.search) {
      const searchInput = document.getElementById('board-search-input') as HTMLInputElement | null;
      const searchClearBtn = document.getElementById('board-search-clear-btn');
      const searchEmptyEl = document.getElementById('board-search-empty');
      const emptyStateClearBtn = document.getElementById('empty-state-clear-btn');
      const liveStatus = document.getElementById('search-live-status');

      let currentSearchQuery = '';
      let activeZoneFilter = 'all';

      function applyFilters() {
        const query = currentSearchQuery.trim().toLowerCase();
        let matchCount = 0;

        document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
          const slug = wrapper.getAttribute('data-tile-slug') || '';
          const zoneId = wrapper.getAttribute('data-zone-id') || '';
          const tile = tiles.find((t) => t.slug === slug);
          if (!tile) return;

          const matchesZone = activeZoneFilter === 'all' || zoneId === activeZoneFilter;
          const textCorpus = `${tile.title} ${tile.description} ${tile.quickTake || ''} ${tile.tag}`.toLowerCase();
          const matchesQuery = !query || textCorpus.includes(query);

          const isMatch = matchesZone && matchesQuery;
          const hitLink = wrapper.querySelector<HTMLAnchorElement>('.tile-hit-link');
          const pinBtn = wrapper.querySelector<HTMLButtonElement>('.tile-pin-btn');

          if (isMatch) {
            matchCount++;
            wrapper.classList.remove('is-dimmed');
            hitLink?.removeAttribute('tabindex');
            pinBtn?.removeAttribute('inert');
          } else {
            wrapper.classList.add('is-dimmed');
            hitLink?.setAttribute('tabindex', '-1');
            pinBtn?.setAttribute('inert', '');
          }
        });

        if (liveStatus) {
          liveStatus.textContent = `${matchCount} of ${TOTAL_PEGS} shown`;
        }

        if (searchEmptyEl) {
          searchEmptyEl.style.display = matchCount === 0 ? 'flex' : 'none';
        }

        if (searchClearBtn) {
          searchClearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
        }

        if (searchInput && searchInput.value !== currentSearchQuery) {
          searchInput.value = currentSearchQuery;
        }
      }

      searchInput?.addEventListener('input', (e) => {
        currentSearchQuery = (e.target as HTMLInputElement).value;
        applyFilters();
      });

      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          currentSearchQuery = '';
          searchInput.value = '';
          applyFilters();
        }
      });

      searchClearBtn?.addEventListener('click', () => {
        currentSearchQuery = '';
        applyFilters();
        searchInput?.focus();
      });

      emptyStateClearBtn?.addEventListener('click', () => {
        currentSearchQuery = '';
        activeZoneFilter = 'all';
        syncZoneFilterButtons();
        applyFilters();
      });

      // Zone Filter Chips
      function syncZoneFilterButtons() {
        document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]').forEach((chip) => {
          const zf = chip.getAttribute('data-zone-filter');
          const isActive = zf === activeZoneFilter;
          chip.classList.toggle('is-active', isActive);
          chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      // Sticky filter bar sentinel observer (toggles .is-stuck for bottom border & shadow)
      const sentinel = document.getElementById('board-filter-sentinel');
      const filterBar = document.getElementById('board-filter-bar');
      if (sentinel && filterBar && window.IntersectionObserver) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            filterBar.classList.toggle('is-stuck', !entry.isIntersecting);
          },
          { threshold: [0] }
        );
        observer.observe(sentinel);
      }

      document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const zf = chip.getAttribute('data-zone-filter') || 'all';
          activeZoneFilter = zf;
          syncZoneFilterButtons();
          applyFilters();

          if (zf !== 'all') {
            window.dispatchEvent(new CustomEvent('rhsp:pegboard:scroll-zone', { detail: { zone: zf } }));
          }
        });
      });
    }

    // 5. MOBILE HORIZONTAL RAILS (<640px) & DOTS WITH RESIZEOBSERVER
    function initMobileRails() {
      const tracks = document.querySelectorAll<HTMLElement>('.zone-tiles-track');
      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => {});
        tracks.forEach((track) => ro.observe(track));
      }

      tracks.forEach((track) => {
        const zoneId = track.getAttribute('data-zone-id');
        const dotsContainer = document.querySelector<HTMLElement>(`[data-zone-dots="${zoneId}"]`);
        if (!dotsContainer) return;

        const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.rail-dot'));
        const items = Array.from(track.children) as HTMLElement[];

        track.addEventListener('scroll', () => {
          const scrollLeft = track.scrollLeft;
          const trackW = track.offsetWidth;
          const activeIndex = Math.min(dots.length - 1, Math.round(scrollLeft / (trackW * 0.78)));

          dots.forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === activeIndex);
          });
        }, { passive: true });

        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            const item = items[idx];
            if (item) {
              item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          });
        });
      });
    }
    initMobileRails();

    // 6. INITIALIZE DRAGGING & FREE HOLE-GRID LAYOUT (>= 900px, hover & fine pointer)
    const resetLayoutBtn = document.getElementById('board-reset-layout-btn');
    resetLayoutBtn?.addEventListener('click', () => {
      clearLayout();
    });

    initPegLayout(board);

    // 7. DELEGATED TILT & HOVER OPTIMIZATION (runs on single board listener via rAF)
    if (window.matchMedia('(hover: hover)').matches) {
      let hoveredTile: HTMLElement | null = null;
      let tiltRaf = 0;
      let mouseX = 0;
      let mouseY = 0;

      board.addEventListener('pointerleave', () => {
        if (hoveredTile) {
          hoveredTile.classList.remove('is-hovered');
          hoveredTile.style.transform = '';
          hoveredTile = null;
        }
      });

      board.addEventListener('pointermove', (e) => {
        if (document.documentElement.classList.contains('pb-is-dragging')) return;
        const target = (e.target as HTMLElement).closest<HTMLElement>('.pb-tile');

        if (hoveredTile && hoveredTile !== target) {
          hoveredTile.classList.remove('is-hovered');
          hoveredTile.style.transform = '';
          hoveredTile = null;
        }

        if (!target || target.classList.contains('is-dragging')) return;

        if (!hoveredTile) {
          hoveredTile = target;
          hoveredTile.classList.add('is-hovered');
        }

        mouseX = e.clientX;
        mouseY = e.clientY;

        if (!tiltRaf) {
          tiltRaf = requestAnimationFrame(() => {
            tiltRaf = 0;
            if (!hoveredTile || document.documentElement.classList.contains('pb-is-dragging')) return;
            const rect = hoveredTile.getBoundingClientRect();
            const relX = (mouseX - rect.left) / (rect.width || 1);
            const relY = (mouseY - rect.top) / (rect.height || 1);
            const tiltY = (relX - 0.5) * 3;
            const tiltX = (0.5 - relY) * 2.5;
            hoveredTile.style.transform = `perspective(800px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;
          });
        }
      });
    }

    // 8. DESKTOP DRAG HINT TOAST (shown once on first visit, never on touch)
    const isDesktopFine = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 900px)').matches;
    if (isDesktopFine && typeof window !== 'undefined' && window.sessionStorage) {
      const hintShown = window.sessionStorage.getItem('rhsp.pegboard.v3.drag-toast');
      if (!hintShown) {
        window.sessionStorage.setItem('rhsp.pegboard.v3.drag-toast', 'true');
        setTimeout(() => {
          const toastMsg = document.querySelector<HTMLElement>('#pb-toast .toast-message');
          const toastBtn = document.getElementById('toast-undo-btn');
          if (toastEl && toastMsg) {
            const originalText = toastMsg.textContent;
            toastMsg.textContent = 'Drag any peg to any free hole';
            if (toastBtn) toastBtn.style.display = 'none';
            toastEl.style.display = 'flex';
            setTimeout(() => {
              if (toastEl) toastEl.style.display = 'none';
              if (toastBtn) toastBtn.style.display = '';
              if (originalText) toastMsg.textContent = originalText;
            }, 5000);
          }
        }, 1200);
      }
    }

    // Initial UI synchronization
    syncPinsUI();
    syncExploredUI();

    // Re-sync on custom storage and theme change events
    window.addEventListener('rhsp:pegboard:pins-changed', syncPinsUI);
    window.addEventListener('rhsp:pegboard:explored-changed', syncExploredUI);
    window.addEventListener('rhsp-theme-change', () => {
      syncExploredUI();
      syncPinsUI();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPegBoard);
  } else {
    initPegBoard();
  }
</script>

