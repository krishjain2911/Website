---
import Icon from '../Icon.astro';
import BoardTile from './BoardTile.astro';
import MyBoardDrawer from './MyBoardDrawer.astro';
import PegFinder from './PegFinder.astro';
import AdapterWidget from './AdapterWidget.astro';
import { zones, tiles, emptySlots, FEATURES } from '../../data/pegBoard';
---

<div class="peg-board-component" id="peg-board-root">
  <!-- Sticky Mini Bar (Desktop & Tablet only, sticks below nav on scroll) -->
  <div class="peg-sticky-minibar" id="peg-sticky-minibar" aria-label="Quick board navigation">
    <div class="minibar-inner">
      <div class="minibar-chips" role="tablist" aria-label="Filter board by zone">
        <button type="button" class="minibar-chip is-active" data-zone-filter="all">All</button>
        <button type="button" class="minibar-chip" data-zone-filter="case-studies">Case studies</button>
        <button type="button" class="minibar-chip" data-zone-filter="solutions">Solutions</button>
        <button type="button" class="minibar-chip" data-zone-filter="resources">Resources</button>
      </div>

      <div class="minibar-search-wrap">
        <Icon name="search" size={14} class="minibar-search-icon" />
        <input
          type="search"
          class="minibar-search-input"
          id="minibar-search-input"
          placeholder="Search guides and topics"
          aria-label="Search the board"
          autocomplete="off"
        />
        <span class="sr-only" id="search-live-status" aria-live="polite">8 of 8 shown</span>
      </div>

      <button
        type="button"
        class="minibar-my-board-btn"
        id="minibar-my-board-btn"
        aria-label="Open saved topics drawer"
      >
        <Icon name="bookmark" size={14} />
        <span id="minibar-my-board-label">My board (0)</span>
      </button>
    </div>
  </div>

  <!-- Perforated Panel Container -->
  <section class="peg-board-panel" id="peg-board-panel" aria-label="PEG Board interactive panel">
    <!-- Holes overlay grid via CSS radial-gradient -->
    <div class="panel-holes-layer" aria-hidden="true"></div>
    <div class="panel-grain-layer" aria-hidden="true"></div>

    <!-- Board Header Row -->
    <div class="board-header">
      <div class="board-header-left">
        <span class="board-eyebrow">PEG BOARD</span>
        <h1 class="board-heading">Everything on one board.</h1>
        <p class="board-subline">
          Guides, comparisons and our approach. Pin what matters and we'll talk it through.
        </p>
      </div>

      <div class="board-header-right">
        <!-- Interactive Adapter Moment in Header -->
        {FEATURES.adapterMoment && (
          <div class="header-adapter-slot">
            <AdapterWidget />
          </div>
        )}

        <!-- Explorer progress ring -->
        <div class="explorer-ring-widget" id="explorer-ring-widget" title="Explore pegs on the board">
          <svg class="explorer-svg" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
            <circle class="ring-bg" cx="22" cy="22" r="18" fill="none" stroke-width="3"></circle>
            <circle
              class="ring-progress"
              id="explorer-progress-circle"
              cx="22"
              cy="22"
              r="18"
              fill="none"
              stroke-width="3"
              stroke-dasharray="113.097"
              stroke-dashoffset="113.097"
              transform="rotate(-90 22 22)"
            ></circle>
          </svg>
          <div class="explorer-stat-box">
            <span class="explorer-num" id="explorer-count-text">0 of 8</span>
            <span class="explorer-label">pegs explored</span>
          </div>
        </div>

        <!-- 8 of 8 Completed Pill (hidden until full exploration) -->
        <a
          href="/#contact"
          class="explorer-completed-pill"
          id="explorer-completed-pill"
          style="display: none;"
        >
          <span>You have been through the board. Book a call</span>
          <Icon name="arrow-right" size={12} />
        </a>

        <!-- My board button -->
        <button
          type="button"
          class="btn btn-secondary my-board-trigger-btn"
          id="my-board-open-btn"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="my-board-drawer"
        >
          <Icon name="bookmark" size={14} />
          <span id="my-board-btn-label">My board (0)</span>
        </button>

        <!-- Reset board button (desktop drag order reset) -->
        <button
          type="button"
          class="reset-board-btn"
          id="reset-board-btn"
          title="Reset board layout"
        >
          Reset board
        </button>
      </div>
    </div>

    <!-- Peg Finder Interactive Tool -->
    {FEATURES.finder && (
      <div class="board-finder-container">
        <PegFinder />
      </div>
    )}

    <!-- Inline Filter & Search Bar for Board (Primary controls) -->
    {FEATURES.search && (
      <div class="board-filter-bar" id="board-filter-bar">
        <div class="board-zone-chips" role="tablist" aria-label="Zone filter">
          <button type="button" class="zone-filter-chip is-active" data-zone-filter="all">All</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="case-studies">Case studies</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="solutions">Solutions</button>
          <button type="button" class="zone-filter-chip" data-zone-filter="resources">Resources</button>
        </div>

        <div class="board-search-box">
          <Icon name="search" size={15} class="board-search-icon" />
          <input
            type="search"
            class="board-search-input"
            id="board-search-input"
            placeholder="Search guides and topics"
            aria-label="Search the board"
            autocomplete="off"
          />
          <button
            type="button"
            class="board-search-clear-btn"
            id="board-search-clear-btn"
            aria-label="Clear search"
            style="display: none;"
          >
            ✕
          </button>
        </div>
      </div>
    )}

    <!-- Empty Search State -->
    <div class="board-search-empty-state" id="board-search-empty" style="display: none;">
      <p class="empty-state-p">No pegs match. Try another word.</p>
      <button type="button" class="btn btn-secondary btn-sm" id="empty-state-clear-btn">
        Clear search
      </button>
    </div>

    <!-- Board Zones Container -->
    <div class="board-zones-container">
      {zones.map((zone) => {
        const zoneTiles = tiles.filter((t) => t.zoneId === zone.id);
        const isCaseStudies = zone.id === 'case-studies';
        return (
          <section class="board-zone-band" data-zone-id={zone.id} id={`zone-band-${zone.id}`}>
            <!-- Zone Plaque with Engraved Shelf Line -->
            <div class="zone-plaque-row">
              <span class={`zone-plaque ${zone.accentClass}`} style={`--zone-accent: ${zone.accentColor};`}>
                <span class="plaque-dot" aria-hidden="true"></span>
                <span>{zone.label}</span>
              </span>
              <div class="zone-shelf-line" aria-hidden="true"></div>
            </div>

            <!-- Tile Slots Track (Snap columns / Mobile swipe rail) -->
            <div class="zone-tiles-track" id={`zone-track-${zone.id}`} data-zone-id={zone.id}>
              {zoneTiles.map((tile, idx) => (
                <BoardTile tile={tile} index={idx} />
              ))}

              <!-- Empty Hook Silhouettes (Case studies zone) -->
              {isCaseStudies && FEATURES.emptySlots && emptySlots.map((slot, sIdx) => (
                <div class="empty-silhouette-wrapper" aria-hidden="true" data-empty-index={sIdx}>
                  <div class="tile-peg-assembly">
                    <div class="peg-hole-shadow"></div>
                    <div class="tile-square-peg" style={`--peg-color: ${slot.pegColor};`}></div>
                  </div>
                  <div class="empty-silhouette-card">
                    {slot.title && <span class="empty-silhouette-label">{slot.title}</span>}
                  </div>
                </div>
              ))}
            </div>

            <!-- Rail Dots for Mobile (<640px) -->
            <div class="zone-rail-dots" data-zone-dots={zone.id} aria-hidden="true">
              {Array.from({ length: isCaseStudies && FEATURES.emptySlots ? zoneTiles.length + emptySlots.length : zoneTiles.length }).map((_, dIdx) => (
                <button
                  type="button"
                  class={`rail-dot ${dIdx === 0 ? 'is-active' : ''}`}
                  data-dot-index={dIdx}
                  aria-label={`Go to item ${dIdx + 1}`}
                ></button>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <!-- My Board Pinned Items Drawer -->
  <MyBoardDrawer />

  <!-- Unpin Undo Toast Notification -->
  <div id="pb-toast-container" class="pb-toast-container" aria-live="polite">
    <div id="pb-toast" class="pb-toast" role="status" style="display: none;">
      <span class="toast-message">Removed from your board.</span>
      <button type="button" class="toast-undo-btn" id="toast-undo-btn">Undo</button>
    </div>
  </div>
</div>

<script>
  import {
    getPinnedSlugs,
    togglePin,
    getExploredSlugs,
    markExplored,
    getSavedTileOrder,
    saveTileOrder,
    resetTileOrder,
    setArrivalVisited,
    hasVisitedArrival
  } from '../../scripts/pegBoardState';
  import { tiles, FEATURES } from '../../data/pegBoard';

  function initPegBoard() {
    const board = document.getElementById('peg-board-panel');
    if (!board) return;

    // Helper: calculate zoom factor k
    function getZoomK(): number {
      if (!board) return 1;
      const rect = board.getBoundingClientRect();
      const offsetW = board.offsetWidth || 1;
      return rect.width / offsetW || 1;
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. PIN FUNCTIONALITY & DRAWER & UNDO TOAST
    const drawerOverlay = document.getElementById('my-board-drawer');
    const drawerBackdrop = document.getElementById('my-board-backdrop');
    const drawerCloseBtn = document.getElementById('my-board-close-btn');
    const drawerOpenBtn = document.getElementById('my-board-open-btn');
    const minibarMyBoardBtn = document.getElementById('minibar-my-board-btn');
    const myBoardBtnLabel = document.getElementById('my-board-btn-label');
    const minibarMyBoardLabel = document.getElementById('minibar-my-board-label');
    const pinnedListEl = document.getElementById('pinned-tiles-list');
    const emptyStateEl = document.getElementById('pinned-empty-state');
    const discussBtn = document.getElementById('discuss-board-btn') as HTMLAnchorElement | null;
    const copyEmailBtn = document.getElementById('copy-contact-email-btn');
    const copyEmailFeedback = document.getElementById('copy-email-feedback');
    const selectableEmail = document.getElementById('selectable-contact-email');

    // Toast element
    const toastEl = document.getElementById('pb-toast');
    const toastUndoBtn = document.getElementById('toast-undo-btn');
    let toastTimeout: any = null;
    let lastUnpinnedSlug: string | null = null;

    function showUnpinToast(slug: string) {
      if (!toastEl) return;
      lastUnpinnedSlug = slug;
      toastEl.style.display = 'flex';
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        if (toastEl) toastEl.style.display = 'none';
        lastUnpinnedSlug = null;
      }, 6000);
    }

    toastUndoBtn?.addEventListener('click', () => {
      if (lastUnpinnedSlug) {
        togglePin(lastUnpinnedSlug, 'undo-toast');
        if (toastEl) toastEl.style.display = 'none';
        lastUnpinnedSlug = null;
        syncPinsUI();
      }
    });

    function syncPinsUI() {
      const pinnedSlugs = getPinnedSlugs();

      // Update tile pin buttons and card state on the board
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
        const slug = wrapper.getAttribute('data-tile-slug') || '';
        const isP = pinnedSlugs.includes(slug);
        wrapper.setAttribute('data-pinned', isP ? 'true' : 'false');
        const pinBtn = wrapper.querySelector<HTMLButtonElement>('[data-pin-btn]');
        if (pinBtn) {
          pinBtn.setAttribute('aria-pressed', isP ? 'true' : 'false');
        }
      });

      // Update header button count
      const countLabel = `My board (${pinnedSlugs.length})`;
      if (myBoardBtnLabel) myBoardBtnLabel.textContent = countLabel;
      if (minibarMyBoardLabel) minibarMyBoardLabel.textContent = countLabel;

      // Render drawer items
      if (pinnedListEl && emptyStateEl) {
        if (pinnedSlugs.length === 0) {
          emptyStateEl.style.display = 'flex';
          pinnedListEl.innerHTML = '';
        } else {
          emptyStateEl.style.display = 'none';
          pinnedListEl.innerHTML = pinnedSlugs
            .map((slug) => {
              const tile = tiles.find((t) => t.slug === slug);
              if (!tile) return '';
              return `
                <li class="pinned-item-row" data-pinned-slug="${tile.slug}">
                  <div class="pinned-item-info">
                    <a href="${tile.href}" class="pinned-item-title">${tile.title}</a>
                    <span class="pinned-item-tag">${tile.tag}</span>
                  </div>
                  <button type="button" class="pinned-remove-btn" data-remove-slug="${tile.slug}" aria-label="Remove ${tile.title} from pins">
                    ✕
                  </button>
                </li>
              `;
            })
            .join('');

          // Wire remove buttons inside drawer
          pinnedListEl.querySelectorAll<HTMLButtonElement>('[data-remove-slug]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const slug = btn.getAttribute('data-remove-slug');
              if (slug) {
                const res = togglePin(slug, 'drawer');
                if (!res.pinned) {
                  showUnpinToast(slug);
                }
                syncPinsUI();
              }
            });
          });
        }
      }

      // Update discuss mailto URL
      if (discussBtn) {
        const pinnedTitles = pinnedSlugs
          .map((s) => tiles.find((t) => t.slug === s)?.title)
          .filter(Boolean);
        const subject = encodeURIComponent('PEG Board: my pinned topics');
        const bodyLines = [
          'Pinned topics from RHSP PEG Board:',
          ...pinnedTitles.map((t) => `- ${t}`),
          '',
          'Tell us a little about your project:'
        ].join('\n');
        const body = encodeURIComponent(bodyLines);
        discussBtn.href = `mailto:letstalk@rhsp.solutions?subject=${subject}&body=${body}`;
      }
    }

    // Toggle pin click on tiles
    board.addEventListener('click', (e) => {
      const pinBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pin-btn]');
      if (pinBtn) {
        e.preventDefault();
        e.stopPropagation();
        const slug = pinBtn.getAttribute('data-pin-btn');
        if (slug) {
          const res = togglePin(slug, 'tile');
          if (!res.pinned) {
            showUnpinToast(slug);
          }
          syncPinsUI();
        }
      }
    });

    // Drawer open / close
    function openDrawer() {
      if (!drawerOverlay) return;
      drawerOverlay.classList.add('is-open');
      drawerOverlay.setAttribute('aria-hidden', 'false');
      drawerOpenBtn?.setAttribute('aria-expanded', 'true');
      drawerCloseBtn?.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawerOverlay) return;
      drawerOverlay.classList.remove('is-open');
      drawerOverlay.setAttribute('aria-hidden', 'true');
      drawerOpenBtn?.setAttribute('aria-expanded', 'false');
      drawerOpenBtn?.focus();
      document.body.style.overflow = '';
    }

    drawerOpenBtn?.addEventListener('click', openDrawer);
    minibarMyBoardBtn?.addEventListener('click', openDrawer);
    drawerCloseBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawerOverlay?.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Copy email handler
    copyEmailBtn?.addEventListener('click', async () => {
      const email = selectableEmail?.textContent || 'letstalk@rhsp.solutions';
      try {
        await navigator.clipboard.writeText(email);
        if (copyEmailFeedback) {
          copyEmailFeedback.textContent = 'Copied!';
          setTimeout(() => {
            copyEmailFeedback.textContent = 'Copy';
          }, 2000);
        }
      } catch {}
    });

    // 2. EXPLORER PROGRESS
    const countText = document.getElementById('explorer-count-text');
    const progressCircle = document.getElementById('explorer-progress-circle');
    const completedPill = document.getElementById('explorer-completed-pill');
    const TOTAL_PEGS = 8;
    const CIRCUMFERENCE = 2 * Math.PI * 18; // ~113.097

    function syncExploredUI() {
      const explored = getExploredSlugs();
      const count = Math.min(explored.length, TOTAL_PEGS);
      if (countText) {
        countText.textContent = `${count} of ${TOTAL_PEGS}`;
      }

      if (progressCircle) {
        const offset = CIRCUMFERENCE * (1 - count / TOTAL_PEGS);
        progressCircle.style.strokeDashoffset = `${offset}`;
        progressCircle.style.stroke = 'var(--pb-accent, #F7941D)';
      }

      // Update explored tag & halo on tiles
      document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
        const slug = wrapper.getAttribute('data-tile-slug') || '';
        const isExplored = explored.includes(slug);
        wrapper.setAttribute('data-explored', isExplored ? 'true' : 'false');
        const tagEl = wrapper.querySelector<HTMLElement>('[data-tile-tag]');
        if (tagEl) {
          const orig = tagEl.getAttribute('data-original-tag') || '';
          if (isExplored && orig !== 'Coming soon') {
            tagEl.textContent = 'Explored';
          } else {
            tagEl.textContent = orig;
          }
        }
      });

      if (completedPill) {
        completedPill.style.display = count >= TOTAL_PEGS ? 'inline-flex' : 'none';
      }
    }

    // Mark peg explored on tile click or Enter
    document.querySelectorAll<HTMLAnchorElement>('[data-tile-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-tile-link');
        if (slug) {
          markExplored(slug);
          syncExploredUI();

          const card = link.closest('.board-tile-card');
          if (card) {
            card.classList.add('is-lifting');
          }
        }
      });
    });

    // 3. ARRIVAL MOMENT (Staggered 60ms 12px drop with settle on first session visit)
    if (FEATURES.arrival && !prefersReducedMotion && !hasVisitedArrival()) {
      const allTileWrappers = Array.from(document.querySelectorAll<HTMLElement>('.board-tile-wrapper'));
      allTileWrappers.forEach((wrapper, index) => {
        wrapper.style.opacity = '0';
        wrapper.style.transform = 'translateY(-12px) rotate(1.5deg)';
        wrapper.style.transition = 'transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease';

        setTimeout(() => {
          wrapper.style.opacity = '1';
          wrapper.style.transform = 'translateY(0) rotate(0deg)';
        }, index * 60);
      });

      setTimeout(() => {
        allTileWrappers.forEach((w) => {
          w.style.transform = '';
          w.style.transition = '';
        });
        setArrivalVisited();
      }, allTileWrappers.length * 60 + 500);
    }

    // 4. LIVING TILES: POINTER TILT & SHEEN (Mouse fine pointer only)
    if (FEATURES.tilt && !prefersReducedMotion) {
      const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (isFinePointer) {
        const wrappers = document.querySelectorAll<HTMLElement>('.board-tile-wrapper');
        wrappers.forEach((wrapper) => {
          const card = wrapper.querySelector<HTMLElement>('.board-tile-card');
          const sheen = wrapper.querySelector<HTMLElement>('.tile-sheen-layer');
          if (!card) return;

          let rafId: number | null = null;

          wrapper.addEventListener('pointerenter', () => {
            wrapper.classList.add('is-tilting');
            if (sheen) sheen.style.opacity = '0.12';
          });

          wrapper.addEventListener('pointermove', (e) => {
            if (wrapper.classList.contains('is-dragging')) return;
            const rect = card.getBoundingClientRect();
            const k = getZoomK();
            const x = (e.clientX - rect.left) / k;
            const y = (e.clientY - rect.top) / k;
            const centerX = rect.width / (2 * k);
            const centerY = rect.height / (2 * k);

            const dx = (x - centerX) / centerX;
            const dy = (y - centerY) / centerY;

            const tiltY = Math.max(-4, Math.min(4, dx * 4));
            const tiltX = Math.max(-4, Math.min(4, -dy * 4));

            if (rafId) cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(() => {
              card.style.transform = `perspective(600px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;
              if (sheen) {
                const percX = Math.round((x / (rect.width / k)) * 100);
                const percY = Math.round((y / (rect.height / k)) * 100);
                sheen.style.background = `radial-gradient(circle at ${percX}% ${percY}%, rgba(255, 255, 255, 0.28) 0%, transparent 60%)`;
              }
            });
          });

          wrapper.addEventListener('pointerleave', () => {
            if (rafId) cancelAnimationFrame(rafId);
            card.style.transform = '';
            if (sheen) sheen.style.opacity = '0';
            setTimeout(() => {
              wrapper.classList.remove('is-tilting');
            }, 100);
          });
        });
      }
    }

    // 5. TOUCH LONG-PRESS FOR QUICK TAKE (500ms on touch)
    if (FEATURES.quickTake) {
      const resourceWrappers = document.querySelectorAll<HTMLElement>('.board-tile-wrapper[data-has-quicktake="true"]');
      resourceWrappers.forEach((wrapper) => {
        let pressTimer: any = null;

        wrapper.addEventListener('touchstart', () => {
          pressTimer = setTimeout(() => {
            wrapper.classList.toggle('is-expanded');
          }, 500);
        }, { passive: true });

        wrapper.addEventListener('touchmove', () => {
          if (pressTimer) clearTimeout(pressTimer);
        }, { passive: true });

        wrapper.addEventListener('touchend', () => {
          if (pressTimer) clearTimeout(pressTimer);
        });
      });
    }

    // 6. SEARCH & ZONE FILTERING
    if (FEATURES.search) {
      const searchInputs = [
        document.getElementById('board-search-input') as HTMLInputElement | null,
        document.getElementById('minibar-search-input') as HTMLInputElement | null
      ].filter(Boolean) as HTMLInputElement[];

      const searchClearBtn = document.getElementById('board-search-clear-btn');
      const searchEmptyEl = document.getElementById('board-search-empty');
      const emptyStateClearBtn = document.getElementById('empty-state-clear-btn');
      const liveStatus = document.getElementById('search-live-status');

      let currentSearchQuery = '';
      let activeZoneFilter = 'all';

      function applyFilters() {
        const query = currentSearchQuery.trim().toLowerCase();
        let matchCount = 0;

        document.querySelectorAll<HTMLElement>('.board-tile-wrapper').forEach((wrapper) => {
          const slug = wrapper.getAttribute('data-tile-slug') || '';
          const zoneId = wrapper.getAttribute('data-zone-id') || '';
          const tile = tiles.find((t) => t.slug === slug);
          if (!tile) return;

          const matchesZone = activeZoneFilter === 'all' || zoneId === activeZoneFilter;
          const textCorpus = `${tile.title} ${tile.description} ${tile.quickTake || ''} ${tile.tag}`.toLowerCase();
          const matchesQuery = !query || textCorpus.includes(query);

          const isMatch = matchesZone && matchesQuery;
          const hitLink = wrapper.querySelector<HTMLAnchorElement>('.tile-hit-link');
          const pinBtn = wrapper.querySelector<HTMLButtonElement>('.tile-pin-btn');

          if (isMatch) {
            matchCount++;
            wrapper.classList.remove('is-dimmed');
            wrapper.style.display = '';
            hitLink?.removeAttribute('tabindex');
            pinBtn?.removeAttribute('inert');
          } else {
            wrapper.classList.add('is-dimmed');
            hitLink?.setAttribute('tabindex', '-1');
            pinBtn?.setAttribute('inert', '');
          }
        });

        // Update live status text
        if (liveStatus) {
          liveStatus.textContent = `${matchCount} of ${TOTAL_PEGS} shown`;
        }

        // Show/hide empty state
        if (searchEmptyEl) {
          searchEmptyEl.style.display = matchCount === 0 ? 'flex' : 'none';
        }

        // Show/hide clear button
        if (searchClearBtn) {
          searchClearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
        }

        // Sync inputs
        searchInputs.forEach((inp) => {
          if (inp.value !== currentSearchQuery) inp.value = currentSearchQuery;
        });
      }

      searchInputs.forEach((inp) => {
        inp.addEventListener('input', (e) => {
          currentSearchQuery = (e.target as HTMLInputElement).value;
          applyFilters();
        });

        inp.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            currentSearchQuery = '';
            inp.value = '';
            applyFilters();
          }
        });
      });

      searchClearBtn?.addEventListener('click', () => {
        currentSearchQuery = '';
        applyFilters();
        searchInputs[0]?.focus();
      });

      emptyStateClearBtn?.addEventListener('click', () => {
        currentSearchQuery = '';
        activeZoneFilter = 'all';
        syncZoneFilterButtons();
        applyFilters();
      });

      // Zone Filter Chips
      function syncZoneFilterButtons() {
        document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]').forEach((chip) => {
          const zf = chip.getAttribute('data-zone-filter');
          const isActive = zf === activeZoneFilter;
          chip.classList.toggle('is-active', isActive);
          chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const zf = chip.getAttribute('data-zone-filter') || 'all';
          activeZoneFilter = zf;
          syncZoneFilterButtons();
          applyFilters();

          // Smooth scroll to zone plaque and brief highlight
          if (zf !== 'all') {
            const zoneBand = document.getElementById(`zone-band-${zf}`);
            if (zoneBand) {
              const k = getZoomK();
              const rect = zoneBand.getBoundingClientRect();
              const targetY = window.scrollY + rect.top * k - 120;
              window.scrollTo({ top: targetY, behavior: 'smooth' });

              const plaque = zoneBand.querySelector('.zone-plaque');
              if (plaque) {
                plaque.classList.add('is-highlighted');
                setTimeout(() => plaque.classList.remove('is-highlighted'), 1500);
              }
            }
          }
        });
      });
    }

    // 7. STICKY MINI BAR VISIBILITY ON SCROLL
    const minibar = document.getElementById('peg-sticky-minibar');
    const headerEl = document.querySelector<HTMLElement>('.board-header');

    if (minibar && headerEl) {
      const onScroll = () => {
        if (window.innerWidth < 640) {
          minibar.classList.remove('is-visible');
          return;
        }
        const rect = headerEl.getBoundingClientRect();
        if (rect.bottom < 60) {
          minibar.classList.add('is-visible');
        } else {
          minibar.classList.remove('is-visible');
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }

    // 8. MOBILE HORIZONTAL RAILS (<640px) & DOTS
    function initMobileRails() {
      const tracks = document.querySelectorAll<HTMLElement>('.zone-tiles-track');
      tracks.forEach((track) => {
        const zoneId = track.getAttribute('data-zone-id');
        const dotsContainer = document.querySelector<HTMLElement>(`[data-zone-dots="${zoneId}"]`);
        if (!dotsContainer) return;

        const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.rail-dot'));
        const items = Array.from(track.children) as HTMLElement[];

        // Sync active dot on rail scroll
        track.addEventListener('scroll', () => {
          const scrollLeft = track.scrollLeft;
          const trackW = track.offsetWidth;
          const activeIndex = Math.min(dots.length - 1, Math.round(scrollLeft / (trackW * 0.78)));

          dots.forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === activeIndex);
          });
        }, { passive: true });

        // Dot click scrolls to item
        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            const item = items[idx];
            if (item) {
              item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          });
        });
      });
    }
    initMobileRails();

    // 9. DESKTOP DRAGGABLE TILES WITH ZOOM FACTOR K (>= 900px only)
    const resetOrderBtn = document.getElementById('reset-board-btn');

    function initTileDragging() {
      if (window.innerWidth < 900) return;

      const tracks = document.querySelectorAll<HTMLElement>('.zone-tiles-track');

      // Restore saved order
      const savedOrder = getSavedTileOrder();
      if (savedOrder) {
        tracks.forEach((track) => {
          const zoneId = track.getAttribute('data-zone-id');
          if (zoneId && savedOrder[zoneId]) {
            const slugs = savedOrder[zoneId];
            slugs.forEach((slug) => {
              const el = track.querySelector(`[data-tile-slug="${slug}"]`);
              if (el) track.appendChild(el);
            });
          }
        });
      }

      // Pointer event dragging per track
      tracks.forEach((track) => {
        const zoneId = track.getAttribute('data-zone-id') || '';
        let draggingEl: HTMLElement | null = null;
        let startX = 0;
        let startY = 0;
        let hasMovedFar = false;

        track.addEventListener('pointerdown', (e) => {
          if ((e.target as HTMLElement).closest('.tile-pin-btn')) return;
          if ((e.target as HTMLElement).closest('.tile-hit-link') && e.button !== 0) return;

          const tileWrapper = (e.target as HTMLElement).closest<HTMLElement>('.board-tile-wrapper');
          if (!tileWrapper) return;

          draggingEl = tileWrapper;
          startX = e.clientX;
          startY = e.clientY;
          hasMovedFar = false;

          const onPointerMove = (moveEv: PointerEvent) => {
            if (!draggingEl) return;
            const k = getZoomK();
            const dx = (moveEv.clientX - startX) / k;
            const dy = (moveEv.clientY - startY) / k;

            if (!hasMovedFar && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
              hasMovedFar = true;
              draggingEl.classList.add('is-dragging');
              draggingEl.setPointerCapture(moveEv.pointerId);
            }

            if (hasMovedFar) {
              draggingEl.style.transform = `translate(${dx}px, ${dy}px)`;

              const siblings = Array.from(track.querySelectorAll<HTMLElement>('.board-tile-wrapper'));
              const dragRect = draggingEl.getBoundingClientRect();
              const dragCenterX = dragRect.left + dragRect.width / 2;

              for (const sib of siblings) {
                if (sib === draggingEl) continue;
                const sibRect = sib.getBoundingClientRect();
                const sibCenterX = sibRect.left + sibRect.width / 2;
                if (dragCenterX > sibCenterX && draggingEl.previousElementSibling === sib) {
                  track.insertBefore(draggingEl, sib);
                  break;
                } else if (dragCenterX < sibCenterX && draggingEl.nextElementSibling === sib) {
                  track.insertBefore(sib, draggingEl);
                  break;
                }
              }
            }
          };

          const onPointerUp = (upEv: PointerEvent) => {
            window.removeEventListener('pointermove', onPointerMove);
            window.removeEventListener('pointerup', onPointerUp);

            if (draggingEl) {
              if (hasMovedFar) {
                try {
                  draggingEl.releasePointerCapture(upEv.pointerId);
                } catch {}

                draggingEl.style.transition = 'transform 150ms ease';
                draggingEl.style.transform = 'translate(0px, 0px)';
                setTimeout(() => {
                  if (draggingEl) {
                    draggingEl.style.transition = '';
                    draggingEl.style.transform = '';
                    draggingEl.classList.remove('is-dragging');
                  }
                }, 150);

                const currentOrder = getSavedTileOrder() || {};
                const currentSlugs = Array.from(track.querySelectorAll('.board-tile-wrapper')).map(
                  (el) => el.getAttribute('data-tile-slug') || ''
                );
                currentOrder[zoneId] = currentSlugs;
                saveTileOrder(currentOrder);
              } else {
                draggingEl.classList.remove('is-dragging');
              }
              draggingEl = null;
            }
          };

          window.addEventListener('pointermove', onPointerMove);
          window.addEventListener('pointerup', onPointerUp);
        });
      });
    }

    // Reset board button handler
    resetOrderBtn?.addEventListener('click', () => {
      resetTileOrder();
      window.location.reload();
    });

    // Initial UI synchronization
    syncPinsUI();
    syncExploredUI();
    initTileDragging();

    // Re-sync on custom storage and theme change events
    window.addEventListener('rhsp:pegboard:pins-changed', syncPinsUI);
    window.addEventListener('rhsp:pegboard:explored-changed', syncExploredUI);
    window.addEventListener('rhsp-theme-change', () => {
      syncExploredUI();
      syncPinsUI();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPegBoard);
  } else {
    initPegBoard();
  }
</script>

