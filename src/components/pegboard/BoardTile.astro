---
import Icon from '../Icon.astro';
import type { BoardTileItem } from '../../data/pegBoard';

interface Props {
  tile: BoardTileItem;
  index: number;
}

const { tile } = Astro.props;
const isPlayground = tile.zoneId === 'playground';
const tileTooltip = tile.quickTake
  ? `${tile.title}: ${tile.quickTake}`
  : `${tile.title}: ${tile.description}`;
const tileAriaLabel = tile.quickTake
  ? `${tile.title}: ${tile.description}. ${tile.quickTake}`
  : `${tile.title}: ${tile.description}`;
---

<article
  class:list={[
    'pb-tile board-tile-card board-tile-wrapper',
    { 'pb-tile--playground': isPlayground }
  ]}
  data-id={tile.slug}
  data-tile-slug={tile.slug}
  data-zone={tile.zoneId}
  data-zone-id={tile.zoneId}
  data-has-quicktake={tile.quickTake ? 'true' : 'false'}
  tabindex="0"
  style={`view-transition-name: tile-${tile.slug};`}
>
  <!-- Pre-rendered glow layer (opacity animated for 60fps) -->
  <div class="tile-glow-layer" aria-hidden="true"></div>

  <!-- Start here pointer badge when recommended by Finder -->
  <span class="peg-start-ribbon" data-start-ribbon aria-hidden="true">Start here</span>

  <a
    href={tile.href}
    class="tile-hit-link"
    data-tile-link={tile.slug}
    data-action={tile.action}
    title={tileTooltip}
    aria-label={tileAriaLabel}
    aria-describedby={tile.quickTake ? `qt-${tile.slug}` : undefined}
    draggable="false"
  >
    <div class="tile-header-row">
      <div class="tile-icon-badge" style={`--peg-color: ${tile.pegColor};`}>
        <Icon name={tile.iconName} size={16} />
      </div>
    </div>

    <div class="tile-body">
      <h3 class="tile-title pb-title">{tile.title}</h3>
      <p class="tile-description">{tile.description}</p>
      {tile.quickTake && (
        <span id={`qt-${tile.slug}`} class="sr-only">
          {tile.quickTake}
        </span>
      )}
    </div>

    <div class="tile-footer-row">
      <span
        class={`tile-tag ${tile.tag === 'Coming soon' ? 'tile-tag--soon' : ''}`}
        data-tile-tag
      >
        {isPlayground ? 'Try it' : tile.tag}
      </span>
    </div>
  </a>

  <!-- Pin button (accessible focusable control) -->
  <button
    type="button"
    class="tile-pin-btn"
    data-pin-btn={tile.slug}
    aria-label={`Pin ${tile.title} to my board`}
    aria-pressed="false"
  >
    <Icon name="bookmark" size={13} class="pin-icon" />
    <span class="pin-dot" aria-hidden="true"></span>
  </button>
</article>

<style>
  /* Hanging tile card */
  .pb-tile {
    background: var(--pb-tile);
    border: 1px solid var(--pb-tile-line);
    color: var(--pb-text);
    border-radius: 16px;
    position: relative;
    width: 100%;
    min-height: 168px;
    transform-origin: 50% -22px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.25s ease, opacity 0.25s ease;
    z-index: 2;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  :global([data-mode="free"]) .pb-tile,
  :global(.pb-canvas) .pb-tile {
    position: absolute;
    width: 208px;
    height: 192px;
    min-height: 0;
    margin: 0;
  }

  :global([data-mode="free"]) .tile-hit-link,
  :global(.pb-canvas) .tile-hit-link {
    padding: 12px 14px 10px;
  }

  :global([data-mode="free"]) .tile-header-row,
  :global(.pb-canvas) .tile-header-row {
    margin-bottom: 0.35rem;
  }

  :global([data-mode="free"]) .tile-footer-row,
  :global(.pb-canvas) .tile-footer-row {
    padding-top: 0.35rem;
  }

  /* Pre-rendered glow layer */
  .tile-glow-layer {
    position: absolute;
    inset: -1px;
    border-radius: 16px;
    box-shadow: 0 0 26px -6px var(--pb-glow, rgba(247, 148, 29, 0.45));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: -1;
  }

  .pb-tile:hover:not(.is-dragging) .tile-glow-layer,
  .pb-tile.is-hovered:not(.is-dragging) .tile-glow-layer,
  .pb-tile[data-pinned="true"] .tile-glow-layer,
  .pb-tile.is-pinned .tile-glow-layer {
    opacity: 1;
  }

  .pb-tile:focus-visible {
    outline: 2px solid var(--pb-focus-ring, var(--pb-peg));
    outline-offset: 3px;
  }

  /* Cord: 1.5px wide, 22px long, stretches to 26px on hover */
  .pb-tile::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -22px;
    width: 1.5px;
    height: 22px;
    background: var(--pb-cord);
    transform: translateX(-50%);
    transform-origin: top center;
    transition: transform 0.25s ease;
    pointer-events: none;
  }

  .pb-tile:hover:not(.is-dragging)::before,
  .pb-tile.is-hovered:not(.is-dragging)::before {
    transform: translateX(-50%) scaleY(1.18);
  }

  /* Orange Peg: 10px circular peg sitting in the hole */
  .pb-tile::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -27px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pb-peg);
    transform: translateX(-50%);
    box-shadow: 0 0 12px var(--pb-glow);
    pointer-events: none;
    transition: box-shadow 0.25s ease, background-color 0.25s ease;
  }

  /* Peg click pulse on pin */
  @keyframes pegClickPulse {
    0% { transform: translateX(-50%) scale(1); }
    50% { transform: translateX(-50%) scale(1.4); }
    100% { transform: translateX(-50%) scale(1); }
  }

  .pb-tile.is-peg-pulsing::after {
    animation: pegClickPulse 0.35s ease-out;
  }

  /* Start here ribbon placed above peg */
  .peg-start-ribbon {
    display: none;
    position: absolute;
    top: -52px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--pb-accent, #F7941D);
    color: var(--pb-on-accent, #14110F);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    pointer-events: none;
    z-index: 10;
  }

  .peg-start-ribbon::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 3px;
    border-style: solid;
    border-color: var(--pb-accent, #F7941D) transparent transparent transparent;
  }

  .pb-tile[data-start-here="true"] .peg-start-ribbon,
  .pb-tile.is-start-here .peg-start-ribbon {
    display: block;
    animation: ribbonPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes ribbonPop {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(4px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }

  /* Pinned peg state: solid orange with stronger glow */
  .pb-tile[data-pinned="true"]::after,
  .pb-tile[aria-pressed="true"]::after,
  .pb-tile.is-pinned::after {
    box-shadow: 0 0 18px 2px var(--pb-glow);
  }

  .pb-tile[data-pinned="true"],
  .pb-tile.is-pinned {
    border-color: var(--pb-peg);
  }

  /* Explored peg state: peg ring */
  .pb-tile[data-explored="true"]::after,
  .pb-tile.is-explored::after {
    box-shadow: 0 0 0 2px var(--pb-board), 0 0 0 4px var(--pb-peg), 0 0 12px var(--pb-glow);
  }

  /* Hit link covers whole tile for keyboard focus */
  .tile-hit-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.15rem 1rem;
    color: inherit;
    text-decoration: none;
    outline: none;
    border-radius: 15px;
    cursor: pointer;
    position: relative;
  }

  .tile-hit-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    z-index: 1;
  }

  .tile-hit-link:focus-visible::after {
    outline: 2px solid var(--pb-focus-ring, var(--pb-peg));
    outline-offset: 2px;
  }

  .tile-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 44px;
    margin-bottom: 0.5rem;
  }

  .tile-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
    color: var(--pb-peg, #F7941D);
  }

  .tile-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tile-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
    color: var(--pb-text, #16161A);
    letter-spacing: -0.01em;
  }

  .tile-description {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--pb-text-2, #55555E);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-footer-row {
    margin-top: auto;
    padding-top: 0.65rem;
  }

  .tile-tag {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--pb-accent-wash, rgba(247, 148, 29, 0.12));
    color: var(--pb-peg, #F7941D);
    letter-spacing: 0.02em;
    border: 1px solid transparent;
  }

  .tile-tag--soon {
    background: transparent;
    border: 1px solid var(--pb-tile-line);
    color: var(--pb-text-2);
  }

  /* Pin button */
  .tile-pin-btn {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    color: var(--pb-text-3, #8C96A5);
    padding: 0;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    z-index: 10;
  }

  .tile-pin-btn:hover {
    color: var(--pb-text);
    background-color: var(--pb-accent-wash);
    border-color: var(--pb-tile-line);
  }

  .tile-pin-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring, var(--pb-peg));
    outline-offset: 1px;
  }

  .pin-dot {
    display: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--pb-peg, #F7941D);
    position: absolute;
    top: 9px;
    right: 9px;
  }

  .tile-pin-btn[aria-pressed="true"] {
    color: var(--pb-peg, #F7941D);
  }

  .tile-pin-btn[aria-pressed="true"] .pin-dot {
    display: block;
  }

  /* Lit & Dimmed states for Finder & Search */
  .pb-tile.is-lit {
    opacity: 1;
    border-color: var(--pb-peg, #F7941D);
    box-shadow: 0 0 0 1px var(--pb-peg), 0 8px 24px var(--pb-glow);
  }

  .pb-tile.is-dimmed {
    opacity: 0.35;
  }

  .pb-tile.is-dimmed .tile-pin-btn {
    pointer-events: none;
  }

  /* Mobile horizontal swipe rail styling */
  @media (max-width: 639px) {
    .pb-tile {
      width: 250px;
      flex-shrink: 0;
      scroll-snap-align: start;
    }
  }
</style>
