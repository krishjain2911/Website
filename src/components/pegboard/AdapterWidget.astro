---
import Icon from '../Icon.astro';
---

<div
  class="adapter-modal-overlay"
  id="adapter-modal-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="adapter-modal-title"
  aria-hidden="true"
>
  <div class="adapter-modal-backdrop" id="adapter-modal-backdrop" tabindex="-1"></div>

  <div class="adapter-modal-card card-mastercard">
    <div class="adapter-modal-header">
      <div class="adapter-modal-title-group">
        <span class="adapter-eyebrow">INTERACTIVE</span>
        <h2 id="adapter-modal-title" class="adapter-heading">Try the adapter</h2>
        <p class="adapter-subline">Throw the square peg through the round hoop. Switch on the RHSP adapter and every throw finds it.</p>
      </div>
      <button type="button" class="adapter-modal-close-btn" id="adapter-modal-close-btn" aria-label="Close adapter">
        <Icon name="x" size={16} />
      </button>
    </div>

    <div class="adapter-stage-container">
      <div class="adapter-status-row">
        <span class="adapter-stat">Score <b id="ah-score">0</b></span>
        <span class="adapter-stat">Streak <b id="ah-streak">0</b></span>
        <button type="button" class="adapter-power" id="ah-power" aria-pressed="false">RHSP adapter: off</button>
      </div>
      <canvas
        id="ah-canvas"
        class="adapter-canvas"
        width="480"
        height="260"
        aria-label="Basketball style game. Drag back from the square peg and release to throw it through the round hoop. Turn on the RHSP adapter to auto-aim every throw."
      ></canvas>
      <p class="adapter-hint" id="ah-hint">Drag back from the peg, then let go.</p>
    </div>
  </div>
</div>

<script>
  function initAdapterWidget() {
    const modal = document.getElementById('adapter-modal-dialog');
    const backdrop = document.getElementById('adapter-modal-backdrop');
    const closeBtn = document.getElementById('adapter-modal-close-btn');
    const cv = document.getElementById('ah-canvas') as HTMLCanvasElement | null;
    const scoreEl = document.getElementById('ah-score');
    const streakEl = document.getElementById('ah-streak');
    const powerBtn = document.getElementById('ah-power');
    const hintEl = document.getElementById('ah-hint');
    if (!modal || !cv || !scoreEl || !streakEl || !powerBtn || !hintEl) return;

    const elModal = modal;
    const elCv = cv;
    const ctx = elCv.getContext('2d')!;
    const W = 480, H = 260, G = 600;
    const START = { x: 56, y: 190 }, HALF = 10;
    const RIM_L = { x: 340, y: 112 }, RIM_R = { x: 394, y: 112 }, BOARD_X = 402;
    const TARGET = { x: (RIM_L.x + RIM_R.x) / 2, y: 102 };
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    elCv.width = W * dpr;
    elCv.height = H * dpr;
    ctx.scale(dpr, dpr);

    let score = 0, streak = 0, power = false, flash = 0, respawnAt = 0;
    let aim: { x: number; y: number } | null = null;
    const peg = { x: START.x, y: START.y, vx: 0, vy: 0, a: 0, live: false, scored: false };
    let raf = 0, last = 0;

    const isDark = () => {
      const t = document.documentElement.getAttribute('data-theme');
      return t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
    };
    const css = (name: string, fallback: string) =>
      getComputedStyle(elModal).getPropertyValue(name).trim() || fallback;

    function setPower(on: boolean) {
      power = on;
      powerBtn!.setAttribute('aria-pressed', String(on));
      powerBtn!.textContent = `RHSP adapter: ${on ? 'on' : 'off'}`;
      hintEl!.textContent = on ? 'Adapter on: click anywhere to throw.' : 'Drag back from the peg, then let go.';
    }
    powerBtn.addEventListener('click', () => setPower(!power));

    function resetGame() {
      score = 0; streak = 0; flash = 0; respawnAt = 0; aim = null;
      scoreEl!.textContent = '0'; streakEl!.textContent = '0';
      Object.assign(peg, { x: START.x, y: START.y, vx: 0, vy: 0, a: 0, live: false, scored: false });
      setPower(false);
    }

    // zoom-safe pointer position (the page runs under html { zoom }), so use the rect, not offsetWidth
    function pos(e: PointerEvent) {
      const r = elCv.getBoundingClientRect();
      return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
    }
    // velocity that lands the peg through the hoop centre in a fixed flight time
    function autoVel() {
      const T = 1.05;
      return { vx: (TARGET.x - START.x) / T, vy: (TARGET.y - START.y - 0.5 * G * T * T) / T };
    }
    function dragVel() {
      let vx = (START.x - aim!.x) * 5.5, vy = (START.y - aim!.y) * 5.5;
      const m = Math.hypot(vx, vy), max = 620;
      if (m > max) { vx *= max / m; vy *= max / m; }
      return { vx, vy };
    }

    elCv.addEventListener('pointerdown', (e) => {
      if (peg.live) return;
      elCv.setPointerCapture(e.pointerId);
      aim = pos(e);
    });
    elCv.addEventListener('pointermove', (e) => { if (aim) aim = pos(e); });
    elCv.addEventListener('pointerup', () => {
      if (!aim) return;
      const dragged = Math.hypot(START.x - aim.x, START.y - aim.y) > 12;
      if (dragged || power) {
        const v = power ? autoVel() : dragVel();
        peg.vx = v.vx; peg.vy = v.vy; peg.live = true; peg.scored = false;
      }
      aim = null;
    });
    elCv.addEventListener('pointercancel', () => { aim = null; });

    function endThrow() {
      if (!peg.scored) { streak = 0; streakEl!.textContent = '0'; }
      peg.live = false;
      respawnAt = performance.now() + 500;
    }

    function step(dt: number) {
      if (!peg.live) {
        if (respawnAt && performance.now() > respawnAt) {
          Object.assign(peg, { x: START.x, y: START.y, vx: 0, vy: 0, a: 0 });
          respawnAt = 0;
        }
        return;
      }
      const py = peg.y;
      peg.vy += G * dt; peg.x += peg.vx * dt; peg.y += peg.vy * dt; peg.a += peg.vx * dt * 0.03;
      if (peg.x + HALF > BOARD_X && peg.y > 50 && peg.y < 130) { peg.x = BOARD_X - HALF; peg.vx *= -0.45; }
      for (const r of [RIM_L, RIM_R]) {
        const dx = peg.x - r.x, dy = peg.y - r.y, d = Math.hypot(dx, dy);
        if (d < HALF + 3 && d > 0) {
          const nx = dx / d, ny = dy / d, dot = peg.vx * nx + peg.vy * ny;
          peg.vx = (peg.vx - 1.6 * dot * nx) * 0.7; peg.vy = (peg.vy - 1.6 * dot * ny) * 0.7;
          peg.x = r.x + nx * (HALF + 3); peg.y = r.y + ny * (HALF + 3);
        }
      }
      if (!peg.scored && py < RIM_L.y && peg.y >= RIM_L.y && peg.vy > 0 && peg.x > RIM_L.x && peg.x < RIM_R.x) {
        peg.scored = true; score++; streak++; flash = 1;
        scoreEl!.textContent = String(score); streakEl!.textContent = String(streak);
      }
      if (peg.y > H - 10) { peg.y = H - 10; peg.vy *= -0.4; peg.vx *= 0.8; if (Math.abs(peg.vy) < 40) endThrow(); }
      if (peg.x < -30 || peg.x > W + 30) endThrow();
    }

    function draw() {
      const accent = css('--pb-accent', '#F7941D');
      const ink = css('--pb-text-2', '#888');
      const blue = isDark() ? '#5B8FE0' : '#1E4B8F';
      ctx.clearRect(0, 0, W, H);
      ctx.globalAlpha = 0.3; ctx.strokeStyle = ink; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(0, H - 0.5); ctx.lineTo(W, H - 0.5); ctx.stroke(); ctx.globalAlpha = 1;
      ctx.fillStyle = blue; ctx.globalAlpha = 0.22; ctx.fillRect(BOARD_X, 46, 8, 90); ctx.globalAlpha = 1;
      ctx.strokeStyle = blue; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(RIM_L.x, RIM_L.y); ctx.lineTo(RIM_R.x, RIM_R.y); ctx.stroke();
      ctx.lineWidth = 1.2; ctx.globalAlpha = 0.5; ctx.beginPath();
      ctx.moveTo(RIM_L.x, RIM_L.y); ctx.lineTo(RIM_L.x + 11, RIM_L.y + 32); ctx.lineTo(RIM_R.x - 11, RIM_R.y + 32); ctx.lineTo(RIM_R.x, RIM_R.y); ctx.stroke(); ctx.globalAlpha = 1;
      ctx.fillStyle = accent;
      for (const r of [RIM_L, RIM_R]) { ctx.beginPath(); ctx.arc(r.x, r.y, 3.5, 0, 6.3); ctx.fill(); }
      if (flash > 0) {
        ctx.globalAlpha = flash * 0.35; ctx.beginPath(); ctx.arc(TARGET.x, TARGET.y + 8, 44, 0, 6.3); ctx.fill();
        ctx.globalAlpha = 1; flash -= 0.03;
      }
      if (!peg.live && (aim || power)) {
        const v = power ? autoVel() : dragVel();
        ctx.fillStyle = accent;
        for (let i = 1; i <= 14; i++) {
          const t = i * 0.07;
          ctx.globalAlpha = 1 - i / 16;
          ctx.beginPath(); ctx.arc(START.x + v.vx * t, START.y + v.vy * t + 0.5 * G * t * t, 2.2, 0, 6.3); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      ctx.save(); ctx.translate(peg.x, peg.y); ctx.rotate(peg.a);
      ctx.fillStyle = accent; ctx.strokeStyle = css('--pb-accent-lo', '#B86200'); ctx.lineWidth = 1.5;
      if (power) { ctx.shadowColor = accent; ctx.shadowBlur = 14; }
      ctx.beginPath(); ctx.roundRect(-HALF, -HALF, HALF * 2, HALF * 2, 3); ctx.fill(); ctx.stroke();
      ctx.shadowBlur = 0; ctx.fillStyle = css('--pb-on-accent', '#14110F'); ctx.globalAlpha = 0.3;
      ctx.fillRect(-3.5, -3.5, 7, 7);
      ctx.restore();
    }

    function loop(now: number) {
      const dt = Math.min((now - last) / 1000, 0.033); last = now;
      step(dt); draw();
      raf = requestAnimationFrame(loop);
    }

    let previousOverflow = '';
    let lastActiveElement: HTMLElement | null = null;
    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement | null;
      elModal.classList.add('is-open');
      elModal.setAttribute('aria-hidden', 'false');
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      resetGame();
      last = performance.now();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
      (powerBtn as HTMLElement).focus();
    }
    function closeModal() {
      elModal.classList.remove('is-open');
      elModal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = previousOverflow;
      document.body.style.overflow = '';
      cancelAnimationFrame(raf);
      lastActiveElement?.focus();
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-action="open-adapter"]');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && elModal.classList.contains('is-open')) closeModal();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdapterWidget);
  } else {
    initAdapterWidget();
  }
</script>

<style>
  .adapter-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 3500;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    padding: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  .adapter-modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .adapter-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .adapter-modal-card {
    position: relative;
    width: 100%;
    max-width: 560px;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line, var(--color-border));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    z-index: 2;
    transform: scale(0.96);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .adapter-modal-overlay.is-open .adapter-modal-card {
    transform: scale(1);
  }

  .adapter-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .adapter-modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .adapter-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pb-accent, #F7941D);
  }

  .adapter-heading {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--pb-text, var(--color-text-primary));
  }

  .adapter-subline {
    font-size: 0.875rem;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  .adapter-modal-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--pb-line, var(--color-border));
    background: transparent;
    color: var(--pb-text-2, var(--color-text-secondary));
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .adapter-modal-close-btn:hover {
    color: var(--pb-text);
    border-color: var(--pb-accent);
  }

  .adapter-stage-container {
    padding: 1.25rem;
    border-radius: 14px;
    background-color: var(--pb-tile, rgba(0, 0, 0, 0.02));
    border: 1px solid var(--pb-line, var(--color-border));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .adapter-status-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .adapter-stat {
    font-size: 12px;
    font-weight: 600;
    color: var(--pb-text-2, var(--color-text-secondary));
  }

  .adapter-stat b {
    margin-left: 0.25rem;
    font-size: 1rem;
    color: var(--pb-text, var(--color-text-primary));
  }

  .adapter-power {
    margin-left: auto;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--pb-accent, #F7941D);
    border: 1.5px solid var(--pb-accent, #F7941D);
    background: transparent;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .adapter-power[aria-pressed="true"] {
    background: var(--pb-accent, #F7941D);
    color: var(--pb-on-accent, #14110F);
    box-shadow: 0 0 16px var(--pb-glow, rgba(247, 148, 29, 0.5));
  }

  .adapter-power:focus-visible {
    outline: 2px solid var(--pb-focus-ring, #FFAE4A);
    outline-offset: 2px;
  }

  .adapter-canvas {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
    cursor: crosshair;
  }

  .adapter-hint {
    margin: 0;
    font-size: 12px;
    color: var(--pb-text-2, var(--color-text-secondary));
  }
</style>