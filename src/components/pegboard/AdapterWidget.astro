---
import Icon from '../Icon.astro';
---

<div
  class="adapter-modal-overlay"
  id="adapter-modal-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="adapter-modal-title"
  aria-hidden="true"
>
  <div class="adapter-modal-backdrop" id="adapter-modal-backdrop" tabindex="-1"></div>

  <div class="adapter-modal-card card-mastercard">
    <div class="adapter-modal-header">
      <div class="adapter-modal-title-group">
        <span class="adapter-eyebrow">INTERACTIVE</span>
        <h2 id="adapter-modal-title" class="adapter-heading">Try the adapter</h2>
        <p class="adapter-subline">Slide the square peg into the round hole. Every problem has an angle.</p>
      </div>
      <button type="button" class="adapter-modal-close-btn" id="adapter-modal-close-btn" aria-label="Close adapter">
        <Icon name="x" size={16} />
      </button>
    </div>

    <div class="adapter-stage-container">
      <div class="adapter-status-row">
        <span class="adapter-label" id="adapter-status-label">Slide to engage the adapter</span>
      </div>

      <div class="adapter-track" id="adapter-track" aria-hidden="false">
        <!-- Round hole target on the right -->
        <div class="adapter-hole-target" id="adapter-hole" aria-hidden="true">
          <div class="adapter-hole-shadow"></div>
          <div class="adapter-ring-overlay" id="adapter-ring-fade"></div>
        </div>

        <!-- Square peg draggable on the left -->
        <div
          class="adapter-square-peg"
          id="adapter-peg"
          tabindex="0"
          role="slider"
          aria-label="Square peg adapter. Use arrow keys to slide into round hole or drag with pointer."
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <div class="peg-core"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initAdapterWidget() {
    const modalDialog = document.getElementById('adapter-modal-dialog');
    const modalBackdrop = document.getElementById('adapter-modal-backdrop');
    const modalCloseBtn = document.getElementById('adapter-modal-close-btn');

    const track = document.getElementById('adapter-track');
    const peg = document.getElementById('adapter-peg');
    const hole = document.getElementById('adapter-hole');
    const ring = document.getElementById('adapter-ring-fade');
    const label = document.getElementById('adapter-status-label');

    if (!modalDialog || !track || !peg || !hole || !ring || !label) return;

    const elModalDialog = modalDialog;
    const elTrack = track;
    const elPeg = peg;
    const elRing = ring;
    const elLabel = label;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let isEngaged = false;
    let resetTimer: any = null;

    let previousOverflow = '';
    let lastActiveElement: HTMLElement | null = null;
    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement | null;
      elModalDialog.classList.add('is-open');
      elModalDialog.setAttribute('aria-hidden', 'false');
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      elPeg.focus();
    }

    function closeModal() {
      elModalDialog.classList.remove('is-open');
      elModalDialog.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = previousOverflow;
      document.body.style.overflow = '';
      lastActiveElement?.focus();
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-action="open-adapter"]');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    modalCloseBtn?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalDialog.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Helper: calculate zoom factor k
    function getK(): number {
      const rect = elTrack.getBoundingClientRect();
      const offsetW = elTrack.offsetWidth || 1;
      return rect.width / offsetW || 1;
    }

    function getMaxX(): number {
      const trackW = elTrack.offsetWidth || 260;
      const pegW = elPeg.offsetWidth || 28;
      return Math.max(10, trackW - pegW - 8);
    }

    function updatePegPosition(x: number) {
      const maxX = getMaxX();
      const clampedX = Math.max(0, Math.min(maxX, x));
      currentX = clampedX;
      elPeg.style.transform = `translateX(${clampedX}px)`;
      elPeg.setAttribute('aria-valuenow', Math.round((clampedX / maxX) * 100).toString());

      // Distance to hole (hole is at maxX)
      const ratio = clampedX / maxX;

      // Orange adapter ring fades in as peg gets close (ratio > 0.35)
      if (ratio > 0.35) {
        const ringOpacity = Math.min(1, (ratio - 0.35) / 0.5);
        elRing.style.opacity = ringOpacity.toFixed(2);
      } else {
        elRing.style.opacity = '0';
      }

      // Check engagement
      if (ratio >= 0.88 && !isEngaged) {
        engage();
      }
    }

    function engage() {
      if (isEngaged) return;
      isEngaged = true;
      const maxX = getMaxX();

      if (reduceMotion) {
        updatePegPosition(maxX);
        elRing.style.opacity = '1';
        elLabel.textContent = 'Every problem has an angle.';
        elLabel.classList.add('is-solved');
      } else {
        elPeg.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
        elPeg.style.transform = `translateX(${maxX}px)`;
        elRing.style.opacity = '1';
        elLabel.textContent = 'Every problem has an angle.';
        elLabel.classList.add('is-solved');
      }

      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        reset();
      }, 3000);
    }

    function reset() {
      isEngaged = false;
      elLabel.textContent = 'Slide to engage the adapter';
      elLabel.classList.remove('is-solved');
      elRing.style.opacity = '0';
      if (reduceMotion) {
        elPeg.style.transform = 'translateX(0px)';
      } else {
        elPeg.style.transition = 'transform 0.35s ease';
        elPeg.style.transform = 'translateX(0px)';
        setTimeout(() => {
          elPeg.style.transition = '';
        }, 350);
      }
      currentX = 0;
      elPeg.setAttribute('aria-valuenow', '0');
    }

    // Pointer events (desktop drag & touch)
    elPeg.addEventListener('pointerdown', (e) => {
      if (isEngaged) return;
      isDragging = true;
      startX = e.clientX;
      elPeg.style.transition = '';
      elPeg.setPointerCapture(e.pointerId);

      const onPointerMove = (moveEv: PointerEvent) => {
        if (!isDragging) return;
        const k = getK();
        const delta = (moveEv.clientX - startX) / k;
        updatePegPosition(currentX + delta);
        startX = moveEv.clientX;
      };

      const onPointerUp = (upEv: PointerEvent) => {
        isDragging = false;
        try {
          elPeg.releasePointerCapture(upEv.pointerId);
        } catch {}
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('pointerup', onPointerUp);

        if (!isEngaged) {
          elPeg.style.transition = 'transform 0.2s ease';
          elPeg.style.transform = 'translateX(0px)';
          currentX = 0;
          elRing.style.opacity = '0';
        }
      };

      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
    });

    // Keyboard controls (arrow keys & Enter)
    elPeg.addEventListener('keydown', (e) => {
      const maxX = getMaxX();
      const step = maxX / 5;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        updatePegPosition(currentX + step);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        updatePegPosition(currentX - step);
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        engage();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdapterWidget);
  } else {
    initAdapterWidget();
  }
</script>

<style>
  .adapter-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 3500;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    padding: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  .adapter-modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .adapter-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .adapter-modal-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line, var(--color-border));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    z-index: 2;
    transform: scale(0.96);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .adapter-modal-overlay.is-open .adapter-modal-card {
    transform: scale(1);
  }

  .adapter-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .adapter-modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .adapter-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pb-accent, #F7941D);
  }

  .adapter-heading {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--pb-text, var(--color-text-primary));
  }

  .adapter-subline {
    font-size: 0.875rem;
    color: var(--pb-text-2, var(--color-text-secondary));
    margin: 0;
  }

  .adapter-modal-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--pb-line, var(--color-border));
    background: transparent;
    color: var(--pb-text-2, var(--color-text-secondary));
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .adapter-modal-close-btn:hover {
    color: var(--pb-text);
    border-color: var(--pb-accent);
  }

  .adapter-stage-container {
    padding: 1.25rem;
    border-radius: 14px;
    background-color: var(--pb-tile, rgba(0, 0, 0, 0.02));
    border: 1px solid var(--pb-line, var(--color-border));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .adapter-status-row {
    width: 100%;
    text-align: center;
    min-height: 20px;
  }

  .adapter-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pb-text-2, var(--color-text-secondary));
    transition: color 0.2s ease;
  }

  .adapter-label.is-solved {
    color: var(--pb-accent, #F7941D);
  }

  .adapter-track {
    position: relative;
    width: 100%;
    max-width: 340px;
    height: 40px;
    background-color: var(--pb-panel, rgba(0, 0, 0, 0.05));
    border-radius: 999px;
    border: 1px solid var(--pb-line, var(--color-border));
    display: flex;
    align-items: center;
    padding: 3px;
    touch-action: none;
  }

  /* Hole target on right */
  .adapter-hole-target {
    position: absolute;
    right: 6px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--pb-hole, #070605);
    border: 1px solid var(--pb-panel-edge, rgba(0, 0, 0, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .adapter-hole-shadow {
    position: absolute;
    inset: 1px;
    border-radius: 50%;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  /* Adapter orange ring that fades in */
  .adapter-ring-overlay {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2.5px solid var(--pb-accent, #F7941D);
    box-shadow: 0 0 10px var(--pb-glow, rgba(247, 148, 29, 0.5));
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* Square peg on left */
  .adapter-square-peg {
    position: absolute;
    left: 6px;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: var(--pb-accent, #F7941D);
    border: 1px solid var(--pb-accent-lo, #B86200);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.35);
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    touch-action: none;
    outline: none;
  }

  .adapter-square-peg:active {
    cursor: grabbing;
  }

  .adapter-square-peg:focus-visible {
    outline: 2px solid var(--pb-focus-ring, #FFAE4A);
    outline-offset: 2px;
  }

  .peg-core {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background-color: var(--pb-on-accent, #14110F);
    opacity: 0.3;
  }
</style>
