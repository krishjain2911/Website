---
import Icon from '../Icon.astro';
import { siteConfig } from '../../config/site';

const contactEmail = siteConfig.contact.email;
---

<div id="my-board-drawer" class="my-board-drawer-overlay" aria-hidden="true">
  <div class="my-board-backdrop" id="my-board-backdrop" tabindex="-1"></div>

  <aside
    class="my-board-panel"
    role="dialog"
    aria-labelledby="my-board-heading"
    aria-modal="true"
  >
    <div class="drawer-header">
      <div class="drawer-title-group">
        <span class="drawer-eyebrow">SAVED TOPICS</span>
        <h2 id="my-board-heading" class="drawer-heading">Your pinned topics</h2>
      </div>
      <button
        type="button"
        id="my-board-close-btn"
        class="drawer-close-btn"
        aria-label="Close my board drawer"
      >
        <Icon name="x" size={18} />
      </button>
    </div>

    <!-- Pinned tiles list / Empty state -->
    <div class="drawer-content">
      <div id="pinned-empty-state" class="pinned-empty-state">
        <div class="empty-icon-circle" aria-hidden="true">
          <Icon name="bookmark" size={24} />
        </div>
        <p class="empty-text">Pin a few tiles and they will appear here.</p>
        <p class="empty-sub">Explore the board, pin what matters to your roadmap, and discuss your priorities with our team.</p>
      </div>

      <ul id="pinned-tiles-list" class="pinned-tiles-list" aria-label="Pinned board tiles">
        <!-- Rendered dynamically by client script -->
      </ul>
    </div>

    <!-- Drawer Footer: Discuss my board + Email copy + Reset board -->
    <div class="drawer-footer">
      <div class="drawer-actions-col">
        <a
          id="discuss-board-btn"
          href={`mailto:${contactEmail}?subject=PEG%20Board%3A%20my%20pinned%20topics`}
          class="btn drawer-discuss-btn"
        >
          <Icon name="mail" size={16} />
          <span>Discuss my board</span>
        </a>

        <div class="email-fallback-row">
          <span class="email-label">Or email us directly:</span>
          <div class="email-copy-box">
            <span class="selectable-email" id="selectable-contact-email">{contactEmail}</span>
            <button
              type="button"
              id="copy-contact-email-btn"
              class="copy-email-btn"
              aria-label="Copy email address to clipboard"
            >
              <Icon name="copy" size={14} />
              <span id="copy-email-feedback">Copy</span>
            </button>
          </div>
        </div>

        <div class="drawer-reset-row">
          <button
            type="button"
            class="drawer-reset-board-btn"
            id="drawer-reset-board-btn"
            title="Reset board layout"
          >
            Reset board
          </button>
        </div>
      </div>
    </div>
  </aside>
</div>

<style>
  .my-board-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 3500;
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  .my-board-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .my-board-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .my-board-panel {
    position: relative;
    width: 100%;
    max-width: 440px;
    height: 100%;
    background-color: var(--pb-tile-raised, #FFFFFF);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
    border-left: 1px solid var(--pb-line);
  }

  .my-board-drawer-overlay.is-open .my-board-panel {
    transform: translateX(0);
  }

  @media (max-width: 639px) {
    .my-board-drawer-overlay {
      align-items: flex-end;
    }

    .my-board-panel {
      max-width: 100%;
      height: 85dvh;
      border-radius: 20px 20px 0 0;
      border-left: none;
      border-top: 2px solid var(--pb-accent, #F7941D);
      transform: translateY(100%);
    }

    .my-board-drawer-overlay.is-open .my-board-panel {
      transform: translateY(0);
    }
  }

  .drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.5rem 1.75rem 1.25rem;
    border-bottom: 1px solid var(--pb-line);
  }

  .drawer-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .drawer-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pb-accent, #F7941D);
  }

  .drawer-heading {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--pb-text);
    letter-spacing: -0.01em;
  }

  .drawer-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid var(--pb-line);
    background: transparent;
    color: var(--pb-text-2);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .drawer-close-btn:hover {
    color: var(--pb-text);
    background-color: var(--pb-accent-wash);
    border-color: var(--pb-accent);
  }

  .drawer-close-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem 1.75rem;
  }

  .pinned-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    min-height: 220px;
    color: var(--pb-text-2);
  }

  .empty-icon-circle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--pb-accent-wash);
    color: var(--pb-accent);
    margin-bottom: 1rem;
    border: 1px solid var(--pb-line);
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--pb-text);
    margin: 0 0 0.4rem;
  }

  .empty-sub {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--pb-text-2);
    margin: 0;
    max-width: 28ch;
  }

  .pinned-tiles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pinned-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border: 1px solid var(--pb-line);
    border-radius: 12px;
    background-color: var(--pb-tile);
    gap: 0.75rem;
  }

  .pinned-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .pinned-item-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--pb-text);
    text-decoration: none;
  }

  .pinned-item-title:hover {
    color: var(--pb-accent);
    text-decoration: underline;
  }

  .pinned-item-tag {
    font-size: 10.5px;
    color: var(--pb-text-3);
  }

  .pinned-remove-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: transparent;
    color: var(--pb-text-3);
    cursor: pointer;
    border-radius: 6px;
    font-size: 14px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .pinned-remove-btn:hover {
    color: var(--pb-accent);
    background-color: var(--pb-accent-wash);
  }

  .pinned-remove-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
  }

  .drawer-footer {
    padding: 1.25rem 1.75rem;
    border-top: 1px solid var(--pb-line);
    background-color: var(--pb-tile-raised);
  }

  .drawer-actions-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drawer-discuss-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.85rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 999px;
    background-color: var(--pb-accent, #F7941D);
    color: var(--pb-on-accent, #14110F);
    border: 1px solid var(--pb-accent-lo, #B86200);
    text-decoration: none;
    box-shadow: 0 4px 14px var(--pb-glow);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .drawer-discuss-btn:hover {
    background-color: var(--pb-accent-hi, #FFAE4A);
    transform: translateY(-1px);
  }

  .drawer-discuss-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
    outline-offset: 2px;
  }

  .email-fallback-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .email-label {
    font-size: 11px;
    color: var(--pb-text-3);
  }

  .email-copy-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 0.5rem 0.3rem 0.85rem;
    border-radius: 8px;
    background-color: var(--pb-tile);
    border: 1px solid var(--pb-line);
    gap: 0.5rem;
  }

  .selectable-email {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--pb-text-2);
    user-select: all;
    -webkit-user-select: all;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--pb-line);
    border-radius: 6px;
    background: transparent;
    color: var(--pb-text);
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .copy-email-btn:hover {
    border-color: var(--pb-accent);
    color: var(--pb-accent);
  }

  .copy-email-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
  }

  .drawer-reset-row {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--pb-line);
  }

  .drawer-reset-board-btn {
    background: transparent;
    border: none;
    color: var(--pb-text-3);
    font-size: 11.5px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .drawer-reset-board-btn:hover {
    color: var(--pb-text);
  }

  .drawer-reset-board-btn:focus-visible {
    outline: 2px solid var(--pb-focus-ring);
  }
</style>
