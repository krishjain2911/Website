---
import { siteConfig } from '../config/site';

interface Props {
  targetPrefix?: string; // 'journey-stop' for homepage, 'stage-0' for solutions
  marker?: 'dot' | 'peg'; // 'dot' on homepage, 'peg' (square logo mark cube) on solutions
  class?: string;
}

const { targetPrefix = 'stage-0', marker = 'peg', class: className = '' } = Astro.props;
const steps = siteConfig.approach.steps;
---

<nav
  class={`journey-progress-rail ${marker === 'peg' ? 'marker-peg' : 'marker-dot'} ${className}`}
  id="journey-progress-rail"
  aria-label="Journey stages progress"
  data-marker={marker}
>
  <div class="rail-indicator" id="rail-indicator-text">STAGE 1 / 6</div>
  <div class="rail-dots-track">
    <div class="rail-connecting-line" aria-hidden="true"></div>
    {steps.map((step, idx) => {
      const targetId = targetPrefix === 'stage-0' ? `stage-0${idx + 1}` : `${targetPrefix}-${idx}`;
      return (
        <a
          href={`#${targetId}`}
          class={`rail-dot ${idx === 0 ? 'is-active is-current' : 'is-upcoming'}`}
          id={`rail-dot-${idx}`}
          data-stage={idx}
          data-target={targetId}
          title={`Stage 0${step.number}: ${step.title}`}
          aria-label={`Stage 0${step.number}: ${step.title}`}
          aria-current={idx === 0 ? 'step' : undefined}
        >
          <span class="rail-dot-num" aria-hidden="true">{step.number}</span>
          <span class="rail-marker-box">
            <span class="dot-inner dot-passed" style={`--dot-color: ${step.color};`}></span>
            <img
              src="/brand/pill-square-64.webp"
              srcset="/brand/pill-square-64.webp 1x, /brand/pill-square-128.webp 2x"
              alt=""
              aria-hidden="true"
              class="peg-marker-cube rail-cube"
              width="20"
              height="20"
              decoding="async"
            />
          </span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .journey-progress-rail {
    position: fixed;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center; /* Keeps STAGE n / 6 pill centered above */
    gap: 0.65rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .journey-progress-rail.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 899px) {
    .journey-progress-rail {
      display: none !important;
    }
  }

  .rail-indicator {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    background-color: var(--color-surface);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    white-space: nowrap;
    text-align: center;
  }

  /* Rail dots track pill container */
  .rail-dots-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.6rem 0.5rem; /* Inner padding prevents any border clipping */
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  /* Connecting vertical line centered on the marker column (Col 2) */
  .rail-connecting-line {
    position: absolute;
    right: calc(0.5rem + 13px); /* 0.5rem track padding + half of 26px marker box */
    top: calc(0.6rem + 13px);
    bottom: calc(0.6rem + 13px);
    width: 2px;
    transform: translateX(50%);
    background: var(--color-border);
    z-index: 1;
    border-radius: 1px;
    pointer-events: none;
  }

  /* Fixed-width CSS Grid (Label Col: 16px, Marker Col: 26px) */
  .rail-dot {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 16px 26px; /* Fixed width: 16px label, 26px marker */
    column-gap: 6px;
    align-items: center;
    justify-items: center;
    padding: 2px 4px;
    min-height: 32px;
    border-radius: 8px;
    text-decoration: none;
    outline: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .rail-dot:hover {
    background-color: var(--color-surface-hover, rgba(0, 0, 0, 0.04));
  }

  .rail-dot:focus-visible {
    box-shadow: 0 0 0 2px #F7941D;
  }

  /* Label Column (Numbers 1-6) - safely contained inside grid, never overlaps pill border */
  .rail-dot-num {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text-muted);
    justify-self: end;
    text-align: right;
    line-height: 1;
    transition: color 0.2s ease;
    user-select: none;
  }

  .rail-dot.is-active .rail-dot-num,
  .rail-dot.is-passed .rail-dot-num {
    color: var(--color-text-primary);
  }

  /* Fixed-size Marker Box */
  .rail-marker-box {
    position: relative;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Dot Marker */
  .dot-inner {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-text-muted);
    opacity: 0.45;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rail-dot:hover .dot-inner {
    opacity: 0.85;
    transform: scale(1.2);
  }

  /* Upcoming stages: pale grey dot */
  .rail-dot.is-upcoming .dot-passed {
    background-color: #cbd5e1;
    opacity: 0.7;
  }
  :global(:root[data-theme="dark"]) .rail-dot.is-upcoming .dot-passed {
    background-color: rgba(255, 255, 255, 0.25);
  }

  /* Passed stages: filled dot with stage color */
  .rail-dot.is-passed .dot-inner {
    width: 8px;
    height: 8px;
    background-color: var(--dot-color, #1E4B8F);
    opacity: 0.95;
    box-shadow: 0 0 6px var(--dot-color, #1E4B8F);
  }

  /* Active stage: 20px RHSP logo cube replaces dot without expanding box */
  .rail-cube {
    display: none;
    width: 20px;
    height: 20px;
    object-fit: contain;
    pointer-events: none;
    filter: drop-shadow(0 2px 4px rgba(247, 148, 29, 0.45));
  }

  .rail-dot.is-active .dot-inner,
  .rail-dot.is-current .dot-inner {
    display: none;
  }

  .rail-dot.is-active .rail-cube,
  .rail-dot.is-current .rail-cube {
    display: block;
    animation: pillCubePop 0.26s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .rail-dot:hover .rail-cube {
    transform: scale(1.1);
  }

  @keyframes pillCubePop {
    from { transform: scale(0.6); opacity: 0.4; }
    to { transform: scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-dot.is-active .rail-cube,
    .rail-dot.is-current .rail-cube {
      animation: none;
    }
  }
</style>

<script>
  function initProgressPill() {
    const rail = document.getElementById('journey-progress-rail');
    if (!rail) return;

    const railText = document.getElementById('rail-indicator-text');
    const dots = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.rail-dot'));

    // Check if on Solution page (#stage-01 to #stage-06)
    const stageSections = [1, 2, 3, 4, 5, 6]
      .map((num) => document.getElementById(`stage-0${num}`))
      .filter((el): el is HTMLElement => Boolean(el));

    if (stageSections.length === 6) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Click handler
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          const target = stageSections[idx];
          if (target) {
            target.scrollIntoView({
              behavior: prefersReducedMotion ? 'auto' : 'smooth',
              block: 'start'
            });
          }
        });
      });

      // Update pill visibility and current stage
      const updateSolutionPill = () => {
        const firstRect = stageSections[0].getBoundingClientRect();
        const lastRect = stageSections[5].getBoundingClientRect();

        // Visible only while within stage panels: hidden above stage 1 and below stage 6
        const inView = firstRect.top <= window.innerHeight * 0.6 && lastRect.bottom >= window.innerHeight * 0.2;
        rail.classList.toggle('is-visible', inView && window.innerWidth >= 900);

        if (!inView) return;

        let activeIdx = 0;
        stageSections.forEach((section, idx) => {
          const rect = section.getBoundingClientRect();
          // Header is ~80px, active when upper third
          if (rect.top <= window.innerHeight * 0.45) {
            activeIdx = idx;
          }
        });

        if (railText) {
          railText.textContent = `STAGE ${activeIdx + 1} / 6`;
        }

        dots.forEach((dot, idx) => {
          dot.classList.remove('is-active', 'is-current', 'is-passed', 'is-upcoming');
          if (idx < activeIdx) {
            dot.classList.add('is-passed');
            dot.removeAttribute('aria-current');
          } else if (idx === activeIdx) {
            dot.classList.add('is-active', 'is-current');
            dot.setAttribute('aria-current', 'step');
          } else {
            dot.classList.add('is-upcoming');
            dot.removeAttribute('aria-current');
          }
        });
      };

      window.addEventListener('scroll', updateSolutionPill, { passive: true });
      window.addEventListener('resize', updateSolutionPill, { passive: true });
      updateSolutionPill();
    }
  }

  initProgressPill();
  document.addEventListener('astro:after-swap', initProgressPill);
</script>
