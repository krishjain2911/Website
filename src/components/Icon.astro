---
// Icon.astro: Clean, accessible inline SVGs from Lucide (stroke-width: 1.75, 24px viewBox)
interface Props {
  name: 
    | 'arrow-right'
    | 'arrow-left'
    | 'arrow-up-right'
    | 'chevron-down'
    | 'chevron-up'
    | 'chevron-left'
    | 'chevron-right'
    | 'x'
    | 'menu'
    | 'play'
    | 'pause'
    | 'rotate-ccw'
    | 'copy'
    | 'check'
    | 'phone'
    | 'mail'
    | 'external-link'
    | 'code'
    | 'layers'
    | 'cpu'
    | 'eye'
    | 'file-text'
    | 'database'
    | 'message-square'
    | 'sliders'
    | 'zap'
    | 'sparkles'
    | 'compass'
    | 'shield'
    | 'users'
    | 'key'
    | 'sun'
    | 'moon'
    | 'search'
    | 'map-pin'
    | 'dollar'
    | 'currency-dollar';
  size?: number | string;
  strokeWidth?: number | string;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { 
  name, 
  size = 24, 
  strokeWidth = 1.75,
  class: className = '',
  'aria-hidden': ariaHidden = true 
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide-icon lucide-${name} ${className}`}
  aria-hidden={ariaHidden ? 'true' : undefined}
>
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </>
  )}

  {name === 'arrow-left' && (
    <>
      <path d="m12 19-7-7 7-7" />
      <path d="M19 12H5" />
    </>
  )}

  {name === 'arrow-up-right' && (
    <>
      <path d="M7 7h10v10" />
      <path d="M7 17 17 7" />
    </>
  )}

  {name === 'chevron-down' && (
    <path d="m6 9 6 6 6-6" />
  )}

  {name === 'chevron-up' && (
    <path d="m18 15-6-6-6 6" />
  )}

  {name === 'chevron-left' && (
    <path d="m15 18-6-6 6-6" />
  )}

  {name === 'chevron-right' && (
    <path d="m9 18 6-6-6-6" />
  )}

  {name === 'x' && (
    <>
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </>
  )}

  {name === 'menu' && (
    <>
      <line x1="4" x2="20" y1="12" y2="12" />
      <line x1="4" x2="20" y1="6" y2="6" />
      <line x1="4" x2="20" y1="18" y2="18" />
    </>
  )}

  {name === 'play' && (
    <polygon points="6 3 20 12 6 21 6 3" />
  )}

  {name === 'pause' && (
    <>
      <rect x="6" y="4" width="4" height="16" />
      <rect x="14" y="4" width="4" height="16" />
    </>
  )}

  {name === 'rotate-ccw' && (
    <>
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
      <path d="M3 3v5h5" />
    </>
  )}

  {name === 'copy' && (
    <>
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </>
  )}

  {name === 'check' && (
    <path d="M20 6 9 17l-5-5" />
  )}

  {name === 'phone' && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}

  {name === 'mail' && (
    <>
      <rect width="20" height="16" x="2" y="4" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </>
  )}

  {name === 'external-link' && (
    <>
      <path d="M15 3h6v6" />
      <path d="M10 14 21 3" />
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    </>
  )}

  {name === 'code' && (
    <>
      <polyline points="16 18 22 12 16 6" />
      <polyline points="8 6 2 12 8 18" />
    </>
  )}

  {name === 'layers' && (
    <>
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </>
  )}

  {name === 'cpu' && (
    <>
      <rect width="16" height="16" x="4" y="4" rx="2" />
      <rect width="6" height="6" x="9" y="9" />
      <path d="M15 2v2" />
      <path d="M15 20v2" />
      <path d="M2 15h2" />
      <path d="M2 9h2" />
      <path d="M20 15h2" />
      <path d="M20 9h2" />
      <path d="M9 2v2" />
      <path d="M9 20v2" />
    </>
  )}

  {name === 'eye' && (
    <>
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}

  {name === 'file-text' && (
    <>
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
      <path d="M10 9H8" />
      <path d="M16 13H8" />
      <path d="M16 17H8" />
    </>
  )}

  {name === 'database' && (
    <>
      <ellipse cx="12" cy="5" rx="9" ry="3" />
      <path d="M3 5V19A9 3 0 0 0 21 19V5" />
      <path d="M3 12A9 3 0 0 0 21 12" />
    </>
  )}

  {name === 'message-square' && (
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
  )}

  {name === 'sliders' && (
    <>
      <line x1="4" x2="4" y1="21" y2="14" />
      <line x1="4" x2="4" y1="10" y2="3" />
      <line x1="12" x2="12" y1="21" y2="12" />
      <line x1="12" x2="12" y1="8" y2="3" />
      <line x1="20" x2="20" y1="21" y2="16" />
      <line x1="20" x2="20" y1="12" y2="3" />
      <line x1="1" x2="7" y1="14" y2="14" />
      <line x1="9" x2="15" y1="8" y2="8" />
      <line x1="17" x2="23" y1="16" y2="16" />
    </>
  )}

  {name === 'zap' && (
    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
  )}

  {name === 'sparkles' && (
    <>
      <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
      <path d="M5 3v4" />
      <path d="M19 17v4" />
      <path d="M3 5h4" />
      <path d="M17 19h4" />
    </>
  )}

  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </>
  )}

  {name === 'shield' && (
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
  )}

  {name === 'users' && (
    <>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </>
  )}

  {name === 'key' && (
    <path d="m21 2-2 2m-1.5 1.5L19 7l-2 2-1.5-1.5L14 9l-1.5-1.5M7.5 15.5A5.5 5.5 0 1 1 13 10a5.5 5.5 0 0 1-5.5 5.5Z" />
  )}

  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </>
  )}

  {name === 'moon' && (
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  )}

  {name === 'map-pin' && (
    <>
      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 10.993 4 10a8 8 0 0 1 16 0" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}

  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </>
  )}

  {(name === 'dollar' || name === 'currency-dollar') && (
    <>
      <line x1="12" x2="12" y1="2" y2="22" />
      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
    </>
  )}

</svg>

<style>
  .lucide-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
