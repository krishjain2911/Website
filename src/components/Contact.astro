---
import { siteConfig } from '../config/site';

const { contact, team } = siteConfig;

// Obfuscate phone numbers in base64 so they are not indexed in plain HTML text
const encodedPhones = team.members.reduce((acc, m, idx) => {
  acc[`founder-${idx}`] = Buffer.from(m.phone).toString('base64');
  return acc;
}, {} as Record<string, string>);
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact-wrapper morphed-frame reveal-on-scroll">
      <div class="contact-header">
        <span class="mono-label">{contact.label}</span>
        <h2 id="contact-heading" class="contact-headline">{contact.headline}</h2>
        <p class="contact-subline">{contact.subline}</p>
      </div>

      <!-- Primary Email Action -->
      <div class="email-action-box">
        <div class="email-meta-label">PRIMARY INQUIRY CHANNEL</div>
        <div class="email-row">
          <a
            href={`mailto:${contact.email}`}
            class="email-link"
            id="main-email-link"
            aria-label={`Send email to ${contact.email}`}
          >
            {contact.email}
          </a>
          <button
            type="button"
            class="btn btn-secondary copy-email-btn"
            id="copy-email-btn"
            data-email={contact.email}
            aria-label="Copy email address to clipboard"
          >
            <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="btn-label" id="copy-btn-text">Copy</span>
          </button>
        </div>
        <span class="copy-status-msg" id="copy-status" role="status" aria-live="polite"></span>
      </div>

      <!-- Direct Founder Contact Channels -->
      <div class="founder-phones-area">
        <h3 class="founder-phones-title mono-label">DIRECT OPERATIONAL CHANNELS</h3>
        <div class="founder-phones-grid">
          {team.members.map((m, idx) => (
            <div class="founder-phone-card">
              <div class="founder-phone-info">
                <strong class="phone-founder-name">{m.name}</strong>
                <span class="phone-founder-role">{m.role}</span>
              </div>

              <!-- Interactive JS Reveal Container -->
              <div class="phone-reveal-container js-only">
                <button
                  type="button"
                  class="btn btn-secondary reveal-phone-btn"
                  data-encoded={encodedPhones[`founder-${idx}`]}
                  aria-label={`Show phone number for ${m.name}`}
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>Show number</span>
                </button>
                <div class="phone-revealed-target" style="display: none;"></div>
              </div>

              <!-- Static Fallback (When JS is disabled) -->
              <noscript>
                <div class="phone-nojs-fallback">
                  <a href={`tel:${m.phone}`} class="fallback-phone-link">
                    {m.phone}
                  </a>
                </div>
              </noscript>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: var(--space-16) 0;
    background: var(--color-bg);
  }

  .contact-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .contact-wrapper {
      padding: var(--space-12);
    }
  }

  .contact-header {
    max-width: 680px;
  }

  .contact-headline {
    font-size: var(--fs-h1);
    line-height: 1.1;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .contact-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }

  /* Email Action Box */
  .email-action-box {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-square);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .email-meta-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand-structural);
    letter-spacing: 0.1em;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .email-link {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 3vw + 0.8rem, 2.2rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  .email-link:hover {
    color: var(--color-text-accent);
  }

  .copy-email-btn {
    padding: 0.65rem 1.25rem;
    gap: 0.5rem;
  }

  .copy-status-msg {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: #10B981;
    min-height: 1.2rem;
  }

  /* Founder Phone Channels */
  .founder-phones-area {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .founder-phones-title {
    margin-bottom: var(--space-5);
  }

  .founder-phones-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .founder-phones-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  .founder-phone-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-square);
    padding: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .founder-phone-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .phone-founder-name {
    font-size: 1rem;
    font-weight: 700;
  }

  .phone-founder-role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .revealed-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--rhsp-peg-start);
  }

  .fallback-phone-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
</style>

<script>
  function setupContact() {
    // Copy email to clipboard
    const copyBtn = document.getElementById('copy-email-btn');
    const copyStatus = document.getElementById('copy-status');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          if (copyStatus) copyStatus.textContent = '✓ Email copied to clipboard';
          
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'Copy';
            if (copyStatus) copyStatus.textContent = '';
          }, 3000);
        } catch (err) {
          // Fallback selection
          if (copyStatus) copyStatus.textContent = 'Press Ctrl+C to copy';
        }
      });
    }

    // Reveal phone number on click via JS
    const revealBtns = document.querySelectorAll<HTMLButtonElement>('.reveal-phone-btn');
    revealBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const encoded = btn.getAttribute('data-encoded');
        if (!encoded) return;

        try {
          const decoded = atob(encoded);
          const parent = btn.parentElement;
          const target = parent?.querySelector<HTMLElement>('.phone-revealed-target');
          if (target) {
            target.innerHTML = `<a href="tel:${decoded.replace(/[^0-9+]/g, '')}" class="revealed-link">${decoded}</a>`;
            target.style.display = 'block';
            btn.style.display = 'none';
          }
        } catch (e) {
          console.error('Decoding failed', e);
        }
      });
    });
  }

  setupContact();
  document.addEventListener('astro:after-swap', setupContact);
</script>
