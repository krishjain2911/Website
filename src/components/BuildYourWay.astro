</style>

<script>
  function setupBuildYourWay() {
    const switcher = document.querySelector<HTMLElement>('.stack-pill-switcher');
    const btnOutsystems = document.getElementById('toggle-outsystems');
    const btnMern = document.getElementById('toggle-mern');
    const panelOutsystems = document.getElementById('panel-outsystems');
    const panelMern = document.getElementById('panel-mern');
    const detailOutsystems = document.getElementById('detail-outsystems');
    const detailMern = document.getElementById('detail-mern');
    const btnCopyCode = document.getElementById('btn-copy-code');
    const codeContent = document.getElementById('terminal-code-content');

    if (!btnOutsystems || !btnMern) return;

    function selectStack(stack: 'outsystems' | 'mern') {
      if (!switcher || !btnOutsystems || !btnMern) return;
      switcher.setAttribute('data-active', stack);

      if (stack === 'outsystems') {
        btnOutsystems.classList.add('is-active');
        btnOutsystems.setAttribute('aria-checked', 'true');
        btnMern.classList.remove('is-active');
        btnMern.setAttribute('aria-checked', 'false');

        panelOutsystems?.classList.add('is-active');
        panelMern?.classList.remove('is-active');
        detailOutsystems?.classList.add('is-active');
        detailMern?.classList.remove('is-active');
      } else {
        btnMern.classList.add('is-active');
        btnMern.setAttribute('aria-checked', 'true');
        btnOutsystems.classList.remove('is-active');
        btnOutsystems.setAttribute('aria-checked', 'false');

        panelMern?.classList.add('is-active');
        panelOutsystems?.classList.remove('is-active');
        detailMern?.classList.add('is-active');
        detailOutsystems?.classList.remove('is-active');
      }
    }

    btnOutsystems.addEventListener('click', () => selectStack('outsystems'));
    btnMern.addEventListener('click', () => selectStack('mern'));

    // Keyboard accessibility for radiogroup
    switcher?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        selectStack('mern');
        btnMern.focus();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        selectStack('outsystems');
        btnOutsystems.focus();
      }
    });

    // Copy code button handler
    if (btnCopyCode && codeContent) {
      btnCopyCode.addEventListener('click', async () => {
        const textToCopy = codeContent.innerText;
        try {
          await navigator.clipboard.writeText(textToCopy);
          btnCopyCode.classList.add('is-copied');
          const label = btnCopyCode.querySelector('.copy-label');
          if (label) label.textContent = 'Copied!';
          setTimeout(() => {
            btnCopyCode.classList.remove('is-copied');
            if (label) label.textContent = 'Copy';
          }, 2000);
        } catch (err) {
          console.warn('Clipboard write failed:', err);
        }
      });
    }
  }

  setupBuildYourWay();
  document.addEventListener('astro:after-swap', setupBuildYourWay);
</script>
