---
import { siteConfig } from '../config/site';
import MediaAsset from './MediaAsset.astro';
import LearnMore from './LearnMore.astro';

const { about } = siteConfig;
const items = [
  {
    id: 'mission',
    title: about.mandate.cards[0].title,
    imageKey: about.mandate.cards[0].imageKey,
    text: about.mandate.cards[0].text,
    href: '/about#mission'
  },
  {
    id: 'purpose',
    title: about.mandate.cards[1].title,
    imageKey: about.mandate.cards[1].imageKey,
    text: about.mandate.cards[1].text,
    href: '/about#mission'
  },
  {
    id: 'vision',
    title: about.mandate.cards[2].title,
    imageKey: about.mandate.cards[2].imageKey,
    text: about.mandate.cards[2].text,
    href: '/about#mission'
  }
];
---

<section id="who-we-are" class="who-we-are-section" aria-labelledby="who-heading">
  <div class="container">
    <div class="who-header">
      <span class="eyebrow">WHO WE ARE</span>
      <h2 id="who-heading" class="who-title">Tech that adapts to business.</h2>
      <p class="who-subline">
        Are you still adapting your business to suit technology?
      </p>
    </div>

    <div class="who-cards-grid">
      {items.map((item) => (
        <article class="who-card card-mastercard reveal-on-scroll">
          <div class="who-circle-wrapper">
            <MediaAsset
              assetKey={item.imageKey}
              alt={`${item.title} graphic`}
              aspectRatio="1/1"
              crop="circle"
              theme="warm"
            />
          </div>

          <div class="who-card-body">
            <div class="who-card-title-row">
              <h3 class="who-card-title">{item.title}</h3>
              {item.tag && <span class="confirm-tag">{item.tag}</span>}
            </div>
            <p class="who-card-text">{item.text}</p>
            <div class="who-card-action">
              <LearnMore href={item.href} text={`About our ${item.title.toLowerCase()}`} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .who-we-are-section {
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .who-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4.5rem auto;
  }

  .who-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .who-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0 auto;
  }

  .who-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .who-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .who-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 3rem 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    box-shadow: var(--shadow-subtle);
  }

  .who-circle-wrapper {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #F6F6F4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  @media (max-width: 767px) {
    .who-circle-wrapper {
      width: 72px;
      height: 72px;
    }
  }

  :global([data-theme="dark"]) .who-circle-wrapper {
    background-color: #1A1A1A;
  }

  .who-circle-wrapper :global(.media-asset-container) {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  .who-circle-wrapper :global(.media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .who-card:hover .who-circle-wrapper :global(.media-img) {
    transform: scale(1.06);
  }

  .who-card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    width: 100%;
  }

  .who-card-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .who-card-title {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .confirm-tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .who-card-text {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .who-card-action {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
