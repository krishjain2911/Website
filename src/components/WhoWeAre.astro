---
import { siteConfig } from '../config/site';
import LearnMore from './LearnMore.astro';

const { about } = siteConfig;
interface MandateItem { id: string; title: string; imageKey: string; text: string; href: string; tag?: string; }
const items: MandateItem[] = [
  {
    id: 'mission',
    title: about.mandate.cards[0].title,
    imageKey: about.mandate.cards[0].imageKey,
    text: about.mandate.cards[0].text,
    href: '/about#mission'
  },
  {
    id: 'purpose',
    title: about.mandate.cards[1].title,
    imageKey: about.mandate.cards[1].imageKey,
    text: about.mandate.cards[1].text,
    href: '/about#mission'
  },
  {
    id: 'vision',
    title: about.mandate.cards[2].title,
    imageKey: about.mandate.cards[2].imageKey,
    text: about.mandate.cards[2].text,
    href: '/about#mission'
  }
];
---

<section id="who-we-are" class="who-we-are-section" aria-labelledby="who-heading">
  <div class="container">
    <div class="who-header">
      <span class="eyebrow">WHO WE ARE</span>
      <h2 id="who-heading" class="who-title">Tech that adapts to business.</h2>
      <p class="who-subline">
        Technology that moves at the pace of your business.
      </p>
    </div>

    <div class="who-cards-grid">
      {items.map((item, index) => {
        const colors = ['#1E4B8F', '#F7941D', '#EE4B2B'];
        const color = colors[index % colors.length];
        return (
          <article
            class="who-card card-mastercard reveal-on-scroll"
            style={`border-top: 3px solid ${color};`}
          >
            <div class="who-card-body">
              <span class="who-eyebrow-label" style={`color: ${color};`}>
                0{index + 1} / {item.title.toUpperCase()}
              </span>
              <div class="who-card-title-row">
                <h3 class="who-card-title">{item.title}</h3>
                {item.tag && <span class="confirm-tag">{item.tag}</span>}
              </div>
              <p class="who-card-text">{item.text}</p>
              <div class="who-card-action">
                <LearnMore href={item.href} text={`About our ${item.title.toLowerCase()}`} />
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Section End Links -->
    <div class="who-footer-links reveal-on-scroll">
      <LearnMore href="/about#story" text="Read our origin story" />
      <span class="sep-dot" aria-hidden="true">&middot;</span>
      <LearnMore href="/about#mission" text="Explore mission, purpose &amp; vision" />
    </div>
  </div>
</section>

<style>
  .who-we-are-section {
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .who-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4.5rem auto;
  }

  .who-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .who-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    margin: 0 auto;
  }

  .who-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .who-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .who-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 2.75rem 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-subtle);
    min-height: 280px;
  }

  .who-eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: 0.25rem;
    display: inline-block;
  }

  .who-card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    width: 100%;
  }

  .who-card-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .who-card-title {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .confirm-tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .who-card-text {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .who-card-action {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .who-footer-links {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .sep-dot {
    color: var(--color-border);
    user-select: none;
  }
</style>
