---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Section { id: string; title: string }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  updated: string;
  sections: Section[];
}
const { title, description, eyebrow, heading, intro, updated, sections } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main id="main-content" tabindex="-1" class="legal-main">
    <header class="legal-hero">
      <div class="container legal-hero-inner">
        <span class="legal-eyebrow">{eyebrow}</span>
        <h1 class="legal-title">{heading}</h1>
        <p class="legal-intro">{intro}</p>
        <span class="legal-updated">Last updated {updated}</span>
      </div>
    </header>

    <div class="container legal-layout">
      <aside class="legal-toc" aria-label="On this page">
        <span class="legal-toc-label">On this page</span>
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ol>
      </aside>

      <div class="legal-body">
        <slot />
        <p class="legal-contact-card">
          Questions? Write to <a href="mailto:letstalk@rhsp.solutions">letstalk@rhsp.solutions</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .legal-main { background: var(--color-bg); font-family: var(--font-sans); }

  .legal-hero {
    padding: calc(var(--nav-height, 72px) + 4rem) 0 3rem;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }
  .legal-hero-inner > .legal-title { max-width: 820px; }
  .legal-eyebrow {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-accent);
    margin-bottom: 1rem;
  }
  .legal-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--color-text-primary);
  }
  .legal-intro {
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0 0 1.5rem;
  }
  .legal-updated {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 960px) {
    .legal-layout { grid-template-columns: 240px minmax(0, 1fr); gap: 3.5rem; }
  }

  .legal-toc { align-self: start; }
  @media (min-width: 960px) {
    .legal-toc { position: sticky; top: calc(var(--nav-height, 72px) + 1.5rem); }
  }
  .legal-toc-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .legal-toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .legal-toc a {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .legal-toc a:hover { color: var(--color-text-accent); }

  .legal-body { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }

  .legal-section {
    padding: 1.75rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-surface);
    scroll-margin-top: calc(var(--nav-height, 72px) + 1.5rem);
  }
  @media (max-width: 640px) { .legal-section { padding: 1.25rem; } }
  .legal-section h2 {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary);
  }
  .legal-section p,
  .legal-section li {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .legal-section p { margin: 0 0 0.75rem; }
  .legal-section p:last-child { margin-bottom: 0; }
  .legal-section ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .legal-section li::marker { color: var(--rhsp-peg-start); }
  .legal-section strong { color: var(--color-text-primary); font-weight: 700; }
  .legal-section a,
  .legal-contact-card a {
    color: var(--color-text-accent);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .legal-contact-card {
    margin: 0.5rem 0 0;
    padding: 1.25rem 1.5rem;
    border-radius: 20px;
    background: var(--color-bg-alt);
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }
</style>