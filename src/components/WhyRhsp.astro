---
import { siteConfig } from '../config/site';

const whyRhsp = (siteConfig as any).about?.whyRhsp || (siteConfig as any).whyRhsp;
const showTestimonial = siteConfig.showTestimonial;
const testimonial = (whyRhsp as any)?.testimonial || (siteConfig as any).testimonial;
---

<section id="why-rhsp" class="why-rhsp-section" aria-labelledby="why-heading">
  <div class="container">
    <div class="why-intro reveal-on-scroll">
      <span class="mono-label">{whyRhsp.badge}</span>
      <h2 id="why-heading" class="why-main-headline">{whyRhsp.headline}</h2>
      
      <!-- Apollo 13 Origin Story Note in Philosophy -->
      <div class="origin-story-box morphed-frame">
        <span class="mono-label origin-label">THE ADAPTER PHILOSOPHY</span>
        <p class="origin-story-text">
          {whyRhsp.originStoryNote}
        </p>
      </div>
    </div>

    <!-- 4 Differentiators as Large Typographic Statements -->
    <div class="differentiators-list">
      {whyRhsp.differentiators.map((item, idx) => (
        <div class="differentiator-row reveal-on-scroll">
          <div class="diff-index-col">
            <span class="diff-num mono-label">0{idx + 1}</span>
          </div>
          <div class="diff-statement-col">
            <h3 class="diff-title">{item.title}</h3>
            <p class="diff-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Toggleable Testimonial Slot -->
    {showTestimonial && testimonial && (
      <div class="testimonial-wrapper reveal-on-scroll">
        <blockquote class="testimonial-card morphed-frame">
          <div class="quote-glyph" aria-hidden="true">“</div>
          <p class="quote-body">{testimonial.quote}</p>
          <footer class="quote-author-row">
            <div class="author-info">
              <strong class="author-name">{testimonial.author}</strong>
              <span class="author-role">{testimonial.role} &bull; {testimonial.industry}</span>
            </div>
            <span class="badge">VERIFIED CLIENT</span>
          </footer>
        </blockquote>
      </div>
    )}
  </div>
</section>

<style>
  .why-rhsp-section {
    padding: var(--space-16) 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .why-intro {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .why-main-headline {
    font-size: var(--fs-h1);
    line-height: 1.1;
    margin-top: var(--space-3);
    margin-bottom: var(--space-6);
  }

  /* Apollo 13 Philosophy Note */
  .origin-story-box {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--rhsp-peg-start);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-square);
  }

  .origin-label {
    font-size: 0.68rem;
    color: var(--color-brand-structural);
    margin-bottom: 0.35rem;
    display: block;
  }

  .origin-story-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-style: italic;
  }

  /* Typographic Statements */
  .differentiators-list {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-12);
  }

  .differentiator-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .differentiator-row {
      grid-template-columns: 72px 1fr;
      gap: var(--space-8);
      padding: var(--space-10) 0;
    }
  }

  .diff-index-col {
    padding-top: 0.35rem;
  }

  .diff-num::before {
    display: none;
  }

  .diff-statement-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 860px;
  }

  .diff-title {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .diff-desc {
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Testimonial Slot */
  .testimonial-wrapper {
    margin-top: var(--space-8);
  }

  .testimonial-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-square);
    padding: var(--space-8);
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 768px) {
    .testimonial-card {
      padding: var(--space-10);
    }
  }

  .quote-glyph {
    font-family: var(--font-sans);
    font-size: 4rem;
    line-height: 1;
    color: var(--rhsp-peg-start);
    opacity: 0.5;
    margin-bottom: -1rem;
  }

  .quote-body {
    font-size: clamp(1.1rem, 1.5vw + 0.8rem, 1.45rem);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.45;
    margin-bottom: var(--space-6);
    max-width: 60ch;
  }

  .quote-author-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-name {
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .author-role {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }
</style>
