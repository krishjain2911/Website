---
// CareersHeroVisual.astro
// Animated SVG illustrating a square peg traversing diverse apertures (circle, triangle, hexagon),
// culminating in the unified RHSP isometric adapter cube.
---

<div class="careers-visual-wrapper" aria-hidden="true">
  <svg class="careers-hero-svg" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Brand Gradients -->
      <linearGradient id="pegOrangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#F7941D" />
        <stop offset="100%" stop-color="#EE4B2B" />
      </linearGradient>

      <linearGradient id="blueAtmosphere" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1E4B8F" />
        <stop offset="100%" stop-color="#0F2A4A" />
      </linearGradient>

      <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- Background Blueprint Grid -->
    <g class="blueprint-grid" opacity="0.35">
      <circle cx="200" cy="160" r="140" stroke="currentColor" stroke-dasharray="3 6" stroke-width="1" />
      <circle cx="200" cy="160" r="100" stroke="currentColor" stroke-dasharray="2 4" stroke-width="0.75" />
      <line x1="60" y1="160" x2="340" y2="160" stroke="currentColor" stroke-dasharray="2 4" stroke-width="0.75" />
      <line x1="200" y1="20" x2="200" y2="300" stroke="currentColor" stroke-dasharray="2 4" stroke-width="0.75" />
    </g>

    <!-- Morphing Apertures Layer -->
    <g class="aperture-group">
      <!-- 1. Circle Aperture (Fades and transitions) -->
      <circle class="aperture aperture-circle" cx="200" cy="160" r="64" stroke="#1E4B8F" stroke-width="2.5" />

      <!-- 2. Triangle Aperture -->
      <polygon class="aperture aperture-triangle" points="200,88 266,204 134,204" stroke="#5B8FE0" stroke-width="2.5" />

      <!-- 3. Hexagon Aperture -->
      <polygon class="aperture aperture-hexagon" points="200,94 256,127 256,193 200,226 144,193 144,127" stroke="#FFAE4A" stroke-width="2.5" />
    </g>

    <!-- Central Square Peg and Isometric Adapter Cube -->
    <g class="peg-core-group">
      <!-- Ambient Glow Behind Peg -->
      <rect class="peg-ambient-glow" x="160" y="120" width="80" height="80" rx="12" fill="url(#pegOrangeGrad)" opacity="0.25" filter="url(#softGlow)" />

      <!-- 2D Square Peg Phase -->
      <rect class="peg-square-solid" x="160" y="120" width="80" height="80" rx="10" stroke="url(#pegOrangeGrad)" stroke-width="3" fill="none" />

      <!-- Isometric 3D RHSP Cube Transformation Phase -->
      <g class="rhsp-cube-phase">
        <!-- Top Face (Blue Foresight) -->
        <polygon class="cube-facet face-top" points="200,105 245,130 200,155 155,130" fill="url(#blueAtmosphere)" stroke="#5B8FE0" stroke-width="1.5" />
        <!-- Left Face (Orange Precision) -->
        <polygon class="cube-facet face-left" points="155,130 200,155 200,210 155,185" fill="#F7941D" stroke="#FFAE4A" stroke-width="1.5" />
        <!-- Right Face (Red Scale) -->
        <polygon class="cube-facet face-right" points="200,155 245,130 245,185 200,210" fill="#EE4B2B" stroke="#FF5B3B" stroke-width="1.5" />
        <!-- Center Axis Node -->
        <circle cx="200" cy="155" r="3.5" fill="#FFFFFF" />
      </g>
    </g>

    <!-- Angle Vector Radians -->
    <g class="angle-vectors" opacity="0.7">
      <line class="vector-line vec-1" x1="130" y1="90" x2="160" y2="120" stroke="#F7941D" stroke-dasharray="2 3" stroke-width="1.5" />
      <circle cx="130" cy="90" r="3" fill="#F7941D" />

      <line class="vector-line vec-2" x1="270" y1="90" x2="240" y2="120" stroke="#5B8FE0" stroke-dasharray="2 3" stroke-width="1.5" />
      <circle cx="270" cy="90" r="3" fill="#5B8FE0" />

      <line class="vector-line vec-3" x1="200" y1="260" x2="200" y2="215" stroke="#EE4B2B" stroke-dasharray="2 3" stroke-width="1.5" />
      <circle cx="200" cy="260" r="3" fill="#EE4B2B" />
    </g>
  </svg>
</div>

<style>
  .careers-visual-wrapper {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border-strong, #CBD5E1);
  }

  .careers-hero-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Keyframe Choreography (10s continuous cycle) */
  .aperture-circle {
    animation: cycleCircle 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 200px 160px;
  }

  .aperture-triangle {
    animation: cycleTriangle 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 200px 160px;
  }

  .aperture-hexagon {
    animation: cycleHexagon 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 200px 160px;
  }

  .peg-square-solid {
    animation: cycleSquare 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 200px 160px;
  }

  .rhsp-cube-phase {
    animation: cycleCube 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 200px 160px;
  }

  .peg-ambient-glow {
    animation: pulseGlow 10s infinite ease-in-out;
    transform-origin: 200px 160px;
  }

  /* 0% - 25%: Circle Aperture adapts to Square */
  @keyframes cycleCircle {
    0%, 20% { opacity: 0.9; transform: scale(1) rotate(0deg); }
    28%, 100% { opacity: 0; transform: scale(1.15) rotate(15deg); }
  }

  /* 28% - 53%: Triangle Aperture adapts to Square */
  @keyframes cycleTriangle {
    0%, 25% { opacity: 0; transform: scale(0.8) rotate(-15deg); }
    32%, 50% { opacity: 0.9; transform: scale(1) rotate(0deg); }
    58%, 100% { opacity: 0; transform: scale(1.15) rotate(15deg); }
  }

  /* 56% - 78%: Hexagon Aperture adapts to Square */
  @keyframes cycleHexagon {
    0%, 53% { opacity: 0; transform: scale(0.8) rotate(-15deg); }
    60%, 75% { opacity: 0.9; transform: scale(1) rotate(0deg); }
    82%, 100% { opacity: 0; transform: scale(1.2) rotate(20deg); }
  }

  /* Square Peg evolves into 3D isometric adapter */
  @keyframes cycleSquare {
    0%, 75% { opacity: 1; transform: scale(1) rotate(0deg); }
    82%, 100% { opacity: 0; transform: scale(0.85) rotate(45deg); }
  }

  /* 3D RHSP Cube emerges as final unified resolution */
  @keyframes cycleCube {
    0%, 75% { opacity: 0; transform: translateY(12px) scale(0.85); }
    83%, 96% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0.9; transform: translateY(0) scale(1); }
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.2; transform: scale(0.95); }
    50% { opacity: 0.45; transform: scale(1.08); }
    85% { opacity: 0.6; transform: scale(1.15); }
  }

  /* Reduced Motion Override: show final resolved frame immediately */
  @media (prefers-reduced-motion: reduce) {
    .aperture-circle,
    .aperture-triangle,
    .aperture-hexagon,
    .peg-square-solid {
      display: none !important;
      animation: none !important;
    }

    .rhsp-cube-phase {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .peg-ambient-glow {
      opacity: 0.35 !important;
      animation: none !important;
    }
  }
</style>
