---
export interface CareerPrinciple {
  letter: 'P' | 'E' | 'G';
  heading: string;
  description: string;
}

export const CAREER_PRINCIPLES: CareerPrinciple[] = [
  {
    letter: 'P',
    heading: 'People Powered, Process Backed',
    description: 'We start with the people who build and use the system, and back them with processes that keep good work steady.'
  },
  {
    letter: 'E',
    heading: 'Experiment Boldly, Deliver Reliably',
    description: 'We try new approaches early, then ship only what we have tested and can stand behind.'
  },
  {
    letter: 'G',
    heading: 'Growth Minded, Goal Anchored',
    description: 'We keep learning, and anchor every effort to a goal the business can measure.'
  }
];
---

<section class="principles-section" aria-labelledby="principles-heading">
  <div class="section-container">
    <div class="section-header">
      <div class="peg-track-line" aria-hidden="true">
        <div class="peg-dot"></div>
        <div class="peg-bar"></div>
        <div class="peg-dot"></div>
      </div>
      <h2 id="principles-heading" class="section-title">Life at RHSP</h2>
      <p class="section-subtext">Three engineering tenets define our internal craft and delivery standard.</p>
    </div>

    <div class="principles-grid">
      {CAREER_PRINCIPLES.map((principle) => {
        const parts = principle.heading.split(', ');
        const phrase1 = parts[0] + ',';
        const phrase2 = parts.slice(1).join(', ');
        return (
          <div class="principle-card">
            <div class={`principle-marker marker-${principle.letter}`} aria-hidden="true">
              <span class="marker-code">{principle.letter}</span>
            </div>
            <h3 class="principle-title">
              <span class="principle-phrase">{phrase1}</span>{' '}
              <span class="principle-phrase">{phrase2}</span>
            </h3>
            <p class="principle-desc">{principle.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .principles-section {
    padding: 80px 24px;
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .principles-section .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .peg-track-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .peg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rhsp-peg-start);
  }

  .peg-bar {
    width: 48px;
    height: 2px;
    background: var(--rhsp-peg-gradient);
    border-radius: 2px;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-subtext {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .principle-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .principle-card:hover {
    transform: translateY(-3px);
    border-color: var(--rhsp-peg-start);
  }

  .principle-marker {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .principle-marker.marker-P {
    background-color: #1E4B8F;
  }

  .principle-marker.marker-E {
    background-color: #F7941D;
  }

  .principle-marker.marker-G {
    background-color: #EE4B2B;
  }

  :global(html[data-theme="dark"]) .principle-marker {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .marker-code {
    color: #ffffff !important;
    font-size: 1.25rem;
    font-weight: 800;
    font-family: inherit;
    line-height: 1;
  }

  .principle-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
    color: var(--color-text-primary, inherit);
  }

  .principle-phrase {
    display: inline-block;
    white-space: nowrap;
  }

  .principle-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    flex-grow: 1;
    min-height: 4.8em;
  }

  @media (max-width: 640px) {
    .principles-section {
      padding: 56px 16px;
    }
  }

  @media (max-width: 320px) {
    .principle-phrase {
      white-space: normal;
    }
  }
</style>
