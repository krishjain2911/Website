---
// PegMethod.astro: Plan · Engineer · Gen-AI
// 3 tall cards with huge overlapping letter, flex hover expansion (~50%), linking to /about#peg
import { siteConfig } from '../config/site';
import MediaAsset from './MediaAsset.astro';
import Icon from './Icon.astro';

const { pegMethod } = siteConfig;
---

<section id="peg" class="peg-section" aria-labelledby="peg-heading">
  <div class="container">
    <!-- Header -->
    <div class="peg-header">
      <span class="mono-label">{pegMethod.badge}</span>
      <h2 id="peg-heading" class="peg-title">
        {pegMethod.headline}
      </h2>
      <p class="peg-subline">
        {pegMethod.primaryTagline}
      </p>
    </div>

    <!-- 3 Tall Expanding Flex Cards -->
    <div class="peg-cards-row">
      {pegMethod.pillars.map((pillar) => (
        <article class={`peg-card peg-card-${pillar.id} card-link`}>
          <a href="/about#peg" class="peg-card-anchor" aria-label={`Learn more about ${pillar.name}: ${pillar.tagline}`}>
            <!-- Background Media Asset -->
            <div class="peg-media-layer">
              <MediaAsset
                assetKey={`peg-${pillar.id}`}
                alt={`${pillar.name} method background`}
                type="video"
                aspectRatio="9/16"
              />
              <div class="peg-media-scrim"></div>
            </div>

            <!-- Overlapping Huge Watermark Letter -->
            <div class="peg-watermark-letter" aria-hidden="true">
              {pillar.letter}
            </div>

            <!-- Foreground Content -->
            <div class="peg-card-content">
              <!-- Pillar Icon Glyph -->
              <div class="peg-icon-badge" style={`color: ${pillar.color}; border-color: ${pillar.color};`}>
                {pillar.iconType === 'wireframe' && (
                  <svg viewBox="0 0 24 24" class="peg-glyph-svg" fill="none" stroke="currentColor" stroke-width="1.75">
                    <polygon points="12,3 21,8 12,13 3,8" />
                    <polygon points="3,8 12,13 12,21 3,16" />
                    <polygon points="12,13 21,8 21,16 12,21" />
                    <line x1="12" y1="13" x2="12" y2="21" stroke-dasharray="2 2" />
                  </svg>
                )}
                {pillar.iconType === 'solid' && (
                  <svg viewBox="0 0 24 24" class="peg-glyph-svg">
                    <polygon points="12,3 21,8 12,13 3,8" fill="#FFBD3A" />
                    <polygon points="3,8 12,13 12,21 3,16" fill="#E83D1B" />
                    <polygon points="12,13 21,8 21,16 12,21" fill="#FF7F1F" />
                  </svg>
                )}
                {pillar.iconType === 'nodes' && (
                  <svg viewBox="0 0 24 24" class="peg-glyph-svg" fill="none" stroke="currentColor" stroke-width="1.75">
                    <polygon points="12,3 21,8 12,13 3,8" stroke="#EE4B2B" />
                    <polygon points="3,8 12,13 12,21 3,16" stroke="#EE4B2B" />
                    <polygon points="12,13 21,8 21,16 12,21" stroke="#EE4B2B" />
                    <circle cx="12" cy="3" r="2" fill="#EE4B2B" />
                    <circle cx="21" cy="8" r="2" fill="#EE4B2B" />
                    <circle cx="3" cy="8" r="2" fill="#EE4B2B" />
                    <circle cx="12" cy="13" r="2" fill="#EE4B2B" />
                    <circle cx="12" cy="21" r="2" fill="#EE4B2B" />
                  </svg>
                )}
              </div>

              <div class="peg-title-row">
                <span class="mono-label peg-pillar-tag" style={`color: ${pillar.color};`}>
                  {pillar.letter} - {pillar.name.toUpperCase()}
                </span>
                <h3 class="peg-pillar-headline">
                  {pillar.tagline}
                </h3>
              </div>

              <!-- Learn More Link -->
              <div class="peg-learn-more">
                <span>Learn more</span>
                <Icon name="arrow-right" size={16} class="peg-arrow" />
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .peg-section {
    padding: var(--space-14) 0 var(--space-16);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border-subtle);
  }

  .peg-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-10);
  }

  .peg-title {
    font-size: var(--fs-h2);
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: var(--space-3) 0 var(--space-2);
  }

  .peg-subline {
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
  }

  /* 3 Tall Cards with Flex Transition */
  .peg-cards-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 960px) {
    .peg-cards-row {
      flex-direction: row;
      min-height: 540px;
    }
  }

  .peg-card {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: flex 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s ease, border-color 0.3s ease;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 960px) {
    .peg-card {
      flex: 1; /* Default equal 33% */
      border-top-right-radius: 40px;
    }

    /* Expanding Hover Effect: Active card grows to ~50%, siblings shrink */
    .peg-cards-row:hover .peg-card {
      flex: 0.75;
      opacity: 0.85;
    }

    .peg-cards-row .peg-card:hover {
      flex: 1.5; /* Expands to ~50% */
      opacity: 1;
      border-color: var(--color-border-strong);
      border-top-right-radius: 56px;
    }
  }

  .peg-card-anchor {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    min-height: 420px;
    padding: var(--space-8) var(--space-6);
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 960px) {
    .peg-card-anchor {
      min-height: 520px;
      padding: var(--space-10) var(--space-8);
    }
  }

  /* Media Layer */
  .peg-media-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .peg-media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 22, 39, 0.75) 0%, rgba(10, 22, 39, 0.95) 100%);
    pointer-events: none;
  }

  /* Huge Watermark Letter */
  .peg-watermark-letter {
    position: absolute;
    top: -20px;
    right: -10px;
    font-size: 16rem;
    font-family: var(--font-headline);
    font-weight: 900;
    line-height: 1;
    color: rgba(255, 255, 255, 0.04);
    pointer-events: none;
    user-select: none;
    transition: transform 0.4s ease, color 0.3s ease;
    z-index: 1;
  }

  .peg-card:hover .peg-watermark-letter {
    transform: translate(-10px, 10px);
    color: rgba(255, 255, 255, 0.07);
  }

  /* Card Content */
  .peg-card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .peg-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-square);
    background-color: rgba(10, 22, 39, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .peg-glyph-svg {
    width: 24px;
    height: 24px;
  }

  .peg-title-row {
    margin-top: auto;
    margin-bottom: var(--space-6);
  }

  .peg-pillar-tag {
    font-size: 0.75rem;
    font-weight: 800;
    display: block;
    margin-bottom: var(--space-2);
  }

  .peg-pillar-headline {
    font-size: 1.4rem;
    line-height: 1.3;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: -0.02em;
  }

  .peg-learn-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #F8FAFC;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .peg-arrow {
    transition: transform 0.25s ease;
  }

  .peg-card:hover .peg-arrow {
    transform: translateX(4px);
  }

  .peg-card:hover .peg-learn-more {
    color: var(--rhsp-orange);
  }
</style>
