---
import Icon from './Icon.astro';
import LearnMore from './LearnMore.astro';
---

<section id="peg-cube" class="peg-section" aria-labelledby="peg-heading">
  <div class="container">
    <div class="peg-header text-center">
      <span class="eyebrow">OUR APPROACH</span>
      <h2 id="peg-heading" class="peg-title">Every PEG, shaped.</h2>
      <p class="peg-subtitle">
        We don't force your business to fit off-the-shelf technology. We shape the adapter across three core capabilities.
      </p>
    </div>

    <div class="peg-stage-grid">
      <!-- Left Column: The 3D CSS Cube resting on Navy Ellipse -->
      <div class="peg-cube-col">
        <div class="cube-scene-wrapper" id="cube-scene-wrapper">
          <!-- 3D Cube Viewport -->
          <div class="cube-viewport" id="cube-viewport" role="region" aria-label="Interactive 3D PEG Cube">
            <div class="cube-assembly" id="cube-assembly">
              <!-- Top Face: P - Plan -->
              <div
                class="cube-face face-top is-active"
                id="face-plan"
                data-pillar="plan"
                role="button"
                tabindex="0"
                aria-label="P - Plan"
              >
                <div class="face-content">
                  <span class="face-letter">P</span>
                  <span class="face-word">PLAN</span>
                </div>
              </div>

              <!-- Left Face: E - Engineer -->
              <div
                class="cube-face face-left"
                id="face-engineer"
                data-pillar="engineer"
                role="button"
                tabindex="0"
                aria-label="E - Engineer"
              >
                <div class="face-content">
                  <span class="face-letter">E</span>
                  <span class="face-word">ENGINEER</span>
                </div>
              </div>

              <!-- Right Face: G - Gen-AI -->
              <div
                class="cube-face face-right"
                id="face-genai"
                data-pillar="genai"
                role="button"
                tabindex="0"
                aria-label="G - Gen-AI"
              >
                <div class="face-content">
                  <span class="face-letter">G</span>
                  <span class="face-word">GEN-AI</span>
                </div>
              </div>

              <!-- Secondary Bottom & Back Faces for full 3D enclosure -->
              <div class="cube-face face-bottom" aria-hidden="true"></div>
              <div class="cube-face face-back" aria-hidden="true"></div>
              <div class="cube-face face-back-left" aria-hidden="true"></div>
            </div>
          </div>

          <!-- Navy Socket Ellipse (Interactive Easter Egg) -->
          <div
            class="cube-socket-ellipse"
            id="cube-socket-ellipse"
            role="button"
            tabindex="0"
            title="Easter egg: Click to test PEG socket locking mechanism"
            aria-label="Interactive Socket: Click to test fit"
          >
            <div class="socket-inner-depth"></div>
            <div class="socket-lock-indicator">
              <span class="socket-dot" aria-hidden="true"></span>
              <span class="socket-text">TEST FIT</span>
            </div>
          </div>
        </div>

        <!-- Easter Egg Celebration Toast -->
        <div id="peg-lock-toast" class="peg-lock-toast" hidden aria-hidden="true">
          <div class="toast-inner">
            <span class="toast-icon" aria-hidden="true">✨</span>
            <div class="toast-text-col">
              <strong class="toast-title">ADAPTER ENGAGED: PERFECT FIT!</strong>
              <span class="toast-sub">Square PEG seated into Round Socket with 0% compromise.</span>
            </div>
          </div>
        </div>

        <!-- Pill Tabs below Cube -->
        <div class="peg-pill-tabs" role="tablist" aria-label="PEG Pillars">
          <button
            type="button"
            class="peg-tab-btn is-active"
            role="tab"
            aria-selected="true"
            aria-controls="panel-plan"
            id="tab-peg-plan"
            data-pillar="plan"
          >
            Plan
          </button>
          <button
            type="button"
            class="peg-tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-engineer"
            id="tab-peg-engineer"
            data-pillar="engineer"
          >
            Engineer
          </button>
          <button
            type="button"
            class="peg-tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-genai"
            id="tab-peg-genai"
            data-pillar="genai"
          >
            Gen-AI
          </button>
          <button
            type="button"
            class="peg-tab-btn peg-lock-tab-btn"
            id="peg-lock-trigger"
            title="Easter egg: Lock the square PEG into the round socket"
            aria-label="Test Adapter Fit Easter Egg"
          >
            <span class="lock-sparkle" aria-hidden="true">⚡</span>
            <span>Test Fit</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Pillar Content Panel (crossfades on interaction) -->
      <div class="peg-content-col">
        <div class="peg-panels-container">
          <!-- Panel: Plan -->
          <div
            id="panel-plan"
            class="peg-panel is-active"
            role="tabpanel"
            aria-labelledby="tab-peg-plan"
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">P - PLAN</span>
              <span class="pillar-role-badge">Technology consultancy</span>
            </div>
            <h3 class="panel-headline">
              "The right decision before the first line of code."
            </h3>
            <p class="panel-desc">
              Strategy, architecture, platform choice, roadmaps.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Strategy and technology advisory</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Architecture and platform choice</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Roadmap planning and delivery guidance</span>
              </li>
            </ul>

            <!-- Plan Architecture Diagram -->
            <div class="panel-diagram-card">
              <div class="diagram-meta-row">
                <span class="diagram-badge">ARCHITECTURE BLUEPRINT</span>
                <span class="diagram-label">Strategy Decision Matrix</span>
              </div>
              <div class="diagram-view">
                <img
                  src="/media/peg/plan-architecture-diagram.webp"
                  alt="Plan Architecture Blueprint: Decision Matrix for Low-Code OutSystems, High-Code MERN, and Hybrid Strategy"
                  class="diagram-img"
                  width="1376"
                  height="768"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="panel-products">
              <span class="products-title">Focus areas:</span>
              <div class="products-chips">
                <span class="prod-chip">Strategy</span>
                <span class="prod-chip">Architecture</span>
                <span class="prod-chip">Platform Choice</span>
                <span class="prod-chip">Roadmaps</span>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Plan" />
            </div>
          </div>

          <!-- Panel: Engineer -->
          <div
            id="panel-engineer"
            class="peg-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-engineer"
            hidden
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">E - ENGINEER</span>
              <span class="pillar-role-badge">Low-code speed or high-code freedom</span>
            </div>
            <h3 class="panel-headline">
              "Low-code speed or high-code freedom - whichever fits."
            </h3>
            <p class="panel-desc">
              OutSystems or MERN, chosen per budget and requirements.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>OutSystems for rapid visual delivery</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>MERN for high-code flexibility</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Chosen per budget and requirements</span>
              </li>
            </ul>

            <!-- Engineer Architecture Diagram -->
            <div class="panel-diagram-card">
              <div class="diagram-meta-row">
                <span class="diagram-badge">INTEGRATION BLUEPRINT</span>
                <span class="diagram-label">Dual-Engine System Pipeline</span>
              </div>
              <div class="diagram-view">
                <img
                  src="/media/peg/engineer-architecture-diagram.webp"
                  alt="Engineer Architecture Blueprint: OutSystems Low-Code Rapid Portal and MERN Stack Integration"
                  class="diagram-img"
                  width="1376"
                  height="768"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="panel-products">
              <span class="products-title">Products:</span>
              <div class="products-chips">
                <a href="/solutions/clm" class="prod-chip is-link">CLM</a>
                <a href="/solutions/dms" class="prod-chip is-link">DMS</a>
                <a href="/solutions/whatsapp-journeys" class="prod-chip is-link">WhatsApp Journeys</a>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Engineer" />
            </div>
          </div>

          <!-- Panel: Gen-AI -->
          <div
            id="panel-genai"
            class="peg-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-genai"
            hidden
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">G - GEN-AI</span>
              <span class="pillar-role-badge">AI solutions</span>
            </div>
            <h3 class="panel-headline">
              "AI that works on your data, inside your walls."
            </h3>
            <p class="panel-desc">
              AI that works on your data, inside your walls.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Voice Agents</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Sovereign AI</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>AskMeAnything</span>
              </li>
            </ul>

            <!-- Gen-AI Architecture Diagram -->
            <div class="panel-diagram-card">
              <div class="diagram-meta-row">
                <span class="diagram-badge">SOVEREIGN AI BLUEPRINT</span>
                <span class="diagram-label">Private Perimeter AI Pipeline</span>
              </div>
              <div class="diagram-view">
                <img
                  src="/media/peg/genai-architecture-diagram.webp"
                  alt="Gen-AI Architecture Blueprint: Sovereign Private AI Pipeline inside Enterprise Walls"
                  class="diagram-img"
                  width="1376"
                  height="768"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="panel-products">
              <span class="products-title">Products:</span>
              <div class="products-chips">
                <a href="/solutions/voice-agents" class="prod-chip is-link">Voice Agents</a>
                <a href="/solutions/sovereign-ai" class="prod-chip is-link">Sovereign AI</a>
                <a href="/solutions/ask-me-anything" class="prod-chip is-link">AskMeAnything</a>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Gen-AI" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .peg-section {
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .text-center {
    text-align: center;
  }

  .peg-header {
    max-width: 680px;
    margin: 0 auto 4rem auto;
  }

  .peg-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .peg-subtitle {
    margin: 0 auto;
    font-size: var(--fs-body-lg);
  }

  .peg-stage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .peg-stage-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 5rem;
    }
  }

  /* 3D Cube Scene */
  .peg-cube-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cube-scene-wrapper {
    position: relative;
    width: 320px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .cube-scene-wrapper:active {
    cursor: grabbing;
  }

  .cube-viewport {
    position: relative;
    width: 180px;
    height: 180px;
    transform-style: preserve-3d;
    z-index: 2;
    animation: idleFloat 5s ease-in-out infinite;
  }

  @keyframes idleFloat {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .cube-assembly {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    /* Default isometric target: rotateX(-30deg) rotateY(45deg) */
    transform: rotateX(-30deg) rotateY(45deg);
    transition: transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1);
  }

  .cube-face {
    position: absolute;
    width: 180px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-family: var(--font-sans);
    cursor: pointer;
    box-sizing: border-box;
    backface-visibility: visible;
    transition: transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1), box-shadow 0.3s ease;
    border-radius: 4px;
    overflow: hidden;
  }

  /* Face Geometry (Half cube size = 90px) */
  /* Top Face: P - Plan (Navy Blueprint) */
  .face-top {
    transform: rotateX(90deg) translateZ(90px);
    background: linear-gradient(135deg, #1E4B8F 0%, #0F2A4A 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.2);
  }

  .face-top.is-popped {
    transform: rotateX(90deg) translateZ(110px);
  }

  /* Left Face: E - Engineer (Warm Orange) */
  .face-left {
    transform: rotateY(-90deg) translateZ(90px);
    background: linear-gradient(135deg, #FF9E2C 0%, #F7941D 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  .face-left.is-popped {
    transform: rotateY(-90deg) translateZ(110px);
  }

  /* Right Face: G - Gen-AI (High-Energy Red-Orange) */
  .face-right {
    transform: translateZ(90px);
    background: linear-gradient(135deg, #FF5B3B 0%, #EE4B2B 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  .face-right.is-popped {
    transform: translateZ(110px);
  }

  /* Solidifying Faces */
  .face-bottom {
    transform: rotateX(-90deg) translateZ(90px);
    background: #0A1B30;
    pointer-events: none;
  }

  .face-back {
    transform: rotateY(180deg) translateZ(90px);
    background: #C43818;
    pointer-events: none;
  }

  .face-back-left {
    transform: rotateY(90deg) translateZ(90px);
    background: #0F2A4A;
    pointer-events: none;
  }

  .face-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    pointer-events: none;
  }

  .face-letter {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .face-word {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.95;
  }

  /* Navy Ellipse Socket with Easter Egg */
  .cube-socket-ellipse {
    position: absolute;
    bottom: 25px;
    width: 250px;
    height: 70px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, #0F2A4A 0%, #1E4B8F 60%, rgba(30, 75, 143, 0) 72%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 15px 25px rgba(15, 42, 74, 0.35));
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cube-socket-ellipse:hover {
    filter: drop-shadow(0 15px 30px rgba(247, 148, 29, 0.45));
  }

  .cube-socket-ellipse.is-locked {
    background: radial-gradient(ellipse at center, #FF9E2C 0%, #1E4B8F 60%, rgba(30, 75, 143, 0) 75%);
    filter: drop-shadow(0 0 35px rgba(247, 148, 29, 0.8));
    animation: socketPulse 1.2s infinite alternate;
  }

  @keyframes socketPulse {
    0% { transform: scale(1); filter: drop-shadow(0 0 25px rgba(247, 148, 29, 0.6)); }
    100% { transform: scale(1.04); filter: drop-shadow(0 0 45px rgba(247, 148, 29, 0.95)); }
  }

  .socket-lock-indicator {
    position: absolute;
    bottom: -24px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: rgba(30, 75, 143, 0.15);
    border: 1px solid rgba(30, 75, 143, 0.3);
    pointer-events: none;
    transition: all 0.25s ease;
  }

  .cube-socket-ellipse:hover .socket-lock-indicator {
    background: rgba(247, 148, 29, 0.2);
    border-color: rgba(247, 148, 29, 0.5);
  }

  .socket-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 5px #22c55e;
  }

  .socket-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-brand-structural);
    letter-spacing: 0.05em;
  }

  .cube-socket-ellipse:hover .socket-text {
    color: #f7941d;
  }

  /* Cube viewport lock animation */
  .cube-viewport.is-locked {
    animation: none !important;
    transform: translateY(68px) scale(0.92) !important;
    transition: transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) !important;
  }

  /* Easter Egg Toast */
  .peg-lock-toast {
    margin-top: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(247, 148, 29, 0.5);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3), 0 0 20px rgba(247, 148, 29, 0.2);
    border-radius: 10px;
    padding: 0.75rem 1.15rem;
    animation: toastPop 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    max-width: 340px;
    z-index: 10;
  }

  @keyframes toastPop {
    0% { opacity: 0; transform: translateY(10px) scale(0.95); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .toast-inner {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .toast-icon {
    font-size: 1.25rem;
  }

  .toast-text-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .toast-title {
    font-size: 0.78rem;
    color: #f7941d;
    letter-spacing: 0.02em;
  }

  .toast-sub {
    font-size: 0.72rem;
    color: #cbd5e1;
    line-height: 1.35;
  }

  /* Architecture Diagram Cards in Panels */
  .panel-diagram-card {
    margin: 1.25rem 0;
    background: #0a0d14;
    border: 1px solid #1f293d;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .panel-diagram-card:hover {
    border-color: rgba(247, 148, 29, 0.5);
    transform: translateY(-2px);
  }

  .diagram-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: #0f1422;
    border-bottom: 1px solid #1f293d;
  }

  .diagram-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.06em;
  }

  .diagram-label {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .diagram-view {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #05070c;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .diagram-view:hover .diagram-img {
    transform: scale(1.02);
  }

  .socket-inner-depth {
    width: 70%;
    height: 60%;
    border-radius: 50%;
    background: #0A1B30;
    box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.6);
  }

  /* Pill Tabs below cube */
  .peg-pill-tabs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 0.35rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .peg-tab-btn {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .peg-tab-btn:hover {
    color: var(--color-text-primary);
  }

  .peg-tab-btn.is-active {
    background-color: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
  }

  .peg-lock-tab-btn {
    background: rgba(247, 148, 29, 0.1);
    color: var(--rhsp-peg-start);
    border: 1px dashed rgba(247, 148, 29, 0.45);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .peg-lock-tab-btn:hover {
    background: rgba(247, 148, 29, 0.2);
    color: var(--color-text-primary);
    border-color: var(--rhsp-peg-start);
  }

  .peg-lock-tab-btn.is-active {
    background: var(--rhsp-peg-start);
    color: #ffffff;
    border-style: solid;
    box-shadow: 0 0 16px rgba(247, 148, 29, 0.4);
  }

  /* Content Panel */
  .peg-panels-container {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 3rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-subtle);
    min-height: 440px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .peg-panels-container {
      padding: 2rem 1.5rem;
      min-height: auto;
    }
  }

  .peg-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s var(--ease-out-expo), transform 0.35s var(--ease-out-expo);
  }

  .peg-panel.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .peg-panel[hidden] {
    display: none;
  }

  .panel-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .panel-eyebrow .eyebrow {
    margin-bottom: 0;
  }

  .pillar-role-badge {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .panel-headline {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .panel-desc {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .panel-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .panel-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--fs-body);
    color: var(--color-text-primary);
  }

  .bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rhsp-peg-gradient);
    margin-top: 0.55rem;
    flex-shrink: 0;
  }

  .panel-products {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .products-title {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .products-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .prod-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .prod-chip.is-link:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .panel-action {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .cube-viewport {
      animation: none !important;
    }
    .cube-assembly,
    .cube-face {
      transition: none !important;
    }
    .peg-panel {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupPegCube() {
    const sceneWrapper = document.getElementById('cube-scene-wrapper');
    const cubeViewport = document.getElementById('cube-viewport');
    const cubeAssembly = document.getElementById('cube-assembly');
    const socketEllipse = document.getElementById('cube-socket-ellipse');
    const lockToast = document.getElementById('peg-lock-toast');
    const tabButtons = document.querySelectorAll('.peg-tab-btn');
    const panels = document.querySelectorAll('.peg-panel');
    const faces = document.querySelectorAll('.cube-face[data-pillar]');

    if (!cubeAssembly) return;

    const angles: Record<string, { x: number; y: number }> = {
      plan: { x: -65, y: 45 },      // Tilted upward to face viewer
      engineer: { x: -12, y: 90 },   // Left face facing viewer
      genai: { x: -12, y: 0 }        // Right/front face facing viewer
    };

    let currentPillar = 'plan';
    let baseAngle = angles[currentPillar];

    function setPillar(pillarKey: string) {
      if (!angles[pillarKey]) return;
      currentPillar = pillarKey;
      baseAngle = angles[pillarKey];

      // Update Tabs
      tabButtons.forEach(tab => {
        const isMatch = tab.getAttribute('data-pillar') === pillarKey;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Update Panels
      panels.forEach(p => {
        if (p.id === `panel-${pillarKey}`) {
          p.removeAttribute('hidden');
          setTimeout(() => p.classList.add('is-active'), 10);
        } else {
          p.classList.remove('is-active');
          p.setAttribute('hidden', '');
        }
      });

      // Rotate Cube smoothly
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        cubeAssembly.style.transform = `rotateX(${baseAngle.x}deg) rotateY(${baseAngle.y}deg)`;

        // Face pop-out
        faces.forEach(face => {
          if (face.getAttribute('data-pillar') === pillarKey) {
            face.classList.add('is-popped');
          } else {
            face.classList.remove('is-popped');
          }
        });
      }
    }

    // Initial setup
    setPillar('plan');

    // Tab buttons click
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const pillar = btn.getAttribute('data-pillar');
        if (pillar) setPillar(pillar);
      });

      // Keyboard arrow cycling
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        const order = ['plan', 'engineer', 'genai'];
        const idx = order.indexOf(currentPillar);
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const nextPillar = order[(idx + 1) % order.length];
          setPillar(nextPillar);
          (document.getElementById(`tab-peg-${nextPillar}`) as HTMLButtonElement)?.focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prevPillar = order[(idx - 1 + order.length) % order.length];
          setPillar(prevPillar);
          (document.getElementById(`tab-peg-${prevPillar}`) as HTMLButtonElement)?.focus();
        }
      });
    });

    // Face clicks & Easter Egg Sequence Tracker (P -> E -> G)
    const clickedSequence: string[] = [];

    faces.forEach(face => {
      face.addEventListener('click', () => {
        const pillar = face.getAttribute('data-pillar');
        if (pillar) {
          setPillar(pillar);
          clickedSequence.push(pillar);
          if (clickedSequence.length > 3) clickedSequence.shift();
          if (clickedSequence.join('-') === 'plan-engineer-genai') {
            triggerSocketLockEasterEgg();
          }
        }
      });
      face.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const pillar = face.getAttribute('data-pillar');
          if (pillar) setPillar(pillar);
        }
      });
    });

    // Desktop Drag Rotation (±25°) with snap back
    if (sceneWrapper) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;

      sceneWrapper.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        deltaX = 0;
        deltaY = 0;
        cubeAssembly.style.transition = 'none';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        deltaX = Math.max(Math.min((e.clientX - startX) * 0.4, 25), -25);
        deltaY = Math.max(Math.min((e.clientY - startY) * -0.4, 25), -25);

        cubeAssembly.style.transform = `rotateX(${baseAngle.x + deltaY}deg) rotateY(${baseAngle.y + deltaX}deg)`;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        cubeAssembly.style.transition = 'transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1)';
        cubeAssembly.style.transform = `rotateX(${baseAngle.x}deg) rotateY(${baseAngle.y}deg)`;
      });
    }

    const lockTrigger = document.getElementById('peg-lock-trigger');

    // Easter Egg: Lock PEG into the socket
    let isLocked = false;
    let lockTimer: any = null;
    let audioCtx: AudioContext | null = null;

    function playLockHarmonicChime() {
      try {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioClass) return;
        if (!audioCtx) audioCtx = new AudioClass();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const notes = [523.25, 659.25, 783.99]; // C5, E5, G5 major triad
        notes.forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.08);

          gain.gain.setValueAtTime(0.0001, audioCtx.currentTime + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.07, audioCtx.currentTime + idx * 0.08 + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + idx * 0.08 + 0.35);

          osc.connect(gain);
          gain.connect(audioCtx.destination);

          osc.start(audioCtx.currentTime + idx * 0.08);
          osc.stop(audioCtx.currentTime + idx * 0.08 + 0.35);
        });
      } catch (err) {
        console.warn('Audio chime suppressed', err);
      }
    }

    function triggerSocketLockEasterEgg() {
      isLocked = !isLocked;
      clearTimeout(lockTimer);

      if (isLocked) {
        cubeViewport?.classList.add('is-locked');
        socketEllipse?.classList.add('is-locked');
        lockTrigger?.classList.add('is-active');
        if (lockToast) {
          lockToast.hidden = false;
          lockToast.style.display = 'block';
          lockToast.setAttribute('aria-hidden', 'false');
        }
        playLockHarmonicChime();

        // Auto release after 4.5 seconds
        lockTimer = setTimeout(() => {
          isLocked = false;
          cubeViewport?.classList.remove('is-locked');
          socketEllipse?.classList.remove('is-locked');
          lockTrigger?.classList.remove('is-active');
          if (lockToast) {
            lockToast.hidden = true;
            lockToast.style.display = 'none';
            lockToast.setAttribute('aria-hidden', 'true');
          }
        }, 4500);
      } else {
        cubeViewport?.classList.remove('is-locked');
        socketEllipse?.classList.remove('is-locked');
        lockTrigger?.classList.remove('is-active');
        if (lockToast) {
          lockToast.hidden = true;
          lockToast.style.display = 'none';
          lockToast.setAttribute('aria-hidden', 'true');
        }
      }
    }

    // Socket click & button triggers lock
    socketEllipse?.addEventListener('click', triggerSocketLockEasterEgg);
    lockTrigger?.addEventListener('click', triggerSocketLockEasterEgg);
    socketEllipse?.addEventListener('keydown', (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        triggerSocketLockEasterEgg();
      }
    });

    // Konami code easter egg (↑ ↑ ↓ ↓ ← → ← → B A)
    const konamiSequence = [
      'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
      'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight',
      'b', 'a'
    ];
    let konamiIdx = 0;

    window.addEventListener('keydown', (e) => {
      const key = e.key.toLowerCase();
      const expectedKey = konamiSequence[konamiIdx].toLowerCase();

      if (key === expectedKey) {
        konamiIdx++;
        if (konamiIdx === konamiSequence.length) {
          konamiIdx = 0;
          triggerSocketLockEasterEgg();
        }
      } else {
        konamiIdx = 0;
      }
    });
  }

  // Defer initialization to idle to safeguard LCP / TBT performance
  if (document.readyState === 'complete') {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(setupPegCube);
    } else {
      setTimeout(setupPegCube, 150);
    }
  } else {
    window.addEventListener('load', () => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(setupPegCube);
      } else {
        setTimeout(setupPegCube, 150);
      }
    }, { once: true });
  }
  document.addEventListener('astro:after-swap', setupPegCube);
</script>
