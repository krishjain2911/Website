---
import LearnMore from './LearnMore.astro';
import PegCardPlan from './PegCardPlan.astro';
import PegCardEngineer from './PegCardEngineer.astro';
import PegCardGenAI from './PegCardGenAI.astro';
---

<section id="peg-cube" class="peg-section" aria-labelledby="peg-heading">
  <div class="container">
    <div class="peg-header text-center">
      <span class="eyebrow">HOW WE THINK</span>
      <h2 id="peg-heading" class="peg-title">Plan. Engineer. Gen-AI.</h2>
      <p class="peg-subtitle">
        Three disciplines. One accountable team.
      </p>
    </div>

    <div class="peg-stage-grid">
      <!-- Left Column: The 3D CSS Cube resting on Navy Ellipse -->
      <div class="peg-cube-col">
        <div class="cube-scene-wrapper" id="cube-scene-wrapper">
          <!-- 3D Cube Viewport -->
          <div class="cube-viewport" id="cube-viewport" role="region" aria-label="Interactive 3D PEG Cube">
            <div class="cube-assembly" id="cube-assembly">
              <!-- Top Face: P - Plan -->
              <div
                class="cube-face face-top is-active"
                id="face-plan"
                data-pillar="plan"
                role="button"
                tabindex="0"
                aria-label="P - Plan"
              >
                <div class="face-content">
                  <span class="face-letter">P</span>
                  <span class="face-word">PLAN</span>
                </div>
              </div>

              <!-- Left Face: E - Engineer -->
              <div
                class="cube-face face-left"
                id="face-engineer"
                data-pillar="engineer"
                role="button"
                tabindex="0"
                aria-label="E - Engineer"
              >
                <div class="face-content">
                  <span class="face-letter">E</span>
                  <span class="face-word">ENGINEER</span>
                </div>
              </div>

              <!-- Right Face: G - Gen-AI -->
              <div
                class="cube-face face-right"
                id="face-genai"
                data-pillar="genai"
                role="button"
                tabindex="0"
                aria-label="G - Gen-AI"
              >
                <div class="face-content">
                  <span class="face-letter">G</span>
                  <span class="face-word">GEN-AI</span>
                </div>
              </div>

              <!-- Secondary Bottom & Back Faces for full 3D enclosure -->
              <div class="cube-face face-bottom" aria-hidden="true"></div>
              <div class="cube-face face-back" aria-hidden="true"></div>
              <div class="cube-face face-back-left" aria-hidden="true"></div>
            </div>
          </div>

          <!-- Navy Socket Ellipse Pedestal -->
          <div
            class="cube-socket-ellipse"
            id="cube-socket-ellipse"
            aria-hidden="true"
          >
            <div class="socket-inner-depth"></div>
          </div>
        </div>

        <!-- Pill Tabs below Cube -->
        <div class="peg-pill-tabs" role="tablist" aria-label="PEG Pillars">
          <button
            type="button"
            class="peg-tab-btn is-active"
            role="tab"
            aria-selected="true"
            aria-controls="panel-plan"
            id="tab-peg-plan"
            data-pillar="plan"
          >
            Plan
          </button>
          <button
            type="button"
            class="peg-tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-engineer"
            id="tab-peg-engineer"
            data-pillar="engineer"
          >
            Engineer
          </button>
          <button
            type="button"
            class="peg-tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-genai"
            id="tab-peg-genai"
            data-pillar="genai"
          >
            Gen-AI
          </button>
        </div>
      </div>

      <!-- Right Column: Pillar Content Panel (crossfades on interaction) -->
      <div class="peg-content-col">
        <div class="peg-panels-container">
          <!-- Panel: Plan -->
          <div
            id="panel-plan"
            class="peg-panel is-active"
            role="tabpanel"
            aria-labelledby="tab-peg-plan"
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">P - PLAN</span>
              <span class="pillar-role-badge">Decide right, once.</span>
            </div>
            <h3 class="panel-headline">
              "The right decision before the first line of code."
            </h3>
            <p class="panel-desc">
              Strategy, architecture, platform choice, roadmaps.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Clarity on what to build, and what to skip</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>The right platform, chosen on facts, not habit</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>A roadmap your team can actually execute</span>
              </li>
            </ul>

            <!-- Plan Interactive Roadmap Card -->
            <PegCardPlan />

            <div class="panel-products">
              <span class="products-title">Focus areas:</span>
              <div class="products-chips">
                <span class="prod-chip">Strategy</span>
                <span class="prod-chip">Architecture</span>
                <span class="prod-chip">Platform Choice</span>
                <span class="prod-chip">Roadmaps</span>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Plan" />
            </div>
          </div>

          <!-- Panel: Engineer -->
          <div
            id="panel-engineer"
            class="peg-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-engineer"
            hidden
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">E - ENGINEER</span>
              <span class="pillar-role-badge">Built fast. Built to scale.</span>
            </div>
            <h3 class="panel-headline">
              "Speed when you need it. Freedom when you don't want limits."
            </h3>
            <p class="panel-desc">
              OutSystems or MERN, chosen per budget and requirements.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>OutSystems: live in weeks, not quarters</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>MERN: complete freedom, no platform ceiling</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>We recommend what suits you, not what suits us</span>
              </li>
            </ul>

            <!-- Engineer Interactive Integration Card -->
            <PegCardEngineer />

            <div class="panel-products">
              <span class="products-title">Products:</span>
              <div class="products-chips">
                <a href="/solutions/clm" class="prod-chip is-link">CLM</a>
                <a href="/solutions/dms" class="prod-chip is-link">DMS</a>
                <a href="/solutions/whatsapp-journeys" class="prod-chip is-link">WhatsApp Journeys</a>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Engineer" />
            </div>
          </div>

          <!-- Panel: Gen-AI -->
          <div
            id="panel-genai"
            class="peg-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-genai"
            hidden
          >
            <div class="panel-eyebrow">
              <span class="eyebrow">G - GEN-AI</span>
              <span class="pillar-role-badge">AI you can trust with your data.</span>
            </div>
            <h3 class="panel-headline">
              "AI that works on your data, inside your walls."
            </h3>
            <p class="panel-desc">
              Private by design. Powerful by default.
            </p>

            <ul class="panel-bullets">
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Voice agents that talk to customers 24/7</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Your own AI, on your own infrastructure</span>
              </li>
              <li>
                <span class="bullet-dot" aria-hidden="true"></span>
                <span>Ask your business anything, get answers from your own data</span>
              </li>
            </ul>

            <!-- Gen-AI Interactive Architecture Card -->
            <PegCardGenAI />

            <div class="panel-products">
              <span class="products-title">Products:</span>
              <div class="products-chips">
                <a href="/solutions/voice-agents" class="prod-chip is-link">Voice Agents</a>
                <a href="/solutions/sovereign-ai" class="prod-chip is-link">Sovereign AI</a>
                <a href="/solutions/ask-me-anything" class="prod-chip is-link">AskMeAnything</a>
              </div>
            </div>

            <div class="panel-action">
              <LearnMore href="/about#peg" text="Learn more about Gen-AI" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section End Link -->
    <div class="peg-section-footer reveal-on-scroll">
      <LearnMore href="/about#peg" text="Explore the complete PEG framework" />
    </div>
  </div>
</section>

<style>
  .peg-section {
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(40px, 5vh, 60px) 0;
  }

  .text-center {
    text-align: center;
  }

  .peg-header {
    max-width: 680px;
    margin: 0 auto 2rem auto;
  }

  .peg-title {
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .peg-subtitle {
    margin: 0 auto;
    font-size: var(--fs-body-lg);
  }

  .peg-stage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .peg-stage-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 3.5rem;
    }
  }

  /* 3D Cube Scene */
  .peg-cube-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cube-scene-wrapper {
    position: relative;
    width: 320px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .cube-scene-wrapper:active {
    cursor: grabbing;
  }

  .cube-viewport {
    position: relative;
    width: 180px;
    height: 180px;
    transform-style: preserve-3d;
    z-index: 2;
    animation: idleFloat 5s ease-in-out infinite;
  }

  @keyframes idleFloat {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .cube-assembly {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    /* Default isometric target: rotateX(-30deg) rotateY(45deg) */
    transform: rotateX(-30deg) rotateY(45deg);
    transition: transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1);
  }

  .cube-face {
    position: absolute;
    width: 180px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-family: var(--font-sans);
    cursor: pointer;
    box-sizing: border-box;
    backface-visibility: visible;
    transition: transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1), box-shadow 0.3s ease;
    border-radius: 4px;
    overflow: hidden;
  }

  /* Face Geometry (Half cube size = 90px) */
  /* Top Face: P - Plan (Navy Blueprint) */
  .face-top {
    transform: rotateX(90deg) translateZ(90px);
    background: linear-gradient(135deg, #1E4B8F 0%, #0F2A4A 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.2);
  }

  .face-top.is-popped {
    transform: rotateX(90deg) translateZ(110px);
  }

  /* Left Face: E - Engineer (Warm Orange) */
  .face-left {
    transform: rotateY(-90deg) translateZ(90px);
    background: linear-gradient(135deg, #FF9E2C 0%, #F7941D 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  .face-left.is-popped {
    transform: rotateY(-90deg) translateZ(110px);
  }

  /* Right Face: G - Gen-AI (High-Energy Red-Orange) */
  .face-right {
    transform: translateZ(90px);
    background: linear-gradient(135deg, #FF5B3B 0%, #EE4B2B 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  .face-right.is-popped {
    transform: translateZ(110px);
  }

  /* Solidifying Faces */
  .face-bottom {
    transform: rotateX(-90deg) translateZ(90px);
    background: #0A1B30;
    pointer-events: none;
  }

  .face-back {
    transform: rotateY(180deg) translateZ(90px);
    background: #C43818;
    pointer-events: none;
  }

  .face-back-left {
    transform: rotateY(90deg) translateZ(90px);
    background: #0F2A4A;
    pointer-events: none;
  }

  .face-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    pointer-events: none;
  }

  .face-letter {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .face-word {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.95;
  }

  /* Navy Ellipse Socket Pedestal */
  .cube-socket-ellipse {
    position: absolute;
    bottom: 25px;
    width: 250px;
    height: 70px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, #0F2A4A 0%, #1E4B8F 60%, rgba(30, 75, 143, 0) 72%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 15px 25px rgba(15, 42, 74, 0.35));
    pointer-events: none;
    transition: all 0.3s ease;
  }


  .socket-inner-depth {
    width: 70%;
    height: 60%;
    border-radius: 50%;
    background: #0A1B30;
    box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.6);
  }

  /* Pill Tabs below cube */
  .peg-pill-tabs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 0.35rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .peg-tab-btn {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .peg-tab-btn:hover {
    color: var(--color-text-primary);
  }

  .peg-tab-btn.is-active {
    background-color: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
  }

  /* Content Panel */
  .peg-panels-container {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--color-border-subtle);
    min-height: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .peg-panels-container {
      padding: 1.5rem 1.25rem;
      min-height: auto;
    }
  }

  .peg-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s var(--ease-out-expo), transform 0.35s var(--ease-out-expo);
  }

  .peg-panel.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .peg-panel[hidden] {
    display: none;
  }

  .panel-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .panel-eyebrow .eyebrow {
    margin-bottom: 0;
  }

  .pillar-role-badge {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .panel-headline {
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin: 0;
  }

  .panel-desc {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .panel-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.15rem 0;
  }

  .panel-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
    line-height: 1.45;
  }

  .bullet-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rhsp-peg-gradient);
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .panel-products {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-top: 0.2rem;
  }

  .products-title {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .products-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .prod-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .prod-chip.is-link:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .panel-action {
    margin-top: 0.35rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .cube-viewport {
      animation: none !important;
    }
    .cube-assembly,
    .cube-face {
      transition: none !important;
    }
    .peg-panel {
      transition: none !important;
      transform: none !important;
    }
  }

  .peg-section-footer {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }
</style>

<script>
  function setupPegCube() {
    const sceneWrapper = document.getElementById('cube-scene-wrapper');
    const cubeAssembly = document.getElementById('cube-assembly');
    const tabButtons = document.querySelectorAll('.peg-tab-btn');
    const panels = document.querySelectorAll('.peg-panel');
    const faces = document.querySelectorAll('.cube-face[data-pillar]');

    if (!cubeAssembly) return;

    const angles: Record<string, { x: number; y: number }> = {
      plan: { x: -65, y: 45 },      // Tilted upward to face viewer
      engineer: { x: -12, y: 90 },   // Left face facing viewer
      genai: { x: -12, y: 0 }        // Right/front face facing viewer
    };

    let currentPillar = 'plan';
    let baseAngle = angles[currentPillar];

    function setPillar(pillarKey: string) {
      if (!angles[pillarKey] || !cubeAssembly) return;
      currentPillar = pillarKey;
      baseAngle = angles[pillarKey];

      // Update Tabs
      tabButtons.forEach(tab => {
        const isMatch = tab.getAttribute('data-pillar') === pillarKey;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Update Panels
      panels.forEach(p => {
        if (p.id === `panel-${pillarKey}`) {
          p.removeAttribute('hidden');
          setTimeout(() => p.classList.add('is-active'), 10);
        } else {
          p.classList.remove('is-active');
          p.setAttribute('hidden', '');
        }
      });

      // Dispatch event for interactive peg cards
      document.dispatchEvent(new CustomEvent('peg-tab-change', { detail: { pillar: pillarKey } }));

      // Rotate Cube smoothly
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        cubeAssembly.style.transform = `rotateX(${baseAngle.x}deg) rotateY(${baseAngle.y}deg)`;

        // Face pop-out
        faces.forEach(face => {
          if (face.getAttribute('data-pillar') === pillarKey) {
            face.classList.add('is-popped');
          } else {
            face.classList.remove('is-popped');
          }
        });
      }
    }

    // Initial setup
    setPillar('plan');

    // Tab buttons click
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const pillar = btn.getAttribute('data-pillar');
        if (pillar) setPillar(pillar);
      });

      // Keyboard arrow cycling
      btn.addEventListener('keydown', (e: any) => {
        const order = ['plan', 'engineer', 'genai'];
        const idx = order.indexOf(currentPillar);
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const nextPillar = order[(idx + 1) % order.length];
          setPillar(nextPillar);
          (document.getElementById(`tab-peg-${nextPillar}`) as HTMLButtonElement)?.focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prevPillar = order[(idx - 1 + order.length) % order.length];
          setPillar(prevPillar);
          (document.getElementById(`tab-peg-${prevPillar}`) as HTMLButtonElement)?.focus();
        }
      });
    });

    // Face clicks
    faces.forEach(face => {
      face.addEventListener('click', () => {
        const pillar = face.getAttribute('data-pillar');
        if (pillar) {
          setPillar(pillar);
        }
      });
      face.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const pillar = face.getAttribute('data-pillar');
          if (pillar) setPillar(pillar);
        }
      });
    });

    // Desktop Drag Rotation (±25°) with snap back
    if (sceneWrapper) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;

      sceneWrapper.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        deltaX = 0;
        deltaY = 0;
        cubeAssembly.style.transition = 'none';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        deltaX = Math.max(Math.min((e.clientX - startX) * 0.4, 25), -25);
        deltaY = Math.max(Math.min((e.clientY - startY) * -0.4, 25), -25);

        cubeAssembly.style.transform = `rotateX(${baseAngle.x + deltaY}deg) rotateY(${baseAngle.y + deltaX}deg)`;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        cubeAssembly.style.transition = 'transform 700ms cubic-bezier(0.34, 1.25, 0.64, 1)';
        cubeAssembly.style.transform = `rotateX(${baseAngle.x}deg) rotateY(${baseAngle.y}deg)`;
      });
    }
  }

  // Defer initialization to idle to safeguard LCP / TBT performance
  if (document.readyState === 'complete') {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(setupPegCube);
    } else {
      setTimeout(setupPegCube, 150);
    }
  } else {
    window.addEventListener('load', () => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(setupPegCube);
      } else {
        setTimeout(setupPegCube, 150);
      }
    }, { once: true });
  }
  document.addEventListener('astro:after-swap', setupPegCube);
</script>
