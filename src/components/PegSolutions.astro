---
import { getCollection } from 'astro:content';
import MediaAsset from './MediaAsset.astro';
import Icon from './Icon.astro';

const allProducts = await getCollection('products');

const engineerProjects = allProducts
  .filter((p) => p.data.pillar === 'Engineer' || p.data.pillar === 'Build')
  .sort((a, b) => a.data.order - b.data.order);

const genAiProjects = allProducts
  .filter((p) => p.data.pillar === 'Gen-AI' || p.data.pillar === 'Intelligence')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="solutions" class="peg-solutions-section" aria-label="How we think and capabilities">
  <!-- Dynamic Background Atmosphere Tint (<= 6% opacity) -->
  <div class="pillar-atmosphere-tint" id="pillar-atmosphere-tint" aria-hidden="true" data-pillar="plan"></div>

  <!-- Desktop / Interactive Scroll Track (~380vh) -->
  <div class="peg-solutions-track" id="peg-solutions-track">
    <div class="peg-solutions-stage" id="peg-solutions-stage">
      <!-- 0. Phase 0 Intro Header (Center-aligned above the cube in Phase 0) -->
      <div class="stage-intro-header" id="stage-intro-header" data-layout="intro-text" aria-hidden="false">
        <span class="eyebrow intro-eyebrow">HOW WE THINK</span>
        <h2 class="intro-headline staged-word-heading" id="intro-headline">
          <span class="staged-word color-word-plan" style="--word-idx: 0;">Plan.</span>
          <span class="staged-word color-word-engineer" style="--word-idx: 1;">Engineer.</span>
          <span class="staged-word color-word-genai" style="--word-idx: 2;">Gen-AI.</span>
        </h2>
        <p class="intro-subline">Three disciplines. One accountable team.</p>
      </div>

      <!-- Main Stage Container: 2-Column Grid (36% Left / 64% Right) -->
      <div class="container stage-container" id="stage-main-container">
        <!-- Left Column: 3D CSS Cube + Pedestal + Pill Tabs -->
        <div class="stage-cube-col" id="stage-cube-col">
          <div class="cube-zone" id="cube-zone">
            <div class="cube-scene-wrapper" id="cube-scene-wrapper" data-layout="cube" aria-label="Interactive 3D PEG Cube">
              <!-- Dynamic cube ambient glow matching active pillar -->
              <div class="cube-ambient-glow" id="cube-ambient-glow" aria-hidden="true" data-pillar="plan"></div>

              <div class="cube-viewport" id="cube-viewport">
                <div class="cube-assembly" id="cube-assembly">
                  <!-- Top Face: Plain Solid Brand Gradient (No text / glyphs) -->
                  <div class="cube-face face-top" aria-hidden="true"></div>

                  <!-- Bottom Face: Plain Solid Brand Surface (No text / glyphs) -->
                  <div class="cube-face face-bottom" aria-hidden="true"></div>

                  <!-- Front Face: P - Plan (Navy) -->
                  <div
                    class="cube-face face-front"
                    id="cube-face-plan"
                    data-pillar="plan"
                    role="button"
                    tabindex="0"
                    aria-label="P - Plan"
                  >
                    <div class="face-content">
                      <span class="face-letter">P</span>
                      <span class="face-word">PLAN</span>
                    </div>
                  </div>

                  <!-- Right Face: E - Engineer (Orange) -->
                  <div
                    class="cube-face face-right"
                    id="cube-face-engineer"
                    data-pillar="engineer"
                    role="button"
                    tabindex="0"
                    aria-label="E - Engineer"
                  >
                    <div class="face-content">
                      <span class="face-letter">E</span>
                      <span class="face-word">ENGINEER</span>
                    </div>
                  </div>

                  <!-- Back Face: G - Gen-AI (Red) -->
                  <div
                    class="cube-face face-back"
                    id="cube-face-genai"
                    data-pillar="genai"
                    role="button"
                    tabindex="0"
                    aria-label="G - Gen-AI"
                  >
                    <div class="face-content">
                      <span class="face-letter">G</span>
                      <span class="face-word">GEN-AI</span>
                    </div>
                  </div>

                  <!-- Left Face: Enclosure Surface -->
                  <div class="cube-face face-left" aria-hidden="true"></div>
                </div>
              </div>

              <!-- Pedestal Socket -->
              <div class="cube-socket-ellipse" aria-hidden="true">
                <div class="socket-inner-depth"></div>
              </div>
            </div>
          </div>

          <!-- P/E/G Pill Tabs (always positioned directly below the cube in left column) -->
          <div class="stage-pill-tabs" id="stage-pill-tabs" data-layout="tabs" role="tablist" aria-label="PEG Pillars">
            <button
              type="button"
              class="peg-tab-btn is-active"
              role="tab"
              aria-selected="true"
              aria-controls="stage-panel-plan"
              id="tab-peg-plan"
              data-pillar="plan"
            >
              <span class="tab-badge plan-badge">P</span>
              <span>Plan</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-engineer"
              id="tab-peg-engineer"
              data-pillar="engineer"
            >
              <span class="tab-badge engineer-badge">E</span>
              <span>Engineer</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-genai"
              id="tab-peg-genai"
              data-pillar="genai"
            >
              <span class="tab-badge genai-badge">G</span>
              <span>Gen-AI</span>
            </button>
          </div>

          <!-- Scroll to Explore Hint (Appears ONLY in Phase 0 below the tabs) -->
          <div class="intro-scroll-cue" id="intro-scroll-cue" data-layout="hint" aria-hidden="true">
            <span class="cue-text">Scroll to explore</span>
            <Icon name="chevron-down" size={14} class="cue-arrow" />
          </div>
        </div>

        <!-- Right Column: Top-Aligned Pillar Content Panels (Phases 2-4 only) -->
        <div class="stage-content-col" id="stage-content-col" data-layout="pillar-content">
          <!-- PANEL 1: PLAN -->
          <div
            id="stage-panel-plan"
            class="stage-panel is-active"
            data-pillar="plan"
            role="tabpanel"
            aria-labelledby="tab-peg-plan"
          >
            <!-- Fixed Slot 1: Header -->
            <div class="panel-header">
              <h2 class="panel-title staged-word-heading">
                <span class="pillar-indicator" style="background-color: #1E4B8F;" aria-hidden="true">P</span>
                <strong class="highlight-plan staged-word" style="--word-idx: 0;">Plan</strong>
                <span class="staged-word" style="--word-idx: 1;">with</span>
                <span class="staged-word" style="--word-idx: 2;">foresight.</span>
              </h2>
              <p class="panel-desc">
                Objective platform selection, architecture blueprints, and founder-led advisory before writing code.
              </p>
            </div>

            <!-- Fixed Slot 2: Cards Grid -->
            <div class="cards-grid plan-grid">
              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="compass" size={18} />
                </div>
                <h3 class="card-heading">Platform Selection</h3>
                <p class="card-copy">
                  Low-code OutSystems vs. high-code MERN vs. hybrid architecture with unbiased evaluation.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Low-Code vs High-Code</span>
                  <span class="stage-tag">Vendor-Neutral</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="layers" size={18} />
                </div>
                <h3 class="card-heading">Architecture Blueprints</h3>
                <p class="card-copy">
                  Resilient system design, data boundaries, and phased implementation roadmaps that your team can execute.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">System Architecture</span>
                  <span class="stage-tag">Roadmaps</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="shield" size={18} />
                </div>
                <h3 class="card-heading">Founder-Led Advisory</h3>
                <p class="card-copy">
                  Direct senior technical guidance for high-stakes digital investments and transformation decisions.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Executive Advisory</span>
                  <span class="stage-tag">Governance</span>
                </div>
              </article>
            </div>

            <!-- CTA strictly under cards in right column -->
            <div class="panel-action">
              <a href="#contact" class="btn btn-primary plan-cta-btn">
                <span>Talk to our consultants</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>

          <!-- PANEL 2: ENGINEER -->
          <div
            id="stage-panel-engineer"
            class="stage-panel"
            data-pillar="engineer"
            role="tabpanel"
            aria-labelledby="tab-peg-engineer"
          >
            <!-- Fixed Slot 1: Header -->
            <div class="panel-header">
              <h2 class="panel-title staged-word-heading">
                <span class="pillar-indicator" style="background-color: #F7941D;" aria-hidden="true">E</span>
                <strong class="highlight-engineer staged-word" style="--word-idx: 0;">Engineer</strong>
                <span class="staged-word" style="--word-idx: 1;">with</span>
                <span class="staged-word" style="--word-idx: 2;">precision.</span>
              </h2>
              <p class="panel-desc">
                OutSystems speed or custom MERN engineering, built around enterprise workflows.
              </p>
            </div>

            <!-- Fixed Slot 2: Single-Line Two Stacks Strip (no buttons/links) -->
            <div class="stacks-strip" aria-label="Development stacks">
              <span class="stacks-strip-intro">We build on two stacks, chosen per project.</span>
              <div class="stacks-badges-wrap">
                <span class="stack-badge badge-outsystems">OutSystems · speed and governance</span>
                <span class="stack-badge badge-mern">MERN · full control and depth</span>
              </div>
            </div>

            <!-- Fixed Slot 3: Horizontal Scroll Rail (Starts at identical Y in Engineer & Gen-AI) -->
            <div class="projects-rail-section" data-rail-id="engineer">
              <div class="rail-header-row">
                <div class="rail-title-group">
                  <span class="rail-label">Projects &amp; accelerators</span>
                  <span class="rail-count">({engineerProjects.length})</span>
                </div>

                <div class="rail-nav-controls">
                  <button type="button" class="rail-nav-btn rail-nav-prev" aria-label="Previous accelerator" data-rail-target="engineer">
                    <Icon name="chevron-left" size={15} />
                  </button>
                  <button type="button" class="rail-nav-btn rail-nav-next" aria-label="Next accelerator" data-rail-target="engineer">
                    <Icon name="chevron-right" size={15} />
                  </button>
                </div>
              </div>

              <div class="projects-rail-track" id="rail-track-engineer" role="region" aria-label="Engineer projects carousel">
                {engineerProjects.map((proj) => {
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  const badge = proj.data.badge || (proj.data.badges && proj.data.badges[0]) || 'Low-code';
                  return (
                    <article class="stage-card project-rail-card card-mastercard">
                      {proj.data.featured && (
                        <div class="spotlight-ribbon">
                          <span>Spotlight</span>
                        </div>
                      )}
                      <div class="rail-card-media">
                        <MediaAsset
                          assetKey={assetKey}
                          alt={proj.data.shortTitle || proj.data.title}
                          aspectRatio="16/10"
                          class="rail-card-image"
                        />
                        <span class="rail-badge">{badge}</span>
                      </div>
                      <div class="rail-card-body">
                        <h4 class="rail-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                        <p class="rail-card-desc">{proj.data.oneLiner}</p>
                        <a href={`/solutions/${proj.slug}`} class="rail-card-link">
                          <span>View project</span>
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>

              <!-- Rail Progress Dots -->
              <div class="rail-dots-row" id="rail-dots-engineer" aria-hidden="true">
                {engineerProjects.map((_, idx) => (
                  <span class:list={['rail-dot', { 'is-active': idx === 0 }]} data-index={idx}></span>
                ))}
              </div>
            </div>
          </div>

          <!-- PANEL 3: GEN-AI -->
          <div
            id="stage-panel-genai"
            class="stage-panel"
            data-pillar="genai"
            role="tabpanel"
            aria-labelledby="tab-peg-genai"
          >
            <!-- Fixed Slot 1: Header (Identical positioning & height) -->
            <div class="panel-header">
              <h2 class="panel-title staged-word-heading">
                <span class="pillar-indicator" style="background-color: #EE4B2B;" aria-hidden="true">G</span>
                <strong class="highlight-genai staged-word" style="--word-idx: 0;">Gen-AI</strong>
                <span class="staged-word" style="--word-idx: 1;">the</span>
                <span class="staged-word" style="--word-idx: 2;">leap.</span>
              </h2>
              <p class="panel-desc">
                Private, catalogue-grounded, production-ready AI operating inside your walls.
              </p>
            </div>

            <!-- Fixed Slot 2: Single-Line Two Stacks Strip (Matching slot & style) -->
            <div class="stacks-strip" aria-label="Deployment environments">
              <span class="stacks-strip-intro">We deploy across two architectures, chosen per project.</span>
              <div class="stacks-badges-wrap">
                <span class="stack-badge badge-mern">High-code (MERN) · retail &amp; voice</span>
                <span class="stack-badge badge-outsystems">Low-code (OutSystems) · enterprise grounding</span>
              </div>
            </div>

            <!-- Fixed Slot 3: Horizontal Scroll Rail (Starts at identical Y in Engineer & Gen-AI) -->
            <div class="projects-rail-section" data-rail-id="genai">
              <div class="rail-header-row">
                <div class="rail-title-group">
                  <span class="rail-label">Solutions &amp; deployments</span>
                  <span class="rail-count">({genAiProjects.length})</span>
                </div>

                <div class="rail-nav-controls">
                  <button type="button" class="rail-nav-btn rail-nav-prev" aria-label="Previous solution" data-rail-target="genai">
                    <Icon name="chevron-left" size={15} />
                  </button>
                  <button type="button" class="rail-nav-btn rail-nav-next" aria-label="Next solution" data-rail-target="genai">
                    <Icon name="chevron-right" size={15} />
                  </button>
                </div>
              </div>

              <div class="projects-rail-track" id="rail-track-genai" role="region" aria-label="Gen-AI solutions carousel">
                {genAiProjects.map((proj) => {
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  const badge = proj.data.badge || (proj.data.badges && proj.data.badges[0]) || 'Gen-AI';
                  return (
                    <article class="stage-card project-rail-card card-mastercard">
                      {proj.data.featured && (
                        <div class="spotlight-ribbon">
                          <span>Spotlight</span>
                        </div>
                      )}
                      <div class="rail-card-media">
                        <MediaAsset
                          assetKey={assetKey}
                          alt={proj.data.shortTitle || proj.data.title}
                          aspectRatio="16/10"
                          class="rail-card-image"
                        />
                        <span class="rail-badge">{badge}</span>
                      </div>
                      <div class="rail-card-body">
                        <h4 class="rail-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                        <p class="rail-card-desc">{proj.data.oneLiner}</p>
                        <a href={`/solutions/${proj.slug}`} class="rail-card-link">
                          <span>View solution</span>
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>

              <!-- Rail Progress Dots -->
              <div class="rail-dots-row" id="rail-dots-genai" aria-hidden="true">
                {genAiProjects.map((_, idx) => (
                  <span class:list={['rail-dot', { 'is-active': idx === 0 }]} data-index={idx}></span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* -------------------------------------------------------------
     Dynamic Atmosphere Background Tint
     <= 6% opacity subtle brand wash that transitions smoothly
     ------------------------------------------------------------- */
  .pillar-atmosphere-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    opacity: 0.05;
  }

  .pillar-atmosphere-tint[data-pillar="plan"] {
    background: radial-gradient(circle at 65% 50%, #1E4B8F 0%, transparent 70%);
  }

  .pillar-atmosphere-tint[data-pillar="engineer"] {
    background: radial-gradient(circle at 65% 50%, #F7941D 0%, transparent 70%);
  }

  .pillar-atmosphere-tint[data-pillar="genai"] {
    background: radial-gradient(circle at 65% 50%, #EE4B2B 0%, transparent 70%);
  }

  :global(.dark) .pillar-atmosphere-tint {
    opacity: 0.07;
  }

  /* -------------------------------------------------------------
     Track & Sticky Stage
     ------------------------------------------------------------- */
  .peg-solutions-section {
    position: relative;
    width: 100%;
    background-color: var(--color-bg);
  }

  .peg-solutions-track {
    position: relative;
    width: 100%;
    --peg-intro-distance: clamp(180px, 25vh, 260px); /* Intro & transition: about 20 to 30vh */
    --peg-stop-distance: clamp(220px, 28vh, 300px); /* Each pillar change: clamp(220px, 28vh, 300px) */
    height: calc(100vh + var(--peg-intro-distance) + 3 * var(--peg-stop-distance) + 15vh); /* Includes 15vh release buffer */
  }

  .peg-solutions-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    padding-top: var(--nav-height, 72px);
    box-sizing: border-box;
    display: grid;
    align-content: center;
    overflow: hidden;
    z-index: 1;
    transition: transform 350ms cubic-bezier(.4, 0, .2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .peg-solutions-stage {
      transition: none !important;
    }
  }

  /* -------------------------------------------------------------
     0. Phase 0 Intro Header (Center-aligned above the cube)
     ------------------------------------------------------------- */
  .stage-intro-header {
    position: absolute;
    top: calc(var(--nav-height, 72px) + clamp(0.75rem, 2vh, 1.75rem));
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 20;
    pointer-events: auto;
    transition: opacity 0.4s ease, transform 0.4s ease;
    padding: 0 var(--space-container, 1.5rem);
    box-sizing: border-box;
  }

  .intro-eyebrow {
    display: block;
    width: 100%;
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .intro-headline {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    text-align: center;
    width: 100%;
  }

  .intro-subline {
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--color-text-secondary);
    margin: 0;
    text-align: center;
    width: 100%;
  }

  /* Staged Word Highlight Colors */
  .color-word-plan { color: #1E4B8F; }
  :global(.dark) .color-word-plan { color: #5B8FE0; }
  .color-word-engineer { color: #F7941D; }
  .color-word-genai { color: #EE4B2B; }

  /* Staggered word reveal animation */
  .staged-word-heading {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
    row-gap: 0.15em;
  }

  .staged-word-heading .staged-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--word-idx, 0) * 80ms);
  }

  .staged-word-heading.is-revealed .staged-word,
  .stage-panel.is-active .staged-word {
    opacity: 1;
    transform: translateY(0);
  }

  /* -------------------------------------------------------------
     Stage Container Grid
     Two-column layout inside container: 0.8fr Left / 1.6fr Right
     ------------------------------------------------------------- */
  .stage-container {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    height: auto;
    max-height: 100%;
    min-height: 0;
    max-width: var(--max-width, 1240px);
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
    box-sizing: border-box;
    position: relative;
    z-index: 5;
  }

  /* -------------------------------------------------------------
     Left Column: Cube + Ambient Glow + Tabs + Scroll Cue
     ------------------------------------------------------------- */
  .stage-cube-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 10;
    width: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    gap: clamp(0.35rem, 1vh, 0.75rem);
    will-change: transform, opacity;
  }

  .cube-zone {
    container-type: size;
    width: 100%;
    height: clamp(230px, 34vh, 320px);
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .cube-scene-wrapper {
    --cube-size: min(calc(100cqw / 1.7), 360px);
    width: var(--cube-size);
    height: var(--cube-size);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    user-select: none;
    touch-action: none;
    opacity: 1;
    visibility: visible;
  }

  .cube-scene-wrapper:active {
    cursor: grabbing;
  }

  /* Dynamic Cube Ambient Glow */
  .cube-ambient-glow {
    position: absolute;
    width: min(calc(var(--cube-size) * 0.9), 240px);
    height: min(calc(var(--cube-size) * 0.9), 240px);
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 1;
    transition: background 0.6s ease, opacity 0.6s ease;
    opacity: 0.18;
  }

  .cube-ambient-glow[data-pillar="plan"] { background: #1E4B8F; }
  .cube-ambient-glow[data-pillar="engineer"] { background: #F7941D; }
  .cube-ambient-glow[data-pillar="genai"] { background: #EE4B2B; }

  :global(.dark) .cube-ambient-glow {
    opacity: 0.28;
  }

  /* 3D Viewport & Assembly */
  .cube-viewport {
    --face-size: clamp(80px, calc(var(--cube-size) * 0.52), 160px);
    --half-face: calc(var(--face-size) / 2);
    width: var(--face-size);
    height: var(--face-size);
    perspective: 800px;
    perspective-origin: 50% 50%;
    position: relative;
    z-index: 5;
  }

  .cube-assembly {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    transform: rotateX(-20deg) rotateY(-30deg);
    transition: transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1);
  }

  .cube-face {
    position: absolute;
    width: var(--face-size);
    height: var(--face-size);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-family: var(--font-sans);
    cursor: pointer;
    box-sizing: border-box;
    backface-visibility: visible;
    border-radius: 4px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }

  /* Top Face: Clean Plain Solid Gradient (No text / glyphs) */
  .face-top {
    transform: rotateX(90deg) translateZ(var(--half-face));
    background: linear-gradient(135deg, #163666 0%, #0D1F35 100%);
    box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.15);
    pointer-events: none;
  }

  /* Bottom Face: Clean Plain Solid Surface */
  .face-bottom {
    transform: rotateX(-90deg) translateZ(var(--half-face));
    background: #081524;
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  /* Front Face: P - Plan (Navy) */
  .face-front {
    transform: translateZ(var(--half-face));
    background: linear-gradient(135deg, #1E4B8F 0%, #0F2A4A 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.2);
  }

  /* Right Face: E - Engineer (Orange) */
  .face-right {
    transform: rotateY(90deg) translateZ(var(--half-face));
    background: linear-gradient(135deg, #FF9E2C 0%, #F7941D 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  /* Back Face: G - Gen-AI (Red) */
  .face-back {
    transform: rotateY(180deg) translateZ(var(--half-face));
    background: linear-gradient(135deg, #FF5B3B 0%, #EE4B2B 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  /* Left Face: Enclosure */
  .face-left {
    transform: rotateY(-90deg) translateZ(var(--half-face));
    background: linear-gradient(135deg, #122744 0%, #0B192C 100%);
    pointer-events: none;
  }

  .face-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    pointer-events: none;
  }

  .face-letter {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .face-word {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    opacity: 0.95;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  /* Active Face Highlight */
  .cube-face.is-active-face {
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.6), inset 0 0 24px rgba(255, 255, 255, 0.3);
  }

  /* Pedestal Socket */
  .cube-socket-ellipse {
    position: absolute;
    bottom: 24px;
    width: 140px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 80%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .socket-inner-depth {
    width: 90px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 0%, transparent 75%);
  }

  /* Pill Tabs (Strictly below the cube in left column) */
  .stage-pill-tabs {
    display: inline-flex;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: clamp(0.15rem, 0.4vh, 0.25rem);
    gap: 0.25rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    margin-top: clamp(0.25rem, 0.8vh, 0.65rem);
    z-index: 10;
  }

  :global(.dark) .stage-pill-tabs {
    background: var(--color-surface-raised);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .peg-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .peg-tab-btn:hover {
    color: var(--color-text-primary);
  }

  .tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 800;
    color: #FFFFFF;
  }

  .plan-badge { background-color: #1E4B8F; }
  .engineer-badge { background-color: #F7941D; }
  .genai-badge { background-color: #EE4B2B; }

  .peg-tab-btn.is-active {
    background: var(--color-bg);
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .peg-tab-btn.is-active {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Scroll to Explore Cue */
  .intro-scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 1.25rem;
    transition: opacity 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cue-arrow {
    animation: cueBounce 1.8s infinite ease-in-out;
  }

  @keyframes cueBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* -------------------------------------------------------------
     Right Column: Top-Aligned Content Column (No shifting between tabs)
     ------------------------------------------------------------- */
  .stage-content-col {
    position: relative;
    min-height: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden; /* Prevents right edge page overflow */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .stage-panel {
    display: none;
    min-width: 0;
    width: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stage-panel.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* Fixed Slot 1: Header (Equal height & top margin across all pillars) */
  .panel-header {
    margin-bottom: clamp(0.25rem, 0.8vh, 0.65rem);
  }

  .pillar-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    color: #FFFFFF;
    flex-shrink: 0;
    margin-right: 0.35rem;
  }

  .panel-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 clamp(0.15rem, 0.4vh, 0.25rem) 0;
    color: var(--color-text-primary);
  }

  .highlight-plan { color: #1E4B8F; }
  :global(.dark) .highlight-plan { color: #5B8FE0; }
  .highlight-engineer { color: #F7941D; }
  .highlight-genai { color: #EE4B2B; }

  .panel-desc {
    font-size: clamp(0.825rem, 1.25vw, 0.9rem);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 620px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Maximum 2 lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* -------------------------------------------------------------
     Fixed Slot 2: Single-Line Two Stacks Strip (Consistent across E & G)
     ------------------------------------------------------------- */
  .stacks-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(0.35rem, 0.9vh, 0.75rem);
    padding: clamp(0.2rem, 0.5vh, 0.35rem) 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  :global(.dark) .stacks-strip {
    background: var(--color-surface-raised);
  }

  .stacks-strip-intro {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .stacks-badges-wrap {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stack-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    letter-spacing: 0.02em;
  }

  .badge-outsystems {
    background: rgba(247, 148, 29, 0.08);
    border-color: rgba(247, 148, 29, 0.25);
    color: #B86200;
  }

  :global(.dark) .badge-outsystems {
    color: #F7941D;
  }

  .badge-mern {
    background: rgba(30, 75, 143, 0.08);
    border-color: rgba(30, 75, 143, 0.25);
    color: #1E4B8F;
  }

  :global(.dark) .badge-mern {
    color: #5B8FE0;
  }

  /* -------------------------------------------------------------
     Plan 3-Card Grid
     ------------------------------------------------------------- */
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin-bottom: clamp(0.4rem, 0.9vh, 0.85rem);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  @media (max-width: 1279px) and (min-width: 768px) {
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .plan-grid {
      grid-template-columns: 1fr;
    }
  }

  .stage-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(0.55rem, 1.1vh, 0.85rem);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .stage-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--color-border-strong);
  }

  :global(.dark) .stage-card {
    background: var(--color-surface-raised);
  }

  :global(.dark) .stage-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .card-top-icon {
    margin-bottom: 0.5rem;
  }

  .card-heading {
    font-size: 0.925rem;
    font-weight: 700;
    margin: 0 0 0.3rem 0;
    color: var(--color-text-primary);
  }

  .card-copy {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
  }

  .card-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .stage-tag {
    font-size: 10.5px;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  :global(.dark) .stage-tag {
    background: rgba(255, 255, 255, 0.05);
  }

  .panel-action {
    display: flex;
    align-items: center;
  }

  .plan-cta-btn {
    padding: 0.65rem 1.25rem;
  }

  /* -------------------------------------------------------------
     Fixed Slot 3: Projects & Accelerators Horizontal Scroll Rail
     ------------------------------------------------------------- */
  .projects-rail-section {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .rail-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(0.25rem, 0.6vh, 0.45rem);
    width: 100%;
    padding-right: 0.25rem;
    box-sizing: border-box;
  }

  .rail-title-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .rail-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .rail-count {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* Arrow controls strictly contained within content column */
  .rail-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .rail-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rail-nav-btn:hover {
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .rail-nav-btn:disabled,
  .rail-nav-btn[aria-disabled="true"] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Horizontal Carousel Grid strictly inside right column */
  .projects-rail-track {
    --gap: 0.85rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    gap: var(--gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.25rem 0 0.5rem 0;
    cursor: grab;
    user-select: none;
    outline: none;
  }

  .projects-rail-track:focus-visible {
    box-shadow: 0 0 0 2px var(--color-border-strong, #CBD5E1);
  }

  @media (max-width: 1279px) and (min-width: 768px) {
    .projects-rail-track {
      grid-auto-columns: calc((100% - 1 * var(--gap)) / 2);
    }
  }

  @media (max-width: 767px) {
    .projects-rail-track {
      grid-auto-columns: 100%;
    }
  }

  .projects-rail-track:active {
    cursor: grabbing;
  }

  .projects-rail-track::-webkit-scrollbar {
    display: none;
  }

  /* Standardized identical card width across all rails */
  .project-rail-card {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    scroll-snap-align: start;
    padding: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  .spotlight-ribbon {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #111827;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .rail-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: clamp(80px, 12vh, 120px);
    background: var(--color-bg);
    overflow: hidden;
  }

  .rail-card-media :global(img),
  .rail-card-media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .project-rail-card:hover .rail-card-media :global(img) {
    transform: scale(1.04);
  }

  .rail-badge {
    position: absolute;
    bottom: 6px;
    right: 6px;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-size: 9.5px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .rail-card-body {
    padding: clamp(0.45rem, 1vh, 0.75rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .rail-card-title {
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0 0 0.2rem 0;
    color: var(--color-text-primary);
  }

  .rail-card-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin: 0 0 clamp(0.2rem, 0.5vh, 0.4rem) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Strict 2-line clamp */
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pinned to the bottom of the card */
  .rail-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: #B86200;
    text-decoration: none;
    margin-top: auto;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  :global(.dark) .rail-card-link {
    color: #F7941D;
  }

  #stage-panel-genai .rail-card-link {
    color: #B82810;
  }

  :global(.dark) #stage-panel-genai .rail-card-link {
    color: #EE4B2B;
  }

  .rail-card-link:hover {
    transform: translateX(3px);
  }

  /* Rail Progress Dots */
  .rail-dots-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-top: clamp(0.25rem, 0.7vh, 0.5rem);
    width: 100%;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border-strong, #CBD5E1);
    opacity: 0.45;
    border: none;
    padding: 0;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .rail-dot.is-active {
    width: 18px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    opacity: 1;
  }

  /* Mobile Elements default hidden on desktop */
  .mobile-peg-header {
    display: none;
  }

  .mobile-stacked-content {
    display: none;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1199px) {
    .stage-container {
      grid-template-columns: 35% 65%;
      gap: 1.5rem;
    }

    .project-rail-card {
      flex: 0 0 250px;
      width: 250px;
    }
  }

  @media (max-height: 639px) and (min-width: 900px) {
    .peg-solutions-track {
      height: auto !important;
    }
    .peg-solutions-stage {
      position: relative !important;
      top: 0 !important;
      height: auto !important;
      max-height: none !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 2rem 0 !important;
      overflow: visible !important;
    }
    .stage-intro-header {
      position: relative !important;
      transform: none !important;
      opacity: 1 !important;
      margin-bottom: 1.5rem !important;
    }
    .stage-container {
      display: grid !important;
      grid-template-columns: 240px 1fr !important;
      gap: 1.5rem !important;
      height: auto !important;
    }
    .stage-cube-col {
      transform: none !important;
      opacity: 1 !important;
      height: auto !important;
    }
    .cube-scene-wrapper {
      --cube-size: 180px !important;
      width: 180px !important;
      height: 180px !important;
    }
    .stage-content-col {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transform: none !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 2rem !important;
    }
    .stage-panel {
      display: block !important;
      opacity: 1 !important;
      transform: none !important;
      position: relative !important;
      pointer-events: auto !important;
      margin-bottom: 2rem !important;
    }
    .intro-scroll-cue {
      display: none !important;
    }
  }

  @media (max-width: 899px) {
    .peg-solutions-section {
      min-height: auto !important;
      padding-bottom: 4rem;
    }

    .peg-solutions-track {
      height: auto !important;
      display: block !important;
    }

    .peg-solutions-stage {
      position: relative !important;
      top: 0 !important;
      height: auto !important;
      min-height: auto !important;
      overflow: visible !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 1.5rem 0 !important;
    }

    .stage-intro-header {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      opacity: 1 !important;
      margin: 0 auto 1.5rem auto !important;
      text-align: center !important;
    }

    .stage-container {
      display: flex !important;
      flex-direction: column !important;
      gap: 1.5rem !important;
      height: auto !important;
      padding: 0 var(--gutter, 1rem) !important;
    }

    .stage-cube-col {
      transform: none !important;
      opacity: 1 !important;
      height: auto !important;
      min-height: max-content !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 1rem !important;
      margin: 0 auto 1.25rem auto !important;
      position: relative !important;
      z-index: 10 !important;
      flex: 0 0 auto !important;
    }

    .cube-zone {
      container-type: normal !important;
      height: clamp(160px, 38vw, 200px) !important;
      min-height: 160px !important;
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      flex: 0 0 auto !important;
    }

    .cube-scene-wrapper {
      --cube-size: clamp(140px, 34vw, 180px) !important;
      width: var(--cube-size) !important;
      height: var(--cube-size) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      opacity: 1 !important;
      visibility: visible !important;
      position: relative !important;
      flex: 0 0 auto !important;
    }

    .cube-viewport {
      --face-size: clamp(70px, calc(var(--cube-size) * 0.52), 94px) !important;
      width: var(--face-size) !important;
      height: var(--face-size) !important;
    }

    .cube-assembly {
      transform: rotateX(-8deg) rotateY(0deg);
    }

    .stage-pill-tabs {
      display: flex !important;
      position: relative !important;
      margin: 0 auto !important;
      justify-content: center !important;
      z-index: 15 !important;
      flex: 0 0 auto !important;
