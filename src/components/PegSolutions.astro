---
import Icon from './Icon.astro';
---

<section id="solutions" class="peg-solutions-section" aria-label="How we think and capabilities">
  <!-- Desktop / Interactive Scroll Track (~380vh) -->
  <div class="peg-solutions-track" id="peg-solutions-track">
    <div class="peg-solutions-stage" id="peg-solutions-stage">
      <!-- 0. Phase 0 Intro Header (Center-aligned above the cube in Phase 0) -->
      <div class="stage-intro-header" id="stage-intro-header" aria-hidden="false">
        <span class="eyebrow intro-eyebrow">HOW WE THINK</span>
        <h2 class="intro-headline">
          <span class="color-word-plan">Plan.</span>
          <span class="color-word-engineer">Engineer.</span>
          <span class="color-word-genai">Gen-AI.</span>
        </h2>
        <p class="intro-subline">Three disciplines. One accountable team.</p>
      </div>

      <!-- Main Stage Container: 2-Column Grid (38% Left / 62% Right) -->
      <div class="container stage-container" id="stage-main-container">
        <!-- Left Column: 3D CSS Cube + Pedestal + Pill Tabs -->
        <div class="stage-cube-col" id="stage-cube-col">
          <div class="cube-scene-wrapper" id="cube-scene-wrapper" aria-label="Interactive 3D PEG Cube">
            <div class="cube-viewport" id="cube-viewport">
              <div class="cube-assembly" id="cube-assembly">
                <!-- Top Face: P - Plan -->
                <div
                  class="cube-face face-top is-active"
                  id="cube-face-plan"
                  data-pillar="plan"
                  role="button"
                  tabindex="0"
                  aria-label="P - Plan"
                >
                  <div class="face-content">
                    <span class="face-letter">P</span>
                    <span class="face-word">PLAN</span>
                  </div>
                </div>

                <!-- Left Face: E - Engineer -->
                <div
                  class="cube-face face-left"
                  id="cube-face-engineer"
                  data-pillar="engineer"
                  role="button"
                  tabindex="0"
                  aria-label="E - Engineer"
                >
                  <div class="face-content">
                    <span class="face-letter">E</span>
                    <span class="face-word">ENGINEER</span>
                  </div>
                </div>

                <!-- Right Face: G - Gen-AI -->
                <div
                  class="cube-face face-right"
                  id="cube-face-genai"
                  data-pillar="genai"
                  role="button"
                  tabindex="0"
                  aria-label="G - Gen-AI"
                >
                  <div class="face-content">
                    <span class="face-letter">G</span>
                    <span class="face-word">GEN-AI</span>
                  </div>
                </div>

                <!-- Enclosure Faces -->
                <div class="cube-face face-bottom" aria-hidden="true"></div>
                <div class="cube-face face-back" aria-hidden="true"></div>
                <div class="cube-face face-back-left" aria-hidden="true"></div>
              </div>
            </div>

            <!-- Pedestal Socket -->
            <div class="cube-socket-ellipse" aria-hidden="true">
              <div class="socket-inner-depth"></div>
            </div>
          </div>

          <!-- P/E/G Pill Tabs (always positioned directly below the cube in left column) -->
          <div class="stage-pill-tabs" id="stage-pill-tabs" role="tablist" aria-label="PEG Pillars">
            <button
              type="button"
              class="peg-tab-btn is-active"
              role="tab"
              aria-selected="true"
              aria-controls="stage-panel-plan"
              id="tab-peg-plan"
              data-pillar="plan"
            >
              <span class="tab-badge plan-badge">P</span>
              <span>Plan</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-engineer"
              id="tab-peg-engineer"
              data-pillar="engineer"
            >
              <span class="tab-badge engineer-badge">E</span>
              <span>Engineer</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-genai"
              id="tab-peg-genai"
              data-pillar="genai"
            >
              <span class="tab-badge genai-badge">G</span>
              <span>Gen-AI</span>
            </button>
          </div>

          <!-- Scroll to Explore Hint (Appears ONLY in Phase 0 below the tabs) -->
          <div class="intro-scroll-cue" id="intro-scroll-cue" aria-hidden="true">
            <span class="cue-text">Scroll to explore</span>
            <Icon name="chevron-down" size={14} class="cue-arrow" />
          </div>
        </div>

        <!-- Right Column: Pillar Content Panels (Phases 2-4 only) -->
        <div class="stage-content-col" id="stage-content-col">
          <!-- PANEL 1: PLAN -->
          <div
            id="stage-panel-plan"
            class="stage-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-plan"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #1E4B8F;">P</span>
                <span class="eyebrow-text" style="color: #1E4B8F;">PLAN</span>
              </div>
              <h2 class="panel-title">
                <strong class="highlight-plan">Plan</strong> with foresight.
              </h2>
              <p class="panel-desc">
                Objective platform selection, architecture blueprints, and founder-led advisory before writing code.
              </p>
            </div>

            <div class="cards-grid plan-grid">
              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="compass" size={20} />
                </div>
                <h3 class="card-heading">Platform Selection</h3>
                <p class="card-copy">
                  Low-code OutSystems vs. high-code MERN vs. hybrid architecture with unbiased evaluation.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Low-Code vs High-Code</span>
                  <span class="stage-tag">Vendor-Neutral</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="layers" size={20} />
                </div>
                <h3 class="card-heading">Architecture Blueprints</h3>
                <p class="card-copy">
                  Resilient system design, data boundaries, and phased implementation roadmaps that your team can execute.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">System Architecture</span>
                  <span class="stage-tag">Roadmaps</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="shield" size={20} />
                </div>
                <h3 class="card-heading">Founder-Led Advisory</h3>
                <p class="card-copy">
                  Direct senior technical guidance for high-stakes digital investments and transformation decisions.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Executive Advisory</span>
                  <span class="stage-tag">Governance</span>
                </div>
              </article>
            </div>

            <!-- CTA strictly under cards in right column -->
            <div class="panel-action">
              <a href="#contact" class="btn btn-primary plan-cta-btn">
                <span>Talk to our consultants</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>

          <!-- PANEL 2: ENGINEER -->
          <div
            id="stage-panel-engineer"
            class="stage-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-engineer"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #F7941D;">E</span>
                <span class="eyebrow-text" style="color: #B86200;">ENGINEER</span>
              </div>
              <h2 class="panel-title">
                <strong class="highlight-engineer">Engineer</strong> with precision.
              </h2>
              <p class="panel-desc">
                OutSystems speed or custom MERN engineering, built around enterprise workflows.
              </p>
            </div>

            <!-- Two Services Row -->
            <div class="services-duo-grid">
              <article class="stage-card service-card card-mastercard">
                <div class="service-meta">
                  <span class="stage-tag primary-tint">OutSystems Low-Code</span>
                  <h3 class="card-heading">Implementation &amp; Transformation</h3>
                  <p class="card-copy">
                    Enterprise applications deployed in weeks with built-in governance, security, and connectivity.
                  </p>
                </div>
                <a href="#contact" class="btn btn-secondary btn-sm service-action">
                  <span>Start an OutSystems project</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </article>

              <article class="stage-card service-card card-mastercard">
                <div class="service-meta">
                  <span class="stage-tag primary-tint">High-Code (MERN)</span>
                  <h3 class="card-heading">Custom Full-Stack Development</h3>
                  <p class="card-copy">
                    Full-stack engineering with complete architectural autonomy, speed, and zero platform ceilings.
                  </p>
                </div>
                <a href="#contact" class="btn btn-secondary btn-sm service-action">
                  <span>Build custom software</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </article>
            </div>

            <!-- Accelerators Row -->
            <div class="accelerators-block">
              <div class="accelerators-label">Accelerators (Ready Building Blocks)</div>
              <div class="accelerators-grid">
                <a href="/solutions/clm" class="accelerator-item card-mastercard">
                  <div class="accelerator-content">
                    <span class="accelerator-code">CLM</span>
                    <h4 class="accelerator-title">Contract Lifecycle</h4>
                    <p class="accelerator-desc">Drafting, approvals, redlining, digital signing.</p>
                  </div>
                  <span class="accelerator-link-icon" aria-hidden="true">
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>

                <a href="/solutions/dms" class="accelerator-item card-mastercard">
                  <div class="accelerator-content">
                    <span class="accelerator-code">DMS</span>
                    <h4 class="accelerator-title">Document Management</h4>
                    <p class="accelerator-desc">Intelligent indexing, access control, compliant flows.</p>
                  </div>
                  <span class="accelerator-link-icon" aria-hidden="true">
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>

                <a href="/solutions/whatsapp-journeys" class="accelerator-item card-mastercard">
                  <div class="accelerator-content">
                    <span class="accelerator-code">WHATSAPP</span>
                    <h4 class="accelerator-title">WhatsApp Journeys</h4>
                    <p class="accelerator-desc">Two-way customer engagement &amp; automated alerts.</p>
                  </div>
                  <span class="accelerator-link-icon" aria-hidden="true">
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </div>
            </div>
          </div>

          <!-- PANEL 3: GEN-AI -->
          <div
            id="stage-panel-genai"
            class="stage-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-genai"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #EE4B2B;">G</span>
                <span class="eyebrow-text" style="color: #B82810;">GEN-AI</span>
              </div>
              <h2 class="panel-title">
                <strong class="highlight-genai">Gen-AI</strong> the leap.
              </h2>
              <p class="panel-desc">
                Private, catalogue-grounded, production-ready AI operating inside your walls.
              </p>
            </div>

            <div class="cards-grid genai-grid">
              <!-- Solution 1: Sonakshi -->
              <article class="stage-card solution-card card-mastercard">
                <div class="card-tags-row">
                  <span class="stage-tag highlight-tag" style="background-color: rgba(238, 75, 43, 0.12); color: #B82810;">High-code (MERN)</span>
                  <span class="stage-tag">Retail Deployment</span>
                </div>
                <h3 class="card-heading">Sonakshi – AI Voice Agent</h3>
                <p class="card-copy">
                  Multilingual voice assistant built in MERN, deployed for a retail store. Helps showroom customers find, compare, and order with live catalogue grounding.
                </p>
                <div class="card-footer-action">
                  <a href="/solutions/sonakshi" class="solution-link" aria-label="Explore Sonakshi solution">
                    <span>Explore Sonakshi</span>
                    <Icon name="arrow-right" size={14} />
                  </a>
                </div>
              </article>

              <!-- Solution 2: Sovereign AI -->
              <article class="stage-card solution-card card-mastercard">
                <div class="card-tags-row">
                  <span class="stage-tag highlight-tag" style="background-color: rgba(238, 75, 43, 0.12); color: #B82810;">Private Infrastructure</span>
                  <span class="stage-tag">Zero Leakage</span>
                </div>
                <h3 class="card-heading">Sovereign AI</h3>
                <p class="card-copy">
                  Private enterprise LLM deployments running entirely on your infrastructure with strict boundaries and zero third-party data exposure.
                </p>
                <div class="card-footer-action">
                  <a href="/solutions/sovereign-ai" class="solution-link" aria-label="Explore Sovereign AI solution">
                    <span>Explore Sovereign AI</span>
                    <Icon name="arrow-right" size={14} />
                  </a>
                </div>
              </article>

              <!-- Solution 3: AskMeAnything -->
              <article class="stage-card solution-card card-mastercard">
                <div class="card-tags-row">
                  <span class="stage-tag highlight-tag" style="background-color: rgba(238, 75, 43, 0.12); color: #B82810;">RAG Search</span>
                  <span class="stage-tag">Enterprise Knowledge</span>
                </div>
                <h3 class="card-heading">AskMeAnything</h3>
                <p class="card-copy">
                  Enterprise search and conversational intelligence grounded in your private documents, contracts, spreadsheets, and databases.
                </p>
                <div class="card-footer-action">
                  <a href="/solutions/ask-me-anything" class="solution-link" aria-label="Explore AskMeAnything solution">
                    <span>Explore AskMeAnything</span>
                    <Icon name="arrow-right" size={14} />
                  </a>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Header (<900px) -->
  <div class="mobile-peg-header" id="mobile-peg-header" aria-label="Pillar navigation">
    <div class="mobile-header-inner">
      <div class="mobile-logo-mark">
        <span class="mobile-cube-icon">P·E·G</span>
      </div>
      <div class="mobile-pill-tabs" role="tablist">
        <a href="#mobile-pillar-plan" class="mobile-tab is-active" data-pillar="plan">Plan</a>
        <a href="#mobile-pillar-engineer" class="mobile-tab" data-pillar="engineer">Engineer</a>
        <a href="#mobile-pillar-genai" class="mobile-tab" data-pillar="genai">Gen-AI</a>
      </div>
    </div>
  </div>

  <!-- Mobile Stacked Content (<900px) -->
  <div class="mobile-stacked-content" aria-label="Pillar solutions">
    <div id="mobile-pillar-plan" class="mobile-pillar-section" data-pillar="plan">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #1E4B8F;">P</span>
            <span class="eyebrow-text" style="color: #1E4B8F;">PLAN</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-plan">Plan</strong> with foresight.</h2>
          <p class="panel-desc">Objective platform selection, architecture blueprints, and founder-led advisory before writing code.</p>
        </div>
        <div class="mobile-cards-stack">
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Platform Selection</h3>
            <p class="card-copy">Low-code OutSystems vs. high-code MERN vs. hybrid architecture with objective evaluation.</p>
          </article>
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Architecture Blueprints</h3>
            <p class="card-copy">Resilient system design, data boundaries, and phased implementation roadmaps.</p>
          </article>
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Founder-Led Advisory</h3>
            <p class="card-copy">Direct senior technical guidance for high-stakes digital investments.</p>
          </article>
        </div>
        <a href="#contact" class="btn btn-primary plan-cta-btn" style="margin-top: 1.25rem;">
          <span>Talk to our consultants</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>

    <div id="mobile-pillar-engineer" class="mobile-pillar-section" data-pillar="engineer">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #F7941D;">E</span>
            <span class="eyebrow-text" style="color: #B86200;">ENGINEER</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-engineer">Engineer</strong> with precision.</h2>
          <p class="panel-desc">OutSystems speed or custom MERN engineering, built around enterprise workflows.</p>
        </div>
        <div class="mobile-cards-stack">
          <article class="stage-card card-mastercard">
            <span class="stage-tag primary-tint">OutSystems Low-Code</span>
            <h3 class="card-heading">Implementation &amp; Transformation</h3>
            <p class="card-copy">Enterprise apps deployed in weeks with built-in governance and security.</p>
            <a href="#contact" class="btn btn-secondary btn-sm" style="margin-top: 0.75rem;">Start an OutSystems project →</a>
          </article>
          <article class="stage-card card-mastercard">
            <span class="stage-tag primary-tint">High-Code (MERN)</span>
            <h3 class="card-heading">Custom Full-Stack Development</h3>
            <p class="card-copy">Full-stack engineering with complete architectural autonomy and high performance.</p>
            <a href="#contact" class="btn btn-secondary btn-sm" style="margin-top: 0.75rem;">Build custom software →</a>
          </article>
        </div>
        <div class="mobile-accelerators" style="margin-top: 1.5rem;">
          <div class="accelerators-label">Accelerators</div>
          <div class="mobile-cards-stack" style="gap: 0.75rem; margin-top: 0.5rem;">
            <a href="/solutions/clm" class="accelerator-item card-mastercard">
              <span class="accelerator-code">CLM</span>
              <span class="accelerator-title">Contract Lifecycle Management</span>
            </a>
            <a href="/solutions/dms" class="accelerator-item card-mastercard">
              <span class="accelerator-code">DMS</span>
              <span class="accelerator-title">Document Management System</span>
            </a>
            <a href="/solutions/whatsapp-journeys" class="accelerator-item card-mastercard">
              <span class="accelerator-code">WHATSAPP</span>
              <span class="accelerator-title">WhatsApp Journeys</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div id="mobile-pillar-genai" class="mobile-pillar-section" data-pillar="genai">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #EE4B2B;">G</span>
            <span class="eyebrow-text" style="color: #B82810;">GEN-AI</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-genai">Gen-AI</strong> the leap.</h2>
          <p class="panel-desc">Private, catalogue-grounded, production-ready AI operating inside your walls.</p>
        </div>
        <div class="mobile-cards-stack">
          <article class="stage-card card-mastercard">
            <span class="stage-tag" style="color: #B82810;">High-code (MERN)</span>
            <h3 class="card-heading">Sonakshi – AI Voice Agent</h3>
            <p class="card-copy">Multilingual voice assistant built in MERN, deployed for a retail store.</p>
            <a href="/solutions/sonakshi" class="solution-link" style="margin-top: 0.75rem;">Explore Sonakshi →</a>
          </article>
          <article class="stage-card card-mastercard">
            <span class="stage-tag" style="color: #B82810;">Private Cloud</span>
            <h3 class="card-heading">Sovereign AI</h3>
            <p class="card-copy">Private enterprise LLM deployments running entirely on your infrastructure.</p>
            <a href="/solutions/sovereign-ai" class="solution-link" style="margin-top: 0.75rem;">Explore Sovereign AI →</a>
          </article>
          <article class="stage-card card-mastercard">
            <span class="stage-tag" style="color: #B82810;">RAG Search</span>
            <h3 class="card-heading">AskMeAnything</h3>
            <p class="card-copy">Enterprise search across private documents, spreadsheets, and databases.</p>
            <a href="/solutions/ask-me-anything" class="solution-link" style="margin-top: 0.75rem;">Explore AskMeAnything →</a>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .peg-solutions-section {
    position: relative;
    width: 100%;
    background-color: var(--color-bg);
  }

  /* Desktop Sticky Track (~380vh) */
  .peg-solutions-track {
    position: relative;
    height: 380vh;
    min-height: 2800px;
    width: 100%;
  }

  /* Stage height fitted to viewport minus header */
  .peg-solutions-stage {
    position: sticky;
    top: var(--nav-height, 72px);
    height: calc(100vh - var(--nav-height, 72px));
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    padding: 1rem 0;
  }

  /* Phase 0 Intro Header (Center-aligned, positioned near top of stage in Phase 0) */
  .stage-intro-header {
    position: absolute;
    top: 6vh;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 10;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
    width: 100%;
    max-width: 720px;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .intro-eyebrow {
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .intro-headline {
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0.4rem 0;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .color-word-plan {
    color: #1E4B8F;
  }

  :global(.dark) .color-word-plan {
    color: #4D8BFF;
  }

  .color-word-engineer {
    color: #F7941D;
  }

  :global(.dark) .color-word-engineer {
    color: #FFA940;
  }

  .color-word-genai {
    color: #EE4B2B;
  }

  :global(.dark) .color-word-genai {
    color: #FF6647;
  }

  .intro-subline {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* 2-Column Grid Stage Container: 38% Cube / 62% Content */
  .stage-container {
    display: grid;
    grid-template-columns: 38% 62%;
    gap: 3rem;
    align-items: center;
    width: 100%;
    max-width: 1280px;
    height: 100%;
    max-height: calc(100vh - 120px);
    position: relative;
    z-index: 2;
  }

  /* Left Column: Cube Scene + Tabs (Fixed on the left in Phases 1-4) */
  .stage-cube-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    transform-origin: center center;
    will-change: transform;
    z-index: 5;
  }

  .cube-scene-wrapper {
    position: relative;
    width: 240px;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .cube-scene-wrapper:active {
    cursor: grabbing;
  }

  .cube-viewport {
    position: relative;
    width: 140px;
    height: 140px;
    transform-style: preserve-3d;
    z-index: 2;
  }

  .cube-assembly {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    transform: rotateX(-30deg) rotateY(45deg);
