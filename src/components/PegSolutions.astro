</style>

<script>
  function initPegSolutions() {
    const track = document.getElementById('peg-solutions-track');
    const stage = document.getElementById('peg-solutions-stage');
    const introOverlay = document.getElementById('stage-intro-overlay');
    const cubeCol = document.getElementById('stage-cube-col');
    const cubeAssembly = document.getElementById('cube-assembly');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-pill-tabs .peg-tab-btn'));
    const panels = {
      plan: document.getElementById('stage-panel-plan'),
      engineer: document.getElementById('stage-panel-engineer'),
      genai: document.getElementById('stage-panel-genai')
    };
    const faces = {
      plan: document.getElementById('cube-face-plan'),
      engineer: document.getElementById('cube-face-engineer'),
      genai: document.getElementById('cube-face-genai')
    };

    if (!track || !stage || !cubeAssembly) return;

    // Cube rotation angles for pillars
    const pillarAngles: Record<string, { x: number; y: number }> = {
      intro: { x: -30, y: 45 },
      plan: { x: -65, y: 45 },
      engineer: { x: -12, y: 90 },
      genai: { x: -12, y: 0 }
    };

    let activePillar = 'plan';
    let isTicking = false;
    let isUserDragging = false;

    // Helper: linear interpolation
    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function setPanelActive(pillar: 'plan' | 'engineer' | 'genai') {
      if (activePillar === pillar) return;
      activePillar = pillar;

      // Update Tabs
      tabs.forEach(tab => {
        const isMatch = tab.getAttribute('data-pillar') === pillar;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Update Panels
      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        panel.classList.toggle('is-active', key === pillar);
      });

      // Face Pop Out
      Object.entries(faces).forEach(([key, face]) => {
        if (!face) return;
        face.classList.toggle('is-popped', key === pillar);
      });
    }

    function updateScroll() {
      if (!track || !cubeAssembly) return;
      if (window.innerWidth < 900 || isUserDragging) {
        isTicking = false;
        return;
      }

      const rect = track.getBoundingClientRect();
      const trackHeight = track.offsetHeight - window.innerHeight;
      if (trackHeight <= 0) {
        isTicking = false;
        return;
      }

      // Progress p from 0 to 1
      const p = Math.max(0, Math.min(1, -rect.top / trackHeight));

      // 1. Intro Transition (p: 0 -> 0.12)
      if (p <= 0.12) {
        const introP = p / 0.12;
        if (introOverlay) {
          introOverlay.style.opacity = `${1 - introP * 1.5}`;
          introOverlay.style.transform = `translateY(${-introP * 30}px)`;
          introOverlay.style.pointerEvents = introP > 0.8 ? 'none' : 'auto';
        }

        // Cube centered scaling down to left column
        if (cubeCol) {
          const scale = lerp(1.15, 1.0, introP);
          const translateX = lerp(window.innerWidth > 1200 ? 180 : 120, 0, introP);
          cubeCol.style.transform = `translateX(${translateX}px) scale(${scale})`;
        }

        // Interpolate cube angle: intro -> plan
        const ang = {
          x: lerp(pillarAngles.intro.x, pillarAngles.plan.x, introP),
          y: lerp(pillarAngles.intro.y, pillarAngles.plan.y, introP)
        };
        cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
        setPanelActive('plan');
      } 
      // 2. Plan Phase (p: 0.12 -> 0.40)
      else if (p <= 0.40) {
        if (introOverlay) {
          introOverlay.style.opacity = '0';
          introOverlay.style.pointerEvents = 'none';
        }
        if (cubeCol) {
          cubeCol.style.transform = 'translateX(0) scale(1.0)';
        }

        // Near end of plan phase (0.35 -> 0.40), smoothly interpolate to engineer
        if (p > 0.35) {
          const t = (p - 0.35) / 0.05;
          const ang = {
            x: lerp(pillarAngles.plan.x, pillarAngles.engineer.x, t),
            y: lerp(pillarAngles.plan.y, pillarAngles.engineer.y, t)
          };
          cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
        } else {
          cubeAssembly.style.transform = `rotateX(${pillarAngles.plan.x}deg) rotateY(${pillarAngles.plan.y}deg)`;
        }
        setPanelActive('plan');
      }
      // 3. Engineer Phase (p: 0.40 -> 0.70)
      else if (p <= 0.70) {
        if (cubeCol) {
          cubeCol.style.transform = 'translateX(0) scale(1.0)';
        }

        // Near end of engineer phase (0.65 -> 0.70), smoothly interpolate to genai
        if (p > 0.65) {
          const t = (p - 0.65) / 0.05;
          const ang = {
            x: lerp(pillarAngles.engineer.x, pillarAngles.genai.x, t),
            y: lerp(pillarAngles.engineer.y, pillarAngles.genai.y, t)
          };
          cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
        } else {
          cubeAssembly.style.transform = `rotateX(${pillarAngles.engineer.x}deg) rotateY(${pillarAngles.engineer.y}deg)`;
        }
        setPanelActive('engineer');
      }
      // 4. Gen-AI Phase (p: 0.70 -> 1.0)
      else {
        if (cubeCol) {
          cubeCol.style.transform = 'translateX(0) scale(1.0)';
        }
        cubeAssembly.style.transform = `rotateX(${pillarAngles.genai.x}deg) rotateY(${pillarAngles.genai.y}deg)`;
        setPanelActive('genai');
      }

      isTicking = false;
    }

    function onScroll() {
      if (!isTicking) {
        requestAnimationFrame(updateScroll);
        isTicking = true;
      }
    }

    // Tab buttons click: smoothly scroll page to that pillar's scroll target
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const pillar = tab.getAttribute('data-pillar');
        if (!pillar) return;

        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        const trackHeight = track.offsetHeight - window.innerHeight;

        let targetP = 0.25;
        if (pillar === 'engineer') targetP = 0.55;
        if (pillar === 'genai') targetP = 0.85;

        const targetScroll = trackTop + trackHeight * targetP;
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      });
    });

    // Interactive Cube Drag
    const sceneWrapper = document.getElementById('cube-scene-wrapper');
    if (sceneWrapper) {
      let startX = 0;
      let deltaX = 0;

      sceneWrapper.addEventListener('pointerdown', (e) => {
        isUserDragging = true;
        startX = e.clientX;
        deltaX = 0;
        cubeAssembly.style.transition = 'none';
        sceneWrapper.setPointerCapture(e.pointerId);
      });

      sceneWrapper.addEventListener('pointermove', (e) => {
        if (!isUserDragging) return;
        deltaX = e.clientX - startX;
        const currentAng = pillarAngles[activePillar] || pillarAngles.plan;
        cubeAssembly.style.transform = `rotateX(${currentAng.x}deg) rotateY(${currentAng.y + deltaX * 0.4}deg)`;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isUserDragging) return;
        isUserDragging = false;
        cubeAssembly.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1)';
        try {
          sceneWrapper.releasePointerCapture(e.pointerId);
        } catch (_) {}

        // Determine snap target
        const pillarOrder: Array<'plan' | 'engineer' | 'genai'> = ['plan', 'engineer', 'genai'];
        let currentIdx = pillarOrder.indexOf(activePillar as any);
        if (currentIdx === -1) currentIdx = 0;

        if (deltaX < -35 && currentIdx < 2) {
          currentIdx += 1;
        } else if (deltaX > 35 && currentIdx > 0) {
          currentIdx -= 1;
        }

        const nextPillar = pillarOrder[currentIdx];
        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        const trackHeight = track.offsetHeight - window.innerHeight;
        let targetP = 0.25;
        if (nextPillar === 'engineer') targetP = 0.55;
        if (nextPillar === 'genai') targetP = 0.85;

        window.scrollTo({ top: trackTop + trackHeight * targetP, behavior: 'smooth' });
      };

      sceneWrapper.addEventListener('pointerup', endDrag);
      sceneWrapper.addEventListener('pointercancel', endDrag);
    }

    // Scroll listener throttled by rAF
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateScroll();

    // Mobile Section Intersection Observer (<900px)
    if (typeof IntersectionObserver !== 'undefined') {
      const mobileSections = document.querySelectorAll('.mobile-pillar-section');
      const mobileTabs = document.querySelectorAll('.mobile-tab');

      const mobileObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const pillar = entry.target.getAttribute('data-pillar');
            mobileTabs.forEach(t => {
              t.classList.toggle('is-active', t.getAttribute('data-pillar') === pillar);
            });
          }
        });
      }, {
        rootMargin: '-30% 0px -50% 0px',
        threshold: 0
      });

      mobileSections.forEach(s => mobileObs.observe(s));
    }
  }

  initPegSolutions();
  document.addEventListener('astro:after-swap', initPegSolutions);
</script>