    .stage-content-col {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transform: none !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 2.5rem !important;
      width: 100% !important;
      padding-top: 0.5rem !important;
    }

    .stage-panel {
      display: block !important;
      opacity: 1 !important;
      transform: none !important;
      position: relative !important;
      pointer-events: auto !important;
      margin-bottom: 2.5rem !important;
    }

    .intro-scroll-cue {
      display: none !important;
    }

    .project-rail-card {
      width: min(280px, 80vw) !important;
      flex: 0 0 min(280px, 80vw) !important;
    }
  }

  /* Compact Viewports (e.g. 1440x720, 1280x650) */
  @media (max-height: 750px) and (min-width: 900px) {
    .stage-content-col {
      padding-top: 0.25rem;
      min-height: 420px;
    }

    .stage-intro-header {
      top: calc(50% - 175px);
    }

    .intro-headline {
      font-size: 2.1rem;
    }

    .cube-scene-wrapper {
      height: 190px;
    }

    .panel-header {
      margin-bottom: 0.5rem;
    }

    .panel-title {
      font-size: 1.35rem;
    }

    .panel-desc {
      font-size: 0.8rem;
    }

    .stacks-strip {
      margin-bottom: 0.65rem;
      padding: 0.3rem 0.6rem;
    }

    .project-rail-card {
      flex: 0 0 240px;
      width: 240px;
    }

    .rail-card-media {
      max-height: 110px;
    }

    .rail-card-body {
      padding: 0.6rem;
    }

    .rail-card-title {
      font-size: 0.8125rem;
    }

    .rail-card-desc {
      font-size: 0.7rem;
      margin-bottom: 0.35rem;
    }
  }
</style>

<script>
  import { getScrollStory, smoothstep, lerp, clamp } from '../scripts/scrollStory';

  function initPegSolutions() {
    const track = document.getElementById('peg-solutions-track');
    const stage = document.getElementById('peg-solutions-stage');
    const introHeader = document.getElementById('stage-intro-header');
    const scrollCue = document.getElementById('intro-scroll-cue');
    const cubeCol = document.getElementById('stage-cube-col');
    const cubeAssembly = document.getElementById('cube-assembly');
    const contentCol = document.getElementById('stage-content-col');
    const container = document.getElementById('stage-main-container');

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-pill-tabs .peg-tab-btn'));
    const panels: Record<string, HTMLElement | null> = {
      plan: document.getElementById('stage-panel-plan'),
      engineer: document.getElementById('stage-panel-engineer'),
      genai: document.getElementById('stage-panel-genai')
    };
    const faces: Record<string, HTMLElement | null> = {
      plan: document.getElementById('cube-face-plan'),
      engineer: document.getElementById('cube-face-engineer'),
      genai: document.getElementById('cube-face-genai')
    };

    if (!track || !stage || !cubeAssembly || !cubeCol || !contentCol) return;

    // Cube rotation angles
    // Face-front: Plan (y: 0)
    // Face-right: Engineer (y: -90)
    // Face-back: Gen-AI (y: -180)
    const pillarAngles: Record<string, { x: number; y: number }> = {
      intro: { x: -20, y: -30 },
      plan: { x: -8, y: 0 },
      engineer: { x: -8, y: -90 },
      genai: { x: -8, y: -180 }
    };

    let activePillar = 'plan';
    let trackTop = 0;
    let trackHeight = 0;
    let centerOffset = 0;
    let introRevealed = false;

    const atmosphereTint = document.getElementById('pillar-atmosphere-tint');
    const cubeGlow = document.getElementById('cube-ambient-glow');

    function setPanelActive(pillar: 'plan' | 'engineer' | 'genai') {
      if (activePillar === pillar && atmosphereTint?.getAttribute('data-pillar') === pillar) return;
      activePillar = pillar;

      // Update atmosphere tint and cube ambient glow
      if (atmosphereTint) atmosphereTint.setAttribute('data-pillar', pillar);
      if (cubeGlow) cubeGlow.setAttribute('data-pillar', pillar);

      // Update Tabs
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-pillar') === pillar;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Update Panels
      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        panel.classList.toggle('is-active', key === pillar);
      });

      // Active Face indicator
      Object.entries(faces).forEach(([key, face]) => {
        if (!face) return;
        face.classList.toggle('is-active-face', key === pillar);
      });
    }

    // Initial state on first paint for mobile / stacked layout
    if (window.innerWidth < 900 || window.innerHeight < 640) {
      setPanelActive('plan');
      const initAng = pillarAngles.plan;
      if (initAng && cubeAssembly) {
        cubeAssembly.style.transform = `rotateX(${initAng.x}deg) rotateY(${initAng.y}deg)`;
      }
    }

    // Subscribe to shared scrollStory controller
    const story = getScrollStory();

    story.subscribe({
      id: 'peg-solutions',
      gateElement: track,
      measure: (vp) => {
        if (vp.viewportWidth < 900 || vp.viewportHeight < 640) return;
        const rect = track.getBoundingClientRect();
        trackTop = rect.top + vp.scrollY;
        trackHeight = track.offsetHeight - vp.viewportHeight;

        // Calculate translation needed to place cube in exact center of container during Phase 0
        if (container && cubeCol) {
          const containerWidth = container.offsetWidth;
          const cubeColWidth = cubeCol.offsetWidth;
          centerOffset = (containerWidth - cubeColWidth) / 2;
        }
      },
      update: (vp) => {
        if (vp.viewportWidth < 900 || vp.viewportHeight < 640 || trackHeight <= 0) return;

        // Intro and stop distances matching CSS variables
        const introDist = clamp(180, Math.round(vp.viewportHeight * 0.25), 260); // 20 to 30vh
        const stopDist = clamp(220, Math.round(vp.viewportHeight * 0.28), 300); // clamp(220px, 28vh, 300px)
        const currentScroll = vp.scrollY - trackTop;
        // Intro only: push the centred cube down so it clears the 3-line intro header
        const introLiftY = clamp(44, Math.round(vp.viewportHeight * 0.08), 72);

        // Intro headline staggered word reveal
        if (!introRevealed && introHeader) {
          const iRect = introHeader.getBoundingClientRect();
          if (iRect.top < vp.viewportHeight * 0.9) {
            const headlineEl = document.getElementById('intro-headline');
            if (headlineEl) headlineEl.classList.add('is-revealed');
            introRevealed = true;
          }
        }

        // --- PHASE 0: Intro only (cube centred) ---
        if (currentScroll <= introDist * 0.35) {
          // Intro header visible
          if (introHeader) {
            introHeader.style.opacity = '1';
            introHeader.style.transform = 'translateX(-50%) translateY(0px)';
            introHeader.style.visibility = 'visible';
            introHeader.style.pointerEvents = 'auto';
          }

          // "Scroll to explore" visible only in phase 0
          if (scrollCue) {
            scrollCue.style.opacity = '1';
            scrollCue.style.visibility = 'visible';
            scrollCue.style.pointerEvents = 'auto';
          }

          // Cube centered in stage with hand-off crossfade
          let cubeAlpha = 1;
          if (vp.scrollY < trackTop) {
            const hStart = trackTop - vp.viewportHeight * 0.35;
            const hEnd = trackTop - vp.viewportHeight * 0.05;
            cubeAlpha = smoothstep(0, 1, clamp((vp.scrollY - hStart) / Math.max(1, hEnd - hStart), 0, 1));
          }
          cubeCol.style.opacity = `${cubeAlpha}`;
          cubeCol.style.transform = `translateX(${centerOffset}px) translateY(${introLiftY}px) scale(1.08)`;

          // Content column completely hidden - ZERO OVERLAP
          contentCol.style.opacity = '0';
          contentCol.style.visibility = 'hidden';
          contentCol.style.pointerEvents = 'none';

          // Cube is on Intro angle (P face forward, E face turning in)
          cubeAssembly.style.transform = `rotateX(${pillarAngles.intro.x}deg) rotateY(${pillarAngles.intro.y}deg)`;
          setPanelActive('plan');
        }
        // --- PHASE 1: Transition into left column (glides to left, settles slightly smaller) ---
        else if (currentScroll <= introDist) {
          const t1 = (currentScroll - introDist * 0.35) / (introDist * 0.65);
          const ease1 = smoothstep(0, 1, clamp(t1, 0, 1));

          // Intro header fades out
          if (introHeader) {
            introHeader.style.opacity = `${(1 - ease1) * 0.9}`;
            introHeader.style.transform = `translateX(-50%) translateY(${-ease1 * 20}px)`;
            introHeader.style.visibility = ease1 > 0.9 ? 'hidden' : 'visible';
            introHeader.style.pointerEvents = 'none';
          }

          // "Scroll to explore" cue completely hidden
          if (scrollCue) {
            scrollCue.style.opacity = `${Math.max(0, 1 - ease1 * 1.5)}`;
            scrollCue.style.visibility = ease1 > 0.6 ? 'hidden' : 'visible';
            scrollCue.style.pointerEvents = 'none';
          }

          // Cube transitions from center to left column and settles slightly smaller (scale 1.08 -> 1.0)
          cubeCol.style.opacity = '1';
          const currentX = lerp(centerOffset, 0, ease1);
          const currentScale = lerp(1.08, 1.0, ease1);
          const currentY = lerp(introLiftY, 0, ease1);
          cubeCol.style.transform = `translateX(${currentX}px) translateY(${currentY}px) scale(${currentScale})`;

          // Cube interpolates angle: intro -> plan
          const ang = {
            x: lerp(pillarAngles.intro.x, pillarAngles.plan.x, ease1),
            y: lerp(pillarAngles.intro.y, pillarAngles.plan.y, ease1)
          };
          cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;

          // Content column fades in smoothly
          contentCol.style.opacity = `${ease1}`;
          contentCol.style.visibility = 'visible';
          contentCol.style.pointerEvents = ease1 > 0.7 ? 'auto' : 'none';

          setPanelActive('plan');
        }
        // --- PHASES 2-4: Pillar Stops ---
        else {
          // Intro & scroll cue strictly hidden
          if (introHeader) {
            introHeader.style.opacity = '0';
            introHeader.style.visibility = 'hidden';
            introHeader.style.pointerEvents = 'none';
          }
          if (scrollCue) {
            scrollCue.style.opacity = '0';
            scrollCue.style.visibility = 'hidden';
            scrollCue.style.pointerEvents = 'none';
          }

          // Cube column settled in left column
          cubeCol.style.opacity = '1';
          cubeCol.style.transform = 'translateX(0px) scale(1.0)';

          // Content column strictly active
          contentCol.style.opacity = '1';
          contentCol.style.visibility = 'visible';
          contentCol.style.pointerEvents = 'auto';

          const pillarScroll = currentScroll - introDist;

          if (vp.isReducedMotion) {
            if (pillarScroll <= stopDist) {
              setPanelActive('plan');
              cubeAssembly.style.transform = `rotateX(${pillarAngles.plan.x}deg) rotateY(${pillarAngles.plan.y}deg)`;
            } else if (pillarScroll <= 2 * stopDist) {
              setPanelActive('engineer');
              cubeAssembly.style.transform = `rotateX(${pillarAngles.engineer.x}deg) rotateY(${pillarAngles.engineer.y}deg)`;
            } else {
              setPanelActive('genai');
              cubeAssembly.style.transform = `rotateX(${pillarAngles.genai.x}deg) rotateY(${pillarAngles.genai.y}deg)`;
            }
          } else {
            // Stop 1: Plan (pillarScroll <= stopDist)
            if (pillarScroll <= stopDist) {
              // Smooth rotation towards Engineer near end of Plan
              if (pillarScroll > stopDist * 0.75) {
                const blend = (pillarScroll - stopDist * 0.75) / (stopDist * 0.25);
                const ang = {
                  x: lerp(pillarAngles.plan.x, pillarAngles.engineer.x, blend * 0.5),
                  y: lerp(pillarAngles.plan.y, pillarAngles.engineer.y, blend * 0.5)
                };
                cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
              } else {
                cubeAssembly.style.transform = `rotateX(${pillarAngles.plan.x}deg) rotateY(${pillarAngles.plan.y}deg)`;
              }
              setPanelActive('plan');
            }
            // Stop 2: Engineer (stopDist < pillarScroll <= 2 * stopDist)
            else if (pillarScroll <= 2 * stopDist) {
              // First part finishes rotation from Plan
              if (pillarScroll < stopDist * 1.25) {
                const blend = (pillarScroll - stopDist) / (stopDist * 0.25);
                const ang = {
                  x: lerp(pillarAngles.plan.x, pillarAngles.engineer.x, 0.5 + blend * 0.5),
                  y: lerp(pillarAngles.plan.y, pillarAngles.engineer.y, 0.5 + blend * 0.5)
                };
                cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
              }
              // Transition towards Gen-AI near end of Engineer
              else if (pillarScroll > stopDist * 1.75) {
                const blend = (pillarScroll - stopDist * 1.75) / (stopDist * 0.25);
                const ang = {
                  x: lerp(pillarAngles.engineer.x, pillarAngles.genai.x, blend * 0.5),
                  y: lerp(pillarAngles.engineer.y, pillarAngles.genai.y, blend * 0.5)
                };
                cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
              } else {
                cubeAssembly.style.transform = `rotateX(${pillarAngles.engineer.x}deg) rotateY(${pillarAngles.engineer.y}deg)`;
              }
              setPanelActive('engineer');
            }
            // Stop 3: Gen-AI (pillarScroll > 2 * stopDist through 15vh release buffer)
            else {
              // First part finishes rotation from Engineer
              if (pillarScroll < stopDist * 2.25) {
                const blend = (pillarScroll - 2 * stopDist) / (stopDist * 0.25);
                const ang = {
                  x: lerp(pillarAngles.engineer.x, pillarAngles.genai.x, 0.5 + blend * 0.5),
                  y: lerp(pillarAngles.engineer.y, pillarAngles.genai.y, 0.5 + blend * 0.5)
                };
                cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
              } else {
                cubeAssembly.style.transform = `rotateX(${pillarAngles.genai.x}deg) rotateY(${pillarAngles.genai.y}deg)`;
              }
              setPanelActive('genai');
            }
          }
        }
      }
    });

    // Tab buttons click: smoothly scroll page to that pillar's scroll target
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const pillar = tab.getAttribute('data-pillar');
        if (!pillar) return;

        if (window.innerWidth < 900 || window.innerHeight < 640) {
          setPanelActive(pillar as any);
          const ang = pillarAngles[pillar];
          if (ang && cubeAssembly) {
            cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
          }
          const panel = panels[pillar];
          if (panel) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          return;
        }

        const introDist = clamp(180, Math.round(window.innerHeight * 0.25), 260);
        const stopDist = clamp(220, Math.round(window.innerHeight * 0.28), 300);
        let targetScroll = trackTop + introDist + stopDist * 0.4;
        if (pillar === 'engineer') targetScroll = trackTop + introDist + stopDist * 1.5;
        if (pillar === 'genai') targetScroll = trackTop + introDist + stopDist * 2.5;

        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      });
    });

    // Mobile scroll observer: rotate cube to active panel when scrolling in stacked layout
    if ('IntersectionObserver' in window) {
      const mobileObserver = new IntersectionObserver((entries) => {
        if (window.innerWidth >= 900 && window.innerHeight >= 640) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const pillar = entry.target.getAttribute('data-pillar') as 'plan' | 'engineer' | 'genai';
            if (pillar && pillarAngles[pillar]) {
              setPanelActive(pillar);
              const ang = pillarAngles[pillar];
              if (cubeAssembly) {
                cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
              }
            }
          }
        });
      }, { rootMargin: '-15% 0px -45% 0px', threshold: 0.1 });

      Object.values(panels).forEach((p) => {
        if (p) mobileObserver.observe(p);
      });
    }

    // Interactive Cube Drag
    const sceneWrapper = document.getElementById('cube-scene-wrapper');
    if (sceneWrapper) {
      let startX = 0;
      let deltaX = 0;
      let isDragging = false;

      sceneWrapper.addEventListener('pointerdown', (e) => {
        isDragging = true;
        startX = e.clientX;
        deltaX = 0;
        cubeAssembly.style.transition = 'none';
        sceneWrapper.setPointerCapture(e.pointerId);
      });

      sceneWrapper.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        deltaX = e.clientX - startX;
        const currentAng = pillarAngles[activePillar] || pillarAngles.plan;
        cubeAssembly.style.transform = `rotateX(${currentAng.x}deg) rotateY(${currentAng.y + deltaX * 0.4}deg)`;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        cubeAssembly.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1)';
        try {
          sceneWrapper.releasePointerCapture(e.pointerId);
        } catch (_) {}

        const pillarOrder: Array<'plan' | 'engineer' | 'genai'> = ['plan', 'engineer', 'genai'];
        let currentIdx = pillarOrder.indexOf(activePillar as any);
        if (currentIdx === -1) currentIdx = 0;

        if (deltaX < -35 && currentIdx < 2) {
          currentIdx += 1;
        } else if (deltaX > 35 && currentIdx > 0) {
          currentIdx -= 1;
        }

        const nextPillar = pillarOrder[currentIdx];
        const introDist = clamp(180, Math.round(window.innerHeight * 0.25), 260);
        const stopDist = clamp(220, Math.round(window.innerHeight * 0.28), 300);
        let targetScroll = trackTop + introDist + stopDist * 0.4;
        if (nextPillar === 'engineer') targetScroll = trackTop + introDist + stopDist * 1.5;
        if (nextPillar === 'genai') targetScroll = trackTop + introDist + stopDist * 2.5;

        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      };

      sceneWrapper.addEventListener('pointerup', endDrag);
      sceneWrapper.addEventListener('pointercancel', endDrag);
    }

    // Horizontal Rails Setup (Engineer & Gen-AI)
    ['engineer', 'genai'].forEach((railId) => {
      const trackEl = document.getElementById(`rail-track-${railId}`);
      const prevBtn = document.querySelector<HTMLButtonElement>(`.rail-nav-prev[data-rail-target="${railId}"]`);
      const nextBtn = document.querySelector<HTMLButtonElement>(`.rail-nav-next[data-rail-target="${railId}"]`);
      const dotsContainer = document.getElementById(`rail-dots-${railId}`);

      if (!trackEl) return;

      const getScrollStep = () => {
        const firstCard = trackEl.querySelector<HTMLElement>('.project-rail-card');
        if (!firstCard) return 280;
        const gap = parseFloat(getComputedStyle(trackEl).gap) || 14;
        return firstCard.offsetWidth + gap;
      };

      const updateDots = () => {
        if (!dotsContainer) return;
        const cards = trackEl.querySelectorAll('.project-rail-card');
        const count = cards.length;
        const cardsPerPage = window.innerWidth >= 1280 ? 3 : (window.innerWidth >= 768 ? 2 : 1);
        const pageCount = Math.ceil(count / cardsPerPage);

        dotsContainer.innerHTML = '';
        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `rail-dot ${i === 0 ? 'is-active' : ''}`;
          dot.setAttribute('aria-label', `Page ${i + 1}`);
          dot.addEventListener('click', () => {
            const maxScroll = trackEl.scrollWidth - trackEl.clientWidth;
            const target = pageCount > 1 ? (i / (pageCount - 1)) * maxScroll : 0;
            trackEl.scrollTo({ left: target, behavior: 'smooth' });
          });
          dotsContainer.appendChild(dot);
        }
      };

      const updateRailState = () => {
        const scrollLeft = trackEl.scrollLeft;
        const maxScroll = trackEl.scrollWidth - trackEl.clientWidth;

        if (prevBtn) {
          prevBtn.disabled = scrollLeft <= 4;
          prevBtn.setAttribute('aria-disabled', scrollLeft <= 4 ? 'true' : 'false');
        }
        if (nextBtn) {
          nextBtn.disabled = scrollLeft >= maxScroll - 4;
          nextBtn.setAttribute('aria-disabled', scrollLeft >= maxScroll - 4 ? 'true' : 'false');
        }

        if (dotsContainer) {
          const dots = dotsContainer.querySelectorAll('.rail-dot');
          if (dots.length > 0 && maxScroll > 0) {
            const progress = scrollLeft / maxScroll;
            const activeIdx = Math.min(dots.length - 1, Math.max(0, Math.round(progress * (dots.length - 1))));
            dots.forEach((dot, idx) => {
              dot.classList.toggle('is-active', idx === activeIdx);
            });
          }
        }
      };

      prevBtn?.addEventListener('click', () => {
        trackEl.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        trackEl.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      });

      // Keyboard navigation (arrow keys when row is focused)
      trackEl.setAttribute('tabindex', '0');
      trackEl.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          trackEl.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          trackEl.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        }
      });

      trackEl.addEventListener('scroll', updateRailState, { passive: true });
      updateDots();
      updateRailState();

      window.addEventListener('resize', () => {
        updateDots();
        updateRailState();
      }, { passive: true });

      // Drag to scroll horizontally on the track (without vertical wheel hijacking)
      let isRailDragging = false;
      let railStartX = 0;
      let railScrollLeft = 0;
      let hasDragged = false;

      trackEl.addEventListener('pointerdown', (e) => {
        isRailDragging = true;
        hasDragged = false;
        railStartX = e.pageX - trackEl.offsetLeft;
        railScrollLeft = trackEl.scrollLeft;
        trackEl.style.scrollBehavior = 'auto';
      });

      window.addEventListener('pointermove', (e) => {
        if (!isRailDragging) return;
        const x = e.pageX - trackEl.offsetLeft;
        const walk = (x - railStartX) * 1.2;
        if (Math.abs(walk) > 4) {
          hasDragged = true;
        }
        trackEl.scrollLeft = railScrollLeft - walk;
      });

      const endRailDrag = () => {
        if (!isRailDragging) return;
        isRailDragging = false;
        trackEl.style.scrollBehavior = 'smooth';
      };

      window.addEventListener('pointerup', endRailDrag);
      window.addEventListener('pointercancel', endRailDrag);

      // Prevent link clicks if user was dragging
      trackEl.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (hasDragged) {
            e.preventDefault();
            hasDragged = false;
          }
        });
      });
    });
  }

  initPegSolutions();
  document.addEventListener('astro:after-swap', initPegSolutions);
