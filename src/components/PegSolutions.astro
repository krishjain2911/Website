---
import { getCollection } from 'astro:content';
import MediaAsset from './MediaAsset.astro';
import Icon from './Icon.astro';

const allProducts = await getCollection('products');

const engineerProjects = allProducts
  .filter((p) => p.data.pillar === 'Engineer' || p.data.pillar === 'Build')
  .sort((a, b) => a.data.order - b.data.order);

const genAiProjects = allProducts
  .filter((p) => p.data.pillar === 'Gen-AI' || p.data.pillar === 'Intelligence')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="solutions" class="peg-solutions-section" aria-label="How we think and capabilities">
  <!-- Dynamic Background Atmosphere Tint (Part D Item 6, <= 6% opacity) -->
  <div class="pillar-atmosphere-tint" id="pillar-atmosphere-tint" aria-hidden="true" data-pillar="plan"></div>

  <!-- Desktop / Interactive Scroll Track (~380vh) -->
  <div class="peg-solutions-track" id="peg-solutions-track">
    <div class="peg-solutions-stage" id="peg-solutions-stage">
      <!-- 0. Phase 0 Intro Header (Center-aligned above the cube in Phase 0) -->
      <div class="stage-intro-header" id="stage-intro-header" aria-hidden="false">
        <span class="eyebrow intro-eyebrow">HOW WE THINK</span>
        <h2 class="intro-headline staged-word-heading" id="intro-headline">
          <span class="staged-word color-word-plan" style="--word-idx: 0;">Plan.</span>
          <span class="staged-word color-word-engineer" style="--word-idx: 1;">Engineer.</span>
          <span class="staged-word color-word-genai" style="--word-idx: 2;">Gen-AI.</span>
        </h2>
        <p class="intro-subline">Three disciplines. One accountable team.</p>
      </div>

      <!-- Main Stage Container: 2-Column Grid (36% Left / 64% Right) -->
      <div class="container stage-container" id="stage-main-container">
        <!-- Left Column: 3D CSS Cube + Pedestal + Pill Tabs -->
        <div class="stage-cube-col" id="stage-cube-col">
          <div class="cube-scene-wrapper" id="cube-scene-wrapper" aria-label="Interactive 3D PEG Cube">
            <!-- Dynamic cube ambient glow matching active pillar -->
            <div class="cube-ambient-glow" id="cube-ambient-glow" aria-hidden="true" data-pillar="plan"></div>

            <div class="cube-viewport" id="cube-viewport">
              <div class="cube-assembly" id="cube-assembly">
                <!-- Top Face: Plain Solid Brand Gradient (No text / glyphs) -->
                <div class="cube-face face-top" aria-hidden="true"></div>

                <!-- Bottom Face: Plain Solid Brand Surface (No text / glyphs) -->
                <div class="cube-face face-bottom" aria-hidden="true"></div>

                <!-- Front Face: P - Plan (Navy) -->
                <div
                  class="cube-face face-front"
                  id="cube-face-plan"
                  data-pillar="plan"
                  role="button"
                  tabindex="0"
                  aria-label="P - Plan"
                >
                  <div class="face-content">
                    <span class="face-letter">P</span>
                    <span class="face-word">PLAN</span>
                  </div>
                </div>

                <!-- Right Face: E - Engineer (Orange) -->
                <div
                  class="cube-face face-right"
                  id="cube-face-engineer"
                  data-pillar="engineer"
                  role="button"
                  tabindex="0"
                  aria-label="E - Engineer"
                >
                  <div class="face-content">
                    <span class="face-letter">E</span>
                    <span class="face-word">ENGINEER</span>
                  </div>
                </div>

                <!-- Back Face: G - Gen-AI (Red) -->
                <div
                  class="cube-face face-back"
                  id="cube-face-genai"
                  data-pillar="genai"
                  role="button"
                  tabindex="0"
                  aria-label="G - Gen-AI"
                >
                  <div class="face-content">
                    <span class="face-letter">G</span>
                    <span class="face-word">GEN-AI</span>
                  </div>
                </div>

                <!-- Left Face: Enclosure Surface -->
                <div class="cube-face face-left" aria-hidden="true"></div>
              </div>
            </div>

            <!-- Pedestal Socket -->
            <div class="cube-socket-ellipse" aria-hidden="true">
              <div class="socket-inner-depth"></div>
            </div>
          </div>

          <!-- P/E/G Pill Tabs (always positioned directly below the cube in left column) -->
          <div class="stage-pill-tabs" id="stage-pill-tabs" role="tablist" aria-label="PEG Pillars">
            <button
              type="button"
              class="peg-tab-btn is-active"
              role="tab"
              aria-selected="true"
              aria-controls="stage-panel-plan"
              id="tab-peg-plan"
              data-pillar="plan"
            >
              <span class="tab-badge plan-badge">P</span>
              <span>Plan</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-engineer"
              id="tab-peg-engineer"
              data-pillar="engineer"
            >
              <span class="tab-badge engineer-badge">E</span>
              <span>Engineer</span>
            </button>
            <button
              type="button"
              class="peg-tab-btn"
              role="tab"
              aria-selected="false"
              aria-controls="stage-panel-genai"
              id="tab-peg-genai"
              data-pillar="genai"
            >
              <span class="tab-badge genai-badge">G</span>
              <span>Gen-AI</span>
            </button>
          </div>

          <!-- Scroll to Explore Hint (Appears ONLY in Phase 0 below the tabs) -->
          <div class="intro-scroll-cue" id="intro-scroll-cue" aria-hidden="true">
            <span class="cue-text">Scroll to explore</span>
            <Icon name="chevron-down" size={14} class="cue-arrow" />
          </div>
        </div>

        <!-- Right Column: Pillar Content Panels (Phases 2-4 only) -->
        <div class="stage-content-col" id="stage-content-col">
          <!-- PANEL 1: PLAN -->
          <div
            id="stage-panel-plan"
            class="stage-panel is-active"
            role="tabpanel"
            aria-labelledby="tab-peg-plan"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #1E4B8F;">P</span>
                <span class="eyebrow-text" style="color: #1E4B8F;">PLAN</span>
              </div>
              <h2 class="panel-title staged-word-heading">
                <strong class="highlight-plan staged-word" style="--word-idx: 0;">Plan</strong>
                <span class="staged-word" style="--word-idx: 1;">with</span>
                <span class="staged-word" style="--word-idx: 2;">foresight.</span>
              </h2>
              <p class="panel-desc">
                Objective platform selection, architecture blueprints, and founder-led advisory before writing code.
              </p>
            </div>

            <div class="cards-grid plan-grid">
              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="compass" size={20} />
                </div>
                <h3 class="card-heading">Platform Selection</h3>
                <p class="card-copy">
                  Low-code OutSystems vs. high-code MERN vs. hybrid architecture with unbiased evaluation.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Low-Code vs High-Code</span>
                  <span class="stage-tag">Vendor-Neutral</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="layers" size={20} />
                </div>
                <h3 class="card-heading">Architecture Blueprints</h3>
                <p class="card-copy">
                  Resilient system design, data boundaries, and phased implementation roadmaps that your team can execute.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">System Architecture</span>
                  <span class="stage-tag">Roadmaps</span>
                </div>
              </article>

              <article class="stage-card card-mastercard">
                <div class="card-top-icon" style="color: #1E4B8F;">
                  <Icon name="shield" size={20} />
                </div>
                <h3 class="card-heading">Founder-Led Advisory</h3>
                <p class="card-copy">
                  Direct senior technical guidance for high-stakes digital investments and transformation decisions.
                </p>
                <div class="card-tags-row">
                  <span class="stage-tag">Executive Advisory</span>
                  <span class="stage-tag">Governance</span>
                </div>
              </article>
            </div>

            <!-- CTA strictly under cards in right column -->
            <div class="panel-action">
              <a href="#contact" class="btn btn-primary plan-cta-btn">
                <span>Talk to our consultants</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>

          <!-- PANEL 2: ENGINEER -->
          <div
            id="stage-panel-engineer"
            class="stage-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-engineer"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #F7941D;">E</span>
                <span class="eyebrow-text" style="color: #B86200;">ENGINEER</span>
              </div>
              <h2 class="panel-title staged-word-heading">
                <strong class="highlight-engineer staged-word" style="--word-idx: 0;">Engineer</strong>
                <span class="staged-word" style="--word-idx: 1;">with</span>
                <span class="staged-word" style="--word-idx: 2;">precision.</span>
              </h2>
              <p class="panel-desc">
                OutSystems speed or custom MERN engineering, built around enterprise workflows.
              </p>
            </div>

            <!-- Slim Two Services Row with wrapped buttons -->
            <div class="services-duo-grid">
              <article class="stage-card service-card card-mastercard">
                <div class="service-meta">
                  <span class="stage-tag primary-tint">OutSystems Low-Code</span>
                  <h3 class="card-heading">Implementation &amp; Transformation</h3>
                  <p class="card-copy">
                    Enterprise applications deployed in weeks with built-in governance, security, and connectivity.
                  </p>
                </div>
                <a href="#contact" class="btn btn-secondary btn-sm service-action">
                  <span>Start an OutSystems project</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </article>

              <article class="stage-card service-card card-mastercard">
                <div class="service-meta">
                  <span class="stage-tag primary-tint">High-Code (MERN)</span>
                  <h3 class="card-heading">Custom Full-Stack Development</h3>
                  <p class="card-copy">
                    Full-stack engineering with complete architectural autonomy, speed, and zero platform ceilings.
                  </p>
                </div>
                <a href="#contact" class="btn btn-secondary btn-sm service-action">
                  <span>Build custom software</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </article>
            </div>

            <!-- Accelerators & Projects Horizontal Scroll Rail -->
            <div class="projects-rail-section" data-rail-id="engineer">
              <div class="rail-header-row">
                <div class="rail-title-group">
                  <span class="rail-label">Accelerators &amp; Projects</span>
                  <span class="rail-count">({engineerProjects.length})</span>
                </div>

                {engineerProjects.length > 4 && (
                  <div class="rail-filter-chips" role="group" aria-label="Filter accelerators">
                    <button type="button" class="rail-chip is-active" data-filter="all">All</button>
                    <button type="button" class="rail-chip" data-filter="outsystems">OutSystems</button>
                    <button type="button" class="rail-chip" data-filter="custom">Custom</button>
                  </div>
                )}

                <div class="rail-nav-controls">
                  <button type="button" class="rail-nav-btn rail-nav-prev" aria-label="Previous accelerator" data-rail-target="engineer">
                    <Icon name="chevron-left" size={16} />
                  </button>
                  <button type="button" class="rail-nav-btn rail-nav-next" aria-label="Next accelerator" data-rail-target="engineer">
                    <Icon name="chevron-right" size={16} />
                  </button>
                </div>
              </div>

              <div class="projects-rail-track" id="rail-track-engineer" role="region" aria-label="Engineer accelerators carousel">
                {engineerProjects.map((proj, idx) => {
                  const isSpotlight = proj.data.featured || idx === 0;
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  const badge = proj.data.badge || (proj.data.badges && proj.data.badges[0]) || 'Low-code';
                  return (
                    <article class:list={['stage-card', 'project-rail-card', 'card-mastercard', { 'is-spotlight': isSpotlight }]}>
                      {isSpotlight && (
                        <div class="spotlight-ribbon">
                          <span>Spotlight</span>
                        </div>
                      )}
                      <div class="rail-card-media">
                        <MediaAsset
                          assetKey={assetKey}
                          alt={proj.data.shortTitle || proj.data.title}
                          aspectRatio="16/10"
                          class="rail-card-image"
                        />
                        <span class="rail-badge">{badge}</span>
                      </div>
                      <div class="rail-card-body">
                        <h4 class="rail-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                        <p class="rail-card-desc">{proj.data.oneLiner}</p>
                        <a href={`/solutions/${proj.slug}`} class="rail-card-link">
                          <span>View project</span>
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>

              <!-- Rail Progress Dots -->
              <div class="rail-dots-row" id="rail-dots-engineer" aria-hidden="true">
                {engineerProjects.map((_, idx) => (
                  <span class:list={['rail-dot', { 'is-active': idx === 0 }]} data-index={idx}></span>
                ))}
              </div>
            </div>
          </div>

          <!-- PANEL 3: GEN-AI -->
          <div
            id="stage-panel-genai"
            class="stage-panel"
            role="tabpanel"
            aria-labelledby="tab-peg-genai"
          >
            <div class="panel-header">
              <div class="panel-eyebrow">
                <span class="pillar-indicator" style="background-color: #EE4B2B;">G</span>
                <span class="eyebrow-text" style="color: #B82810;">GEN-AI</span>
              </div>
              <h2 class="panel-title staged-word-heading">
                <strong class="highlight-genai staged-word" style="--word-idx: 0;">Gen-AI</strong>
                <span class="staged-word" style="--word-idx: 1;">the</span>
                <span class="staged-word" style="--word-idx: 2;">leap.</span>
              </h2>
              <p class="panel-desc">
                Private, catalogue-grounded, production-ready AI operating inside your walls.
              </p>
            </div>

            <!-- Gen-AI Solutions Horizontal Scroll Rail -->
            <div class="projects-rail-section" data-rail-id="genai">
              <div class="rail-header-row">
                <div class="rail-title-group">
                  <span class="rail-label">Solutions &amp; Deployments</span>
                  <span class="rail-count">({genAiProjects.length})</span>
                </div>

                {genAiProjects.length > 4 && (
                  <div class="rail-filter-chips" role="group" aria-label="Filter Gen-AI solutions">
                    <button type="button" class="rail-chip is-active" data-filter="all">All</button>
                    <button type="button" class="rail-chip" data-filter="voice">Voice</button>
                    <button type="button" class="rail-chip" data-filter="sovereign">Sovereign</button>
                  </div>
                )}

                <div class="rail-nav-controls">
                  <button type="button" class="rail-nav-btn rail-nav-prev" aria-label="Previous solution" data-rail-target="genai">
                    <Icon name="chevron-left" size={16} />
                  </button>
                  <button type="button" class="rail-nav-btn rail-nav-next" aria-label="Next solution" data-rail-target="genai">
                    <Icon name="chevron-right" size={16} />
                  </button>
                </div>
              </div>

              <div class="projects-rail-track" id="rail-track-genai" role="region" aria-label="Gen-AI solutions carousel">
                {genAiProjects.map((proj, idx) => {
                  const isSpotlight = proj.data.featured || idx === 0;
                  const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
                  const badge = proj.data.badge || (proj.data.badges && proj.data.badges[0]) || 'Gen-AI';
                  return (
                    <article class:list={['stage-card', 'project-rail-card', 'card-mastercard', { 'is-spotlight': isSpotlight }]}>
                      {isSpotlight && (
                        <div class="spotlight-ribbon">
                          <span>Spotlight</span>
                        </div>
                      )}
                      <div class="rail-card-media">
                        <MediaAsset
                          assetKey={assetKey}
                          alt={proj.data.shortTitle || proj.data.title}
                          aspectRatio="16/10"
                          class="rail-card-image"
                        />
                        <span class="rail-badge">{badge}</span>
                      </div>
                      <div class="rail-card-body">
                        <h4 class="rail-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                        <p class="rail-card-desc">{proj.data.oneLiner}</p>
                        <a href={`/solutions/${proj.slug}`} class="rail-card-link">
                          <span>View solution</span>
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>

              <!-- Rail Progress Dots -->
              <div class="rail-dots-row" id="rail-dots-genai" aria-hidden="true">
                {genAiProjects.map((_, idx) => (
                  <span class:list={['rail-dot', { 'is-active': idx === 0 }]} data-index={idx}></span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Header (<900px) -->
  <div class="mobile-peg-header" id="mobile-peg-header" aria-label="Pillar navigation">
    <div class="mobile-header-inner">
      <div class="mobile-logo-mark">
        <span class="mobile-cube-icon">P·E·G</span>
      </div>
      <div class="mobile-pill-tabs" role="tablist">
        <a href="#mobile-pillar-plan" class="mobile-tab is-active" data-pillar="plan">Plan</a>
        <a href="#mobile-pillar-engineer" class="mobile-tab" data-pillar="engineer">Engineer</a>
        <a href="#mobile-pillar-genai" class="mobile-tab" data-pillar="genai">Gen-AI</a>
      </div>
    </div>
  </div>

  <!-- Mobile Stacked Content (<900px) -->
  <div class="mobile-stacked-content" aria-label="Pillar solutions">
    <!-- Mobile Plan -->
    <div id="mobile-pillar-plan" class="mobile-pillar-section" data-pillar="plan">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #1E4B8F;">P</span>
            <span class="eyebrow-text" style="color: #1E4B8F;">PLAN</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-plan">Plan</strong> with foresight.</h2>
          <p class="panel-desc">Objective platform selection, architecture blueprints, and founder-led advisory before writing code.</p>
        </div>
        <div class="mobile-cards-stack">
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Platform Selection</h3>
            <p class="card-copy">Low-code OutSystems vs. high-code MERN vs. hybrid architecture with objective evaluation.</p>
          </article>
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Architecture Blueprints</h3>
            <p class="card-copy">Resilient system design, data boundaries, and phased implementation roadmaps.</p>
          </article>
          <article class="stage-card card-mastercard">
            <h3 class="card-heading">Founder-Led Advisory</h3>
            <p class="card-copy">Direct senior technical guidance for high-stakes digital investments.</p>
          </article>
        </div>
        <a href="#contact" class="btn btn-primary plan-cta-btn" style="margin-top: 1.25rem;">
          <span>Talk to our consultants</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>

    <!-- Mobile Engineer -->
    <div id="mobile-pillar-engineer" class="mobile-pillar-section" data-pillar="engineer">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #F7941D;">E</span>
            <span class="eyebrow-text" style="color: #B86200;">ENGINEER</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-engineer">Engineer</strong> with precision.</h2>
          <p class="panel-desc">OutSystems speed or custom MERN engineering, built around enterprise workflows.</p>
        </div>
        <div class="mobile-cards-stack">
          <article class="stage-card card-mastercard">
            <span class="stage-tag primary-tint">OutSystems Low-Code</span>
            <h3 class="card-heading">Implementation &amp; Transformation</h3>
            <p class="card-copy">Enterprise applications deployed in weeks with built-in governance, security, and connectivity.</p>
            <a href="#contact" class="btn btn-secondary btn-sm" style="margin-top: 0.75rem; width: 100%;">
              <span>Start an OutSystems project</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </article>
          <article class="stage-card card-mastercard">
            <span class="stage-tag primary-tint">High-Code (MERN)</span>
            <h3 class="card-heading">Custom Full-Stack Development</h3>
            <p class="card-copy">Full-stack engineering with complete architectural autonomy, speed, and zero platform ceilings.</p>
            <a href="#contact" class="btn btn-secondary btn-sm" style="margin-top: 0.75rem; width: 100%;">
              <span>Build custom software</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </article>
        </div>

        <div class="mobile-accelerators-block">
          <h3 class="mobile-acc-title">Accelerators &amp; Projects</h3>
          <div class="mobile-project-cards">
            {engineerProjects.map((proj) => {
              const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
              return (
                <a href={`/solutions/${proj.slug}`} class="mobile-project-card card-mastercard">
                  <div class="mobile-card-media">
                    <MediaAsset assetKey={assetKey} alt={proj.data.shortTitle || proj.data.title} aspectRatio="16/10" />
                  </div>
                  <div class="mobile-card-content">
                    <span class="mobile-badge">{proj.data.badge}</span>
                    <h4 class="mobile-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                    <p class="mobile-card-desc">{proj.data.oneLiner}</p>
                    <span class="mobile-card-link">View project &rarr;</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Gen-AI -->
    <div id="mobile-pillar-genai" class="mobile-pillar-section" data-pillar="genai">
      <div class="container">
        <div class="panel-header">
          <div class="panel-eyebrow">
            <span class="pillar-indicator" style="background-color: #EE4B2B;">G</span>
            <span class="eyebrow-text" style="color: #B82810;">GEN-AI</span>
          </div>
          <h2 class="panel-title"><strong class="highlight-genai">Gen-AI</strong> the leap.</h2>
          <p class="panel-desc">Private, catalogue-grounded, production-ready AI operating inside your walls.</p>
        </div>
        <div class="mobile-project-cards">
          {genAiProjects.map((proj) => {
            const assetKey = proj.data.image || proj.data.imageKey || `product-${proj.slug}`;
            return (
              <a href={`/solutions/${proj.slug}`} class="mobile-project-card card-mastercard">
                <div class="mobile-card-media">
                  <MediaAsset assetKey={assetKey} alt={proj.data.shortTitle || proj.data.title} aspectRatio="16/10" />
                </div>
                <div class="mobile-card-content">
                  <span class="mobile-badge">{proj.data.badge}</span>
                  <h4 class="mobile-card-title">{proj.data.shortTitle || proj.data.title}</h4>
                  <p class="mobile-card-desc">{proj.data.oneLiner}</p>
                  <span class="mobile-card-link">View solution &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* -------------------------------------------------------------
     Dynamic Atmosphere Background Tint (Part D Item 6)
     <= 6% opacity subtle brand wash that transitions smoothly
     ------------------------------------------------------------- */
  .pillar-atmosphere-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    opacity: 0.05;
  }

  .pillar-atmosphere-tint[data-pillar="plan"] {
    background: radial-gradient(circle at 65% 50%, #1E4B8F 0%, transparent 70%);
  }

  .pillar-atmosphere-tint[data-pillar="engineer"] {
    background: radial-gradient(circle at 65% 50%, #F7941D 0%, transparent 70%);
  }

  .pillar-atmosphere-tint[data-pillar="genai"] {
    background: radial-gradient(circle at 65% 50%, #EE4B2B 0%, transparent 70%);
  }

  :global(.dark) .pillar-atmosphere-tint {
    opacity: 0.07;
  }

  /* -------------------------------------------------------------
     Track & Sticky Stage
     ------------------------------------------------------------- */
  .peg-solutions-section {
    position: relative;
    width: 100%;
    background-color: var(--color-bg);
  }

  .peg-solutions-track {
    position: relative;
    width: 100%;
    height: 380vh; /* Smooth scroll progression through phases */
  }

  .peg-solutions-stage {
    position: sticky;
    top: var(--nav-height, 72px);
    width: 100%;
    height: calc(100vh - var(--nav-height, 72px));
    max-height: 1000px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    z-index: 1;
  }

  /* -------------------------------------------------------------
     0. Phase 0 Intro Header (Center-aligned above the cube)
     ------------------------------------------------------------- */
  .stage-intro-header {
    position: absolute;
    top: calc(50% - 210px);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    width: 90%;
    max-width: 720px;
    z-index: 20;
    pointer-events: auto;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .intro-eyebrow {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .intro-headline {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .intro-subline {
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Staged Word Highlight Colors */
  .color-word-plan {
    color: #1E4B8F;
  }

  :global(.dark) .color-word-plan {
    color: #5B8FE0;
  }

  .color-word-engineer {
    color: #F7941D;
  }

  .color-word-genai {
    color: #EE4B2B;
  }

  /* Staggered word reveal animation */
  .staged-word-heading .staged-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--word-idx, 0) * 80ms);
  }

  .staged-word-heading.is-revealed .staged-word,
  .stage-panel.is-active .staged-word {
    opacity: 1;
    transform: translateY(0);
  }

  /* -------------------------------------------------------------
     Stage Container Grid
     36% Left (Cube + Tabs) / 64% Right (Content Panels)
     ------------------------------------------------------------- */
  .stage-container {
    display: grid;
    grid-template-columns: 36% 64%;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    max-width: var(--max-w-content);
    margin: 0 auto;
    padding: 0 var(--space-container);
    box-sizing: border-box;
    position: relative;
    z-index: 5;
  }

  /* -------------------------------------------------------------
     Left Column: Cube + Ambient Glow + Tabs + Scroll Cue
     ------------------------------------------------------------- */
  .stage-cube-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 10;
    will-change: transform, opacity;
  }

  .cube-scene-wrapper {
    position: relative;
    width: 260px;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .cube-scene-wrapper:active {
    cursor: grabbing;
  }

  /* Dynamic Cube Ambient Glow */
  .cube-ambient-glow {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 1;
    transition: background 0.6s ease, opacity 0.6s ease;
    opacity: 0.18;
  }

  .cube-ambient-glow[data-pillar="plan"] {
    background: #1E4B8F;
  }

  .cube-ambient-glow[data-pillar="engineer"] {
    background: #F7941D;
  }

  .cube-ambient-glow[data-pillar="genai"] {
    background: #EE4B2B;
  }

  :global(.dark) .cube-ambient-glow {
    opacity: 0.28;
  }

  /* 3D Viewport & Assembly */
  .cube-viewport {
    width: 130px;
    height: 130px;
    perspective: 800px;
    perspective-origin: 50% 50%;
    position: relative;
    z-index: 5;
  }

  .cube-assembly {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-style: preserve-3d;
    transform: rotateX(-20deg) rotateY(-30deg);
    transition: transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1);
  }

  .cube-face {
    position: absolute;
    width: 130px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-family: var(--font-sans);
    cursor: pointer;
    box-sizing: border-box;
    backface-visibility: visible;
    border-radius: 4px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }

  /* Top Face: Clean Plain Solid Gradient (No text / glyphs) */
  .face-top {
    transform: rotateX(90deg) translateZ(65px);
    background: linear-gradient(135deg, #163666 0%, #0D1F35 100%);
    box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.15);
    pointer-events: none;
  }

  /* Bottom Face: Clean Plain Solid Surface */
  .face-bottom {
    transform: rotateX(-90deg) translateZ(65px);
    background: #081524;
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  /* Front Face: P - Plan (Navy) */
  .face-front {
    transform: translateZ(65px);
    background: linear-gradient(135deg, #1E4B8F 0%, #0F2A4A 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.2);
  }

  /* Right Face: E - Engineer (Orange) */
  .face-right {
    transform: rotateY(90deg) translateZ(65px);
    background: linear-gradient(135deg, #FF9E2C 0%, #F7941D 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  /* Back Face: G - Gen-AI (Red) */
  .face-back {
    transform: rotateY(180deg) translateZ(65px);
    background: linear-gradient(135deg, #FF5B3B 0%, #EE4B2B 100%);
    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
  }

  /* Left Face: Enclosure */
  .face-left {
    transform: rotateY(-90deg) translateZ(65px);
    background: linear-gradient(135deg, #122744 0%, #0B192C 100%);
    pointer-events: none;
  }

  .face-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    pointer-events: none;
  }

  .face-letter {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .face-word {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    opacity: 0.95;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  /* Active Face Highlight */
  .cube-face.is-active-face {
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.6), inset 0 0 24px rgba(255, 255, 255, 0.3);
  }

  /* Pedestal Socket */
  .cube-socket-ellipse {
    position: absolute;
    bottom: 24px;
    width: 140px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 80%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .socket-inner-depth {
    width: 90px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 0%, transparent 75%);
  }

  /* Pill Tabs (Strictly below the cube in left column) */
  .stage-pill-tabs {
    display: inline-flex;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.25rem;
    gap: 0.25rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    margin-top: 1rem;
    z-index: 10;
  }

  :global(.dark) .stage-pill-tabs {
    background: var(--color-surface-raised);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .peg-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .peg-tab-btn:hover {
    color: var(--color-text-primary);
  }

  .tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 800;
    color: #FFFFFF;
  }

  .plan-badge { background-color: #1E4B8F; }
  .engineer-badge { background-color: #F7941D; }
  .genai-badge { background-color: #EE4B2B; }

  .peg-tab-btn.is-active {
    background: var(--color-bg);
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .peg-tab-btn.is-active {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Scroll to Explore Cue */
  .intro-scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 1.25rem;
    transition: opacity 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cue-arrow {
    animation: cueBounce 1.8s infinite ease-in-out;
  }

  @keyframes cueBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* -------------------------------------------------------------
     Right Column: Pillar Content Panels
     ------------------------------------------------------------- */
  .stage-content-col {
    position: relative;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity 0.4s ease;
  }

  .stage-panel {
    display: none;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stage-panel.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .panel-header {
    margin-bottom: 1rem;
  }

  .panel-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }

  .pillar-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    color: #FFFFFF;
  }

  .eyebrow-text {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .panel-title {
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 0.35rem 0;
    color: var(--color-text-primary);
  }

  .highlight-plan { color: #1E4B8F; }
  :global(.dark) .highlight-plan { color: #5B8FE0; }
  .highlight-engineer { color: #F7941D; }
  .highlight-genai { color: #EE4B2B; }

  .panel-desc {
    font-size: clamp(0.85rem, 1.4vw, 0.95rem);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 600px;
    line-height: 1.4;
  }

  /* Plan 3-Card Grid */
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .stage-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .stage-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--color-border-strong);
  }

  :global(.dark) .stage-card {
    background: var(--color-surface-raised);
  }

  :global(.dark) .stage-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .card-top-icon {
    margin-bottom: 0.65rem;
  }

  .card-heading {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
    color: var(--color-text-primary);
  }

  .card-copy {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
  }

  .card-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .stage-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  :global(.dark) .stage-tag {
    background: rgba(255, 255, 255, 0.05);
  }

  .stage-tag.primary-tint {
    background: rgba(247, 148, 29, 0.1);
    color: #B86200;
    border-color: rgba(247, 148, 29, 0.25);
  }

  :global(.dark) .stage-tag.primary-tint {
    color: #F7941D;
  }

  .panel-action {
    display: flex;
    align-items: center;
  }

  .plan-cta-btn {
    padding: 0.65rem 1.25rem;
  }

  /* -------------------------------------------------------------
     Engineer Panel Slim Duo Services Row
     ------------------------------------------------------------- */
  .services-duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .service-card {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .service-card .card-heading {
    font-size: 0.9rem;
    margin: 0.25rem 0 0.25rem 0;
  }

  .service-card .card-copy {
    font-size: 0.775rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  /* Fixed wrapped button so text never overflows */
  .service-card .service-action {
    margin-top: 0.4rem;
    width: 100%;
    white-space: normal;
    text-align: center;
    justify-content: center;
    padding: 0.45rem 0.75rem;
    font-size: 0.775rem;
    line-height: 1.25;
  }

  /* -------------------------------------------------------------
     Projects & Accelerators Horizontal Scroll-Snap Rail
     ------------------------------------------------------------- */
  .projects-rail-section {
    position: relative;
    width: 100%;
    margin-top: 0.25rem;
  }

  .rail-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .rail-title-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .rail-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .rail-count {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .rail-filter-chips {
    display: flex;
    gap: 0.35rem;
  }

  .rail-chip {
    padding: 0.15rem 0.55rem;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rail-chip.is-active,
  .rail-chip:hover {
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .rail-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .rail-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rail-nav-btn:hover {
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .rail-nav-btn:disabled,
  .rail-nav-btn[aria-disabled="true"] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Horizontal Snap Track (no vertical wheel hijacking) */
  .projects-rail-track {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.65rem;
    padding-right: 2.5rem; /* Visible partial card hint */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    user-select: none;
  }

  .projects-rail-track:active {
    cursor: grabbing;
  }

  .projects-rail-track::-webkit-scrollbar {
    display: none;
  }

  .project-rail-card {
    flex: 0 0 280px;
    width: 280px;
    scroll-snap-align: start;
    padding: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .project-rail-card.is-spotlight {
    flex: 0 0 340px;
    width: 340px;
    border-color: rgba(247, 148, 29, 0.4);
  }

  #stage-panel-genai .project-rail-card.is-spotlight {
    border-color: rgba(238, 75, 43, 0.4);
  }

  .spotlight-ribbon {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #111827;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .rail-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
    overflow: hidden;
  }

  .rail-card-media :global(img),
  .rail-card-media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .project-rail-card:hover .rail-card-media :global(img) {
    transform: scale(1.04);
  }

  .rail-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 10px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .rail-card-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .rail-card-title {
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: var(--color-text-primary);
  }

  .rail-card-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin: 0 0 0.65rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rail-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: #B86200;
    text-decoration: none;
    margin-top: auto;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  :global(.dark) .rail-card-link {
    color: #F7941D;
  }

  #stage-panel-genai .rail-card-link {
    color: #B82810;
  }

  :global(.dark) #stage-panel-genai .rail-card-link {
    color: #EE4B2B;
  }

  .rail-card-link:hover {
    transform: translateX(3px);
  }

  /* Rail Progress Dots */
  .rail-dots-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .rail-dot.is-active {
    width: 16px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
  }

  /* Mobile Elements default hidden on desktop */
  .mobile-peg-header {
    display: none;
  }

  .mobile-stacked-content {
    display: none;
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media (max-width: 1199px) {
    .stage-container {
      grid-template-columns: 35% 65%;
      gap: 1.5rem;
    }

    .project-rail-card {
      flex: 0 0 250px;
      width: 250px;
    }

    .project-rail-card.is-spotlight {
      flex: 0 0 290px;
      width: 290px;
    }
  }

  @media (max-width: 899px) {
    .peg-solutions-track {
      display: none; /* Interactive scroll track disabled on mobile */
    }

    /* Mobile Sticky Header */
    .mobile-peg-header {
      display: block;
      position: sticky;
      top: var(--nav-height, 72px);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      z-index: 40;
      backdrop-filter: blur(12px);
      padding: 0.5rem 0;
    }

    :global(.dark) .mobile-peg-header {
      background: rgba(18, 22, 28, 0.9);
    }

    .mobile-header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: var(--max-w-content);
      margin: 0 auto;
      padding: 0 var(--space-container);
    }

    .mobile-logo-mark {
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      color: var(--color-text-primary);
    }

    .mobile-pill-tabs {
      display: flex;
      gap: 0.35rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      padding: 0.2rem;
    }

    .mobile-tab {
      padding: 0.25rem 0.65rem;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-decoration: none;
      border-radius: var(--radius-full);
      transition: all 0.2s ease;
    }

    .mobile-tab.is-active {
      background: var(--color-surface);
      color: var(--color-text-primary);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    }

    /* Mobile Stacked Content */
    .mobile-stacked-content {
      display: block;
      padding: 2.5rem 0;
    }

    .mobile-pillar-section {
      padding: 2rem 0;
      border-bottom: 1px solid var(--color-border);
      scroll-margin-top: calc(var(--nav-height, 72px) + 50px);
    }

    .mobile-cards-stack {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 1.25rem;
    }

    .mobile-accelerators-block {
      margin-top: 1.5rem;
    }

    .mobile-acc-title {
      font-size: var(--fs-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin: 0 0 0.85rem 0;
    }

    .mobile-project-cards {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 1rem;
    }

    .mobile-project-card {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      padding: 0;
      overflow: hidden;
    }

    .mobile-card-media {
      width: 100%;
      aspect-ratio: 16 / 10;
      background: var(--color-bg);
      overflow: hidden;
    }

    .mobile-card-content {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .mobile-badge {
      font-size: 10px;
      font-weight: 700;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .mobile-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      margin: 0;
      color: var(--color-text-primary);
    }

    .mobile-card-desc {
      font-size: 0.8125rem;
      color: var(--color-text-secondary);
      line-height: 1.4;
      margin: 0;
    }

    .mobile-card-link {
      font-size: var(--fs-xs);
      font-weight: 600;
      color: #1E4B8F;
      margin-top: 0.4rem;
    }

    :global(.dark) .mobile-card-link {
      color: #5B8FE0;
    }
  }

  /* Compact Viewports (e.g. 1440x720, 1280x650) */
  @media (max-height: 750px) and (min-width: 900px) {
    .stage-intro-header {
      top: calc(50% - 180px);
    }

    .intro-headline {
      font-size: 2.2rem;
    }

    .cube-scene-wrapper {
      height: 200px;
    }

    .panel-header {
      margin-bottom: 0.65rem;
    }

    .panel-title {
      font-size: 1.35rem;
    }

    .panel-desc {
      font-size: 0.8125rem;
    }

    .services-duo-grid {
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }

    .service-card {
      padding: 0.65rem 0.85rem;
    }

    .project-rail-card {
      flex: 0 0 240px;
      width: 240px;
    }

    .project-rail-card.is-spotlight {
      flex: 0 0 280px;
      width: 280px;
    }

    .rail-card-body {
      padding: 0.65rem;
    }

    .rail-card-title {
      font-size: 0.8125rem;
    }

    .rail-card-desc {
      font-size: 0.7rem;
      margin-bottom: 0.4rem;
    }
  }
</style>

<script>
  import { getScrollStory, smoothstep, lerp, clamp } from '../scripts/scrollStory';

  function initPegSolutions() {
    const track = document.getElementById('peg-solutions-track');
    const stage = document.getElementById('peg-solutions-stage');
    const introHeader = document.getElementById('stage-intro-header');
    const scrollCue = document.getElementById('intro-scroll-cue');
    const cubeCol = document.getElementById('stage-cube-col');
    const cubeAssembly = document.getElementById('cube-assembly');
    const contentCol = document.getElementById('stage-content-col');
    const container = document.getElementById('stage-main-container');

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-pill-tabs .peg-tab-btn'));
    const panels: Record<string, HTMLElement | null> = {
      plan: document.getElementById('stage-panel-plan'),
      engineer: document.getElementById('stage-panel-engineer'),
      genai: document.getElementById('stage-panel-genai')
    };
    const faces: Record<string, HTMLElement | null> = {
      plan: document.getElementById('cube-face-plan'),
      engineer: document.getElementById('cube-face-engineer'),
      genai: document.getElementById('cube-face-genai')
    };

    if (!track || !stage || !cubeAssembly || !cubeCol || !contentCol) return;

    // Cube rotation angles
    // Face-front: Plan (y: 0)
    // Face-right: Engineer (y: -90)
    // Face-back: Gen-AI (y: -180)
    const pillarAngles: Record<string, { x: number; y: number }> = {
      intro: { x: -20, y: -30 },
      plan: { x: -8, y: 0 },
      engineer: { x: -8, y: -90 },
      genai: { x: -8, y: -180 }
    };

    let activePillar = 'plan';
    let trackTop = 0;
    let trackHeight = 0;
    let centerOffset = 0;
    let introRevealed = false;

    const atmosphereTint = document.getElementById('pillar-atmosphere-tint');
    const cubeGlow = document.getElementById('cube-ambient-glow');

    function setPanelActive(pillar: 'plan' | 'engineer' | 'genai') {
      if (activePillar === pillar && atmosphereTint?.getAttribute('data-pillar') === pillar) return;
      activePillar = pillar;

      // Update atmosphere tint and cube ambient glow
      if (atmosphereTint) atmosphereTint.setAttribute('data-pillar', pillar);
      if (cubeGlow) cubeGlow.setAttribute('data-pillar', pillar);

      // Update Tabs
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-pillar') === pillar;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Update Panels
      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        panel.classList.toggle('is-active', key === pillar);
      });

      // Active Face indicator
      Object.entries(faces).forEach(([key, face]) => {
        if (!face) return;
        face.classList.toggle('is-active-face', key === pillar);
      });
    }

    // Subscribe to shared scrollStory controller
    const story = getScrollStory();

    story.subscribe({
      id: 'peg-solutions',
      gateElement: track,
      measure: (vp) => {
        if (vp.viewportWidth < 900) return;
        const rect = track.getBoundingClientRect();
        trackTop = rect.top + vp.scrollY;
        trackHeight = track.offsetHeight - vp.viewportHeight;

        // Calculate translation needed to place cube in exact center of container during Phase 0
        if (container && cubeCol) {
          const containerWidth = container.offsetWidth;
          const cubeColWidth = cubeCol.offsetWidth;
          centerOffset = (containerWidth - cubeColWidth) / 2;
        }
      },
      update: (vp) => {
        if (vp.viewportWidth < 900 || trackHeight <= 0) return;

        // Intro headline staggered word reveal
        if (!introRevealed && introHeader) {
          const iRect = introHeader.getBoundingClientRect();
          if (iRect.top < vp.viewportHeight * 0.9) {
            const headlineEl = document.getElementById('intro-headline');
            if (headlineEl) headlineEl.classList.add('is-revealed');
            introRevealed = true;
          }
        }

        // Calculate scroll progress p in [0, 1]
        const p = clamp((vp.scrollY - trackTop) / trackHeight, 0, 1);

        // --- PHASE 0: Intro only (p: 0 -> 0.15) ---
        if (p <= 0.15) {
          const introP = p / 0.15; // 0 to 1 inside phase 0

          // Intro header visible
          if (introHeader) {
            introHeader.style.opacity = `${1 - introP * 0.8}`;
            introHeader.style.transform = `translateX(-50%) translateY(${-introP * 15}px)`;
            introHeader.style.pointerEvents = introP > 0.8 ? 'none' : 'auto';
          }

          // "Scroll to explore" visible only in phase 0
          if (scrollCue) {
            scrollCue.style.opacity = `${1 - introP * 1.5}`;
            scrollCue.style.pointerEvents = introP > 0.6 ? 'none' : 'auto';
          }

          // Cube centered in stage with hand-off crossfade
          let cubeAlpha = 1;
          if (vp.scrollY < trackTop) {
            const hStart = trackTop - vp.viewportHeight * 0.35;
            const hEnd = trackTop - vp.viewportHeight * 0.05;
            cubeAlpha = smoothstep(0, 1, clamp((vp.scrollY - hStart) / Math.max(1, hEnd - hStart), 0, 1));
          }
          cubeCol.style.opacity = `${cubeAlpha}`;
          cubeCol.style.transform = `translateX(${centerOffset}px) scale(1.0)`;

          // Content column completely hidden
          contentCol.style.opacity = '0';
          contentCol.style.visibility = 'hidden';
          contentCol.style.pointerEvents = 'none';

          // Cube is on Intro angle
          cubeAssembly.style.transform = `rotateX(${pillarAngles.intro.x}deg) rotateY(${pillarAngles.intro.y}deg)`;
          setPanelActive('plan');
        }
        // --- PHASE 1: Transition into left column (p: 0.15 -> 0.30) ---
        else if (p <= 0.30) {
          const t1 = (p - 0.15) / 0.15; // 0 to 1 inside phase 1
          const ease1 = smoothstep(0, 1, t1);

          // Intro header fades out
          if (introHeader) {
            introHeader.style.opacity = `${(1 - ease1) * 0.2}`;
            introHeader.style.transform = `translateX(-50%) translateY(${-15 - ease1 * 25}px)`;
            introHeader.style.pointerEvents = 'none';
          }

          // "Scroll to explore" cue completely hidden
          if (scrollCue) {
            scrollCue.style.opacity = '0';
            scrollCue.style.pointerEvents = 'none';
          }

          // Cube transitions from center to left column
          cubeCol.style.opacity = '1';
          const currentX = lerp(centerOffset, 0, ease1);
          cubeCol.style.transform = `translateX(${currentX}px) scale(1.0)`;

          // Cube interpolates angle: intro -> plan
          const ang = {
            x: lerp(pillarAngles.intro.x, pillarAngles.plan.x, ease1),
            y: lerp(pillarAngles.intro.y, pillarAngles.plan.y, ease1)
          };
          cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;

          // Content column begins fading in toward end of phase 1
          if (t1 > 0.6) {
            const contentAlpha = (t1 - 0.6) / 0.4;
            contentCol.style.opacity = `${contentAlpha}`;
            contentCol.style.visibility = 'visible';
            contentCol.style.pointerEvents = 'auto';
          } else {
            contentCol.style.opacity = '0';
            contentCol.style.visibility = 'hidden';
            contentCol.style.pointerEvents = 'none';
          }

          setPanelActive('plan');
        }
        // --- PHASES 2-4: Pillar Stages (p: 0.30 -> 1.0) ---
        else {
          // Intro & scroll cue fully hidden
          if (introHeader) {
            introHeader.style.opacity = '0';
            introHeader.style.pointerEvents = 'none';
          }
          if (scrollCue) {
            scrollCue.style.opacity = '0';
            scrollCue.style.pointerEvents = 'none';
          }

          // Cube column fixed in left column
          cubeCol.style.transform = 'translateX(0px) scale(1.0)';

          // Content column fully active
          contentCol.style.opacity = '1';
          contentCol.style.visibility = 'visible';
          contentCol.style.pointerEvents = 'auto';

          // Phase 2: Plan (0.30 -> 0.55)
          if (p <= 0.55) {
            if (p > 0.48) {
              const blend = (p - 0.48) / 0.07;
              const ang = {
                x: lerp(pillarAngles.plan.x, pillarAngles.engineer.x, blend),
                y: lerp(pillarAngles.plan.y, pillarAngles.engineer.y, blend)
              };
              cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
            } else {
              cubeAssembly.style.transform = `rotateX(${pillarAngles.plan.x}deg) rotateY(${pillarAngles.plan.y}deg)`;
            }
            setPanelActive('plan');
          }
          // Phase 3: Engineer (0.55 -> 0.78)
          else if (p <= 0.78) {
            if (p > 0.72) {
              const blend = (p - 0.72) / 0.06;
              const ang = {
                x: lerp(pillarAngles.engineer.x, pillarAngles.genai.x, blend),
                y: lerp(pillarAngles.engineer.y, pillarAngles.genai.y, blend)
              };
              cubeAssembly.style.transform = `rotateX(${ang.x}deg) rotateY(${ang.y}deg)`;
            } else {
              cubeAssembly.style.transform = `rotateX(${pillarAngles.engineer.x}deg) rotateY(${pillarAngles.engineer.y}deg)`;
            }
            setPanelActive('engineer');
          }
          // Phase 4: Gen-AI (0.78 -> 1.0)
          else {
            cubeAssembly.style.transform = `rotateX(${pillarAngles.genai.x}deg) rotateY(${pillarAngles.genai.y}deg)`;
            setPanelActive('genai');
          }
        }
      }
    });

    // Tab buttons click: smoothly scroll page to that pillar's scroll target
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const pillar = tab.getAttribute('data-pillar');
        if (!pillar) return;

        let targetP = 0.40;
        if (pillar === 'engineer') targetP = 0.65;
        if (pillar === 'genai') targetP = 0.88;

        const targetScroll = trackTop + trackHeight * targetP;
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      });
    });

    // Interactive Cube Drag
    const sceneWrapper = document.getElementById('cube-scene-wrapper');
    if (sceneWrapper) {
      let startX = 0;
      let deltaX = 0;
      let isDragging = false;

      sceneWrapper.addEventListener('pointerdown', (e) => {
        isDragging = true;
        startX = e.clientX;
        deltaX = 0;
        cubeAssembly.style.transition = 'none';
        sceneWrapper.setPointerCapture(e.pointerId);
      });

      sceneWrapper.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        deltaX = e.clientX - startX;
        const currentAng = pillarAngles[activePillar] || pillarAngles.plan;
        cubeAssembly.style.transform = `rotateX(${currentAng.x}deg) rotateY(${currentAng.y + deltaX * 0.4}deg)`;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        cubeAssembly.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1)';
        try {
          sceneWrapper.releasePointerCapture(e.pointerId);
        } catch (_) {}

        const pillarOrder: Array<'plan' | 'engineer' | 'genai'> = ['plan', 'engineer', 'genai'];
        let currentIdx = pillarOrder.indexOf(activePillar as any);
        if (currentIdx === -1) currentIdx = 0;

        if (deltaX < -35 && currentIdx < 2) {
          currentIdx += 1;
        } else if (deltaX > 35 && currentIdx > 0) {
          currentIdx -= 1;
        }

        const nextPillar = pillarOrder[currentIdx];
        let targetP = 0.40;
        if (nextPillar === 'engineer') targetP = 0.65;
        if (nextPillar === 'genai') targetP = 0.88;

        window.scrollTo({ top: trackTop + trackHeight * targetP, behavior: 'smooth' });
      };

      sceneWrapper.addEventListener('pointerup', endDrag);
      sceneWrapper.addEventListener('pointercancel', endDrag);
    }

    // Horizontal Rails Setup (Engineer & Gen-AI)
    ['engineer', 'genai'].forEach((railId) => {
      const trackEl = document.getElementById(`rail-track-${railId}`);
      const prevBtn = document.querySelector<HTMLButtonElement>(`.rail-nav-prev[data-rail-target="${railId}"]`);
      const nextBtn = document.querySelector<HTMLButtonElement>(`.rail-nav-next[data-rail-target="${railId}"]`);
      const dots = Array.from(document.querySelectorAll<HTMLElement>(`#rail-dots-${railId} .rail-dot`));

      if (!trackEl) return;

      const cardStep = 290;

      const updateRailState = () => {
        const scrollLeft = trackEl.scrollLeft;
        const maxScroll = trackEl.scrollWidth - trackEl.clientWidth;

        if (prevBtn) {
          prevBtn.disabled = scrollLeft <= 4;
          prevBtn.setAttribute('aria-disabled', scrollLeft <= 4 ? 'true' : 'false');
        }
        if (nextBtn) {
          nextBtn.disabled = scrollLeft >= maxScroll - 4;
          nextBtn.setAttribute('aria-disabled', scrollLeft >= maxScroll - 4 ? 'true' : 'false');
        }

        const activeIdx = Math.round(scrollLeft / cardStep);
        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === activeIdx);
        });
      };

      prevBtn?.addEventListener('click', () => {
        trackEl.scrollBy({ left: -cardStep, behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        trackEl.scrollBy({ left: cardStep, behavior: 'smooth' });
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          trackEl.scrollTo({ left: idx * cardStep, behavior: 'smooth' });
        });
      });

      trackEl.addEventListener('scroll', updateRailState, { passive: true });
      updateRailState();

      // Drag to scroll horizontally on the track (without vertical wheel hijacking)
      let isRailDragging = false;
      let railStartX = 0;
      let railScrollLeft = 0;
      let hasDragged = false;

      trackEl.addEventListener('pointerdown', (e) => {
        isRailDragging = true;
        hasDragged = false;
        railStartX = e.pageX - trackEl.offsetLeft;
        railScrollLeft = trackEl.scrollLeft;
        trackEl.style.scrollBehavior = 'auto';
      });

      window.addEventListener('pointermove', (e) => {
        if (!isRailDragging) return;
        const x = e.pageX - trackEl.offsetLeft;
        const walk = (x - railStartX) * 1.2;
        if (Math.abs(walk) > 4) {
          hasDragged = true;
        }
        trackEl.scrollLeft = railScrollLeft - walk;
      });

      const endRailDrag = () => {
        if (!isRailDragging) return;
        isRailDragging = false;
        trackEl.style.scrollBehavior = 'smooth';
      };

      window.addEventListener('pointerup', endRailDrag);
      window.addEventListener('pointercancel', endRailDrag);

      // Prevent link clicks if user was dragging
      trackEl.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (hasDragged) {
            e.preventDefault();
            hasDragged = false;
          }
        });
      });
    });
  }

  initPegSolutions();
  document.addEventListener('astro:after-swap', initPegSolutions);
</script>
