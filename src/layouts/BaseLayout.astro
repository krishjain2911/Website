---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; item: string }>;
}

const {
  title = `${siteConfig.name} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  ogImage = '/og-image.png',
  breadcrumbs
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageURL = new URL(ogImage, siteConfig.url).toString();

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": b.name,
    "item": new URL(b.item, siteConfig.url).toString()
  }))
} : null;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteConfig.name,
  "legalName": siteConfig.legalName,
  "url": siteConfig.url,
  "logo": `${siteConfig.url}/brand/rhsp-logo.png`,
  "description": siteConfig.description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ThePlayce, 17th Floor, Marathon Millennium, Lal Bahadur Shastri Marg, beside Nirmal Lifestyle Road, Moti Nagar, Mulund Colony, Mulund West",
    "addressLocality": "Mumbai",
    "addressRegion": "Maharashtra",
    "postalCode": "400080",
    "addressCountry": "IN"
  },
  "hasMap": siteConfig.contact.mapUrl,
  "founders": siteConfig.team.members.map(m => ({
    "@type": "Person",
    "name": m.name,
    "jobTitle": m.role,
    "sameAs": m.linkedin
  })),
  "sameAs": [
    siteConfig.socials.linkedin,
    siteConfig.socials.twitter,
    siteConfig.socials.youtube
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Krish Jain" />
    <link rel="author" href="/humans.txt" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/brand/rhsp-logo.png" />
    <link rel="apple-touch-icon" href="/brand/rhsp-logo.png" />

    <!-- Preload critical variable display font for instant FCP/LCP -->
    <link
      rel="preload"
      href="/fonts/figtree-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme Inline Script (Strict Zero Flash of Unthemed Content) -->
    <script is:inline>
      (function() {
        try {
          const urlTheme = new URLSearchParams(window.location.search).get('theme');
          if (urlTheme === 'dark' || urlTheme === 'light') {
            document.documentElement.setAttribute('data-theme', urlTheme);
            return;
          }
          const stored = localStorage.getItem('rhsp-theme');
          if (stored) {
            document.documentElement.setAttribute('data-theme', stored);
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph / Social Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteConfig.legalName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@RoundHoleSqrPeg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />

    <!-- Global Scroll Reveal & Arc Observer -->
    <script>
      function setupScrollObserver() {
        const revealElements = document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)');
        const arcElements = document.querySelectorAll('.curved-arc-path:not(.is-drawn)');

        if (revealElements.length) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
          });

          revealElements.forEach(el => observer.observe(el));
        }

        if (arcElements.length) {
          const arcObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-drawn');
                arcObserver.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.05,
            rootMargin: '0px 0px -20px 0px'
          });

          arcElements.forEach(el => arcObserver.observe(el));
        }
      }

      setupScrollObserver();
      document.addEventListener('astro:after-swap', setupScrollObserver);
    </script>

    <!-- Console Easter Eggs (Crafted by Krish Jain) -->
    <script is:inline>
      (function() {
        if (window.__rhsp_easter_egg_init) return;
        window.__rhsp_easter_egg_init = true;

        const brandHeader = 'background: linear-gradient(135deg, #F7941D 0%, #EE4B2B 100%); color: #FFFFFF; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-weight: 700; font-size: 13px; padding: 8px 16px; border-radius: 6px; text-shadow: 0 1px 2px rgba(0,0,0,0.25); display: inline-block; margin-bottom: 6px;';
        const authorBadge = 'background: #141413; color: #F7941D; font-family: monospace; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 4px; border: 1px solid #F7941D;';
        const linkStyle = 'color: #1E4B8F; font-weight: 600; text-decoration: underline; font-family: monospace; font-size: 11px;';
        const labelStyle = 'color: #888888; font-size: 11px; font-family: sans-serif;';
        const cmdBadge = 'background: #F6F6F4; color: #EE4B2B; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-weight: 600; border: 1px solid #E6E6E3;';

        console.log(
          '%c⬡ RHSP | Round Hole Square Peg — Enterprise Low-Code & Sovereign AI',
          brandHeader
        );

        console.log(
          '%cCrafted & Developed with Precision by Krish Jain\n' +
          '%cLinkedIn: %chttps://www.linkedin.com/in/thekrishjain/\n' +
          '%cBuilt with Astro, WebGL/OGL 3D engine, custom shaders & zero layout shift.',
          authorBadge,
          labelStyle,
          linkStyle,
          labelStyle
        );

        console.log(
          '%c💡 Exploring the codebase? Try running %ckrish()%c or %crhsp()%c in the console! ✨',
          labelStyle,
          cmdBadge,
          labelStyle,
          cmdBadge,
          labelStyle
        );

        // Interactive Console Easter Eggs
        window.krish = function() {
          console.log(
            '%c👋 Hey there! I\'m Krish Jain.\n' +
            'Frontend Engineer & Creative Technologist.\n\n' +
            '🚀 Connect with me on LinkedIn:\nhttps://www.linkedin.com/in/thekrishjain/\n\n' +
            '✨ Fun facts about this build:\n' +
            '• Frame-by-frame responsive 3D cube scroll engine\n' +
            '• Near-zero CLS (< 0.01) across mobile and desktop\n' +
            '• Custom AVIF/WebP image processing pipeline with alpha defringing',
            'color: #F7941D; font-size: 13px; font-weight: 600; line-height: 1.6; font-family: sans-serif;'
          );
          return '✨ Krish Jain: https://www.linkedin.com/in/thekrishjain/';
        };

        window.rhsp = function() {
          console.log(
            '%c🔷 Round Hole Square Peg — We engineer the bridge from challenge to solution.\n' +
            '• Plan: Automate high-friction workflows\n' +
            '• Engineer: OutSystems speed + MERN high-code architecture\n' +
            '• Gen-AI: Private, on-prem sovereign models with verified grounding\n\n' +
            '📍 ThePlayce, 17th Floor, Marathon Millennium, Mulund West, Mumbai\n' +
            '📧 letstalk@rhsp.solutions',
            'color: #1E4B8F; font-size: 12px; font-weight: 600; line-height: 1.6; font-family: sans-serif;'
          );
          return '🚀 https://rhsp.solutions';
        };

        window.developedBy = window.krish;
        window.author = window.krish;

        // Easter Egg: Konami Code triggers a celebration in console
        const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
        let konamiIdx = 0;
        window.addEventListener('keydown', function(e) {
          if (e.key.toLowerCase() === konami[konamiIdx].toLowerCase()) {
            konamiIdx++;
            if (konamiIdx === konami.length) {
              konamiIdx = 0;
              console.log(
                '%c🎉 KONAMI CODE UNLOCKED! 🎉\n' +
                'You found the secret easter egg! You have great taste in code.\n' +
                'Say hi to Krish Jain: https://www.linkedin.com/in/thekrishjain/',
                'background: #141413; color: #00FF66; font-size: 15px; font-weight: bold; padding: 10px; border-radius: 6px;'
              );
            }
          } else {
            konamiIdx = 0;
          }
        });
      })();
    
        // Handle all "Let's talk" and #contact links to smoothly scroll to founders contact section
        document.addEventListener('click', (e) => {
          const target = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!target) return;
          const href = target.getAttribute('href');
          if (href === '#contact' || href === '/#contact' || href === '#founders-contact' || href === '/#founders-contact') {
            const contactEl = document.getElementById('contact') || document.getElementById('founders-contact');
            if (contactEl) {
              e.preventDefault();
              contactEl.scrollIntoView({ behavior: 'smooth' });
              history.pushState(null, '', '#contact');
            }
          }
        });

        // If landing on page with #contact in hash, smooth scroll to it
        if (window.location.hash === '#contact' || window.location.hash === '#founders-contact') {
          setTimeout(() => {
            const contactEl = document.getElementById('contact') || document.getElementById('founders-contact');
            contactEl?.scrollIntoView({ behavior: 'smooth' });
          }, 150);
        }
    
    </script>
  </body>
</html>
